<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UseLocalAgentBlazorSource Condition="'$(UseLocalAgentBlazorSource)' == '' and Exists('..\..\src\AgentBlazor.Components\AgentBlazor.Components.csproj')">true</UseLocalAgentBlazorSource>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLocalAgentBlazorSource)' == 'true'">
    <ProjectReference Include="..\..\src\AgentBlazor.Core\AgentBlazor.Core.csproj" />
    <ProjectReference Include="..\..\src\AgentBlazor.Hosting\AgentBlazor.Hosting.csproj" />
    <ProjectReference Include="..\..\src\AgentBlazor.Components\AgentBlazor.Components.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLocalAgentBlazorSource)' != 'true'">
    <PackageReference Include="AgentBlazor" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

</Project>
