@inherits LayoutComponentBase
@using AgentBlazor.Components
@using AgentBlazor.Components.Chat
@using MudBlazor

<MudThemeProvider Theme="_activeTheme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="demo-app @CurrentThemeCssClass">
    <aside class="demo-app__sidebar">
        <DemoNavMenu />
    </aside>

    <main class="demo-app__main">
        <header class="demo-app__topbar">
            <a href="/" class="demo-app__back">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                <span>Back to Home</span>
            </a>

            <a href="/demo" class="demo-app__brand">
                <img src="logo.png" class="demo-app__brand-logo" alt="AgentBlazor" />
                <span class="demo-app__brand-name">AgentBlazor Demo</span>
            </a>

            <div class="demo-app__controls">
                <div class="demo-app__quick-links">
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Href="/demo/components">
                        Component Kit
                    </MudButton>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Href="/demo/docs">
                        Integration Guide
                    </MudButton>
                </div>

                <MudSelect T="string"
                           Value="_selectedThemeKey"
                           ValueChanged="OnThemeChanged"
                           Label="Theme"
                           Dense="true"
                           Variant="Variant.Outlined"
                           Class="demo-app__theme-select">
                    @foreach (var option in ThemeOptions)
                    {
                        <MudSelectItem T="string" Value="@option.Key">@option.Label</MudSelectItem>
                    }
                </MudSelect>
            </div>
        </header>

        <article class="demo-app__content">
            @Body
        </article>
    </main>
</div>

<AgentChatWidget Title="Assistant"
                 Description="Generated UI mode is enabled for this chat."
                 EnableGeneratedUi="true"
                 Placeholder="Ask me to navigate, analyze data, draft UI, and run workflow actions across this app..."
                 Theme="ChatTheme.Dark()"
                 Width="31rem"
                 Height="68vh"
                 Right="1.1rem"
                 Bottom="1rem"
                 CssClass="demo-app__assistant-widget" />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string AuroraThemeKey = "aurora";
    private const string CoastlineThemeKey = "coastline";

    private static readonly MudTheme AuroraTheme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#e03a58",
            Secondary = "#4a9edd",
            Tertiary = "#7a5af8",
            Info = "#3a8fd4",
            Success = "#2ecc87",
            Warning = "#f0a030",
            Error = "#ff4d6a",
            Background = "#03040a",
            BackgroundGray = "#0a0d18",
            Surface = "#0d1120",
            AppbarBackground = "#080b16",
            AppbarText = "#e8f0ff",
            DrawerBackground = "#080b16",
            DrawerText = "#c8d8f0",
            TextPrimary = "#e8f0ff",
            TextSecondary = "#7a92bb",
            TableLines = "#1a2040",
            Divider = "#1a2040",
            LinesDefault = "#1a2040",
            ActionDefault = "#7a92bb",
            ActionDisabled = "#3a4a6a",
            ActionDisabledBackground = "#0d1120"
        }
    };

    private static readonly MudTheme CoastlineTheme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#e03a58",
            Secondary = "#2ecc87",
            Tertiary = "#2a9faa",
            Info = "#2a8ab0",
            Success = "#2ecc87",
            Warning = "#f0a030",
            Error = "#ff4d6a",
            Background = "#03040a",
            BackgroundGray = "#08100e",
            Surface = "#0c1410",
            AppbarBackground = "#080e0c",
            AppbarText = "#e0f4ee",
            DrawerBackground = "#080e0c",
            DrawerText = "#b8d8cc",
            TextPrimary = "#e0f4ee",
            TextSecondary = "#6a9a8a",
            TableLines = "#142418",
            Divider = "#142418",
            LinesDefault = "#142418",
            ActionDefault = "#6a9a8a",
            ActionDisabled = "#2a4038",
            ActionDisabledBackground = "#0c1410"
        }
    };

    private static readonly IReadOnlyList<ThemeOption> ThemeOptions =
    [
        new(AuroraThemeKey, "Aurora Blue"),
        new(CoastlineThemeKey, "Coastline Mint")
    ];

    private string _selectedThemeKey = AuroraThemeKey;
    private MudTheme _activeTheme = AuroraTheme;

    private string CurrentThemeCssClass =>
        string.Equals(_selectedThemeKey, CoastlineThemeKey, StringComparison.OrdinalIgnoreCase)
            ? "demo-theme--coastline"
            : "demo-theme--aurora";

    private Task OnThemeChanged(string key)
    {
        _selectedThemeKey = key;
        _activeTheme = string.Equals(key, CoastlineThemeKey, StringComparison.OrdinalIgnoreCase)
            ? CoastlineTheme
            : AuroraTheme;
        return Task.CompletedTask;
    }

    private sealed record ThemeOption(string Key, string Label);
}
