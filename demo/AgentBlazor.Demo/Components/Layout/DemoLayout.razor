@inherits LayoutComponentBase
@using AgentBlazor.Components
@using AgentBlazor.Components.Chat
@using MudBlazor
@implements IDisposable
@inject NavigationManager NavigationManager

<MudThemeProvider Theme="_activeTheme" IsDarkMode="@(!IsDojoRoute)" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="demo-app @CurrentThemeCssClass @(IsDojoRoute ? "demo-app--dojo" : IsComponentsRoute ? "demo-app--components" : null)">
    @if (!IsDojoRoute && !IsComponentsRoute)
    {
        <aside class="demo-app__sidebar">
            <MudPaper Elevation="0" Class="demo-app__sidebar-card">
                <a href="/demo" class="demo-app__sidebar-brand">
                    <img src="logo.png" class="demo-app__sidebar-logo" alt="AgentBlazor" />
                    <span class="demo-app__sidebar-brand-text">
                        <strong>AgentBlazor</strong>
                        <small>Workflow Hub</small>
                    </span>
                </a>

                <p class="demo-app__sidebar-copy">
                    Start with semantic workflow showcases. The dojo and component explorer remain supporting reference surfaces.
                </p>

                <DemoNavMenu />
            </MudPaper>
        </aside>
    }

    <main class="demo-app__main @(IsDojoRoute ? "demo-app__main--dojo" : IsComponentsRoute ? "demo-app__main--components" : null)">
        @if (!IsDojoRoute)
        {
            @if (IsComponentsRoute)
            {
                <header class="demo-app__topbar demo-app__topbar--components">
                    <a href="/" class="demo-app__masthead-brand">
                        <img src="logo.png" class="demo-app__masthead-logo" alt="AgentBlazor" />
                        <span class="demo-app__masthead-copy">
                            <strong>AgentBlazor</strong>
                            <small>Agentic Components</small>
                        </span>
                    </a>

                    <nav class="demo-app__masthead-nav" aria-label="Primary">
                        <a href="/">Home</a>
                        <a href="/demo/dojo">Capability Dojo</a>
                        <a href="/demo/components" aria-current="page">Agentic Components</a>
                    </nav>

                    <div class="demo-app__controls">
                        <MudSelect T="string"
                                   Value="_selectedThemeKey"
                                   ValueChanged="OnThemeChanged"
                                   Label="Theme"
                                   Dense="true"
                                   Variant="Variant.Outlined"
                                   Class="demo-app__theme-select">
                            @foreach (var option in ThemeOptions)
                            {
                                <MudSelectItem T="string" Value="@option.Key">@option.Label</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </header>
            }
            else
            {
                <header class="demo-app__topbar">
                    <div class="demo-app__topbar-intro">
                        <a href="/" class="demo-app__back">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                            <span>Back to Home</span>
                        </a>

                        <div class="demo-app__title-block">
                            <p class="demo-app__title-eyebrow">Workflow-First Product Proof</p>
                            <h1 class="demo-app__title">AgentBlazor Workflow Hub</h1>
                        </div>
                    </div>

                    <div class="demo-app__controls">
                        <MudSelect T="string"
                                   Value="_selectedThemeKey"
                                   ValueChanged="OnThemeChanged"
                                   Label="Theme"
                                   Dense="true"
                                   Variant="Variant.Outlined"
                                   Class="demo-app__theme-select">
                            @foreach (var option in ThemeOptions)
                            {
                                <MudSelectItem T="string" Value="@option.Key">@option.Label</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                </header>
            }
        }

        <article class="demo-app__content @(IsComponentsRoute ? "demo-app__content--components" : null)">
            @Body
        </article>
    </main>

    @if (!IsDojoRoute && !IsComponentsRoute)
    {
        <aside class="demo-app__assistant-pane">
            <MudPaper Elevation="0" Class="demo-app__assistant-card">
                <div class="demo-app__assistant-head">
                    <p class="demo-app__assistant-eyebrow">AI Assistant</p>
                    <h2 class="demo-app__assistant-title">Control This Workspace</h2>
                    <p class="demo-app__assistant-copy">
                        @AssistantDescription
                    </p>
                </div>

                <AgentChatSurface Title="@AssistantTitle"
                                  Description="@AssistantDescription"
                                  DefaultAgentName="@DefaultAssistantAgent"
                                  LockAgentToCurrentRoute="true"
                                  ShowAgentSelector="false"
                                  RequireHandoffApproval="@AssistantRequireHandoffApproval"
                                  HandoffApprovalPolicy="@_assistantHandoffApprovalPolicy"
                                  HandoffPolicy="@_assistantHandoffPolicy"
                                  MaxHandoffsPerSession="6"
                                  MaxHandoffsPerPair="2"
                                  MaxHandoffsPerWindow="3"
                                  HandoffWindowMinutes="10"
                                  MaxPairHandoffsPerWindow="2"
                                  BlockImmediateReturnHandoff="true"
                                  EnableGeneratedUi="@AssistantEnableGeneratedUi"
                                  Placeholder="@AssistantPlaceholder"
                                  Theme="_assistantTheme"
                                  CssClass="demo-app__assistant-surface" />
            </MudPaper>
        </aside>
    }
</div>

@if (!IsDojoRoute)
{
    <AgentChatWidget Title="@AssistantTitle"
                     Description="@AssistantDescription"
                     DefaultAgentName="@DefaultAssistantAgent"
                     RequireHandoffApproval="@AssistantRequireHandoffApproval"
                     HandoffApprovalPolicy="@_assistantHandoffApprovalPolicy"
                     HandoffPolicy="@_assistantHandoffPolicy"
                     MaxHandoffsPerSession="6"
                     MaxHandoffsPerPair="2"
                     MaxHandoffsPerWindow="3"
                     HandoffWindowMinutes="10"
                     MaxPairHandoffsPerWindow="2"
                     BlockImmediateReturnHandoff="true"
                     EnableGeneratedUi="@AssistantEnableGeneratedUi"
                     Placeholder="@AssistantPlaceholder"
                     Theme="_assistantTheme"
                     Width="26rem"
                     Height="68vh"
                     Right="0.85rem"
                     Bottom="0.85rem"
                     CssClass="demo-app__assistant-widget" />
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string AuroraThemeKey = "aurora";
    private const string CoastlineThemeKey = "coastline";

    private static readonly ChatTheme _assistantTheme = new()
    {
        Variant = ChatThemeVariant.Dark,
        Style = ChatVisualStyle.Minimal,
        Spacing = ChatSpacing.Compact,
        BorderRadius = ChatBorderRadius.Medium,
        EnableGlassEffect = false,
        AccentColor = "#6ea8fe",
        FontFamily = "\"Public Sans\", \"Segoe UI\", sans-serif",
        FontSize = "0.92rem"
    };

    private static readonly IReadOnlyDictionary<string, IReadOnlyList<string>> _assistantHandoffPolicy =
        new Dictionary<string, IReadOnlyList<string>>(StringComparer.OrdinalIgnoreCase)
        {
            ["Workflow Hub Agent"] = ["Supplier Compliance Agent", "File Workflow Agent", "Recipe Release Agent"],
            ["Dojo Workspace Agent"] = ["Workflow Orchestrator Agent"],
            ["Workflow Orchestrator Agent"] = ["Dojo Workspace Agent", "Supplier Analyst Agent"],
            ["Supplier Analyst Agent"] = ["Workflow Orchestrator Agent"]
        };

    private static readonly IReadOnlyDictionary<string, IReadOnlyList<string>> _assistantHandoffApprovalPolicy =
        new Dictionary<string, IReadOnlyList<string>>(StringComparer.OrdinalIgnoreCase)
        {
            ["Workflow Orchestrator Agent"] = ["Supplier Analyst Agent"],
            ["*"] = ["!Dojo Workspace Agent"]
        };

    private static readonly MudTheme AuroraTheme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#6ea8fe",
            Secondary = "#6fd3c2",
            Tertiary = "#8ea6ff",
            Info = "#6ea8fe",
            Success = "#2ecc87",
            Warning = "#f0a030",
            Error = "#ff5d7b",
            Background = "#070c16",
            BackgroundGray = "#0d1422",
            Surface = "#101a2b",
            AppbarBackground = "#0e1624",
            AppbarText = "#e9f1ff",
            DrawerBackground = "#0e1624",
            DrawerText = "#c5d6ef",
            TextPrimary = "#e9f1ff",
            TextSecondary = "#8da3c7",
            TableLines = "#22324a",
            Divider = "#22324a",
            LinesDefault = "#22324a",
            ActionDefault = "#8da3c7",
            ActionDisabled = "#44597a",
            ActionDisabledBackground = "#101a2b"
        }
    };

    private static readonly MudTheme CoastlineTheme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#66c7b0",
            Secondary = "#88b3ff",
            Tertiary = "#4ab29a",
            Info = "#88b3ff",
            Success = "#40c89b",
            Warning = "#f0a030",
            Error = "#ff5d7b",
            Background = "#07120f",
            BackgroundGray = "#0b1a16",
            Surface = "#0f211b",
            AppbarBackground = "#0d1c18",
            AppbarText = "#e8f7f2",
            DrawerBackground = "#0d1c18",
            DrawerText = "#b9ddd1",
            TextPrimary = "#e8f7f2",
            TextSecondary = "#78aa9a",
            TableLines = "#214034",
            Divider = "#214034",
            LinesDefault = "#214034",
            ActionDefault = "#78aa9a",
            ActionDisabled = "#355f52",
            ActionDisabledBackground = "#0f211b"
        }
    };

    private static readonly IReadOnlyList<ThemeOption> ThemeOptions =
    [
        new(AuroraThemeKey, "Aurora Blue"),
        new(CoastlineThemeKey, "Coastline Mint")
    ];

    private string _selectedThemeKey = AuroraThemeKey;
    private MudTheme _activeTheme = AuroraTheme;

    private string CurrentThemeCssClass =>
        string.Equals(_selectedThemeKey, CoastlineThemeKey, StringComparison.OrdinalIgnoreCase)
            ? "demo-theme--coastline"
            : "demo-theme--aurora";

    private string CurrentRoutePath => new Uri(NavigationManager.Uri).AbsolutePath;

    private bool IsWorkflowHubRoute =>
        string.Equals(CurrentRoutePath.TrimEnd('/'), "/demo", StringComparison.OrdinalIgnoreCase);

    private bool IsDojoRoute => CurrentRoutePath.StartsWith("/demo/dojo", StringComparison.OrdinalIgnoreCase);

    private bool IsComponentsRoute => CurrentRoutePath.StartsWith("/demo/components", StringComparison.OrdinalIgnoreCase);

    private bool IsWorkflowRoute => CurrentRoutePath.StartsWith("/demo/workflows", StringComparison.OrdinalIgnoreCase);

    private bool IsSupplierWorkflowRoute => CurrentRoutePath.StartsWith("/demo/workflows/supplier-compliance", StringComparison.OrdinalIgnoreCase);

    private bool IsFileWorkflowRoute => CurrentRoutePath.StartsWith("/demo/workflows/file-audit-bundle", StringComparison.OrdinalIgnoreCase);

    private bool IsRecipeWorkflowRoute => CurrentRoutePath.StartsWith("/demo/workflows/recipe-release", StringComparison.OrdinalIgnoreCase);

    private bool IsIncidentWorkflowRoute => CurrentRoutePath.StartsWith("/demo/workflows/incident-escalation", StringComparison.OrdinalIgnoreCase);

    private bool IsResponseOrchestrationRoute => CurrentRoutePath.StartsWith("/demo/workflows/response-orchestration", StringComparison.OrdinalIgnoreCase);

    private bool IsReleaseDossierRoute => CurrentRoutePath.StartsWith("/demo/workflows/release-dossier", StringComparison.OrdinalIgnoreCase);

    private string AssistantTitle =>
        IsComponentsRoute
            ? "Component Assistant"
            : IsSupplierWorkflowRoute
                ? "Supplier Compliance Assistant"
                : IsFileWorkflowRoute
                    ? "File Audit Assistant"
                    : IsRecipeWorkflowRoute
                        ? "Recipe Release Assistant"
                        : IsIncidentWorkflowRoute
                            ? "Incident Escalation Assistant"
                            : IsResponseOrchestrationRoute
                                ? "Response Orchestration Assistant"
                                : IsReleaseDossierRoute
                                    ? "Release Dossier Assistant"
                        : "Workflow Assistant";

    private string AssistantDescription =>
        IsComponentsRoute
            ? "Inspect wrapper behavior, compare Mud parity, and drive deterministic component actions on the current route."
            : IsSupplierWorkflowRoute
                ? "Use semantic supplier-risk workflows first: identify at-risk suppliers, explain the signals, apply the recovery playbook when severe supplier blockers remain, and prepare remediation-ready next steps with clear approval boundaries."
                : IsFileWorkflowRoute
                    ? "Use the semantic file-audit workflow first: explain blockers, prepare audit-ready remote bundles, and apply the recovery playbook when remote policy rejects a file."
                        : IsRecipeWorkflowRoute
                        ? "Use the semantic recipe-release workflow first: assess readiness, explain blockers, apply the recovery playbook when metadata conflicts appear, and prepare a release draft before any publish step."
                            : IsIncidentWorkflowRoute
                            ? "Use the semantic incident-escalation workflow first: explain blockers, move the triage surface into evidence review, prepare the escalation brief only when the case is ready, and guide recovery if the board handoff is blocked."
                            : IsResponseOrchestrationRoute
                                ? "Use the cross-system response workflow first: assess supplier, file, and incident readiness together, advance the next guided subsystem stage when you want the orchestration shell to move the shared session forward, apply shared recovery when one subsystem blocks the handoff, and prepare one approval-gated response packet."
                                : IsReleaseDossierRoute
                                    ? "Use the release dossier workflow first: assess recipe and evidence readiness together, advance the next guided subsystem stage when you want the orchestration shell to move the shared session forward, apply shared recovery when one subsystem blocks the release, and prepare one approval-gated release dossier."
                        : IsWorkflowHubRoute
                            ? "Start by choosing the right semantic workflow. Ask the assistant to compare the supplier, file, recipe, incident, response, and release-dossier showcases and route you to the best fit."
                            : "Ask for workflow analysis, blocker explanations, approval-gated next steps, and deterministic execution against the current route.";

    private string AssistantPlaceholder =>
        IsComponentsRoute
            ? "Try: compare this wrapper to MudBlazor, set form fields, validate the form, or open the parity route."
            : IsSupplierWorkflowRoute
                ? "Try: explain why these suppliers are at risk, apply the supplier recovery playbook, or prepare the remediation draft."
                : IsFileWorkflowRoute
                    ? "Try: explain why this bundle is blocked, prepare an audit-ready remote bundle, or apply the file audit recovery playbook."
                        : IsRecipeWorkflowRoute
                        ? "Try: assess release readiness, explain this blocker, or apply the recipe release recovery playbook."
                            : IsIncidentWorkflowRoute
                            ? "Try: summarize the current incident triage workflow, submit the escalation handoff, or apply the recovery playbook."
                            : IsResponseOrchestrationRoute
                                ? "Try: assess cross-system response readiness, advance the next guided subsystem stage, prepare the response packet, or apply the cross-system recovery playbook."
                                : IsReleaseDossierRoute
                                    ? "Try: assess release dossier readiness, advance the next guided subsystem stage, prepare the release dossier, or apply the release dossier recovery playbook."
                        : IsWorkflowHubRoute
                            ? "Try: which workflow should I open, compare the workflow showcases, or route me to the right production-style workflow."
                            : "Try: explain the current blockers, prepare the next draft, summarize this workflow, or show what needs approval.";

    private bool AssistantRequireHandoffApproval => false;

    private bool AssistantEnableGeneratedUi => true;

    private string? DefaultAssistantAgent =>
        IsSupplierWorkflowRoute
            ? "Supplier Compliance Agent"
            : IsFileWorkflowRoute
                    ? "File Workflow Agent"
                : IsRecipeWorkflowRoute
                    ? "Recipe Release Agent"
                    : IsIncidentWorkflowRoute
                        ? "Incident Escalation Agent"
                        : IsResponseOrchestrationRoute
                            ? "Response Orchestration Agent"
                            : IsReleaseDossierRoute
                                ? "Release Dossier Agent"
                    : IsWorkflowHubRoute
                        ? "Workflow Hub Agent"
                        : null;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private Task OnThemeChanged(string key)
    {
        _selectedThemeKey = key;
        _activeTheme = string.Equals(key, CoastlineThemeKey, StringComparison.OrdinalIgnoreCase)
            ? CoastlineTheme
            : AuroraTheme;
        return Task.CompletedTask;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = args;
        _ = sender;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    private sealed record ThemeOption(string Key, string Label);
}
