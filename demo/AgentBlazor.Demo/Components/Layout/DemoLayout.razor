@inherits LayoutComponentBase
@using AgentBlazor.Components
@using AgentBlazor.Components.Chat
@using AgentBlazor.Demo.Services
@using Microsoft.JSInterop
@using MudBlazor
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="demo-shell">
    <header class="demo-shell__header">
        <a href="/" class="demo-shell__brand">
            <img src="logo.png" class="demo-shell__brand-logo" alt="AgentBlazor" />
            <span class="demo-shell__brand-copy">
                <strong>AgentBlazor</strong>
                <small>Live workflow demo</small>
            </span>
        </a>

        <nav class="demo-shell__nav" aria-label="Primary">
            <a href="/docs">Docs</a>
        </nav>
    </header>

    <div class="demo-shell__frame @(ShowAssistantPane ? "demo-shell__frame--split" : null)">
        <main class="demo-shell__main">
            <article class="demo-shell__content">
                @Body
            </article>
        </main>

        @if (ShowAssistantPane)
        {
            <aside class="demo-shell__assistant-pane">
                <MudPaper Elevation="0" Class="demo-shell__assistant-card">
                    <div class="demo-shell__assistant-head">
                        <h2 class="demo-shell__assistant-title">@AssistantTitle</h2>
                        <p class="demo-shell__assistant-copy">@AssistantDescription</p>
                    </div>

                    @if (_assistantClientId is not null)
                    {
                        <AgentChatSurface Title="@AssistantTitle"
                                          Description="@AssistantDescription"
                                          DefaultAgentName="@DefaultAssistantAgent"
                                          SessionId="@AssistantSessionId"
                                          LockAgentToCurrentRoute="true"
                                          ShowAgentSelector="false"
                                          EnableGeneratedUi="true"
                                          Placeholder="@AssistantPlaceholder"
                                          Theme="_assistantTheme"
                                          CssClass="demo-shell__assistant-surface" />
                    }
                    else
                    {
                        <p class="demo-shell__assistant-copy">Loading assistant…</p>
                    }
                </MudPaper>
            </aside>
        }
    </div>
</div>

@if (ShowAssistantWidget)
{
    @if (_assistantClientId is not null)
    {
        <AgentChatWidget Title="@AssistantTitle"
                         Description="@AssistantDescription"
                         DefaultAgentName="@DefaultAssistantAgent"
                         SessionId="@AssistantSessionId"
                         LockAgentToCurrentRoute="@ShouldLockAssistantToRoute"
                         ShowAgentSelector="@ShowAssistantSelector"
                         EnableGeneratedUi="true"
                         Placeholder="@AssistantPlaceholder"
                         Theme="_assistantTheme"
                         Width="@AssistantWidgetWidth"
                         Height="@AssistantWidgetHeight"
                         Right="@AssistantWidgetRight"
                         Bottom="@AssistantWidgetBottom"
                         CssClass="demo-shell__assistant-widget" />
    }
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#ff6a3d",
            Secondary = "#6ea8fe",
            Tertiary = "#7be0bf",
            Info = "#6ea8fe",
            Success = "#40c89b",
            Warning = "#ffb84f",
            Error = "#ff5d7b",
            Background = "#06111a",
            BackgroundGray = "#0b1824",
            Surface = "#0e1d2c",
            AppbarBackground = "#09141f",
            AppbarText = "#eef6ff",
            DrawerBackground = "#09141f",
            DrawerText = "#d2e0f6",
            TextPrimary = "#eef6ff",
            TextSecondary = "#8ba5c4",
            TableLines = "#203246",
            Divider = "#203246",
            LinesDefault = "#203246",
            ActionDefault = "#8ba5c4",
            ActionDisabled = "#425a74",
            ActionDisabledBackground = "#112131"
        }
    };

    private static readonly ChatTheme _assistantTheme = new()
    {
        Variant = ChatThemeVariant.Dark,
        Style = ChatVisualStyle.Minimal,
        Spacing = ChatSpacing.Compact,
        BorderRadius = ChatBorderRadius.Medium,
        EnableGlassEffect = false,
        AccentColor = "#ff6a3d",
        FontFamily = "\"Public Sans\", \"Segoe UI\", sans-serif",
        FontSize = "0.92rem"
    };

    private string? _assistantClientId;
    private int _assistantClientIdLoadAttempts;
    private const int MaxAssistantClientIdLoadAttempts = 8;

    private string CurrentRoutePath => new Uri(NavigationManager.Uri).AbsolutePath;
    private DemoScenario? CurrentScenario => DemoScenarioCatalog.FindByPath(CurrentRoutePath);
    private string AssistantSessionId => $"demo:{_assistantClientId}:{CurrentRoutePath.TrimEnd('/').ToLowerInvariant()}";

    private bool IsComponentsRoute => CurrentRoutePath.StartsWith("/demo/components", StringComparison.OrdinalIgnoreCase);
    private bool IsWorkflowRoute => CurrentRoutePath.StartsWith("/demo/workflows", StringComparison.OrdinalIgnoreCase);
    private bool IsSupportInboxRoute => CurrentRoutePath.StartsWith("/demo/workflows/support-inbox", StringComparison.OrdinalIgnoreCase);

    private bool ShowAssistantPane => CurrentScenario is not null && IsWorkflowRoute && !IsComponentsRoute && !IsSupportInboxRoute;
    private bool ShowAssistantWidget => !ShowAssistantPane;
    private bool ShouldLockAssistantToRoute => CurrentScenario is not null && IsWorkflowRoute;
    private bool ShowAssistantSelector => !ShouldLockAssistantToRoute;

    private string AssistantWidgetWidth =>
        IsSupportInboxRoute
            ? "32rem"
            : "26rem";

    private string AssistantWidgetHeight =>
        IsSupportInboxRoute
            ? "80vh"
            : "68vh";

    private string AssistantWidgetRight => "0.85rem";
    private string AssistantWidgetBottom => "0.85rem";

    private string AssistantTitle => CurrentScenario?.AssistantTitle ?? "Workflow assistant";

    private string AssistantDescription => CurrentScenario?.AssistantDescription ?? "Ask for the next step.";

    private string AssistantPlaceholder => CurrentScenario?.AssistantPlaceholder ?? "What should happen next?";

    private string? DefaultAssistantAgent => CurrentScenario?.AgentName;

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_assistantClientId is not null ||
            _assistantClientIdLoadAttempts >= MaxAssistantClientIdLoadAttempts)
        {
            return;
        }

        try
        {
            _assistantClientIdLoadAttempts++;
            _assistantClientId = await JSRuntime.InvokeAsync<string>("AgentBlazorDemo.getOrCreateAssistantClientId");

            if (!string.IsNullOrWhiteSpace(_assistantClientId))
            {
                StateHasChanged();
            }
        }
        catch (JSException)
        {
            try
            {
                await Task.Delay(150);
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException)
            {
                // Ignore teardown during retry scheduling.
            }
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = sender;
        _ = args;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
