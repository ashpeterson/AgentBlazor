@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="docs-shell">
    <header class="docs-shell__header">
        <a href="/" class="docs-shell__brand">
            <img src="logo.png" class="docs-shell__brand-logo" alt="AgentBlazor" />
            <span class="docs-shell__brand-copy">
                <strong>AgentBlazor</strong>
                <small>Docs</small>
            </span>
        </a>

        <nav class="docs-shell__nav" aria-label="Docs">
            <a href="/docs" class="@(IsActive("/docs") ? "is-active" : null)" aria-current="@(IsActive("/docs") ? "page" : null)">Overview</a>
            <a href="/docs/getting-started" class="@(IsActive("/docs/getting-started") ? "is-active" : null)" aria-current="@(IsActive("/docs/getting-started") ? "page" : null)">Getting Started</a>
            <a href="/docs/cli" class="@(IsActive("/docs/cli") ? "is-active" : null)" aria-current="@(IsActive("/docs/cli") ? "page" : null)">CLI</a>
            <a href="/docs/hosting-models" class="@(IsActive("/docs/hosting-models") ? "is-active" : null)" aria-current="@(IsActive("/docs/hosting-models") ? "page" : null)">Hosting</a>
            <a href="/docs/workflows" class="@(IsActive("/docs/workflows") ? "is-active" : null)" aria-current="@(IsActive("/docs/workflows") ? "page" : null)">Workflows</a>
            <a href="/docs/components" class="@(IsActive("/docs/components") ? "is-active" : null)" aria-current="@(IsActive("/docs/components") ? "page" : null)">Components</a>
        </nav>

        <div class="docs-shell__actions">
            <a href="/demo/workflows/response-orchestration?reset=true" class="docs-shell__demo-link">Live Demo</a>
        </div>
    </header>

    <main class="docs-shell__body">
        <aside class="docs-shell__sidebar" aria-label="Documentation sections">
            <div class="docs-shell__sidebar-card">
                <p class="docs-shell__sidebar-label">Start Here</p>
                <nav class="docs-shell__sidebar-nav">
                    <a href="/docs" class="@(IsActive("/docs") ? "is-active" : null)">Docs Overview</a>
                    <a href="/docs/getting-started" class="@(IsActive("/docs/getting-started") ? "is-active" : null)">Getting Started</a>
                    <a href="/docs/cli" class="@(IsActive("/docs/cli") ? "is-active" : null)">CLI Guide</a>
                </nav>
            </div>

            <div class="docs-shell__sidebar-card">
                <p class="docs-shell__sidebar-label">Host Shapes</p>
                <nav class="docs-shell__sidebar-nav">
                    <a href="/docs/hosting-models" class="@(IsActive("/docs/hosting-models") ? "is-active" : null)">Hosting Models</a>
                </nav>
            </div>

            <div class="docs-shell__sidebar-card">
                <p class="docs-shell__sidebar-label">Authoring</p>
                <nav class="docs-shell__sidebar-nav">
                    <a href="/docs/workflows" class="@(IsActive("/docs/workflows") ? "is-active" : null)">Workflows</a>
                    <a href="/docs/components" class="@(IsActive("/docs/components") ? "is-active" : null)">Components</a>
                </nav>
            </div>

            <div class="docs-shell__sidebar-card">
                <p class="docs-shell__sidebar-label">Operate</p>
                <nav class="docs-shell__sidebar-nav">
                    <a href="/docs/demo-tour" class="@(IsActive("/docs/demo-tour") ? "is-active" : null)">Demo Tour</a>
                    <a href="/docs/troubleshooting" class="@(IsActive("/docs/troubleshooting") ? "is-active" : null)">Troubleshooting</a>
                </nav>
            </div>

            <div class="docs-shell__sidebar-card">
                <p class="docs-shell__sidebar-label">Plans</p>
                <nav class="docs-shell__sidebar-nav">
                    <a href="/docs/pricing" class="@(IsActive("/docs/pricing") ? "is-active" : null)">Pricing & Tiers</a>
                </nav>
            </div>

            <div class="docs-shell__sidebar-callout">
                <span>Validated Path</span>
                <strong>OpenAI on a standard Blazor host is the primary production path today.</strong>
                <small>Hosted WebAssembly server+client scaffold is supported. Advanced hosts stay review-first when automatic wiring would be risky.</small>
            </div>
        </aside>

        <section class="docs-shell__content">
            @Body
        </section>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private static readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#ff6a3d", Secondary = "#6ea8fe", Tertiary = "#7be0bf",
            Info = "#6ea8fe", Success = "#40c89b", Warning = "#ffb84f", Error = "#ff5d7b",
            Background = "#06111a", BackgroundGray = "#0b1824", Surface = "#0e1d2c",
            AppbarBackground = "#09141f", AppbarText = "#eef6ff",
            DrawerBackground = "#09141f", DrawerText = "#d2e0f6",
            TextPrimary = "#eef6ff", TextSecondary = "#8ba5c4",
            TableLines = "#203246", Divider = "#203246", LinesDefault = "#203246"
        }
    };

    private string CurrentPath => new Uri(NavigationManager.Uri).AbsolutePath.TrimEnd('/');

    private bool IsActive(string path)
    {
        var normalizedPath = path.TrimEnd('/');
        return string.Equals(CurrentPath, normalizedPath, StringComparison.OrdinalIgnoreCase);
    }
}
