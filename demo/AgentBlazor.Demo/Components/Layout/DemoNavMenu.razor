@using AgentBlazor.Components
@using MudBlazor

<AgentNavMenu AgentId="demo-nav" Dense="true">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="/demo/dojo" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AutoFixHigh">Capability Dojo</MudNavLink>
    <MudNavLink Href="/demo/workflows/supplier-compliance" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.RuleFolder">Supplier Compliance Workflow</MudNavLink>

    <MudNavGroup Title="Agentic Components" Icon="@Icons.Material.Filled.Widgets" @bind-Expanded="_componentsExpanded">
        <MudNavLink Href="/demo/components" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.ViewAgenda">Overview</MudNavLink>
        <MudNavLink Href="/demo/components/datagrid" Match="NavLinkMatch.Prefix">AgentDataGrid</MudNavLink>
        <MudNavLink Href="/demo/components/form" Match="NavLinkMatch.Prefix">AgentForm</MudNavLink>
        <MudNavLink Href="/demo/components/dialog" Match="NavLinkMatch.Prefix">AgentDialog</MudNavLink>
        <MudNavLink Href="/demo/components/nav-menu" Match="NavLinkMatch.Prefix">AgentNavMenu</MudNavLink>
        <MudNavLink Href="/demo/components/tabs" Match="NavLinkMatch.Prefix">AgentTabs</MudNavLink>
        <MudNavLink Href="/demo/components/select" Match="NavLinkMatch.Prefix">AgentSelect</MudNavLink>
        <MudNavLink Href="/demo/components/autocomplete" Match="NavLinkMatch.Prefix">AgentAutocomplete</MudNavLink>
        <MudNavLink Href="/demo/components/date-picker" Match="NavLinkMatch.Prefix">AgentDatePicker</MudNavLink>
        <MudNavLink Href="/demo/components/date-range-picker" Match="NavLinkMatch.Prefix">AgentDateRangePicker</MudNavLink>
        <MudNavLink Href="/demo/components/tree-view" Match="NavLinkMatch.Prefix">AgentTreeView</MudNavLink>
        <MudNavLink Href="/demo/components/stepper" Match="NavLinkMatch.Prefix">AgentStepper</MudNavLink>
        <MudNavLink Href="/demo/components/command-bar" Match="NavLinkMatch.Prefix">AgentCommandBar</MudNavLink>
        <MudNavLink Href="/demo/components/file-upload" Match="NavLinkMatch.Prefix">AgentFileUpload</MudNavLink>
        <MudNavLink Href="/demo/components/parity/form" Match="NavLinkMatch.Prefix">MudForm vs AgentForm</MudNavLink>
        <MudNavLink Href="/demo/components/parity/datagrid" Match="NavLinkMatch.Prefix">MudDataGrid vs AgentDataGrid</MudNavLink>
        <MudNavLink Href="/demo/components/parity/dialog" Match="NavLinkMatch.Prefix">MudDialog vs AgentDialog</MudNavLink>
        <MudNavLink Href="/demo/components/parity/choice-inputs" Match="NavLinkMatch.Prefix">MudSelect and MudAutocomplete parity</MudNavLink>
        <MudNavLink Href="/demo/components/parity/file-upload" Match="NavLinkMatch.Prefix">MudFileUpload vs AgentFileUpload</MudNavLink>
        <MudNavLink Href="/demo/components/parity/date-pickers" Match="NavLinkMatch.Prefix">MudDatePicker and MudDateRangePicker parity</MudNavLink>
        <MudNavLink Href="/demo/components/parity/workflow-navigation" Match="NavLinkMatch.Prefix">MudTabs and MudStepper parity</MudNavLink>
        <MudNavLink Href="/demo/components/parity/hierarchy-navigation" Match="NavLinkMatch.Prefix">MudNavMenu and MudTreeView parity</MudNavLink>
        <MudNavLink Href="/demo/components/parity/composed-workflow" Match="NavLinkMatch.Prefix">Composed workflow parity</MudNavLink>
        <MudNavLink Href="/demo/components/attribute-based" Match="NavLinkMatch.Prefix">Custom Attribute-Based Component</MudNavLink>
    </MudNavGroup>
</AgentNavMenu>

@code {
    private bool _componentsExpanded = true;
}
