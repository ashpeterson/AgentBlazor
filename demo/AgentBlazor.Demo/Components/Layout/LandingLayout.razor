@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="lp">
    <header class="lp__header">
        <a href="/" class="lp__brand">
            <img src="logo.png" class="lp__brand-logo" alt="AgentBlazor" />
            <span class="lp__brand-copy">
                <strong>AgentBlazor</strong>
                <small>Agent workflows for Blazor</small>
            </span>
        </a>

        <nav class="lp__nav" aria-label="Primary">
            <a href="/docs">Docs</a>
            <a href="/demo/workflows/response-orchestration?reset=true">Live Demo</a>
        </nav>
    </header>

    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#ff6a3d",
            Secondary = "#6ea8fe",
            Tertiary = "#7be0bf",
            Info = "#6ea8fe",
            Success = "#40c89b",
            Warning = "#ffb84f",
            Error = "#ff5d7b",
            Background = "#06111a",
            BackgroundGray = "#0b1824",
            Surface = "#0e1d2c",
            AppbarBackground = "#09141f",
            AppbarText = "#eef6ff",
            DrawerBackground = "#09141f",
            DrawerText = "#d2e0f6",
            TextPrimary = "#eef6ff",
            TextSecondary = "#8ba5c4",
            TableLines = "#203246",
            Divider = "#203246",
            LinesDefault = "#203246"
        }
    };
}
