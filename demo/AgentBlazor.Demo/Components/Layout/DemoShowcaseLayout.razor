@inherits LayoutComponentBase
@using AgentBlazor.Components
@using AgentBlazor.Components.Chat
@using MudBlazor

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="ab-showcase">

    <header class="ab-showcase__topbar">
        <a href="" class="ab-showcase__brand">
            <img src="logo.png" alt="AgentBlazor" class="ab-showcase__logo" />
            <span class="ab-showcase__brand-name">AgentBlazor</span>
        </a>

        <nav class="ab-showcase__nav" aria-label="Demo sections">
            <a href="/demo/workflow" class="ab-showcase__nav-link">Workflow</a>
            <a href="/demo/suppliers" class="ab-showcase__nav-link">Data Grid</a>
            <a href="/demo/generative-ui" class="ab-showcase__nav-link">Generative UI</a>
            <a href="/demo/onboarding" class="ab-showcase__nav-link">Form</a>
            <a href="/demo/docs" class="ab-showcase__nav-link ab-showcase__nav-link--docs">Getting Started</a>
        </nav>
    </header>

    <div class="ab-showcase__body">

        <section class="ab-showcase__app" aria-label="Live application">
            @Body
        </section>

        <aside class="ab-showcase__chat-panel" aria-label="Assistant">

            <div class="ab-showcase__chat-wrap">
                <AgentChatSurface @ref="_chat"
                                  Title="How can I help you today?"
                                  EnableGeneratedUi="true"
                                  Placeholder="Ask me to filter data, fill forms, switch tabs, or generate charts..."
                                  Theme="ChatTheme.Dark()"
                                  CssClass="ab-showcase__surface" />
            </div>

            <div class="ab-showcase__caps">
                <div class="ab-showcase__caps-header">
                    <p class="ab-showcase__caps-label">Capabilities — try any of these</p>
                    <button class="ab-showcase__slash-hint" @onclick='() => OnCapClick("/")' title="Open slash command menu">
                        <span class="ab-showcase__slash-hint-icon">/</span>
                        <span>discover commands</span>
                    </button>
                </div>
                <div class="ab-showcase__caps-grid">
                    <button class="ab-showcase__cap" @onclick='() => OnCapClick("filter to EMEA region")'>
                        <span>filter to EMEA region</span>
                        <em>AgentDataGrid</em>
                    </button>
                    <button class="ab-showcase__cap" @onclick='() => OnCapClick("sort by risk score descending")'>
                        <span>sort by risk score descending</span>
                        <em>AgentDataGrid</em>
                    </button>
                    <button class="ab-showcase__cap" @onclick='() => OnCapClick("switch to onboarding tab")'>
                        <span>switch to onboarding tab</span>
                        <em>AgentTabs</em>
                    </button>
                    <button class="ab-showcase__cap" @onclick='() => OnCapClick("switch to mitigation tasks")'>
                        <span>switch to mitigation tasks</span>
                        <em>AgentTabs</em>
                    </button>
                    <button class="ab-showcase__cap" @onclick='() => OnCapClick("open mitigation dialog")'>
                        <span>open mitigation dialog</span>
                        <em>AgentDialog</em>
                    </button>
                    <button class="ab-showcase__cap" @onclick='() => OnCapClick("fill task for highest-risk supplier")'>
                        <span>fill task for highest-risk supplier</span>
                        <em>AgentForm</em>
                    </button>
                    <button class="ab-showcase__cap" @onclick='() => OnCapClick("show risk tier distribution as a pie chart")'>
                        <span>show risk tier distribution as a pie chart</span>
                        <em>Generative UI</em>
                    </button>
                    <button class="ab-showcase__cap" @onclick='() => OnCapClick("chart onboarding intake for the last 9 months")'>
                        <span>chart onboarding intake for the last 9 months</span>
                        <em>Generative UI</em>
                    </button>
                    <button class="ab-showcase__cap" @onclick='() => OnCapClick("filter onboarding queue to high-risk tier")'>
                        <span>filter onboarding queue to high-risk tier</span>
                        <em>AgentDataGrid</em>
                    </button>
                    <button class="ab-showcase__cap" @onclick='() => OnCapClick("select the highest-risk supplier row")'>
                        <span>select the highest-risk supplier row</span>
                        <em>AgentDataGrid</em>
                    </button>
                    <button class="ab-showcase__cap" @onclick='() => OnCapClick("filter to critical risk suppliers then open a mitigation dialog")'>
                        <span>filter to critical risk then open mitigation</span>
                        <em>Multi-step</em>
                    </button>
                    <button class="ab-showcase__cap" @onclick='() => OnCapClick("show me which suppliers have the highest onboarding backlog")'>
                        <span>highest onboarding backlog</span>
                        <em>Generative UI</em>
                    </button>
                </div>
            </div>

        </aside>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private AgentChatSurface? _chat;

    private Task OnCapClick(string text) => _chat?.SetInputAsync(text) ?? Task.CompletedTask;

    private static readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#e03a58",
            Secondary = "#4a9edd",
            Tertiary = "#7a5af8",
            Info = "#3a8fd4",
            Success = "#2ecc87",
            Warning = "#f0a030",
            Error = "#ff4d6a",
            Background = "#03040a",
            BackgroundGray = "#0a0d18",
            Surface = "#0d1120",
            AppbarBackground = "#080b16",
            AppbarText = "#e8f0ff",
            DrawerBackground = "#080b16",
            DrawerText = "#c8d8f0",
            TextPrimary = "#e8f0ff",
            TextSecondary = "#7a92bb",
            TableLines = "#1a2040",
            Divider = "#1a2040",
            LinesDefault = "#1a2040",
            ActionDefault = "#7a92bb",
            ActionDisabled = "#3a4a6a",
            ActionDisabledBackground = "#0d1120"
        }
    };
}
