@inherits LayoutComponentBase
@using AgentBlazor.Components.Chat
@using MudBlazor

<MudThemeProvider Theme="_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="demo-dashboard-shell">
    <header class="demo-dashboard-shell__topbar">
        <MudPaper Class="demo-dashboard-shell__topbar-card" Elevation="0">
            <a href="/" class="demo-dashboard-shell__home">
                <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" />
                <span>Back to Landing</span>
            </a>

            <div class="demo-dashboard-shell__brand">
                <img src="logo.png" alt="AgentBlazor" />
                <div>
                    <MudText Typo="Typo.caption" Class="demo-dashboard-shell__eyebrow">Live Demo</MudText>
                    <MudText Typo="Typo.subtitle2">Executive Supplier Risk Dashboard</MudText>
                </div>
            </div>

            <div class="demo-dashboard-shell__links">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Href="/demo/docs">Integration Guide</MudButton>
                <MudButton Variant="Variant.Text" Size="Size.Small" Href="/demo/status">Runtime Status</MudButton>
            </div>
        </MudPaper>
    </header>

    <div class="demo-dashboard-shell__body">
        <main class="demo-dashboard-shell__main">
            @Body
        </main>

        <aside class="demo-dashboard-shell__chat">
            <MudPaper Class="demo-dashboard-shell__chat-card" Elevation="0">
                <div class="demo-dashboard-shell__chat-head">
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">AI Assistant</MudChip>
                    <MudText Typo="Typo.caption" Class="demo-dashboard-shell__chat-caption">
                        Controls the full dashboard in natural language
                    </MudText>
                </div>

                <AgentChatSurface Title="Assistant"
                                  Description="Everything on the left is mounted and agent-controllable."
                                  EnableGeneratedUi="true"
                                  Placeholder="Try: set country select to Germany, sort supplier risk descending, open the dialog, validate the form, or generate a chart."
                                  Theme="ChatTheme.Dark()"
                                  CssClass="demo-dashboard-shell__chat-surface" />
            </MudPaper>
        </aside>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly MudTheme _theme = new()
    {
        PaletteDark = new PaletteDark
        {
            Primary = "#e03a58",
            Secondary = "#4a9edd",
            Tertiary = "#7a5af8",
            Info = "#3a8fd4",
            Success = "#2ecc87",
            Warning = "#f0a030",
            Error = "#ff4d6a",
            Background = "#03040a",
            BackgroundGray = "#0a0d18",
            Surface = "#0d1120",
            AppbarBackground = "#080b16",
            AppbarText = "#e8f0ff",
            DrawerBackground = "#080b16",
            DrawerText = "#c8d8f0",
            TextPrimary = "#e8f0ff",
            TextSecondary = "#7a92bb",
            TableLines = "#1a2040",
            Divider = "#1a2040",
            LinesDefault = "#1a2040",
            ActionDefault = "#7a92bb",
            ActionDisabled = "#3a4a6a",
            ActionDisabledBackground = "#0d1120"
        }
    };
}
