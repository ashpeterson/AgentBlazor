@page "/agent-routing-demo"
@using AgentBlazor.Components
@using MudBlazor

<PageTitle>Built-In Agent Playground</PageTitle>

<MudPaper Class="pa-4 agent-routing-demo__panel" Elevation="1">
    <MudText Typo="Typo.h4">Built-In Agent Playground</MudText>
    <MudText Typo="Typo.body2" Class="agent-routing-demo__subtitle">
        This page demonstrates the built-in AgentBlazor UI Agent without direct runtime wiring in page code.
    </MudText>
</MudPaper>

<MudPaper Class="pa-4 mt-4 agent-routing-demo__panel" Elevation="1">
    <MudText Typo="Typo.h6" Class="mb-2">Try Prompts</MudText>
    <MudList T="string" Dense="true">
        <MudListItem T="string">Show me all suppliers that are high risk</MudListItem>
        <MudListItem T="string">Open supplier onboarding</MudListItem>
        <MudListItem T="string">Open workspace and switch to the risk tab</MudListItem>
    </MudList>
</MudPaper>

<AgentChatWidget />
