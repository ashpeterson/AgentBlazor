@using AgentBlazor.Components
@using AgentBlazor.Core.Runtime.Agents
@using AgentBlazor.Core.Runtime.Interfaces
@using AgentBlazor.Runtime
@using MudBlazor
@inject IAgentRuntime AgentRuntime

<section class="home-prompt">
    <div class="home-prompt__inner">
        <p class="home-prompt__label">Demo Prompt Bar</p>

        <div class="home-prompt__chips">
            @foreach (var suggestion in _suggestedPrompts)
            {
                <button type="button" @onclick="() => SubmitSuggestionAsync(suggestion)">@suggestion</button>
            }
        </div>

        <form class="home-prompt__form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <input type="text"
                   @bind="_prompt"
                   placeholder="Try: show me all suppliers that are high risk"
                   aria-label="Prompt input" />
            <button type="submit" disabled="@_isBusy">@(_isBusy ? "Running..." : "Run")</button>
        </form>

        @if (!string.IsNullOrWhiteSpace(_status))
        {
            <p class="home-prompt__status">@_status</p>
        }
    </div>

    <div style="display:none" aria-hidden="true">
        <AgentNavMenu AgentId="landing-nav" Dense="true">
            <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
            <MudNavLink Href="suppliers" Match="NavLinkMatch.Prefix">Suppliers</MudNavLink>
            <MudNavLink Href="workspace" Match="NavLinkMatch.Prefix">Workspace</MudNavLink>
            <MudNavLink Href="agentblazor-status" Match="NavLinkMatch.Prefix">Status</MudNavLink>
        </AgentNavMenu>
    </div>
</section>

@code {
    private readonly string[] _suggestedPrompts =
    [
        "Show me all suppliers that are high risk",
        "Show me low risk suppliers",
        "Open supplier onboarding",
        "Open workspace"
    ];

    private string _prompt = string.Empty;
    private string? _status;
    private bool _isBusy;
    private readonly string _sessionId = $"home-prompt-{Guid.NewGuid():N}";

    private Task SubmitSuggestionAsync(string prompt)
    {
        _prompt = prompt;
        return SubmitAsync();
    }

    private async Task SubmitAsync()
    {
        if (_isBusy)
        {
            return;
        }

        var prompt = _prompt.Trim();
        if (prompt.Length == 0)
        {
            _status = "Enter a prompt or pick one of the suggested prompts.";
            return;
        }

        _status = "Running agent...";
        _isBusy = true;
        try
        {
            var response = await AgentRuntime.RunTurnAsync(new AgentTurnRequest(
                UserMessage: prompt,
                AgentName: null,
                Context: new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
                {
                    ["agentblazor.session_id"] = _sessionId
                }));

            if (response.ExecutionResults.Count > 0)
            {
                var failed = response.ExecutionResults.Where(static result => !result.Succeeded).ToArray();
                if (failed.Length > 0)
                {
                    _status = failed[0].Message;
                }
                else
                {
                    _status = $"Executed {response.ExecutionResults.Count} action(s).";
                }
            }
            else
            {
                _status = response.ResponseText;
            }
        }
        catch (Exception ex)
        {
            _status = $"Agent run failed: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }
}
