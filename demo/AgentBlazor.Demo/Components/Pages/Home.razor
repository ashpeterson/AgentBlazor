@page "/"
@layout LandingLayout
@using AgentBlazor.Demo.Components.Layout
@using AgentBlazor.Demo.Components.Shared
@using MudBlazor

<PageTitle>AgentBlazor — Agent-first Blazor UI</PageTitle>

<div class="landing-page">
    <section class="landing-page__stage">
        <LandingHero />

        <article class="landing-page__hero-player">
            <div class="landing-page__hero-frame">
                <video controls autoplay muted loop preload="metadata" playsinline poster="/videos/agentblazor-capability-reel-poster.jpg" src="/videos/agentblazor-capability-reel.mp4"></video>
            </div>
            <div class="landing-page__hero-caption">
                <strong>CLI, code, working UI</strong>
                <span>Run the install path, inspect the generated shape, then watch the app respond.</span>
            </div>
        </article>
    </section>
</div>
