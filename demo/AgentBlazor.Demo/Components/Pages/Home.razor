@page "/"
@layout LandingLayout
@using AgentBlazor.Demo.Components.Layout
@using AgentBlazor.Demo.Components.Shared
@using MudBlazor

<PageTitle>AgentBlazor — Agent-first Blazor UI</PageTitle>

<div class="landing-page">
    <LandingHero />

    <section class="landing-page__section">
        <div class="landing-page__section-head">
            <div>
                <p class="landing-page__eyebrow">Quick Examples</p>
                <h2>3 short videos. No tour required.</h2>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/demo">
                Open video hub
            </MudButton>
        </div>

        <div class="landing-page__video-grid">
            <article class="landing-page__video-card">
                <div class="landing-page__video-frame">
                    <video controls preload="metadata" playsinline src="/videos/cli-install.mp4"></video>
                </div>
                <strong>1. Install with CLI</strong>
                <p>Fresh app to installed runtime in one pass.</p>
            </article>
            <article class="landing-page__video-card">
                <div class="landing-page__video-frame">
                    <video controls preload="metadata" playsinline src="/videos/workflow-live.mp4"></video>
                </div>
                <strong>2. Run one live workflow</strong>
                <p>Real prompt and approval on the runtime probe route.</p>
            </article>
            <article class="landing-page__video-card">
                <div class="landing-page__video-frame">
                    <video controls preload="metadata" playsinline src="/videos/dashboard-live.mp4"></video>
                </div>
                <strong>3. Open the Pro dashboard</strong>
                <p>See audit and usage after real activity.</p>
            </article>
        </div>
    </section>

    <section class="landing-page__section">
        <div class="landing-page__section-head">
            <div>
                <p class="landing-page__eyebrow">Next Step</p>
                <h2>Then choose docs or the live app.</h2>
            </div>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/docs">
                Open docs
            </MudButton>
        </div>

        <div class="landing-page__grid landing-page__grid--demo">
            <a href="/docs/getting-started" class="landing-page__card">
                <strong>Getting Started</strong>
                <p>Install source, first workflow, first chat surface.</p>
            </a>
            <a href="/docs/cli" class="landing-page__card">
                <strong>CLI Guide</strong>
                <p>Exact command order and validation flow.</p>
            </a>
            <a href="/demo/workflows/response-orchestration?reset=true" class="landing-page__card landing-page__card--featured">
                <strong>Live workflow</strong>
                <p>Open the route after you know what to look for.</p>
            </a>
            <a href="/demo/components" class="landing-page__card">
                <strong>Reference surfaces</strong>
                <p>Components and paid dashboard stay secondary.</p>
            </a>
        </div>
    </section>
</div>
