@page "/"
@layout LandingLayout
@using AgentBlazor.Demo.Components.Layout
@using AgentBlazor.Demo.Components.Shared
@using MudBlazor

<PageTitle>AgentBlazor — Agent-first Blazor UI</PageTitle>

<div class="landing-page">
    <section class="landing-page__stage">
        <LandingHero />

        <article class="landing-page__hero-player">
            <div class="landing-page__hero-frame">
                <video autoplay muted loop preload="auto" playsinline poster="/videos/agentblazor-hero-teaser-poster.jpg" src="/videos/agentblazor-hero-teaser.mp4"></video>
            </div>
            <div class="landing-page__hero-caption">
                <strong>Real app result first</strong>
                <span>Prompt, approval, visible UI change.</span>
            </div>
        </article>
    </section>

    <section class="landing-page__support-strip">
        <article class="landing-page__support-card">
            <div class="landing-page__support-frame">
                <video controls preload="metadata" playsinline poster="/videos/agentblazor-capability-reel-poster.jpg" src="/videos/agentblazor-capability-reel.mp4"></video>
            </div>
            <strong>Full reel</strong>
        </article>
        <article class="landing-page__support-card">
            <div class="landing-page__support-frame">
                <video controls preload="metadata" playsinline poster="/videos/dashboard-live-poster.jpg" src="/videos/dashboard-live.mp4"></video>
            </div>
            <strong>Pro dashboard</strong>
        </article>
    </section>
</div>
