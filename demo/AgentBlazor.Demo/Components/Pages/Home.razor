@page "/"

<PageTitle>Home</PageTitle>

<MudPaper Class="demo-surface demo-hero pa-6" Elevation="0">
    <MudText Typo="Typo.h3" GutterBottom="true">AgentBlazor Demo</MudText>
    <MudText Typo="Typo.body1" Class="demo-subtitle">
        Sample line-of-business screens with AgentBlazor wrappers and a built-in UI agent.
    </MudText>

    <MudStack Row="true" Spacing="2" Class="mt-5">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/suppliers">
            Open Suppliers
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Href="/supplier-onboarding">
            Open Onboarding
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Tertiary" Href="/workspace">
            Open Workspace
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Info" Href="/debug">
            Open Debug
        </MudButton>
    </MudStack>
</MudPaper>

<MudPaper Class="demo-surface pa-4 mt-4" Elevation="0">
    <AgentBlazorShell />
</MudPaper>
