@page "/"
@layout LandingLayout
@using AgentBlazor.Demo.Components.Layout
@using AgentBlazor.Demo.Components.Shared
@using MudBlazor

<PageTitle>AgentBlazor — Agent-first Blazor UI</PageTitle>

<div class="landing-page">
    <section class="landing-page__stage">
        <LandingHero />

        <article class="landing-page__hero-player">
            <div class="landing-page__hero-frame">
                <video autoplay muted loop preload="auto" playsinline poster="/videos/agentblazor-capability-reel-poster.jpg" src="/videos/agentblazor-capability-reel.mp4"></video>
            </div>
            <div class="landing-page__hero-caption">
                <strong>CLI, code, real app result</strong>
                <span>Fresh app. Small code shape. Official Microsoft sample. Live prompt result.</span>
            </div>
        </article>
    </section>

    <section class="landing-page__quick-links" aria-label="Primary links">
        <a href="/docs/cli" class="landing-page__quick-card">
            <strong>CLI guide</strong>
            <span>Exact commands</span>
        </a>
        <a href="/docs/getting-started" class="landing-page__quick-card">
            <strong>Getting started</strong>
            <span>First install path</span>
        </a>
        <a href="/demo/workflows/response-orchestration?reset=true" class="landing-page__quick-card landing-page__quick-card--featured">
            <strong>Live workflow</strong>
            <span>Open the full demo</span>
        </a>
        <a href="/demo/dashboard" class="landing-page__quick-card">
            <strong>Pro dashboard</strong>
            <span>Audit and usage</span>
        </a>
    </section>

    <section class="landing-page__support-strip">
        <article class="landing-page__support-card">
            <div class="landing-page__support-frame">
                <video controls preload="metadata" playsinline poster="/videos/ms-movies-agentblazor-poster.jpg" src="/videos/ms-movies-agentblazor.mp4"></video>
            </div>
            <strong>Microsoft sample clip</strong>
        </article>
        <article class="landing-page__support-card">
            <div class="landing-page__support-frame">
                <video controls preload="metadata" playsinline poster="/videos/dashboard-live-poster.jpg" src="/videos/dashboard-live.mp4"></video>
            </div>
            <strong>Pro dashboard clip</strong>
        </article>
    </section>
</div>
