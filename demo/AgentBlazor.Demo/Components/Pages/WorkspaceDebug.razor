@page "/workspace-debug"
@using AgentBlazor.Components
@using MudBlazor
@inject NavigationManager Navigation

<PageTitle>Workspace Debug</PageTitle>

<MudPaper Class="pa-4 agent-nav-tabs-demo__panel" Elevation="1">
    <MudText Typo="Typo.h4">AgentNavMenu + AgentTabs Debug</MudText>
    <MudText Typo="Typo.body2" Class="agent-nav-tabs-demo__subtitle">
        Ask for navigation and tab actions. This page uses wrapper components only.
    </MudText>

    <MudStack Row="true" Spacing="1" Class="my-3">
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
            Current URI: @Navigation.Uri
        </MudChip>
        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">
            Ask the agent to switch tabs
        </MudChip>
    </MudStack>

    <AgentNavMenu AgentId="workspace-nav-debug" Dense="true">
        <MudNavLink Href="/suppliers" Match="NavLinkMatch.Prefix">Suppliers</MudNavLink>
        <MudNavLink Href="/supplier-onboarding" Match="NavLinkMatch.Prefix">Onboarding</MudNavLink>
        <MudNavLink Href="/workspace" Match="NavLinkMatch.Prefix">Workspace</MudNavLink>
        <MudNavLink Href="/agentblazor-status" Match="NavLinkMatch.Prefix">Status</MudNavLink>
    </AgentNavMenu>

    <MudDivider Class="my-3" />

    <AgentTabs AgentId="workspace-tabs-debug">
        <MudTabPanel Text="Overview">
            <MudText Typo="Typo.body2">Overview tab content.</MudText>
        </MudTabPanel>
        <MudTabPanel Text="Risk">
            <MudText Typo="Typo.body2">Risk tab content.</MudText>
        </MudTabPanel>
        <MudTabPanel Text="Audit">
            <MudText Typo="Typo.body2">Audit tab content.</MudText>
        </MudTabPanel>
    </AgentTabs>
</MudPaper>

<MudPaper Class="pa-4 mt-4 agent-nav-tabs-demo__panel" Elevation="1">
    <AgentChatWidget
        Title="Navigation + Tabs Agent Chat"
        Description="Try: go to /suppliers, then switch to tab 1." />
</MudPaper>
