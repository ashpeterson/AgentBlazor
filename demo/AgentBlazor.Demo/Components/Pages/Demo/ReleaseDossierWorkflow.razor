@page "/demo/workflows/release-dossier"
@layout DemoLayout
@using AgentBlazor.Components
@using AgentBlazor.Core.Runtime.Interfaces
@using AgentBlazor.Demo.Services
@implements IDisposable
@inject ReleaseDossierWorkflowService Workflow
@inject IAgentComponentRegistry ComponentRegistry

<PageTitle>Release Dossier Workflow</PageTitle>

<div class="workflow-board">
    <MudPaper Elevation="0" Class="workflow-board__hero">
        <div class="workflow-board__hero-top">
            <div>
                <p class="workflow-board__eyebrow">Second live flow</p>
                <MudText Typo="Typo.h4">Release dossier</MudText>
            </div>

            <div class="workflow-board__stat-strip">
                <span><strong>@GetWorkflowPhase()</strong><small>phase</small></span>
                <span><strong>@Workflow.Snapshot.RecipeTitle</strong><small>recipe</small></span>
                <span><strong>@Workflow.Snapshot.VerifiedFileCount</strong><small>files</small></span>
                <span><strong>1</strong><small>approval</small></span>
            </div>
        </div>

        <div class="workflow-board__prompt-row">
            <span>Assess readiness</span>
            <span>Run next step</span>
            <span>Prepare dossier</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(ReturnedFrom))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3 mb-0">
                @Workflow.GetGuidedJourneySummary(ReturnedFrom, ReturnState)
            </MudAlert>
        }

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunPrimaryActionAsync">
                @GetPrimaryActionLabel()
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Info" OnClick="ResetAsync">
                Reset
            </MudButton>
        </MudStack>

        <MudGrid Spacing="2" Class="mt-4">
            @foreach (var step in Workflow.GetJourneySteps(ReturnedFrom))
            {
                <MudItem xs="12" sm="6" lg="4">
                    <MudPaper Class="workflow-board__journey-card" Outlined="true">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle2">@step.Title</MudText>
                            <MudChip T="string" Color="@GetStepColor(step.Status)" Variant="@(step.Status == ReleaseDossierJourneyStepStatus.Complete ? Variant.Filled : Variant.Outlined)" Size="Size.Small">
                                @GetStepLabel(step.Status)
                            </MudChip>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                            @step.Phase
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-2">
                            @step.Summary
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(step.Route))
                        {
                            <MudButton Variant="Variant.Text" Color="@GetStepColor(step.Status)" Href="@step.Route" Class="mt-2 px-0">
                                Open
                            </MudButton>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <section class="demo-doc-page__section">
        <MudPaper Class="workflow-board__preview-card" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">Dossier preview</MudText>
                <MudChip T="string" Color="@GetOutcomeChipColor()" Variant="Variant.Outlined" Size="Size.Small">
                    @GetWorkflowPhase()
                </MudChip>
            </MudStack>

            @if (Workflow.CurrentDossier is { } dossier)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-3">@dossier.Title</MudText>
                <MudText Typo="Typo.caption" Class="d-block mb-2">
                    Recipe: @dossier.RecipeTitle • Files: @string.Join(", ", dossier.FileNames)
                </MudText>
                <MudList T="string" Dense="true">
                    @foreach (var dossierSection in dossier.Sections)
                    {
                        <MudListItem T="string">@dossierSection</MudListItem>
                    }
                </MudList>
            }
            else if (Workflow.LatestBlockers.Count > 0)
            {
                <MudList T="string" Dense="true" Class="mt-3">
                    @foreach (var blocker in Workflow.LatestBlockers)
                    {
                        <MudListItem T="string">@blocker</MudListItem>
                    }
                </MudList>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mt-3">@GetNextStepSummary()</MudText>
            }
        </MudPaper>
    </section>

    <AgentDialog AgentId="release-dossier-dialog"
                 Visible="@Workflow.IsDossierDialogOpen"
                 VisibleChanged="OnDossierVisibilityChanged">
        <TitleContent>
            <MudText Typo="Typo.h6">Release dossier</MudText>
        </TitleContent>
        <DialogContent>
            @if (Workflow.CurrentDossier is { } dossier)
            {
                <MudText Typo="Typo.body2" Class="mb-2">
                    This dossier combines recipe readiness and verified evidence into one approval surface.
                </MudText>
                <MudList T="string" Dense="true" Class="mb-3">
                    @foreach (var dossierSection in dossier.Sections)
                    {
                        <MudListItem T="string">@dossierSection</MudListItem>
                    }
                </MudList>
                <MudText Typo="Typo.subtitle2">Handoff checklist</MudText>
                <MudList T="string" Dense="true">
                    @foreach (var item in dossier.HandoffChecklist)
                    {
                        <MudListItem T="string">@item</MudListItem>
                    }
                </MudList>
            }
            else
            {
                <MudText Typo="Typo.body2">No release dossier is active.</MudText>
            }
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseDossierAsync">
                Close dossier
            </MudButton>
        </DialogActions>
    </AgentDialog>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnedFrom")] public string? ReturnedFrom { get; set; }
    [SupplyParameterFromQuery(Name = "returnState")] public string? ReturnState { get; set; }
    [SupplyParameterFromQuery(Name = "reset")] public bool? ResetDemo { get; set; }

    private string? _lastProcessedReturnKey;
    private string? _lastResetKey;

    protected override async Task OnInitializedAsync()
    {
        Workflow.Changed += HandleWorkflowChanged;
        await Workflow.LoadAsync(ComponentRegistry.SessionId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ResetDemo is true)
        {
            var resetKey = $"release|{ComponentRegistry.SessionId}";
            if (!string.Equals(_lastResetKey, resetKey, StringComparison.Ordinal))
            {
                _lastResetKey = resetKey;
                Workflow.Reset();
                await Workflow.LoadAsync(ComponentRegistry.SessionId);
            }
        }
        else
        {
            _lastResetKey = null;
        }

        if (string.IsNullOrWhiteSpace(ReturnedFrom))
        {
            _lastProcessedReturnKey = null;
            return;
        }

        var returnKey = $"{ReturnedFrom}|{ReturnState}|{ComponentRegistry.SessionId}";
        if (string.Equals(_lastProcessedReturnKey, returnKey, StringComparison.Ordinal))
        {
            return;
        }

        _lastProcessedReturnKey = returnKey;
        await Workflow.ProcessGuidedReturnAsync(ComponentRegistry.SessionId, ReturnedFrom, ReturnState);
    }

    private Task AssessAsync()
        => Workflow.AssessReleaseDossierReadinessAsync(ComponentRegistry.SessionId);

    private Task RunPrimaryActionAsync()
    {
        if (Workflow.CurrentDossier is not null)
        {
            Workflow.SetDossierDialogVisible(true);
            return Task.CompletedTask;
        }

        if (Workflow.LatestBlockers.Count > 0)
        {
            return ApplyRecoveryAsync();
        }

        if (GetNextGuidedRoute() is not null)
        {
            return AdvanceNextStageAsync();
        }

        if (HasAssessmentState())
        {
            return PrepareDossierAsync();
        }

        return AssessAsync();
    }

    private Task AdvanceNextStageAsync()
        => Workflow.AdvanceNextStageAsync(ComponentRegistry.SessionId);

    private Task PrepareDossierAsync()
        => Workflow.PrepareReleaseDossierAsync(ComponentRegistry.SessionId);

    private Task ApplyRecoveryAsync()
        => Workflow.ApplyRecoveryPlaybookAsync(ComponentRegistry.SessionId);

    private Task ResetAsync()
    {
        Workflow.Reset();
        return Task.CompletedTask;
    }

    private Task CloseDossierAsync()
    {
        Workflow.SetDossierDialogVisible(false);
        return Task.CompletedTask;
    }

    private Task OnDossierVisibilityChanged(bool visible)
    {
        Workflow.SetDossierDialogVisible(visible);
        return Task.CompletedTask;
    }

    private string GetPrimaryActionLabel()
    {
        if (Workflow.CurrentDossier is not null)
        {
            return "Open dossier";
        }

        if (Workflow.LatestBlockers.Count > 0)
        {
            return "Run recovery";
        }

        if (GetNextGuidedRoute() is not null)
        {
            return "Run next step";
        }

        return HasAssessmentState() ? "Prepare dossier" : "Assess";
    }

    private bool HasAssessmentState() =>
        !string.Equals(Workflow.Snapshot.RecipePhase, "Idle", StringComparison.OrdinalIgnoreCase) ||
        !string.Equals(Workflow.Snapshot.FilePhase, "Idle", StringComparison.OrdinalIgnoreCase) ||
        Workflow.Snapshot.VerifiedFileCount > 0;

    private string GetWorkflowPhase() =>
        Workflow.CurrentDossier is not null
            ? "Release dossier ready"
            : Workflow.LatestBlockers.Count > 0
                ? "Recovery required"
                : !string.IsNullOrWhiteSpace(Workflow.Snapshot.RecipePhase) && !string.Equals(Workflow.Snapshot.RecipePhase, "Idle", StringComparison.OrdinalIgnoreCase)
                    ? "Readiness assessed"
                    : "Awaiting orchestration";

    private string GetNextStepSummary()
    {
        if (Workflow.CurrentDossier is not null)
        {
            return Workflow.IsDossierDialogOpen
                ? "Review the release dossier in the dialog and decide whether to approve the downstream handoff."
                : "Reopen the dossier dialog or approve the downstream handoff.";
        }

        if (Workflow.LatestBlockers.Count > 0)
        {
            return "Apply the release dossier recovery playbook to align recipe and evidence state before preparing the dossier again.";
        }

        return "Assess readiness first, then prepare the release dossier once recipe and evidence phases are aligned.";
    }

    private string? GetNextGuidedRoute() => Workflow.GetNextGuidedWorkflowRoute(ReturnedFrom);

    private Color GetOutcomeChipColor()
    {
        if (Workflow.CurrentDossier is not null)
        {
            return Color.Success;
        }

        return Workflow.LatestBlockers.Count > 0 ? Color.Warning : Color.Primary;
    }

    private static string GetStepLabel(ReleaseDossierJourneyStepStatus status) => status switch
    {
        ReleaseDossierJourneyStepStatus.Complete => "Complete",
        ReleaseDossierJourneyStepStatus.Blocked => "Blocked",
        ReleaseDossierJourneyStepStatus.Current => "Current",
        _ => "Pending"
    };

    private static Color GetStepColor(ReleaseDossierJourneyStepStatus status) => status switch
    {
        ReleaseDossierJourneyStepStatus.Complete => Color.Success,
        ReleaseDossierJourneyStepStatus.Blocked => Color.Warning,
        ReleaseDossierJourneyStepStatus.Current => Color.Primary,
        _ => Color.Secondary
    };

    private void HandleWorkflowChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Workflow.Changed -= HandleWorkflowChanged;
    }
}
