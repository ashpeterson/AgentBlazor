        <MudGrid>
            <MudItem xs="12" sm="6" md="4">
                <div class="docs-summary__item">
                    <MudIcon Icon="@Icons.Material.Filled.TableChart" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.subtitle2">AgentDataGrid</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Filter, sort, select rows via chat</MudText>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="docs-summary__item">
                    <MudIcon Icon="@Icons.Material.Filled.Tab" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.subtitle2">AgentTabs</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Switch tabs by name</MudText>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="docs-summary__item">
                    <MudIcon Icon="@Icons.Material.Filled.DynamicForm" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.subtitle2">AgentDialog + AgentForm</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Open dialogs, fill and submit fields</MudText>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="docs-summary__item">
                    <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Generative UI</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Agent-generated charts and cards in chat</MudText>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="docs-summary__item">
                    <MudIcon Icon="@Icons.Material.Filled.Extension" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.subtitle2">Custom Components</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">[AgentAction] on any Blazor component</MudText>
                    </div>
                </div>
            </MudItem>
            <MudItem xs="12" sm="6" md="4">
                <div class="docs-summary__item">
                    <MudIcon Icon="@Icons.Material.Filled.Brush" Color="Color.Primary" />
                    <div>
                        <MudText Typo="Typo.subtitle2">AgentActionRender</MudText>
