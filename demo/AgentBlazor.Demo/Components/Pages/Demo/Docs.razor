@page "/demo/docs"
@layout DemoLayout
@using MudBlazor

<PageTitle>Integration Guide - AgentBlazor</PageTitle>

<div class="docs">
    <MudText Typo="Typo.h4" Class="mb-1">Integration Guide</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-4">
        Accurate, current setup and capability coverage for this repository.
    </MudText>

    <section class="docs-section">
        <MudText Typo="Typo.h5" Class="docs-section__title">1. Install and register AgentBlazor</MudText>
        <pre class="docs-code">dotnet add package AgentBlazor

// Program.cs
builder.Services.AddAgentBlazor(options =>
{
    options.UseInstructionsFile("agent-instructions.txt");

    // Use one provider:
    // options.UseOpenAI(apiKey, "gpt-4o-mini");
    // options.UseOllama("llama3.2", "http://127.0.0.1:11434/v1");
});

app.MapAgentBlazorEndpoints();</pre>
    </section>

    <section class="docs-section">
        <MudText Typo="Typo.h5" Class="docs-section__title">2. Add chat UI</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            Use <code class="docs-inline">AgentChatWidget</code> for a floating assistant or
            <code class="docs-inline">AgentChatSurface</code> for inline chat.
        </MudText>
        <pre class="docs-code">&lt;AgentChatWidget
    Title="Assistant"
    EnableGeneratedUi="true"
    Placeholder="Ask me to filter data, fill forms, and navigate..." /&gt;</pre>
    </section>

    <section class="docs-section">
        <MudText Typo="Typo.h5" Class="docs-section__title">3. Route map for testing</MudText>
        <MudTable T="RouteRow" Items="@RouteRows" Dense="true" Hover="true" Bordered="true">
            <HeaderContent>
                <MudTh>Route</MudTh>
                <MudTh>Purpose</MudTh>
                <MudTh>Mounted components</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Route"><MudLink Href="@context.Route">@context.Route</MudLink></MudTd>
                <MudTd DataLabel="Purpose">@context.Purpose</MudTd>
                <MudTd DataLabel="Mounted components">@context.Components</MudTd>
            </RowTemplate>
        </MudTable>
    </section>

    <section class="docs-section">
        <MudText Typo="Typo.h5" Class="docs-section__title">4. Wrapper action coverage</MudText>
        <MudTable T="ActionRow" Items="@ActionRows" Dense="true" Hover="true" Bordered="true" Striped="true">
            <HeaderContent>
                <MudTh>Wrapper</MudTh>
                <MudTh>Action IDs</MudTh>
                <MudTh>Best test page</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Wrapper">@context.Component</MudTd>
                <MudTd DataLabel="Action IDs">@context.Actions</MudTd>
                <MudTd DataLabel="Best test page"><MudLink Href="@context.Route">@context.Route</MudLink></MudTd>
            </RowTemplate>
        </MudTable>
    </section>

    <section class="docs-section">
        <MudText Typo="Typo.h5" Class="docs-section__title">5. Generative UI data sources</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            This demo exposes named sources for charts and generated cards. The assistant is instructed to use:
        </MudText>
        <pre class="docs-code">demo.suppliers.risk.by-region
demo.suppliers.risk.tier-distribution
demo.onboarding.volume.monthly
demo.mitigation.volume.monthly</pre>
    </section>

    <section class="docs-section">
        <MudText Typo="Typo.h5" Class="docs-section__title">6. Suggested end-to-end validation flow</MudText>
        <ol class="docs-ordered">
            <li>Start on <code class="docs-inline">/demo/components</code> and validate all input and utility wrappers.</li>
            <li>Move to <code class="docs-inline">/demo/workflow</code> and test tab switch + grid filter + dialog + submit sequence.</li>
            <li>Use <code class="docs-inline">/demo/generative-ui</code> to validate chart/card generation prompts.</li>
            <li>Open <code class="docs-inline">/demo/status</code> to verify provider and catalog visibility.</li>
        </ol>
    </section>
</div>

@code {
    private static readonly IReadOnlyList<RouteRow> RouteRows =
    [
        new("/demo", "Demo index and capability matrix", "Guide surface, route navigation"),
        new("/demo/components", "Input and utility wrappers", "Select, autocomplete, date/date-range, tree, stepper, command, file upload"),
        new("/demo/workflow", "Complex orchestration flow", "Tabs, three data grids, dialog, form"),
        new("/demo/suppliers", "Focused data grid testing", "Single AgentDataGrid + custom action rendering"),
        new("/demo/onboarding", "Form automation flow", "AgentFormPageBase<TModel>, dialog/form workflow"),
        new("/demo/generative-ui", "Generated chart/card testing", "Chat-driven generated UI"),
        new("/demo/status", "Runtime diagnostics", "Provider + registry + capability catalog")
    ];

    private static readonly IReadOnlyList<ActionRow> ActionRows =
    [
        new("AgentDataGrid", "sort, filter, clear_filters, go_to_page, select_row", "/demo/suppliers"),
        new("AgentTabs", "switch_tab", "/demo/workflow"),
        new("AgentDialog", "open, close, confirm", "/demo/workflow"),
        new("AgentForm", "validate, reset, submit", "/demo/workflow"),
        new("AgentSelect", "open, close, set_value, clear", "/demo/components"),
        new("AgentAutocomplete", "set_query, select_option, clear", "/demo/components"),
        new("AgentDatePicker", "set_date, clear", "/demo/components"),
        new("AgentDateRangePicker", "set_range, clear", "/demo/components"),
        new("AgentTreeView", "expand, collapse, select_node", "/demo/components"),
        new("AgentStepper", "go_to_step, next, previous", "/demo/components"),
        new("AgentCommandBar", "invoke_command, list_commands", "/demo/components"),
        new("AgentFileUpload", "attach, remove, list_files", "/demo/components"),
        new("AgentNavMenu", "navigate_internal, navigate_external", "/demo"),
        new("AgentActionRender", "custom action-result UI templates", "/demo/suppliers")
    ];

    private sealed record RouteRow(string Route, string Purpose, string Components);
    private sealed record ActionRow(string Component, string Actions, string Route);
}
