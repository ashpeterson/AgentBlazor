        new("command-bar", "AgentCommandBar", "/demo/components/command-bar", "Invoke known commands from a host-defined command bar.", "kit-command-bar", "Available commands and the last command the host ran.", "Map natural language onto a curated command surface.", ["invoke command publish_report", "invoke command create_audit_bundle"], ["invoke_command", "list_commands"]),
