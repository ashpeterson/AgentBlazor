        "show_remote_upload_policy",
        "sync_remote_handoff",
        "validate_remote_tokens",
        "create_audit_bundle"
    ];

    private static readonly IReadOnlyList<ComponentEntry> _componentEntries =
    [
        new("datagrid", "AgentDataGrid", "/demo/components/datagrid", "Sort, filter, page, and focus grid rows with deterministic actions.", "components-datagrid", "DataGrid actions, current page, focused row, and visible columns.", "Sort and filter supplier records while keeping the grid native to Blazor.", ["sort suppliers by risk score descending", "filter region EMEA", "go to page 2", "clear filters"], ["filter", "sort", "go_to_page", "select_row", "clear_filters"]),
        new("form", "AgentForm", "/demo/components/form", "Validate, reset, and submit structured data through a host-owned MudForm surface.", "components-form", "Current field values, validation errors, and metadata for the host-owned form model.", "Keep the full MudForm surface while layering agent-driven validation and submission on top.", ["validate the form", "reset the form", "submit form"], ["validate", "reset", "submit"]),
        new("dialog", "AgentDialog", "/demo/components/dialog", "Open, confirm, and close dialogs while the host still owns the modal content.", "components-dialog", "Dialog visibility plus the currently mounted dialog content.", "Use deterministic dialog orchestration instead of free-form UI generation.", ["open dialog", "confirm dialog", "close dialog"], ["open", "confirm", "close"]),
        new("nav-menu", "AgentNavMenu", "/demo/components/nav-menu", "Navigate between known routes from a host-defined navigation menu.", "components-nav-menu", "Current route and the menu destinations mounted in the explorer.", "Expose safe internal navigation actions from a Blazor navigation surface.", ["navigate to /demo/dojo", "navigate to /demo/components/file-upload"], ["navigate_to", "navigate_external"]),
        new("tabs", "AgentTabs", "/demo/components/tabs", "Switch between host-owned tabs without giving up component structure.", "components-tabs", "Active tab index and the available tab labels.", "Move around a multi-panel surface while keeping tab content native.", ["switch to policy tab", "switch to audit tab"], ["switch_tab"]),
