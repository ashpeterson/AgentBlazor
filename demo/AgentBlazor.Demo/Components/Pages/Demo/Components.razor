        new("autocomplete", "AgentAutocomplete", "/demo/components/autocomplete", "Drive query text and option selection in an autocomplete surface.", "kit-supplier-autocomplete", "Current query, selected option, and available supplier matches.", "Let the agent refine search input without replacing the host component.", ["set supplier search query to Apex", "select option Apex Components"], ["set_query", "select_option", "clear"]),
        new("date-picker", "AgentDatePicker", "/demo/components/date-picker", "Apply single-date values with a typed date picker contract.", "kit-review-date", "Current date, min/max date bounds, and picker state.", "Use natural-language dates while keeping the host-side picker authoritative.", ["set review date to March 18 2026", "clear the review date"], ["set_date", "clear"]),
        new("date-range-picker", "AgentDateRangePicker", "/demo/components/date-range-picker", "Set date ranges through one deterministic component contract.", "kit-review-range", "Current range plus the allowed date window.", "Use one action surface for paired start and end dates.", ["set review range from 2026-03-01 to 2026-03-15", "clear the review range"], ["set_range", "clear"]),
        new("tree-view", "AgentTreeView", "/demo/components/tree-view", "Expand, collapse, and select nodes inside a host-owned tree.", "kit-workflow-tree", "Selected node and the currently expanded nodes.", "Drive hierarchical UI without inventing a new tree surface.", ["expand node compliance", "select node policy-documents"], ["expand", "collapse", "select_node"]),
