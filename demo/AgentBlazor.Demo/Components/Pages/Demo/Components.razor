    ];

    private static readonly IReadOnlyList<ContentLink> _componentContentLinks =
    [
        new("overview", "Overview"),
        new("example", "Live Example"),
        new("prompts", "Prompt Ideas"),
        new("contract", "Component Contract")
    ];

    private static readonly IReadOnlyList<ContentLink> _fileUploadContentLinks =
