    private string NormalizedComponentKey => NormalizeComponentKey(ComponentKey);

    private string EffectiveComponentKey => IsUnknownComponent ? "overview" : NormalizedComponentKey;

    private bool IsOverviewRoute => string.Equals(EffectiveComponentKey, "overview", StringComparison.OrdinalIgnoreCase);

    private ComponentEntry? SelectedComponentEntry =>
        _componentEntries.FirstOrDefault(x => string.Equals(x.Key, EffectiveComponentKey, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<ContentLink> CurrentContentLinks =>
        IsOverviewRoute
            ? _overviewContentLinks
            : string.Equals(EffectiveComponentKey, "file-upload", StringComparison.OrdinalIgnoreCase)
                ? _fileUploadContentLinks
                : _componentContentLinks;

    private bool IsUnknownComponent =>
        !string.Equals(NormalizedComponentKey, "overview", StringComparison.OrdinalIgnoreCase)
        && !_componentEntries.Any(x => string.Equals(NormalizedComponentKey, x.Key, StringComparison.OrdinalIgnoreCase));

    private bool Show(string key) => string.Equals(EffectiveComponentKey, key, StringComparison.OrdinalIgnoreCase);

    private bool IsSelected(ComponentEntry entry) => string.Equals(entry.Key, EffectiveComponentKey, StringComparison.OrdinalIgnoreCase);

