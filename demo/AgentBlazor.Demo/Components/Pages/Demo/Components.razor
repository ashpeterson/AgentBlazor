    private async Task OnCommandInvoked(string command)
    {
        _lastCommand = command;
        DemoFileWorkflowSnapshot snapshot;

        var message = command switch
        {
            "show_local_upload_policy" =>
                "Local policy: keep file names as references only; do not read/write local files directly.",
            "show_remote_upload_policy" =>
                "Remote policy: treat file names as tokens and hand off uploads to approved external storage services.",
            "sync_remote_handoff" =>
                "Started remote handoff pipeline for files in Remote mode.",
            "validate_remote_tokens" =>
                "Validated remote storage tokens for files in Remote mode.",
            "create_audit_bundle" =>
                "Executed remote handoff and token validation to generate an audit-ready workflow trace.",
            _ => $"Invoked '{command}'."
        };

        if (string.Equals(command, "show_local_upload_policy", StringComparison.OrdinalIgnoreCase))
        {
            _uploadPolicyMode = "Local";
            snapshot = await FileWorkflowService.SyncFilesAsync(ComponentRegistry.SessionId, _attachedFiles, _uploadPolicyMode);
        }
        else if (string.Equals(command, "show_remote_upload_policy", StringComparison.OrdinalIgnoreCase))
        {
            _uploadPolicyMode = "Remote";
            snapshot = await FileWorkflowService.SyncFilesAsync(ComponentRegistry.SessionId, _attachedFiles, _uploadPolicyMode);
        }
        else if (string.Equals(command, "sync_remote_handoff", StringComparison.OrdinalIgnoreCase))
        {
            snapshot = await FileWorkflowService.RunRemoteHandoffAsync(ComponentRegistry.SessionId);
        }
        else if (string.Equals(command, "validate_remote_tokens", StringComparison.OrdinalIgnoreCase))
        {
            snapshot = await FileWorkflowService.ValidateRemoteTokensAsync(ComponentRegistry.SessionId);
        }
        else if (string.Equals(command, "create_audit_bundle", StringComparison.OrdinalIgnoreCase))
        {
            snapshot = await FileWorkflowService.RunRemoteHandoffAsync(ComponentRegistry.SessionId);
            snapshot = await FileWorkflowService.ValidateRemoteTokensAsync(ComponentRegistry.SessionId);
        }
        else
        {
            snapshot = await FileWorkflowService.GetOrCreateAsync(ComponentRegistry.SessionId, _uploadPolicyMode);
        }

        snapshot = await FileWorkflowService.RecordWorkflowEventAsync(
            ComponentRegistry.SessionId,
            "CommandInvoked",
            command,
            message);

        ApplyFileWorkflowSnapshot(snapshot);

        Snackbar.Add(message, Severity.Info);
    }

    private async Task RunRemoteHandoffAsync()
    {
        var snapshot = await FileWorkflowService.RunRemoteHandoffAsync(ComponentRegistry.SessionId);
        snapshot = await FileWorkflowService.RecordWorkflowEventAsync(
            ComponentRegistry.SessionId,
            "CommandInvoked",
            "sync_remote_handoff",
            "Started remote handoff pipeline for files in Remote mode.");
        ApplyFileWorkflowSnapshot(snapshot);
        _lastCommand = "sync_remote_handoff";
        Snackbar.Add("Remote handoff pipeline executed.", Severity.Info);
    }

    private async Task ValidateRemoteTokensAsync()
    {
        var snapshot = await FileWorkflowService.ValidateRemoteTokensAsync(ComponentRegistry.SessionId);
        snapshot = await FileWorkflowService.RecordWorkflowEventAsync(
            ComponentRegistry.SessionId,
            "CommandInvoked",
            "validate_remote_tokens",
            "Validated remote storage tokens for files in Remote mode.");
        ApplyFileWorkflowSnapshot(snapshot);
        _lastCommand = "validate_remote_tokens";
        Snackbar.Add("Remote token validation completed.", Severity.Info);
    }

    private void ApplyFileWorkflowSnapshot(DemoFileWorkflowSnapshot snapshot)
    {
        _attachedFiles = snapshot.Files;
        _uploadPolicyMode = snapshot.UploadMode;
        _fileWorkflowEvents = snapshot.Events;
        _fileWorkflowJobs = snapshot.Jobs;
    }

    private static Color MapJobStatusColor(string status) =>
        status switch
        {
            "Completed" => Color.Success,
            "Verified" => Color.Success,
            "Failed" => Color.Error,
            "InProgress" => Color.Warning,
            _ => Color.Default
        };

    private static string FormatDate(DateTime? value) =>
        value?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture) ?? "(none)";

    private static string NormalizeComponentKey(string? key)
    {
        if (string.IsNullOrWhiteSpace(key))
        {
            return "overview";
        }

        return key.Trim().ToLowerInvariant();
    }

    protected override async Task OnInitializedAsync()
    {
        var snapshot = await FileWorkflowService.GetOrCreateAsync(ComponentRegistry.SessionId, _uploadPolicyMode);
        ApplyFileWorkflowSnapshot(snapshot);
    }

