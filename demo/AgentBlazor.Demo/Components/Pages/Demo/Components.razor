@page "/demo/components"
@page "/demo/components/{ComponentKey}"
@layout DemoLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using AgentBlazor.Components
@using AgentBlazor.Core.Runtime.Interfaces
@using AgentBlazor.Demo.Services
@using MudBlazor
@inject ISnackbar Snackbar
@inject IAgentComponentRegistry ComponentRegistry
@inject DemoFileWorkflowService FileWorkflowService

<PageTitle>Components — AgentBlazor Demo</PageTitle>

<div class="components-page">
    <aside class="components-page__catalog">
        <nav class="components-page__catalog-card" aria-label="Components">
            <p class="components-page__catalog-label">Component Catalog</p>
            <div class="components-page__catalog-nav">
                <a class="components-page__catalog-link @(IsOverviewRoute ? "is-active" : null)"
                   href="/demo/components"
                   aria-current="@(IsOverviewRoute ? "page" : null)">
                    <span>Overview</span>
                    <small>Use the component explorer as a reference surface after the workflow hub.</small>
                </a>

                @foreach (var entry in _componentEntries)
                {
                    <a class="components-page__catalog-link @(IsSelected(entry) ? "is-active" : null)"
                       href="@entry.Href"
                       aria-current="@(IsSelected(entry) ? "page" : null)">
                        <span>@entry.Title</span>
                        <small>@entry.NavSummary</small>
                    </a>
                }

                <a class="components-page__catalog-link" href="/demo/components/attribute-based">
                    <span>Custom Attribute-Based Component</span>
                    <small>Use <code>AgentControllableComponentBase</code> for your own component contract.</small>
                </a>
            </div>
        </nav>
    </aside>

    <main class="components-page__main">
        @if (IsUnknownComponent)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                Unknown component route: <code>@ComponentKey</code>. Showing the explorer overview instead.
            </MudAlert>
        }

        @if (IsOverviewRoute)
        {
@*             <section id="overview" class="components-page__panel components-page__panel--hero">
                <p class="components-page__section-eyebrow">Component Explorer</p>
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    This explorer mirrors a docs workflow: choose a component from the left, inspect its live example in the center,
                    and use the contents rail on the right to jump between prompts, contract details, and any component-specific notes.
                </MudText>
            </section> *@

            <section id="catalog" class="components-page__panel">
                <div class="components-page__section-head">
                    <div>
                        <p class="components-page__section-eyebrow">Catalog</p>
                        <MudText Typo="Typo.h5">Current drop-in components</MudText>
                    </div>
                </div>

                <div class="components-page__catalog-grid">
                    @foreach (var entry in _componentEntries)
                    {
                        <a class="components-page__catalog-card-tile" href="@entry.Href">
                            <strong>@entry.Title</strong>
                            <span>@entry.Summary</span>
                        </a>
                    }
                </div>
            </section>

            <section id="authoring" class="components-page__panel">
                <div class="components-page__section-head">
                    <div>
                        <p class="components-page__section-eyebrow">Authoring Paths</p>
                        <MudText Typo="Typo.h5">Use components directly, then graduate to custom contracts</MudText>
                    </div>
                </div>

                <div class="components-page__overview-grid">
                    <div class="components-page__mini-card">
                        <strong>Component reference surface</strong>
                        <span>Use the catalog on the left to inspect one built-in component at a time after the workflow story is clear.</span>
                    </div>
                    <div class="components-page__mini-card">
                        <strong>Workflow hub first</strong>
                        <span>Start in the workflow hub for semantic, approval-aware flows, then come here to inspect reusable component contracts.</span>
                    </div>
                    <div class="components-page__mini-card">
                        <strong>Custom component path</strong>
                        <span>Move to the attribute-based example when you need your own Blazor component contract.</span>
                    </div>
                    <div class="components-page__mini-card">
                        <strong>Compatibility proofs</strong>
                        <span><a href="/demo/components/parity/form">Open the form proof</a>, <a href="/demo/components/parity/datagrid">the data grid proof</a>, <a href="/demo/components/parity/dialog">the dialog proof</a>, <a href="/demo/components/parity/choice-inputs">the select and autocomplete proof</a>, <a href="/demo/components/parity/file-upload">the file upload proof</a>, <a href="/demo/components/parity/date-pickers">the date-picker proof</a>, <a href="/demo/components/parity/workflow-navigation">the tabs and stepper proof</a>, <a href="/demo/components/parity/hierarchy-navigation">the nav-menu and tree-view proof</a>, or <a href="/demo/components/parity/composed-workflow">the composed workflow proof</a> to validate the drop-in claim.</span>
                    </div>
                </div>
            </section>
        }
        else if (SelectedComponentEntry is not null)
        {
            <section id="overview" class="components-page__panel components-page__panel--hero">
                <p class="components-page__section-eyebrow">Selected Component</p>
                <MudText Typo="Typo.h4">@SelectedComponentEntry.Title</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">
                    @SelectedComponentEntry.Summary
                </MudText>

                <div class="components-page__tag-row">
                    <span class="components-page__tag">Deterministic actions</span>
                    <span class="components-page__tag">Native Blazor rendering</span>
                    <span class="components-page__tag">MudBlazor-friendly</span>
                    <span class="components-page__tag">Ask via chat bubble</span>
                </div>
            </section>

            <section id="example" class="components-page__panel">
                <div class="components-page__section-head">
                    <div>
                        <p class="components-page__section-eyebrow">Live Example</p>
                        <MudText Typo="Typo.h5">@SelectedComponentEntry.Title in context</MudText>
                    </div>
                </div>

                @if (Show("datagrid"))
                {
                    <AgentDataGrid TItem="GridSupplierRow"
                                   AgentId="components-datagrid"
                                   Items="@_gridRows"
                                   Dense="true"
                                   Hover="true"
                                   Bordered="true"
                                   Striped="true"
                                   RowKeyProperty="Id">
                        <Columns>
                            <PropertyColumn T="GridSupplierRow" TProperty="string" Property="x => x.Id" Title="ID" />
                            <PropertyColumn T="GridSupplierRow" TProperty="string" Property="x => x.Name" Title="Supplier" />
                            <PropertyColumn T="GridSupplierRow" TProperty="string" Property="x => x.Region" Title="Region" />
                            <PropertyColumn T="GridSupplierRow" TProperty="int" Property="x => x.RiskScore" Title="Risk Score" />
                        </Columns>
                    </AgentDataGrid>
                }
                else if (Show("form"))
                {
                    <AgentForm @ref="_componentForm"
                               AgentId="components-form"
                               Model="@_componentFormModel"
                               Submitted="OnComponentFormSubmittedAsync">
                        <MudGrid Spacing="2">
                            <MudItem xs="12" md="6">
                                <MudTextField T="string"
                                              Label="Supplier Name"
                                              For="@(() => _componentFormModel.SupplierName)"
                                              @bind-Value="_componentFormModel.SupplierName" />
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudSelect T="string"
                                           Label="Risk Tier"
                                           For="@(() => _componentFormModel.RiskTier)"
                                           @bind-Value="_componentFormModel.RiskTier">
                                    <MudSelectItem T="string" Value="@("Low")">Low</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("Medium")">Medium</MudSelectItem>
                                    <MudSelectItem T="string" Value="@("High")">High</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudCheckBox T="bool" Label="Needs Expedite" @bind-Value="_componentFormModel.NeedsExpedite" />
                            </MudItem>
                        </MudGrid>
                        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                            <MudButton ButtonType="ButtonType.Button"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="SubmitComponentFormAsync">Submit</MudButton>
                        </MudStack>
                    </AgentForm>
                }
                else if (Show("dialog"))
                {
                    <MudStack Row="true" Spacing="1" Class="mb-2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenComponentDialogAsync">Open Dialog</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseComponentDialogAsync">Close Dialog</MudButton>
                    </MudStack>

                    <AgentDialog @ref="_componentDialog"
                                 AgentId="components-dialog"
                                 Visible="@_componentDialogVisible"
                                 VisibleChanged="OnComponentDialogVisibleChanged">
                        <TitleContent>
                            <MudText Typo="Typo.h6">Supplier Policy Confirmation</MudText>
                        </TitleContent>
                        <DialogContent>
                            <MudText Typo="Typo.body2">Confirm this supplier can move from review to approval.</MudText>
                        </DialogContent>
                        <DialogActions>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmComponentDialogAsync">Confirm</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseComponentDialogAsync">Cancel</MudButton>
                        </DialogActions>
                    </AgentDialog>
                }
                else if (Show("nav-menu"))
                {
                    <AgentNavMenu AgentId="components-nav-menu" Dense="true">
                        <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
                        <MudNavLink Href="/demo" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Hub">Workflow Hub</MudNavLink>
                        <MudNavLink Href="/demo/components/file-upload" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.UploadFile">File Upload</MudNavLink>
                    </AgentNavMenu>
                }
                else if (Show("tabs"))
                {
                    <AgentTabs AgentId="components-tabs">
                        <MudTabPanel Text="Summary">
                            <MudText Typo="Typo.body2">Supplier overview and risk summary.</MudText>
                        </MudTabPanel>
                        <MudTabPanel Text="Policy">
                            <MudText Typo="Typo.body2">Policy controls and compliance checks.</MudText>
                        </MudTabPanel>
                        <MudTabPanel Text="Audit">
                            <MudText Typo="Typo.body2">Audit logs and evidence bundle state.</MudText>
                        </MudTabPanel>
                    </AgentTabs>
                }
                else if (Show("select"))
                {
                    <AgentSelect T="string"
                                 AgentId="kit-country-select"
                                 Value="@_selectedCountry"
                                 ValueChanged="OnCountryChanged"
                                 Options="@_countryOptions" />
                    <MudText Typo="Typo.caption" Class="mt-2">Selected: @_selectedCountry</MudText>
                }
                else if (Show("autocomplete"))
                {
                    <AgentAutocomplete T="string"
                                       AgentId="kit-supplier-autocomplete"
                                       Query="@_supplierQuery"
                                       QueryChanged="OnSupplierQueryChanged"
                                       Value="@_selectedSupplier"
                                       ValueChanged="OnSupplierValueChanged"
                                       Options="@_supplierOptions"
                                       Placeholder="Search suppliers..." />
                    <MudText Typo="Typo.caption" Class="mt-2">Query: @_supplierQuery | Selected: @_selectedSupplier</MudText>
                }
                else if (Show("date-picker"))
                {
                    <AgentDatePicker AgentId="kit-review-date"
                                     Value="@_reviewDate"
                                     ValueChanged="OnReviewDateChanged"
                                     MinDate="@_minReviewDate"
                                     MaxDate="@_maxReviewDate" />
                    <MudText Typo="Typo.caption" Class="mt-2">Review date: @FormatDate(_reviewDate)</MudText>
                }
                else if (Show("date-range-picker"))
                {
                    <AgentDateRangePicker AgentId="kit-review-range"
                                          StartDate="@_rangeStart"
                                          StartDateChanged="OnRangeStartChanged"
                                          EndDate="@_rangeEnd"
                                          EndDateChanged="OnRangeEndChanged"
                                          MinDate="@_minReviewDate"
                                          MaxDate="@_maxReviewDate" />
                    <MudText Typo="Typo.caption" Class="mt-2">Range: @FormatDate(_rangeStart) to @FormatDate(_rangeEnd)</MudText>
                }
                else if (Show("tree-view"))
                {
                    <AgentTreeView T="string" AgentId="kit-workflow-tree"
                                   NodeIds="@_treeNodeIds"
                                   SelectedNodeId="@_selectedTreeNodeId"
                                   SelectedNodeIdChanged="OnTreeNodeSelected"
                                   ExpandedNodeIds="@_expandedTreeNodeIds"
                                   ExpandedNodeIdsChanged="OnTreeExpandedChanged" />
                    <MudText Typo="Typo.caption" Class="mt-2">Selected: @_selectedTreeNodeId | Expanded: @string.Join(", ", _expandedTreeNodeIds)</MudText>
                }
                else if (Show("stepper"))
                {
                    <AgentStepper AgentId="kit-onboarding-stepper"
                                  CurrentStepIndex="@_currentStepIndex"
                                  CurrentStepIndexChanged="OnCurrentStepChanged">
                        <MudStep Title="@_stepIds[0]">
                            <MudText Typo="Typo.body2">Create the onboarding kit and confirm the intake owner.</MudText>
                        </MudStep>
                        <MudStep Title="@_stepIds[1]">
                            <MudText Typo="Typo.body2">Collect the required documents and verify policy coverage.</MudText>
                        </MudStep>
                        <MudStep Title="@_stepIds[2]">
                            <MudText Typo="Typo.body2">Run the review checks and prepare the final submission.</MudText>
                        </MudStep>
                    </AgentStepper>
                    <MudText Typo="Typo.caption" Class="mt-2">Current step: @_currentStepIndex (@_stepIds[_currentStepIndex])</MudText>
                }
                else if (Show("command-bar"))
                {
                    <AgentCommandBar AgentId="kit-command-bar"
                                     Commands="@_commands"
                                     CommandInvoked="OnCommandInvoked" />
                    <MudText Typo="Typo.caption" Class="mt-2">Last command: @_lastCommand</MudText>
                }
                else if (Show("file-upload"))
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-2">
                        Local mode treats names as trusted references. Remote mode treats names as handoff tokens.
                    </MudAlert>

                    <AgentFileUpload T="IReadOnlyList<IBrowserFile>" AgentId="kit-file-upload"
                                     FileNames="@_attachedFiles"
                                     FileNamesChanged="OnFilesChanged" />
                    <MudText Typo="Typo.caption" Class="mt-2">Attached files: @(string.Join(", ", _attachedFiles))</MudText>
                    <MudText Typo="Typo.caption" Class="mt-1">Upload mode: @_uploadPolicyMode</MudText>

                    <MudStack Row="true" Spacing="1" Class="mt-2">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="RunRemoteHandoffAsync">
                            Sync Remote Handoff
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ValidateRemoteTokensAsync">
                            Validate Tokens
                        </MudButton>
                    </MudStack>
                }
            </section>

            <section id="prompts" class="components-page__panel">
                <div class="components-page__section-head">
                    <div>
                        <p class="components-page__section-eyebrow">Prompt Ideas</p>
                        <MudText Typo="Typo.h5">Use the chat bubble with these prompts</MudText>
                    </div>
                </div>

                <ul class="components-page__prompt-list">
                    @foreach (var prompt in SelectedComponentEntry.PromptIdeas)
                    {
                        <li><code>@prompt</code></li>
                    }
                </ul>
            </section>

            <section id="contract" class="components-page__panel">
                <div class="components-page__section-head">
                    <div>
                        <p class="components-page__section-eyebrow">Component Contract</p>
                        <MudText Typo="Typo.h5">What the agent can safely do</MudText>
                    </div>
                </div>

                <div class="components-page__contract-grid">
                    <div class="components-page__mini-card">
                        <strong>Example agent id</strong>
                        <code>@SelectedComponentEntry.AgentId</code>
                    </div>
                    <div class="components-page__mini-card">
                        <strong>Primary actions</strong>
                        <div class="components-page__inline-code-list">
                            @foreach (var action in SelectedComponentEntry.Actions)
                            {
                                <code>@action</code>
                            }
                        </div>
                    </div>
                    <div class="components-page__mini-card">
                        <strong>Readable state</strong>
                        <span>@SelectedComponentEntry.Readables</span>
                    </div>
                </div>
            </section>

            @if (Show("file-upload") && (_fileWorkflowEvents.Count > 0 || _fileWorkflowJobs.Count > 0))
            {
                <section id="activity" class="components-page__panel">
                    <div class="components-page__section-head">
                        <div>
                            <p class="components-page__section-eyebrow">Workflow Activity</p>
                            <MudText Typo="Typo.h5">Remote handoff and token validation state</MudText>
                        </div>
                    </div>

                    @if (_fileWorkflowEvents.Count > 0)
                    {
                        <ul class="components-page__file-events">
                            @foreach (var fileEvent in _fileWorkflowEvents)
                            {
                                <li>
                                    <span>@fileEvent.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                                    <span>@fileEvent.EventType</span>
                                    <span>@fileEvent.Message</span>
                                </li>
                            }
                        </ul>
                    }

                    @if (_fileWorkflowJobs.Count > 0)
                    {
                        <div class="components-page__job-block">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Recent workflow jobs</MudText>
                            <ul class="components-page__file-jobs">
                                @foreach (var job in _fileWorkflowJobs)
                                {
                                    <li>
                                        <div class="components-page__job-head">
                                            <span>@job.UpdatedUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                                            <span>@job.Operation</span>
                                            <MudChip T="string" Size="Size.Small" Color="@MapJobStatusColor(job.Status)">
                                                @job.Status
                                            </MudChip>
                                        </div>
                                        <div class="components-page__job-detail">
                                            <span>@job.FileName</span>
                                            @if (!string.IsNullOrWhiteSpace(job.StorageToken))
                                            {
                                                <span>@job.StorageToken</span>
                                            }
                                            <span>@job.Message</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </section>
            }
        }
    </main>

    <aside class="components-page__contents">
        <div class="components-page__contents-card">
            <p class="components-page__catalog-label">Contents</p>
            <nav class="components-page__contents-links" aria-label="Contents">
                @foreach (var link in CurrentContentLinks)
                {
                    <a href="@($"#{link.Id}")">@link.Label</a>
                }
            </nav>

            <div class="components-page__contents-note">
                <strong>Prompting</strong>
                <span>Use the bottom-right chat bubble to drive the currently selected component. The assistant is route-aware and stays scoped to this explorer.</span>
            </div>
        </div>
    </aside>
</div>

@code {
    [Parameter]
    public string? ComponentKey { get; set; }

    private AgentDialog? _componentDialog;
    private AgentForm? _componentForm;
    private bool _componentDialogVisible;

    private readonly ComponentFormModel _componentFormModel = new()
    {
        SupplierName = "Northwind Traders",
        RiskTier = "Medium",
        NeedsExpedite = false
    };

    private string? _selectedCountry = "United States";
    private string? _supplierQuery = "Apex";
    private string? _selectedSupplier = "Apex Components";
    private DateTime? _reviewDate = new DateTime(2026, 3, 18);
    private DateTime? _rangeStart = new DateTime(2026, 3, 1);
    private DateTime? _rangeEnd = new DateTime(2026, 3, 15);
    private readonly DateTime _minReviewDate = new(2026, 1, 1);
