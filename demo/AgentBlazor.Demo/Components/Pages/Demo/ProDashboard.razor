@page "/demo/dashboard"
@layout DemoLayout
@using MudBlazor
@using AgentBlazor.Components

<PageTitle>Pro Dashboard — AgentBlazor Demo</PageTitle>

<div class="dashboard-page">
    <section class="dashboard-page__header">
        <div class="dashboard-page__title-row">
            <MudText Typo="Typo.h4">Pro Dashboard</MudText>
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">Archived Route</MudChip>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            This route is preserved for future paid-tier work. It is intentionally not linked from the current public launch path.
        </MudText>
    </section>

    <section class="dashboard-page__content">
        <AgentProDashboard Title="Agent Intelligence Dashboard" DaysRange="30" RequireAuthenticatedUser="false" />
    </section>

    <section class="dashboard-page__info">
        <MudPaper Class="pa-4" Outlined="true">
            <MudText Typo="Typo.h6">Why this still exists</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                The dashboard, licensing, audit, and analytics work are being preserved in the repo. They are not part of the current launch story, but they are not being deleted.
            </MudText>
        </MudPaper>
    </section>
</div>

<style>
    .dashboard-page {
        padding: 24px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .dashboard-page__header {
        margin-bottom: 24px;
    }

    .dashboard-page__title-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
    }

    .dashboard-page__content {
        margin-bottom: 32px;
    }
</style>
