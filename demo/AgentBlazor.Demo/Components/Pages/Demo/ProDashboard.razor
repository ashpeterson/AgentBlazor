@page "/demo/dashboard"
@layout DemoLayout
@using MudBlazor
@using AgentBlazor.Components

<PageTitle>Pro Dashboard — AgentBlazor Demo</PageTitle>

<div class="dashboard-page">
    <section class="dashboard-page__header">
        <div class="dashboard-page__title-row">
            <MudText Typo="Typo.h4">Pro Dashboard</MudText>
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined" Size="Size.Small">Pro Tier</MudChip>
        </div>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Shows usage, audit, patterns, and agent performance for paid installs.
        </MudText>
    </section>

    <section class="dashboard-page__content">
        <AgentProDashboard Title="Agent Intelligence Dashboard" DaysRange="30" RequireAuthenticatedUser="false" />
    </section>

    <section class="dashboard-page__info">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.h6">What this shows</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Use the tabs to inspect the paid surfaces.
                    </MudText>
                    <MudChipSet T="string">
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">Usage</MudChip>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">Audit</MudChip>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">Patterns</MudChip>
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">Performance</MudChip>
                    </MudChipSet>
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.h6">Enable it</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Add `UseProLicense()` and render `AgentProDashboard`.
                    </MudText>
                    <pre class="dashboard-page__code"><code>builder.Services.AddAgentBlazor(options =>
{
    options.UseOpenAI(apiKey, "gpt-5.4-mini");
    options.UseProLicense("AB-PRO-YOUR-LICENSE-KEY");
});

&lt;AgentProDashboard Title="My Dashboard" DaysRange="30" /&gt;</code></pre>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </section>
</div>

<style>
    .dashboard-page {
        padding: 24px;
        max-width: 1400px;
        margin: 0 auto;
    }

    .dashboard-page__header {
        margin-bottom: 24px;
    }

    .dashboard-page__title-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 8px;
    }

    .dashboard-page__content {
        margin-bottom: 32px;
    }

    .dashboard-page__info {
        margin-top: 24px;
    }

    .dashboard-page__code {
        background: #1e1e1e;
        color: #d4d4d4;
        padding: 16px;
        border-radius: 8px;
        overflow-x: auto;
        font-family: 'Consolas', 'Monaco', monospace;
        font-size: 0.875rem;
        line-height: 1.5;
    }

    .dashboard-page__code code {
        color: inherit;
    }
</style>
