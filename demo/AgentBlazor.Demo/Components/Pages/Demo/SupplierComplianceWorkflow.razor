@page "/demo/workflows/supplier-compliance"
@layout DemoLayout
@using AgentBlazor.Demo.Services
@implements IDisposable
@inject NavigationManager NavigationManager

<PageTitle>Supplier Compliance Workflow</PageTitle>

<div class="demo-doc-page">
    <MudPaper Elevation="1" Class="demo-doc-page__hero">
        <p class="demo-doc-page__eyebrow">Workflow module</p>
        <MudText Typo="Typo.h5">Supplier compliance</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="demo-doc-page__hero-subtitle">
            Focus risk. Explain it. Draft remediation.
        </MudText>

        <div class="demo-doc-page__prompt-row">
            <span>Show suppliers likely to fail compliance review</span>
            <span>Explain why these suppliers are at risk</span>
            <span>Prepare a remediation draft</span>
        </div>

        @if (IsResponseOrchestrationHandoff)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                Opened from response orchestration. This live supplier surface is carrying the current workflow session and focus.
            </MudAlert>
            <MudAlert Severity="Severity.Success" Variant="Variant.Text" Dense="true" Class="mt-2">
                Current orchestration contribution: @(Focus?.Equals("recovery", StringComparison.OrdinalIgnoreCase) == true
                    ? "clear severe supplier blockers, then return once the remediation draft is ready."
                    : "confirm supplier focus and prepare the remediation draft so the response packet can advance.")
            </MudAlert>
        }

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-4">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                Phase: @GetWorkflowPhase()
            </MudChip>
            <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">
                Focused suppliers: @Workflow.HighlightedSupplierIds.Count
            </MudChip>
            <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">
                Recovery staged: @Workflow.RecoveredSupplierIds.Count
            </MudChip>
            <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">
                Approval boundary: @(Workflow.CurrentDraft is null ? "not reached" : "draft ready")
            </MudChip>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => FocusAtRiskAsync(30))">
                Highlight 30-day risk
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ExplainFocusedAsync">
                Explain current focus
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="PrepareDraftAsync">
                Prepare remediation draft
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Success" OnClick="ApplyRecoveryPlaybookAsync">
                Apply Recovery Playbook
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Info" OnClick="ResetAsync">
                Reset view
            </MudButton>
            @if (!string.IsNullOrWhiteSpace(ReturnTo))
            {
                <MudButton Variant="Variant.Text" Color="Color.Info" OnClick="ReturnToWorkflowAsync">
                    Return to orchestration
                </MudButton>
            }
        </MudStack>
    </MudPaper>

    <section class="demo-doc-page__section">
        <MudGrid Spacing="2">
            <MudItem xs="12" xl="7">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                        <div>
                            <MudText Typo="Typo.h6">Focused supplier grid</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">
                            Review window: @Workflow.CurrentReviewWindowDays days
                        </MudChip>
                    </MudStack>

                    <AgentDataGrid TItem="SupplierComplianceRow"
                                   AgentId="supplier-compliance-grid"
                                   Items="@Workflow.VisibleSuppliers"
                                   Dense="true"
                                   Hover="true"
                                   Bordered="true"
                                   Striped="true"
                                   RowsPerPage="5"
                                   RowKeyProperty="Id">
                        <Columns>
                            <PropertyColumn T="SupplierComplianceRow" TProperty="string" Property="x => x.Id" Title="ID" />
                            <PropertyColumn T="SupplierComplianceRow" TProperty="string" Property="x => x.Name" Title="Supplier" />
                            <PropertyColumn T="SupplierComplianceRow" TProperty="string" Property="x => x.Country" Title="Country" />
                            <PropertyColumn T="SupplierComplianceRow" TProperty="string" Property="x => x.RiskTier" Title="Risk" />
                            <PropertyColumn T="SupplierComplianceRow" TProperty="int" Property="x => x.CertificateExpiryDays" Title="Cert Expiry" />
                            <PropertyColumn T="SupplierComplianceRow" TProperty="int" Property="x => x.AuditAgeDays" Title="Audit Age" />
                            <TemplateColumn T="SupplierComplianceRow" Title="Signals">
                                <CellTemplate>
                                    <MudStack Spacing="1">
                                        @if (Workflow.IsHighlighted(context.Item.Id))
                                        {
                                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                                                In current focus
                                            </MudChip>
                                        }
                                        <MudText Typo="Typo.caption">@Workflow.DescribeSignals(context.Item)</MudText>
                                    </MudStack>
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                    </AgentDataGrid>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" xl="5">
                <MudStack Spacing="2">
                    <WorkflowDecisionSupport Title="Decision support"
                                             Description="Risk focus, blockers, and draft readiness."
                                             PhaseLabel="@GetWorkflowPhase()"
                                             ApprovalBoundarySummary="@(Workflow.CurrentDraft is null ? "not reached" : "draft ready")"
                                             NextStepSummary="@GetNextStepSummary()"
                                             OutcomeTitle="Workflow insight"
                                             OutcomeSummary="@GetOutcomeSummary()"
                                             OutcomeSeverity="@GetOutcomeSeverity()"
                                             BlockerSummary="Resolve these blockers before preparing a remediation draft."
                                             Blockers="@GetBlockers()"
                                             Warnings="@GetWarnings()"
                                             NextActions="@GetRecommendedActions()">
                        <SummaryContent>
                            <MudList T="string" Dense="true" Class="mb-0">
                                <MudListItem T="string">Focused suppliers: @Workflow.HighlightedSupplierIds.Count</MudListItem>
                                <MudListItem T="string">Review window: @Workflow.CurrentReviewWindowDays days</MudListItem>
                                <MudListItem T="string">Recovery staged: @Workflow.RecoveredSupplierIds.Count</MudListItem>
                                <MudListItem T="string">Draft actions: @(Workflow.CurrentDraft?.Actions.Count ?? 0)</MudListItem>
                            </MudList>
                        </SummaryContent>
                    </WorkflowDecisionSupport>

                    <MudPaper Class="pa-4" Outlined="true">
                        <MudText Typo="Typo.h6">Remediation draft</MudText>

                        @if (Workflow.CurrentDraft is { } draft)
                        {
                            <MudText Typo="Typo.subtitle2">@draft.Title</MudText>
                            <MudText Typo="Typo.caption" Class="d-block mb-2">
                                Suppliers: @string.Join(", ", draft.SupplierIds)
                            </MudText>
                            <MudList T="string" Dense="true">
                                @foreach (var action in draft.Actions)
                                {
                                    <MudListItem T="string">@action</MudListItem>
                                }
                            </MudList>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">No remediation draft has been prepared yet.</MudText>
                        }
                    </MudPaper>
                </MudStack>
            </MudItem>
        </MudGrid>
    </section>

    <AgentDialog AgentId="supplier-remediation-dialog"
                 Visible="@Workflow.IsRemediationDialogOpen"
                 OnConfirm="ConfirmDraftAsync"
                 VisibleChanged="OnDraftVisibilityChanged">
        <TitleContent>
            <MudText Typo="Typo.h6">Supplier remediation draft</MudText>
        </TitleContent>
        <DialogContent>
            @if (Workflow.CurrentDraft is { } draft)
            {
                <MudText Typo="Typo.body2" Class="mb-2">
                    This draft is the approval boundary for the current highlighted suppliers.
                </MudText>
                <MudText Typo="Typo.caption" Class="d-block mb-3">
                    Suppliers: @string.Join(", ", draft.SupplierIds)
                </MudText>
                <MudList T="string" Dense="true">
                    @foreach (var action in draft.Actions)
                    {
                        <MudListItem T="string">@action</MudListItem>
                    }
                </MudList>
            }
            else
            {
                <MudText Typo="Typo.body2">No remediation draft is active.</MudText>
            }
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CloseDraftAsync">
                Close draft
            </MudButton>
        </DialogActions>
    </AgentDialog>
</div>

@code {
    [Inject] private SupplierComplianceWorkflowService Workflow { get; set; } = default!;
    [SupplyParameterFromQuery(Name = "source")] public string? Source { get; set; }
    [SupplyParameterFromQuery(Name = "focus")] public string? Focus { get; set; }
    [SupplyParameterFromQuery(Name = "returnTo")] public string? ReturnTo { get; set; }

    private string? _lastAppliedHandoffKey;
    private bool IsResponseOrchestrationHandoff => string.Equals(Source, "response-orchestration", StringComparison.OrdinalIgnoreCase);

    protected override void OnInitialized()
    {
        Workflow.Changed += HandleWorkflowChanged;
    }

    protected override Task OnParametersSetAsync()
    {
        ApplyRouteHandoff();
        return Task.CompletedTask;
    }

    private Task FocusAtRiskAsync(int days)
    {
        Workflow.FocusAtRiskSuppliers(days);
        return Task.CompletedTask;
    }

    private Task ExplainFocusedAsync()
    {
        Workflow.ExplainFocusedSuppliers();
        return Task.CompletedTask;
    }

    private Task PrepareDraftAsync()
    {
        if (Workflow.HighlightedSupplierIds.Any())
        {
            Workflow.PrepareRemediationDraft();
        }

        return Task.CompletedTask;
    }

    private Task ApplyRecoveryPlaybookAsync()
    {
        Workflow.ApplyRecoveryPlaybook();
        return Task.CompletedTask;
    }

    private Task ResetAsync()
    {
        Workflow.Reset();
        return Task.CompletedTask;
    }

    private Task ReturnToWorkflowAsync()
    {
        if (!string.IsNullOrWhiteSpace(ReturnTo))
        {
            NavigationManager.NavigateTo(BuildReturnUri());
        }

        return Task.CompletedTask;
    }

    private Task CloseDraftAsync()
    {
        Workflow.SetRemediationDialogVisible(false);
        return Task.CompletedTask;
    }

    private Task<AgentBlazor.Runtime.ActionResult> ConfirmDraftAsync()
    {
        Workflow.SetRemediationDialogVisible(false);
        return Task.FromResult(AgentBlazor.Runtime.ActionResult.Applied("Approved the supplier remediation dialog."));
    }

    private Task OnDraftVisibilityChanged(bool visible)
    {
        Workflow.SetRemediationDialogVisible(visible);
        return Task.CompletedTask;
    }

    private string GetWorkflowPhase() =>
        Workflow.CurrentDraft is not null
            ? "Draft prepared"
            : Workflow.LatestDraftBlockers.Count > 0
                ? "Recovery required"
                : Workflow.RecoveredSupplierIds.Count > 0
                    ? "Recovery staged"
                    : Workflow.HighlightedSupplierIds.Count > 0
                        ? "Suppliers in focus"
                        : "Awaiting analysis";

    private string GetNextStepSummary()
    {
        if (Workflow.CurrentDraft is not null)
        {
            return Workflow.IsRemediationDialogOpen
                ? "Review the draft actions in the dialog and decide whether to approve the remediation batch."
                : "Open or review the remediation draft before approving any mutating follow-up.";
        }

        if (Workflow.LatestDraftBlockers.Count > 0)
        {
            return "Apply the supplier recovery playbook to clear the severe compliance blockers, then prepare the remediation draft again.";
        }

        if (Workflow.HighlightedSupplierIds.Count > 0)
        {
            return string.IsNullOrWhiteSpace(Workflow.LatestInsight)
                ? "Ask the agent to explain why the current suppliers are at risk, then prepare the remediation draft."
                : "Prepare a remediation draft for the highlighted suppliers when you are ready to cross the approval boundary.";
        }

        return "Start by identifying at-risk suppliers, then use the explanation and draft steps to complete the workflow.";
    }

    private string GetOutcomeSummary() =>
        string.IsNullOrWhiteSpace(Workflow.LatestInsight)
            ? "Run the at-risk capability to populate the workflow explanation."
            : Workflow.LatestInsight!;

    private Severity GetOutcomeSeverity()
    {
        if (Workflow.CurrentDraft is not null)
        {
            return Severity.Success;
        }

        if (Workflow.LatestDraftBlockers.Count > 0)
        {
            return Severity.Warning;
        }

        return Workflow.HighlightedSupplierIds.Count > 0
            ? Severity.Info
            : Severity.Normal;
    }

    private IReadOnlyList<string> GetBlockers()
    {
        if (Workflow.LatestDraftBlockers.Count > 0)
        {
            return Workflow.LatestDraftBlockers;
        }

        return Workflow.HighlightedSupplierIds.Count == 0
            ? ["No suppliers are currently in focus for remediation."]
            : [];
    }

    private IReadOnlyList<string> GetWarnings()
    {
        var warnings = new List<string>();

        if (Workflow.HighlightedSupplierIds.Count > 0 && string.IsNullOrWhiteSpace(Workflow.LatestInsight))
        {
            warnings.Add("The focused suppliers have not been explained yet, so the operator still lacks the semantic rationale for the current set.");
        }

        if (Workflow.HighlightedSupplierIds.Count > 0 && Workflow.CurrentDraft is null)
        {
            warnings.Add("The workflow has not crossed the approval boundary yet because no remediation draft has been prepared.");
        }

        if (Workflow.RecoveredSupplierIds.Count > 0 && Workflow.CurrentDraft is null)
        {
            warnings.Add("Recovery prerequisites have been staged, but the remediation draft still needs to be prepared.");
        }

        return warnings;
    }

    private IReadOnlyList<string> GetRecommendedActions()
    {
        if (Workflow.CurrentDraft is not null)
        {
            return
            [
                Workflow.IsRemediationDialogOpen
                    ? "Review the remediation draft actions in the dialog"
                    : "Reopen the remediation draft dialog",
                "Decide whether to approve the remediation batch"
            ];
        }

        if (Workflow.LatestDraftBlockers.Count > 0)
        {
            return
            [
                "Apply the supplier recovery playbook for the highlighted suppliers",
                "Prepare the remediation draft again once the blockers are cleared"
            ];
        }

        if (Workflow.HighlightedSupplierIds.Count > 0)
        {
            return
            [
                string.IsNullOrWhiteSpace(Workflow.LatestInsight)
                    ? "Explain why the current suppliers are at risk"
                    : "Prepare a remediation draft for the highlighted suppliers",
                "Review the approval boundary before mutating follow-up work"
            ];
        }

        return
        [
            "Identify at-risk suppliers for the current review window",
            "Use the explanation and draft steps to complete the workflow"
        ];
    }

    private void ApplyRouteHandoff()
    {
        if (!IsResponseOrchestrationHandoff)
        {
            return;
        }

        var handoffKey = $"{Source}|{Focus}|{ReturnTo}";
        if (string.Equals(handoffKey, _lastAppliedHandoffKey, StringComparison.Ordinal))
        {
            return;
        }

        _lastAppliedHandoffKey = handoffKey;

        switch (Focus?.Trim().ToLowerInvariant())
        {
            case "recovery":
                Workflow.FocusAtRiskSuppliers(30);
                Workflow.ExplainFocusedSuppliers();
                Workflow.PrepareRemediationDraft();
                break;
            case "remediation":
                Workflow.FocusAtRiskSuppliers(30);
                Workflow.ExplainFocusedSuppliers();
                break;
            default:
                Workflow.FocusAtRiskSuppliers(30);
                break;
        }
    }

    private string BuildReturnUri()
    {
        if (string.IsNullOrWhiteSpace(ReturnTo))
        {
            return "/demo/workflows/response-orchestration";
        }

        var separator = ReturnTo.Contains('?', StringComparison.Ordinal) ? "&" : "?";
        return $"{ReturnTo}{separator}returnedFrom=supplier&returnState={Uri.EscapeDataString(GetReturnState())}";
    }

    private string GetReturnState()
    {
        if (Workflow.CurrentDraft is not null)
        {
            return "draft-ready";
        }

        if (Workflow.LatestDraftBlockers.Count > 0)
        {
            return "recovery";
        }

        return Workflow.HighlightedSupplierIds.Count > 0
            ? "focused"
            : "idle";
    }

    private void HandleWorkflowChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Workflow.Changed -= HandleWorkflowChanged;
    }
}
