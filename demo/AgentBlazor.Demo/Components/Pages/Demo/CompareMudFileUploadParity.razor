@page "/demo/components/parity/file-upload"
@layout DemoLayout
@using AgentBlazor.Components
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

<PageTitle>MudFileUpload vs AgentFileUpload</PageTitle>

<div class="demo-doc-page">
    <MudPaper Elevation="1" Class="demo-doc-page__hero">
        <p class="demo-doc-page__eyebrow">Compatibility Proof</p>
        <MudText Typo="Typo.h5">MudFileUpload and AgentFileUpload side by side</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            This proof keeps the same multi-file binding, selected-file template, and accepted-file policy on both sides.
            The host still owns the selected files; the Agent version adds deterministic file actions on top.
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
            Use the page controls to load or clear the same evidence bundle in both uploads, then compare the rendered file list.
            The Agent upload can also respond to prompts like <code>list files</code> and <code>remove file vendor-checklist.csv</code>.
        </MudText>
    </MudPaper>

    <section class="demo-doc-page__section">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadBothEvidenceBundlesAsync">
                Load both evidence bundles
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ClearBothUploadsAsync">
                Clear both uploads
            </MudButton>
        </MudStack>
    </section>

    <section class="demo-doc-page__section">
        <MudGrid Spacing="2">
            <MudItem xs="12" xl="6">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.h6">MudFileUpload baseline</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Native MudBlazor multi-file upload with a host-owned selected-file template.
                    </MudText>

                    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                                   Files="@_mudFiles"
                                   FilesChanged="OnMudFilesChanged"
                                   Hidden="false"
                                   Accept=".pdf,.csv"
                                   AppendMultipleFiles="true">
                        <SelectedTemplate Context="files">
                            <MudStack Spacing="1">
                                @if (files is not null)
                                {
                                    foreach (var file in files)
                                    {
                                        <MudText Typo="Typo.body2">@file.Name</MudText>
                                    }
                                }
                            </MudStack>
                        </SelectedTemplate>
                    </MudFileUpload>

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Class="d-block">File count: @_mudFiles.Count</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" xl="6">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.h6">AgentFileUpload drop-in</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        The same binding and selected-file template, with agent metadata layered on top.
                    </MudText>

                    <AgentFileUpload T="IReadOnlyList<IBrowserFile>"
                                     AgentId="parity-agent-upload"
                                     Files="@_agentFiles"
                                     FilesChanged="OnAgentFilesChanged"
                                     Hidden="false"
                                     Accept=".pdf,.csv"
                                     AppendMultipleFiles="true">
                        <SelectedTemplate Context="files">
                            <MudStack Spacing="1">
                                @if (files is not null)
                                {
                                    foreach (var file in files)
                                    {
                                        <MudText Typo="Typo.body2">@file.Name</MudText>
                                    }
                                }
                            </MudStack>
                        </SelectedTemplate>
                    </AgentFileUpload>

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Class="d-block">File count: @_agentFiles.Count</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </section>
</div>

@code {
    private IReadOnlyList<IBrowserFile> _mudFiles = [];
    private IReadOnlyList<IBrowserFile> _agentFiles = [];

    private Task OnMudFilesChanged(IReadOnlyList<IBrowserFile>? files)
    {
        _mudFiles = files ?? [];
        return Task.CompletedTask;
    }

    private Task OnAgentFilesChanged(IReadOnlyList<IBrowserFile>? files)
    {
        _agentFiles = files ?? [];
        return Task.CompletedTask;
    }

    private Task LoadBothEvidenceBundlesAsync()
    {
        var bundle = CreateEvidenceBundle();
        _mudFiles = bundle;
        _agentFiles = CreateEvidenceBundle();
        return Task.CompletedTask;
    }

    private Task ClearBothUploadsAsync()
    {
        _mudFiles = [];
        _agentFiles = [];
        return Task.CompletedTask;
    }

    private static IReadOnlyList<IBrowserFile> CreateEvidenceBundle() =>
    [
        new DemoBrowserFile("q1-risk-summary.pdf", "application/pdf", 128_000),
        new DemoBrowserFile("vendor-checklist.csv", "text/csv", 24_000)
    ];

    private sealed class DemoBrowserFile(string name, string contentType, long size) : IBrowserFile
    {
        public string Name { get; } = name;

        public DateTimeOffset LastModified { get; } = DateTimeOffset.UtcNow;

        public long Size { get; } = size;

        public string ContentType { get; } = contentType;

        public Stream OpenReadStream(long maxAllowedSize = 512000, CancellationToken cancellationToken = default)
        {
            cancellationToken.ThrowIfCancellationRequested();
            return new MemoryStream();
        }
    }
}
