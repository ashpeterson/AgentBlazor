@page "/demo/generative-ui"
@layout DemoLayout
@using AgentBlazor.Components
@using MudBlazor

<PageTitle>Generative UI — AgentBlazor Demo</PageTitle>

<section class="gen-ui-demo">
    <header class="gen-ui-demo__header">
        <MudText Typo="Typo.h5">Generative UI Playground</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Generated blocks are backed by live workflow data from the demo database.
        </MudText>
    </header>

    <MudStack Row="true" Spacing="1" Class="mb-3">
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">
            Try: "show onboarding intake volume for the last 8 months"
        </MudChip>
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">
            Try: "show supplier risk by region as a chart"
        </MudChip>
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">
            Try: "create a supplier onboarding checklist card"
        </MudChip>
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">
            Then continue with generated actions to run follow-up steps
        </MudChip>
    </MudStack>

    <MudPaper Elevation="1" Class="pa-4 gen-ui-demo__chat">
        <AgentChatSurface Title="Generative UI Agent"
                          Description="Generated UI mode is enabled for this chat."
                          EnableGeneratedUi="true"
                          Placeholder="Ask for a generated summary, form draft, table, or live chart and continue with generated actions..." />
    </MudPaper>
</section>
