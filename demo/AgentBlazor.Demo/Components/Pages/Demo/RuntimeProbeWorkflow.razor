@page "/demo/workflows/runtime-probe"
@layout DemoLayout

<PageTitle>Runtime Probe</PageTitle>

<section class="wf-shell">
    <header class="wf-shell__hero">
        <p class="wf-shell__eyebrow">Runtime test</p>
        <h1>Runtime probe</h1>
        <p>
            Use this page to test cancel, approve, reconnect, and structured error recovery behavior.
        </p>
    </header>

    <div class="wf-shell__grid">
        <article class="wf-card wf-card--reference">
            <h2>Structured error recovery</h2>
            <ol class="wf-list">
                <li>Send: <code>run the structured error date range probe from 2026-05-10 to 2026-05-01</code></li>
                <li>Confirm the action returns <code>invalid_date_range</code>, not a raw exception.</li>
                <li>Confirm the recovery hint says to retry with an end date on or after the start date.</li>
            </ol>
        </article>
        <article class="wf-card">
            <h2>Cancel run</h2>
            <ol class="wf-list">
                <li>Send: <code>run the runtime cancellation probe</code></li>
                <li>Wait for the stop control</li>
                <li>Stop the run and confirm <code>Run canceled.</code></li>
            </ol>
        </article>
        <article class="wf-card">
            <h2>Approve action</h2>
            <ol class="wf-list">
                <li>Send: <code>run the runtime approval probe</code></li>
                <li>Approve the pending action</li>
                <li>Confirm <code>Runtime approval probe completed.</code></li>
            </ol>
        </article>
        <article class="wf-card">
            <h2>Reconnect</h2>
            <ol class="wf-list">
                <li>Send: <code>run the runtime reconnect probe</code></li>
                <li>Refresh while the run is active</li>
                <li>Confirm <code>Runtime reconnect probe completed.</code></li>
            </ol>
        </article>
    </div>
</section>

<style>
    .wf-shell {
        display: grid;
        gap: 1.5rem;
    }

    .wf-shell__hero,
    .wf-card {
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 1rem;
        padding: 1.25rem;
        background: rgba(8, 20, 32, 0.72);
    }

    .wf-card--reference {
        border-color: rgba(99, 232, 181, 0.42);
        background: linear-gradient(135deg, rgba(11, 73, 58, 0.78), rgba(8, 20, 32, 0.72));
    }

    .wf-shell__eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 0.75rem;
        opacity: 0.72;
        margin: 0 0 0.5rem 0;
    }

    .wf-shell__hero h1,
    .wf-card h2 {
        margin: 0 0 0.75rem 0;
    }

    .wf-shell__hero p,
    .wf-card li {
        margin: 0;
        line-height: 1.6;
    }

    .wf-shell__grid {
        display: grid;
    }

    .wf-list {
        display: grid;
        gap: 0.65rem;
        padding-left: 1.25rem;
        margin: 0;
    }
</style>
