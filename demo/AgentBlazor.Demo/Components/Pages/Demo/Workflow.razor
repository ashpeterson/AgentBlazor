@page "/demo/workflow"
@layout DemoLayout
@using System.ComponentModel.DataAnnotations
@using AgentBlazor.Components
@using AgentBlazor.Demo.Models
@using AgentBlazor.Demo.Services
@using MudBlazor
@inject SupplierWorkflowService WorkflowService
@inject ISnackbar Snackbar

<PageTitle>Workflow — AgentBlazor Demo</PageTitle>

<section>
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <div>
            <MudText Typo="Typo.h5">Complex Workflow</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Real-data workflow surface: onboarding queue, supplier risk operations, and generated UI charts.
            </MudText>
        </div>

        <MudButton Variant="Variant.Outlined"
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@_isLoading"
                   OnClick="ReloadAsync">
            Refresh
        </MudButton>
    </MudStack>

    <MudStack Row="true" Spacing="1" Class="mb-3">
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">
            Try: "sort onboarding requests by priority desc"
        </MudChip>
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">
            Try: "show only high risk suppliers"
        </MudChip>
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">
            Try: "show onboarding intake volume chart"
        </MudChip>
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">
            Try: "triage unhealthy services and draft a mitigation plan"
        </MudChip>
    </MudStack>

    @if (_lastMitigationResult is not null)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            Created mitigation task <strong>@_lastMitigationResult.TaskId</strong> for
            <strong>@_lastMitigationResult.SupplierName</strong> (owner: @_lastMitigationResult.Owner).
        </MudAlert>
    }

    <MudGrid Class="mb-3">
        <MudItem xs="12" sm="6" md="4" lg="2">
            <MudPaper Elevation="1" Class="pa-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Suppliers</MudText>
                <MudText Typo="Typo.h6">@_summary.TotalSuppliers</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <MudPaper Elevation="1" Class="pa-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">High Risk</MudText>
                <MudText Typo="Typo.h6" Color="Color.Error">@_summary.HighRiskSuppliers</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <MudPaper Elevation="1" Class="pa-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Open Onboarding</MudText>
                <MudText Typo="Typo.h6" Color="Color.Warning">@_summary.OpenOnboardingRequests</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <MudPaper Elevation="1" Class="pa-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Submitted This Month</MudText>
                <MudText Typo="Typo.h6" Color="Color.Success">@_summary.SubmittedThisMonth</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="4" lg="2">
            <MudPaper Elevation="1" Class="pa-3">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Open Mitigation</MudText>
                <MudText Typo="Typo.h6" Color="Color.Warning">@_summary.OpenMitigationTasks</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Elevation="1" Class="pa-4 mb-3">
        <AgentTabs AgentId="workflow-tabs">
                    <MudTabPanel Text="Onboarding Queue">
                        <AgentDataGrid TItem="OnboardingRequestRow"
                                       AgentId="workflow-intake-grid"
                                       Items="@_onboarding"
                                       Dense="true"
                                       Hover="true"
                                       Bordered="true"
                                       Striped="true"
                                       RowKeyProperty="RequestId"
                                       ColumnAliases="@_onboardingAliases">
                            <Columns>
                                <PropertyColumn T="OnboardingRequestRow" TProperty="string" Property="x => x.RequestId" Title="Request" />
                                <PropertyColumn T="OnboardingRequestRow" TProperty="string" Property="x => x.SupplierId" Title="Supplier ID" />
                                <PropertyColumn T="OnboardingRequestRow" TProperty="string" Property="x => x.SupplierName" Title="Supplier" />
                                <PropertyColumn T="OnboardingRequestRow" TProperty="string" Property="x => x.RiskTier" Title="Risk Tier" />
                                <PropertyColumn T="OnboardingRequestRow" TProperty="int" Property="x => x.Priority" Title="Priority" />
                                <PropertyColumn T="OnboardingRequestRow" TProperty="string" Property="x => x.Status" Title="Status" />
                                <PropertyColumn T="OnboardingRequestRow" TProperty="DateTime" Property="x => x.SubmittedUtc" Title="Submitted" Format="yyyy-MM-dd" />
                            </Columns>
                        </AgentDataGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Supplier Risk">
                        <AgentDataGrid TItem="SupplierRow"
                                       AgentId="workflow-supplier-grid"
                                       Items="@_suppliers"
                                       Dense="true"
                                       Hover="true"
                                       Bordered="true"
                                       Striped="true"
                                       RowKeyProperty="SupplierId"
                                       ColumnAliases="@_supplierAliases">
                            <Columns>
                                <PropertyColumn T="SupplierRow" TProperty="string" Property="x => x.SupplierId" Title="ID" />
                                <PropertyColumn T="SupplierRow" TProperty="string" Property="x => x.SupplierName" Title="Supplier" />
                                <PropertyColumn T="SupplierRow" TProperty="string" Property="x => x.Region" Title="Region" />
                                <PropertyColumn T="SupplierRow" TProperty="int" Property="x => x.RiskScore" Title="Risk Score" />
                                <PropertyColumn T="SupplierRow" TProperty="DateTime" Property="x => x.LastAuditDate" Title="Last Audit" Format="yyyy-MM-dd" />
                            </Columns>
                        </AgentDataGrid>
                    </MudTabPanel>

                    <MudTabPanel Text="Mitigation Tasks">
                        <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-2">
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Primary"
                                       OnClick="OpenMitigationDialogAsync">
                                Open Mitigation Dialog
                            </MudButton>
                        </MudStack>
                        <AgentDataGrid TItem="MitigationTaskRow"
                                       AgentId="workflow-mitigation-grid"
                                       Items="@_mitigationTasks"
                                       Dense="true"
                                       Hover="true"
                                       Bordered="true"
                                       Striped="true"
                                       RowKeyProperty="TaskId"
                                       ColumnAliases="@_mitigationAliases">
                            <Columns>
                                <PropertyColumn T="MitigationTaskRow" TProperty="string" Property="x => x.TaskId" Title="Task" />
                                <PropertyColumn T="MitigationTaskRow" TProperty="string" Property="x => x.SupplierId" Title="Supplier ID" />
                                <PropertyColumn T="MitigationTaskRow" TProperty="string" Property="x => x.SupplierName" Title="Supplier" />
                                <PropertyColumn T="MitigationTaskRow" TProperty="string" Property="x => x.ServiceName" Title="Service" />
                                <PropertyColumn T="MitigationTaskRow" TProperty="string" Property="x => x.Owner" Title="Owner" />
                                <PropertyColumn T="MitigationTaskRow" TProperty="int" Property="x => x.Priority" Title="Priority" />
                                <PropertyColumn T="MitigationTaskRow" TProperty="string" Property="x => x.Status" Title="Status" />
                                <PropertyColumn T="MitigationTaskRow" TProperty="DateTime" Property="x => x.DueDate" Title="Due" Format="yyyy-MM-dd" />
                                <PropertyColumn T="MitigationTaskRow" TProperty="DateTime" Property="x => x.CreatedUtc" Title="Created" Format="yyyy-MM-dd" />
                            </Columns>
                        </AgentDataGrid>
                    </MudTabPanel>
        </AgentTabs>
    </MudPaper>

    <AgentDialog @ref="_mitigationDialog"
                 AgentId="workflow-mitigation-dialog"
                 Visible="@_mitigationDialogVisible"
                 VisibleChanged="OnMitigationDialogVisibleChanged">
        <TitleContent>
            <MudText Typo="Typo.h6">Create Mitigation Task</MudText>
        </TitleContent>
        <DialogContent>
            <AgentForm AgentId="workflow-mitigation-form"
                       Model="@_mitigationModel"
                       Submitted="OnMitigationSubmittedAsync">
                <ChildContent Context="formContext">
                    <DataAnnotationsValidator />
                    <MudTextField T="string"
                                  Label="Supplier ID"
                                  For="@(() => _mitigationModel.SupplierId)"
                                  @bind-Value="_mitigationModel.SupplierId" />
                    <MudTextField T="string"
                                  Label="Supplier name"
                                  For="@(() => _mitigationModel.SupplierName)"
                                  @bind-Value="_mitigationModel.SupplierName" />
                    <MudTextField T="string"
                                  Label="Service name"
                                  For="@(() => _mitigationModel.ServiceName)"
                                  @bind-Value="_mitigationModel.ServiceName" />
                    <MudTextField T="string"
                                  Label="Owner"
                                  For="@(() => _mitigationModel.Owner)"
                                  @bind-Value="_mitigationModel.Owner" />
                    <MudTextField T="string"
                                  Label="Mitigation action"
                                  Lines="3"
                                  For="@(() => _mitigationModel.MitigationAction)"
                                  @bind-Value="_mitigationModel.MitigationAction" />
                    <MudNumericField T="int"
                                     Label="Priority (1-5)"
                                     For="@(() => _mitigationModel.Priority)"
                                     @bind-Value="_mitigationModel.Priority" />
                    <MudDatePicker Label="Due date"
                                   For="@(() => _mitigationModel.DueDate)"
                                   @bind-Date="_mitigationModel.DueDate" />
                    <MudStack Row="true" Justify="Justify.FlexEnd">
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary">
                            Submit Mitigation Task
                        </MudButton>
                    </MudStack>
                </ChildContent>
            </AgentForm>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text"
                       Color="Color.Secondary"
                       OnClick="CloseMitigationDialogAsync">
                Close
            </MudButton>
        </DialogActions>
    </AgentDialog>

    <div style="display:none" aria-hidden="true">
        <AgentForm AgentId="workflow-mitigation-runtime-form"
                   Model="@_mitigationModel"
                   Submitted="OnMitigationSubmittedAsync">
            <ChildContent Context="formContext">
                <DataAnnotationsValidator />
            </ChildContent>
        </AgentForm>
    </div>
</section>

@code {
    private WorkflowSummary _summary = new(0, 0, 0, 0, 0);
    private List<OnboardingRequestRow> _onboarding = [];
    private List<SupplierRow> _suppliers = [];
    private List<MitigationTaskRow> _mitigationTasks = [];
    private AgentDialog? _mitigationDialog;
    private bool _mitigationDialogVisible;
    private MitigationTaskModel _mitigationModel = new();
    private MitigationTaskResult? _lastMitigationResult;
    private bool _isLoading;

    private static readonly IReadOnlyDictionary<string, string> _onboardingAliases =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["request"] = nameof(OnboardingRequestRow.RequestId),
            ["supplier"] = nameof(OnboardingRequestRow.SupplierName),
            ["risk"] = nameof(OnboardingRequestRow.RiskTier),
            ["priority"] = nameof(OnboardingRequestRow.Priority),
            ["status"] = nameof(OnboardingRequestRow.Status),
            ["submitted"] = nameof(OnboardingRequestRow.SubmittedUtc)
        };

    private static readonly IReadOnlyDictionary<string, string> _supplierAliases =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["id"] = nameof(SupplierRow.SupplierId),
            ["supplier"] = nameof(SupplierRow.SupplierName),
            ["region"] = nameof(SupplierRow.Region),
            ["risk"] = nameof(SupplierRow.RiskScore),
            ["audit"] = nameof(SupplierRow.LastAuditDate)
        };

    private static readonly IReadOnlyDictionary<string, string> _mitigationAliases =
        new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["task"] = nameof(MitigationTaskRow.TaskId),
            ["supplier"] = nameof(MitigationTaskRow.SupplierName),
            ["supplier id"] = nameof(MitigationTaskRow.SupplierId),
            ["service"] = nameof(MitigationTaskRow.ServiceName),
            ["owner"] = nameof(MitigationTaskRow.Owner),
            ["priority"] = nameof(MitigationTaskRow.Priority),
            ["status"] = nameof(MitigationTaskRow.Status),
            ["due"] = nameof(MitigationTaskRow.DueDate)
        };

    protected override async Task OnInitializedAsync()
    {
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _isLoading = true;
        try
        {
            _summary = await WorkflowService.GetWorkflowSummaryAsync(CancellationToken.None);
            _onboarding = (await WorkflowService.ListOnboardingRequestsAsync(CancellationToken.None)).ToList();
            _suppliers = (await WorkflowService.ListSuppliersAsync(CancellationToken.None)).ToList();
            _mitigationTasks = (await WorkflowService.ListMitigationTasksAsync(CancellationToken.None)).ToList();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task OpenMitigationDialogAsync() =>
        _mitigationDialog?.OpenAsync() ?? Task.CompletedTask;

    private Task CloseMitigationDialogAsync() =>
        _mitigationDialog?.CloseAsync() ?? Task.CompletedTask;

    private Task OnMitigationDialogVisibleChanged(bool visible)
    {
        return InvokeAsync(() =>
        {
            _mitigationDialogVisible = visible;
            StateHasChanged();
        });
    }

    private async Task OnMitigationSubmittedAsync()
    {
        var submission = new MitigationTaskSubmission(
            _mitigationModel.SupplierId,
            _mitigationModel.SupplierName,
            _mitigationModel.ServiceName,
            _mitigationModel.Owner,
            _mitigationModel.MitigationAction,
            _mitigationModel.Priority,
            _mitigationModel.DueDate ?? DateTime.UtcNow.Date.AddDays(7));

        var result = await WorkflowService.CreateMitigationTaskAsync(submission, CancellationToken.None);
        _lastMitigationResult = result;
        Snackbar.Add(
            $"Created mitigation task {result.TaskId} for {result.SupplierName}.",
            Severity.Success);

        _mitigationModel = new MitigationTaskModel();
        await CloseMitigationDialogAsync();
        await ReloadAsync();
    }

    private sealed class MitigationTaskModel
    {
        [Required]
        public string SupplierId { get; set; } = string.Empty;

        [Required]
        public string SupplierName { get; set; } = string.Empty;

        [Required]
        public string ServiceName { get; set; } = "Supplier Risk Monitoring";

        [Required]
        public string Owner { get; set; } = "Ops Lead";

        [Required]
        [StringLength(500)]
        public string MitigationAction { get; set; } = string.Empty;

        [Range(1, 5)]
        public int Priority { get; set; } = 1;

        [Required]
        public DateTime? DueDate { get; set; } = DateTime.UtcNow.Date.AddDays(7);
    }
}
