@page "/demo/onboarding"
@layout DemoLayout
@using System.ComponentModel.DataAnnotations
@using AgentBlazor.Demo.Services
@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor
@inherits AgentFormPageBase<SupplierOnboardingModel>
@inject SupplierWorkflowService WorkflowService
@inject ISnackbar Snackbar

<PageTitle>Supplier Onboarding — AgentBlazor Demo</PageTitle>

<div class="demo-doc-page onboarding-page">
    <MudPaper Elevation="1" Class="demo-doc-page__hero">
        <p class="demo-doc-page__eyebrow">Form Automation</p>
        <MudText Typo="Typo.h5">Supplier Onboarding Workflow</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            The page inherits from <code class="demo-code">AgentFormPageBase&lt;TModel&gt;</code>,
            so form actions are generated directly from model fields.
        </MudText>
        <div class="demo-doc-page__toc">
            <a class="demo-doc-page__toc-link" href="#prompt-set">Prompt Set</a>
            <a class="demo-doc-page__toc-link" href="#dialog">Dialog + Form</a>
            <a class="demo-doc-page__toc-link" href="#result">Last Submission</a>
        </div>
    </MudPaper>

    <section id="prompt-set" class="demo-doc-page__section">
        <div class="demo-doc-page__section-head">
            <MudText Typo="Typo.h6">Prompt Set</MudText>
        </div>
        <div class="demo-doc-page__prompt-box">
            <ul class="demo-doc-page__prompt-list">
                <li><span class="demo-doc-page__prompt-code">open the onboarding form</span></li>
                <li><span class="demo-doc-page__prompt-code">onboard Apex Components from Germany, high risk tier, priority 2</span></li>
            </ul>
        </div>
    </section>

    <section id="dialog" class="demo-doc-page__section">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenDialogAsync">
            Open Onboarding Dialog
        </MudButton>
    </section>

    <section id="result" class="demo-doc-page__section">
        @if (_lastSubmission is not null)
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true">
                Submitted <strong>@_lastSubmission.RequestId</strong> and created supplier
                <strong>@_lastSubmission.SupplierId</strong> with computed risk score
                <strong>@_lastSubmission.RiskScore</strong>.
            </MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                No submission yet. Run a prompt or open the dialog and submit.
            </MudText>
        }
    </section>

    <MudDialog @bind-Visible="DialogVisible">
        <TitleContent>
            <MudText Typo="Typo.h6">New Supplier</MudText>
        </TitleContent>
        <DialogContent>
            <EditForm EditContext="_editContext" OnValidSubmit="OnSubmittedAsync">
                <DataAnnotationsValidator />
                <MudTextField T="string"
                              Label="Supplier name"
                              For="@(() => Model.SupplierName)"
                              @bind-Value="Model.SupplierName" />
                <MudTextField T="string"
                              Label="Contact email"
                              For="@(() => Model.ContactEmail)"
                              @bind-Value="Model.ContactEmail" />
                <MudTextField T="string"
                              Label="Contact phone"
                              For="@(() => Model.ContactPhone)"
                              @bind-Value="Model.ContactPhone" />
                <MudTextField T="string"
                              Label="Risk tier"
                              For="@(() => Model.RiskTier)"
                              @bind-Value="Model.RiskTier" />
                <MudTextField T="string"
                              Label="Country"
                              For="@(() => Model.Country)"
                              @bind-Value="Model.Country" />
                <MudTextField T="string"
                              Label="Category"
                              For="@(() => Model.Category)"
                              @bind-Value="Model.Category" />
                <MudTextField T="string"
                              Label="Payment terms"
                              For="@(() => Model.PaymentTerms)"
                              @bind-Value="Model.PaymentTerms" />
                <MudTextField T="string"
                              Label="Preferred currency"
                              For="@(() => Model.PreferredCurrency)"
                              @bind-Value="Model.PreferredCurrency" />
                <MudNumericField T="decimal"
                                 Label="Requested budget"
                                 For="@(() => Model.RequestedBudget)"
                                 @bind-Value="Model.RequestedBudget"
                                 Adornment="Adornment.End"
                                 AdornmentText="USD" />
                <MudNumericField T="decimal"
                                 Label="Expected monthly spend"
                                 For="@(() => Model.ExpectedMonthlySpend)"
                                 @bind-Value="Model.ExpectedMonthlySpend"
                                 Adornment="Adornment.End"
                                 AdornmentText="USD" />
                <MudNumericField T="int"
                                 Label="Priority (1-5)"
                                 For="@(() => Model.Priority)"
                                 @bind-Value="Model.Priority" />
                <MudCheckBox T="bool"
                             Label="Sanctions screened"
                             For="@(() => Model.SanctionsScreened)"
                             @bind-Value="Model.SanctionsScreened" />
                <MudCheckBox T="bool"
                             Label="NDA required"
                             For="@(() => Model.NdaRequired)"
                             @bind-Value="Model.NdaRequired" />
                <MudTextField T="string"
                              Label="Notes"
                              Lines="2"
                              For="@(() => Model.Notes)"
                              @bind-Value="Model.Notes" />
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary">
                        Submit Onboarding
                    </MudButton>
                </MudStack>
            </EditForm>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseDialogAsync">
                Close
            </MudButton>
        </DialogActions>
    </MudDialog>
</div>

@code {
    private EditContext? _editContext;
    private SupplierOnboardingResult? _lastSubmission;

    // Required by AgentFormPageBase<TModel>
    protected override string AgentIdValue => "supplier-onboarding";
    protected override string FormDisplayName => "Supplier Onboarding";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _editContext = new EditContext(Model);
    }

    // -------------------------------------------------------------------------
    // UI Event Handlers
    // -------------------------------------------------------------------------

    private Task OpenDialogAsync()
    {
        DialogVisible = true;
        return Task.CompletedTask;
    }

    private Task CloseDialogAsync()
    {
        DialogVisible = false;
        return Task.CompletedTask;
    }

    private async Task OnSubmittedAsync()
    {
        var submission = new SupplierOnboardingSubmission(
            Model.SupplierName,
            Model.ContactEmail,
            Model.ContactPhone,
            Model.RiskTier,
            Model.Country,
            Model.Category,
            Model.PaymentTerms,
            Model.PreferredCurrency,
            Model.RequestedBudget,
            Model.ExpectedMonthlySpend,
            Model.Priority,
            Model.SanctionsScreened,
            Model.NdaRequired,
            Model.Notes);

        var result = await WorkflowService.SubmitOnboardingAsync(submission, CancellationToken.None);
        _lastSubmission = result;
        Snackbar.Add(
            $"Submitted {result.RequestId} and created supplier {result.SupplierId} (risk score {result.RiskScore}).",
            Severity.Success);

        ResetForm();
        _editContext = new EditContext(Model);
        DialogVisible = false;
    }
}
