@page "/demo/onboarding"
@layout DemoLayout
@using System.ComponentModel.DataAnnotations
@using AgentBlazor.Components
@using MudBlazor

<PageTitle>Supplier Onboarding — AgentBlazor Demo</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Supplier Onboarding</MudText>

<MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenDialogAsync">
    Open Onboarding Dialog
</MudButton>

<AgentDialog @ref="_dialog"
             AgentId="supplier-onboarding-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">New Supplier</MudText>
    </TitleContent>
    <DialogContent>
        <AgentForm AgentId="supplier-onboarding-form"
                   Model="@_model"
                   Submitted="OnSubmitted">
            <ChildContent Context="formContext">
                <DataAnnotationsValidator />
                <MudTextField T="string"
                              Label="Supplier name"
                              For="@(() => _model.SupplierName)"
                              @bind-Value="_model.SupplierName" />
                <MudTextField T="string"
                              Label="Contact email"
                              For="@(() => _model.ContactEmail)"
                              @bind-Value="_model.ContactEmail" />
                <MudTextField T="string"
                              Label="Risk tier"
                              For="@(() => _model.RiskTier)"
                              @bind-Value="_model.RiskTier" />
                <MudNumericField T="decimal"
                                 Label="Requested budget"
                                 For="@(() => _model.RequestedBudget)"
                                 @bind-Value="_model.RequestedBudget"
                                 Adornment="Adornment.End"
                                 AdornmentText="USD" />
            </ChildContent>
        </AgentForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseDialogAsync">
            Close
        </MudButton>
    </DialogActions>
</AgentDialog>

<AgentChatWidget Title="Onboarding Agent"
                 Description="Ask me to open the form or fill in supplier details." />

@code {
    private AgentDialog? _dialog;
    private readonly SupplierOnboardingModel _model = new();

    private Task OpenDialogAsync() => _dialog?.OpenAsync() ?? Task.CompletedTask;

    private Task CloseDialogAsync() => _dialog?.CloseAsync() ?? Task.CompletedTask;

    private Task OnSubmitted() => CloseDialogAsync();

    private sealed class SupplierOnboardingModel
    {
        [Required]
        public string SupplierName { get; set; } = string.Empty;

        [Required, EmailAddress]
        public string ContactEmail { get; set; } = string.Empty;

        [Required]
        public string RiskTier { get; set; } = string.Empty;

        [Range(typeof(decimal), "0.01", "1000000000")]
        public decimal RequestedBudget { get; set; }
    }
}
