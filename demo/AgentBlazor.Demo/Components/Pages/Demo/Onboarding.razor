@page "/demo/onboarding"
@layout DemoLayout
@using System.ComponentModel.DataAnnotations
@using AgentBlazor.Components
@using AgentBlazor.Demo.Services
@using MudBlazor
@inject SupplierWorkflowService WorkflowService
@inject ISnackbar Snackbar

<PageTitle>Supplier Onboarding — AgentBlazor Demo</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Supplier Onboarding</MudText>

<MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenDialogAsync">
    Open Onboarding Dialog
</MudButton>

@if (_lastSubmission is not null)
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mt-3">
        Submitted <strong>@_lastSubmission.RequestId</strong> and created supplier
        <strong>@_lastSubmission.SupplierId</strong> with computed risk score
        <strong>@_lastSubmission.RiskScore</strong>.
    </MudAlert>
}

<AgentDialog @ref="_dialog"
             AgentId="supplier-onboarding-dialog">
    <TitleContent>
        <MudText Typo="Typo.h6">New Supplier</MudText>
    </TitleContent>
    <DialogContent>
        <AgentForm AgentId="supplier-onboarding-form"
                   Model="@_model"
                   Submitted="OnSubmitted">
            <ChildContent Context="formContext">
                <DataAnnotationsValidator />
                <MudTextField T="string"
                              Label="Supplier name"
                              For="@(() => _model.SupplierName)"
                              @bind-Value="_model.SupplierName" />
                <MudTextField T="string"
                              Label="Contact email"
                              For="@(() => _model.ContactEmail)"
                              @bind-Value="_model.ContactEmail" />
                <MudTextField T="string"
                              Label="Contact phone"
                              For="@(() => _model.ContactPhone)"
                              @bind-Value="_model.ContactPhone" />
                <MudTextField T="string"
                              Label="Risk tier"
                              For="@(() => _model.RiskTier)"
                              @bind-Value="_model.RiskTier" />
                <MudTextField T="string"
                              Label="Country"
                              For="@(() => _model.Country)"
                              @bind-Value="_model.Country" />
                <MudTextField T="string"
                              Label="Category"
                              For="@(() => _model.Category)"
                              @bind-Value="_model.Category" />
                <MudTextField T="string"
                              Label="Payment terms"
                              For="@(() => _model.PaymentTerms)"
                              @bind-Value="_model.PaymentTerms" />
                <MudTextField T="string"
                              Label="Preferred currency"
                              For="@(() => _model.PreferredCurrency)"
                              @bind-Value="_model.PreferredCurrency" />
                <MudNumericField T="decimal"
                                 Label="Requested budget"
                                 For="@(() => _model.RequestedBudget)"
                                 @bind-Value="_model.RequestedBudget"
                                 Adornment="Adornment.End"
                                 AdornmentText="USD" />
                <MudNumericField T="decimal"
                                 Label="Expected monthly spend"
                                 For="@(() => _model.ExpectedMonthlySpend)"
                                 @bind-Value="_model.ExpectedMonthlySpend"
                                 Adornment="Adornment.End"
                                 AdornmentText="USD" />
                <MudNumericField T="int"
                                 Label="Priority (1-5)"
                                 For="@(() => _model.Priority)"
                                 @bind-Value="_model.Priority" />
                <MudCheckBox T="bool"
                             Label="Sanctions screened"
                             For="@(() => _model.SanctionsScreened)"
                             @bind-Value="_model.SanctionsScreened" />
                <MudCheckBox T="bool"
                             Label="NDA required"
                             For="@(() => _model.NdaRequired)"
                             @bind-Value="_model.NdaRequired" />
                <MudTextField T="string"
                              Label="Notes"
                              Lines="2"
                              For="@(() => _model.Notes)"
                              @bind-Value="_model.Notes" />
                <MudStack Row="true" Justify="Justify.FlexEnd">
                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary">
                        Submit Onboarding
                    </MudButton>
                </MudStack>
            </ChildContent>
        </AgentForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseDialogAsync">
            Close
        </MudButton>
    </DialogActions>
</AgentDialog>

@code {
    private AgentDialog? _dialog;
    private SupplierOnboardingModel _model = new();
    private SupplierOnboardingResult? _lastSubmission;

    private Task OpenDialogAsync() => _dialog?.Open() ?? Task.CompletedTask;

    private Task CloseDialogAsync() => _dialog?.Close() ?? Task.CompletedTask;

    private async Task OnSubmitted()
    {
        var submission = new SupplierOnboardingSubmission(
            _model.SupplierName,
            _model.ContactEmail,
            _model.ContactPhone,
            _model.RiskTier,
            _model.Country,
            _model.Category,
            _model.PaymentTerms,
            _model.PreferredCurrency,
            _model.RequestedBudget,
            _model.ExpectedMonthlySpend,
            _model.Priority,
            _model.SanctionsScreened,
            _model.NdaRequired,
            _model.Notes);

        var result = await WorkflowService.SubmitOnboardingAsync(submission, CancellationToken.None);
        _lastSubmission = result;
        Snackbar.Add(
            $"Submitted {result.RequestId} and created supplier {result.SupplierId} (risk score {result.RiskScore}).",
            Severity.Success);

        _model = new SupplierOnboardingModel();
        await CloseDialogAsync();
    }

    private sealed class SupplierOnboardingModel
    {
        [Required]
        public string SupplierName { get; set; } = string.Empty;

        [Required, EmailAddress]
        public string ContactEmail { get; set; } = string.Empty;

        [Phone]
        public string ContactPhone { get; set; } = string.Empty;

        [Required]
        public string RiskTier { get; set; } = string.Empty;

        [Required]
        public string Country { get; set; } = string.Empty;

        [Required]
        public string Category { get; set; } = string.Empty;

        [Required]
        public string PaymentTerms { get; set; } = string.Empty;

        [Required]
        public string PreferredCurrency { get; set; } = "USD";

        [Range(typeof(decimal), "0.01", "1000000000")]
        public decimal RequestedBudget { get; set; }

        [Range(typeof(decimal), "0", "1000000000")]
        public decimal ExpectedMonthlySpend { get; set; }

        [Range(1, 5)]
        public int Priority { get; set; } = 3;

        public bool SanctionsScreened { get; set; }

        public bool NdaRequired { get; set; }

        [StringLength(500)]
        public string Notes { get; set; } = string.Empty;
    }
}
