@page "/demo/components/parity/date-pickers"
@layout DemoLayout
@using AgentBlazor.Components
@using MudBlazor

<PageTitle>MudDatePicker and MudDateRangePicker vs Agent equivalents</PageTitle>

<div class="demo-doc-page">
    <MudPaper Elevation="1" Class="demo-doc-page__hero">
        <p class="demo-doc-page__eyebrow">Compatibility Proof</p>
        <MudText Typo="Typo.h5">MudDatePicker and MudDateRangePicker side by side with Agent equivalents</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            This proof page keeps the same host-owned date bounds and selected values across both versions.
            The host still owns the chosen dates; the Agent versions add deterministic date actions on top.
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
            Use the page controls to seed or clear both pickers together, then compare the visible values.
            The Agent controls also support prompts like <code>set review date to 2026-03-18</code> and
            <code>set review range from 2026-03-20 to 2026-03-24</code>.
        </MudText>
    </MudPaper>

    <section class="demo-doc-page__section">
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SetBothReviewDatesAsync">
                Set both review dates
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="ClearBothReviewDatesAsync">
                Clear both review dates
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="SetBothReviewRangesAsync">
                Set both review ranges
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="ClearBothReviewRangesAsync">
                Clear both review ranges
            </MudButton>
        </MudStack>
    </section>

    <section class="demo-doc-page__section">
        <MudText Typo="Typo.h6" Class="mb-2">Shared single-date composition</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" xl="6">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.h6">MudDatePicker baseline</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Native MudBlazor date picker with host-owned value and bounds.
                    </MudText>

                    <MudDatePicker Label="Review date"
                                   Date="@_mudReviewDate"
                                   DateChanged="OnMudReviewDateChanged"
                                   MinDate="@_minReviewDate"
                                   MaxDate="@_maxReviewDate" />

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Class="d-block">Review date: @FormatDate(_mudReviewDate)</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" xl="6">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.h6">AgentDatePicker drop-in</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        The same date-picker surface with agent metadata layered on top.
                    </MudText>

                    <AgentDatePicker AgentId="parity-agent-date-picker"
                                     Label="Review date"
                                     Value="@_agentReviewDate"
                                     ValueChanged="OnAgentReviewDateChanged"
                                     MinDate="@_minReviewDate"
                                     MaxDate="@_maxReviewDate" />

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Class="d-block">Review date: @FormatDate(_agentReviewDate)</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </section>

    <section class="demo-doc-page__section">
        <MudText Typo="Typo.h6" Class="mb-2">Shared range-date composition</MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" xl="6">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.h6">MudDateRangePicker baseline</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Native MudBlazor range picker with host-owned selected range and bounds.
                    </MudText>

                    <MudDateRangePicker Label="Review range"
                                        DateRange="@_mudReviewRange"
                                        DateRangeChanged="OnMudReviewRangeChanged"
                                        MinDate="@_minReviewDate"
                                        MaxDate="@_maxReviewDate" />

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Class="d-block">Range: @FormatRange(_mudReviewRange)</MudText>
                </MudPaper>
            </MudItem>

            <MudItem xs="12" xl="6">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.h6">AgentDateRangePicker drop-in</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        The same range surface with agent metadata and deterministic range actions layered on top.
                    </MudText>

                    <AgentDateRangePicker AgentId="parity-agent-date-range-picker"
                                          Label="Review range"
                                          StartDate="@_agentRangeStart"
                                          StartDateChanged="OnAgentRangeStartChanged"
                                          EndDate="@_agentRangeEnd"
                                          EndDateChanged="OnAgentRangeEndChanged"
                                          MinDate="@_minReviewDate"
                                          MaxDate="@_maxReviewDate" />

                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Class="d-block">Range: @FormatRange(new DateRange(_agentRangeStart, _agentRangeEnd))</MudText>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </section>
</div>

@code {
    private readonly DateTime _minReviewDate = new(2026, 3, 10);
    private readonly DateTime _maxReviewDate = new(2026, 3, 31);

    private DateTime? _mudReviewDate = new(2026, 3, 14);
    private DateTime? _agentReviewDate = new(2026, 3, 14);
    private DateRange _mudReviewRange = new(new DateTime(2026, 3, 14), new DateTime(2026, 3, 18));
    private DateTime? _agentRangeStart = new(2026, 3, 14);
    private DateTime? _agentRangeEnd = new(2026, 3, 18);

    private Task OnMudReviewDateChanged(DateTime? value)
    {
        _mudReviewDate = value;
        return Task.CompletedTask;
    }

    private Task OnAgentReviewDateChanged(DateTime? value)
    {
        _agentReviewDate = value;
        return Task.CompletedTask;
    }

    private Task OnMudReviewRangeChanged(DateRange value)
    {
        _mudReviewRange = value;
        return Task.CompletedTask;
    }

    private Task OnAgentRangeStartChanged(DateTime? value)
    {
        _agentRangeStart = value;
        return Task.CompletedTask;
    }

    private Task OnAgentRangeEndChanged(DateTime? value)
    {
        _agentRangeEnd = value;
        return Task.CompletedTask;
    }

    private Task SetBothReviewDatesAsync()
    {
        _mudReviewDate = new DateTime(2026, 3, 18);
        _agentReviewDate = new DateTime(2026, 3, 18);
        return Task.CompletedTask;
    }

    private Task ClearBothReviewDatesAsync()
    {
        _mudReviewDate = null;
        _agentReviewDate = null;
        return Task.CompletedTask;
    }

    private Task SetBothReviewRangesAsync()
    {
        _mudReviewRange = new DateRange(new DateTime(2026, 3, 20), new DateTime(2026, 3, 24));
        _agentRangeStart = new DateTime(2026, 3, 20);
        _agentRangeEnd = new DateTime(2026, 3, 24);
        return Task.CompletedTask;
    }

    private Task ClearBothReviewRangesAsync()
    {
        _mudReviewRange = new DateRange(null, null);
        _agentRangeStart = null;
        _agentRangeEnd = null;
        return Task.CompletedTask;
    }

    private static string FormatDate(DateTime? value) =>
        value?.ToString("yyyy-MM-dd") ?? "None";

    private static string FormatRange(DateRange? range) =>
        $"{FormatDate(range?.Start)} to {FormatDate(range?.End)}";
}
