@page "/demo/dojo"
@layout DemoLayout
@using AgentBlazor
@using AgentBlazor.Attributes
@using AgentBlazor.Components
@using AgentBlazor.Components.Chat
@using AgentBlazor.Core.Components
@using AgentBlazor.Core.Runtime.Agents
@using AgentBlazor.Runtime
@using AgentBlazor.Demo.Services
@using MudBlazor
@inherits AgentFormPageBase<DojoRecipeModel>
@inject ISnackbar Snackbar
@inject DojoWorkspaceService WorkspaceService
@inject DojoExperienceState DojoExperience

<PageTitle>Dojo Workspace — AgentBlazor Demo</PageTitle>

<AgentToolRender ToolId="AgentForm.submit">
    <InProgress Context="_">
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
            Gathering submit parameters...
        </MudAlert>
    </InProgress>
    <Executing Context="_">
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
            Running tool invocation...
        </MudAlert>
    </Executing>
    <Complete Context="ctx">
        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-2">
            Tool completed: @ctx.Result
        </MudAlert>
    </Complete>
    <Failed Context="ctx">
        <MudAlert Severity="Severity.Error" Dense="true" Class="mb-2">
            Tool failed: @ctx.Result
        </MudAlert>
    </Failed>
</AgentToolRender>

<div class="dojo-workspace">
    <MudPaper Elevation="0" Class="dojo-workspace__rail">
        <MudText Typo="Typo.subtitle1">AG-UI Interactive Dojo</MudText>

        <section class="dojo-workspace__rail-section">
            <p class="dojo-workspace__rail-label">Integrations</p>
            <MudSelect T="string" Value="@_selectedIntegration" ValueChanged="OnIntegrationChanged" Dense="true" Variant="Variant.Outlined">
                <MudSelectItem T="string" Value="@("Microsoft Agent Framework (.NET)")">Microsoft Agent Framework (.NET)</MudSelectItem>
            </MudSelect>
        </section>

        <section class="dojo-workspace__rail-section">
            <p class="dojo-workspace__rail-label">View</p>
            <div class="dojo-workspace__view-toggle">
                <button type="button"
                        class="dojo-workspace__view-button @(IsViewMode(DojoViewMode.Preview) ? "is-active" : null)"
                        @onclick="() => SetViewMode(DojoViewMode.Preview)">
                    Preview
                </button>
                <button type="button"
                        class="dojo-workspace__view-button @(IsViewMode(DojoViewMode.Code) ? "is-active" : null)"
                        @onclick="() => SetViewMode(DojoViewMode.Code)">
                    Code
                </button>
                <button type="button"
                        class="dojo-workspace__view-button @(IsViewMode(DojoViewMode.Docs) ? "is-active" : null)"
                        @onclick="() => SetViewMode(DojoViewMode.Docs)">
                    Docs
                </button>
            </div>
        </section>

        <section class="dojo-workspace__rail-section">
            <p class="dojo-workspace__rail-label">Demos</p>
            <div class="dojo-workspace__demo-list">
                @foreach (var example in _examples)
                {
                    <button type="button"
                            class="dojo-workspace__demo-item @(IsSelectedExample(example.Key) ? "is-active" : null)"
                            @onclick="() => SelectExample(example.Key)">
                        <span class="dojo-workspace__demo-title">@example.Title</span>
                        <span class="dojo-workspace__demo-description">@example.Description</span>
                        <span class="dojo-workspace__demo-tags">
                            @foreach (var tag in example.Tags)
                            {
                                <span>@tag</span>
                            }
                        </span>
                    </button>
                }
            </div>
        </section>
    </MudPaper>

    <div class="dojo-workspace__main">
        @if (_viewMode == DojoViewMode.Preview)
        {
            @if (IsExample("agentic-chat"))
            {
                <MudPaper Elevation="1" Class="dojo-canvas dojo-canvas--chat" Style="@BackgroundCanvasStyle">
                    <div class="dojo-canvas__prompt-pill">@_backgroundStudioUserPrompt</div>

                    <div class="dojo-canvas__center-copy">
                        <MudText Typo="Typo.h4">@_backgroundStudioHeadline</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@_backgroundStudioBody</MudText>
                    </div>

                    <div class="dojo-canvas__suggestions">
                        @foreach (var suggestion in _backgroundStudioSuggestions)
                        {
                            <span>@suggestion</span>
                        }
                    </div>

                    <div class="dojo-canvas__chat-shell">
                        <AgentChatSurface FormName="dojo-chat-agentic"
                                          DefaultAgentName="Dojo Workspace Agent"
                                          ShowAgentSelector="false"
                                          LockAgentToCurrentRoute="true"
                                          SessionId="@WorkspaceSessionId"
                                          Placeholder="Change the background color, update the title, or ask what components are mounted."
                                          Theme="_dojoChatTheme"
                                          CssClass="dojo-embedded-chat" />
                    </div>
                </MudPaper>
            }
            else if (IsExample("backend-tool-rendering"))
            {
                <MudPaper Elevation="1" Class="dojo-canvas dojo-canvas--chat">
                    <div class="dojo-canvas__center-copy dojo-canvas__center-copy--compact">
                        <MudText Typo="Typo.h5">Backend Tool Rendering</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Submit the backend action below or ask the assistant to do it for you. Tool lifecycle events stream into the chat and run notes.
                        </MudText>
                    </div>

                    <MudPaper Elevation="0" Class="dojo-backend-panel">
                        <AgentForm AgentId="dojo-backend-tool-form"
                                   Model="@_backendToolModel"
                                   Submitted="OnBackendToolSubmittedAsync">
                            <ChildContent Context="_">
                                <DataAnnotationsValidator />
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" md="5">
                                        <MudTextField T="string"
                                                      Label="Action Label"
                                                      For="@(() => _backendToolModel.ActionLabel)"
                                                      @bind-Value="_backendToolModel.ActionLabel" />
                                    </MudItem>
                                    <MudItem xs="12" md="4">
                                        <MudTextField T="string"
                                                      Label="Operator"
                                                      For="@(() => _backendToolModel.Operator)"
                                                      @bind-Value="_backendToolModel.Operator" />
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   ButtonType="ButtonType.Submit"
                                                   FullWidth="true"
                                                   Class="dojo-backend-panel__submit">
                                            Submit Tool
                                        </MudButton>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string"
                                                      Label="Notes"
                                                      Lines="2"
                                                      For="@(() => _backendToolModel.Notes)"
                                                      @bind-Value="_backendToolModel.Notes" />
                                    </MudItem>
                                </MudGrid>
                            </ChildContent>
                        </AgentForm>

                        <div class="dojo-backend-panel__events">
                            @foreach (var note in ToolExecutionNotes)
                            {
                                <div class="dojo-backend-panel__event">@note.Message</div>
                            }
                        </div>
                    </MudPaper>

                    <div class="dojo-canvas__chat-shell">
                        <AgentChatSurface FormName="dojo-chat-backend"
                                          DefaultAgentName="Dojo Workspace Agent"
                                          ShowAgentSelector="false"
                                          LockAgentToCurrentRoute="true"
                                          SessionId="@WorkspaceSessionId"
                                          Placeholder="Set action label to policy review and submit the backend demo form."
                                          Theme="_dojoChatTheme"
                                          CssClass="dojo-embedded-chat" />
                    </div>
                </MudPaper>
            }
            else if (IsExample("human-loop"))
            {
                <MudPaper Elevation="1" Class="dojo-canvas dojo-canvas--chat">
                    <MudPaper Elevation="0" Class="dojo-checklist">
                        <div class="dojo-checklist__head">
                            <MudText Typo="Typo.h6">Select Steps</MudText>
                            <div class="dojo-checklist__meta">
                                <span>@SelectedSandwichStepCount/@_humanLoopSteps.Count Selected</span>
                                <span class="dojo-checklist__status">@_humanLoopStatus</span>
                            </div>
                        </div>

                        <div class="dojo-checklist__progress">
                            <span style="width:@SandwichSelectionProgress%;"></span>
                        </div>

                        @foreach (var step in _humanLoopSteps)
                        {
                            <button type="button"
                                    class="dojo-checklist__item @(step.Selected ? "is-selected" : null)"
                                    @onclick="() => ToggleSandwichStep(step.Number)">
                                <span class="dojo-checklist__checkbox">@(step.Selected ? "\u2713" : "")</span>
                                <span>@step.Text</span>
                            </button>
                        }
                    </MudPaper>

                    <div class="dojo-canvas__chat-shell">
                        <AgentChatSurface FormName="dojo-chat-human-loop"
                                          DefaultAgentName="Dojo Workspace Agent"
                                          ShowAgentSelector="false"
                                          LockAgentToCurrentRoute="true"
                                          SessionId="@WorkspaceSessionId"
                                          RequireHandoffApproval="true"
                                          Placeholder="Make me a sandwich and then finalize the selected steps."
                                          Theme="_dojoChatTheme"
                                          CssClass="dojo-embedded-chat" />
                    </div>
                </MudPaper>
            }
            else if (IsExample("agentic-generative-ui"))
            {
                <MudPaper Elevation="1" Class="dojo-canvas dojo-canvas--chat">
                    <MudPaper Elevation="0" Class="dojo-progress-board">
                        <div class="dojo-progress-board__head">
                            <MudText Typo="Typo.h6">Task Progress</MudText>
                            <span>@CompletedTaskCount/@_taskProgressSteps.Count Complete</span>
                        </div>

                        <div class="dojo-progress-board__progress">
                            <span style="width:@TaskCompletionProgress%;"></span>
                        </div>

                        @foreach (var step in _taskProgressSteps)
                        {
                            <div class="dojo-progress-board__item @(step.Completed ? "is-complete" : null)">
                                <span class="dojo-progress-board__dot"></span>
                                <span>@step.Text</span>
                            </div>
                        }
                    </MudPaper>

                    <div class="dojo-canvas__chat-shell">
                        <AgentChatSurface FormName="dojo-chat-agentic-ui"
                                          DefaultAgentName="Dojo Workspace Agent"
                                          ShowAgentSelector="false"
                                          LockAgentToCurrentRoute="true"
                                          SessionId="@WorkspaceSessionId"
                                          EnableGeneratedUi="true"
                                          Placeholder="Plan a vacation to Japan and keep the progress board updated."
                                          Theme="_dojoChatTheme"
                                          CssClass="dojo-embedded-chat" />
                    </div>
                </MudPaper>
            }
            else if (IsExample("tool-based-generative-ui"))
            {
                <div class="dojo-split-stage dojo-split-stage--tool-ui">
                    <MudPaper Elevation="1" Class="dojo-stage dojo-stage--artifact">
                        <AgentGenerativeSurface Document="@_toolBasedGeneratedUiDocument"
                                                AgentName="Dojo Workspace Agent"
                                                SessionId="@WorkspaceSessionId"
                                                ForwardActionsToRuntime="true"
                                                ShowRuntimeResponses="false"
                                                OnActionInvoked="OnGeneratedUiActionInvokedAsync"
                                                OnRuntimeResponseReceived="OnGeneratedUiRuntimeResponseAsync"
                                                OnError="OnGeneratedUiErrorAsync"
                                                CssClass="dojo-generated-surface" />
                    </MudPaper>

                    <MudPaper Elevation="1" Class="dojo-stage dojo-stage--sidechat">
                        <div class="dojo-sidechat__head">
                            <p>Haiku Generator</p>
                        </div>

                        <AgentChatSurface FormName="dojo-chat-tool-ui"
                                          DefaultAgentName="Dojo Workspace Agent"
                                          ShowAgentSelector="false"
                                          LockAgentToCurrentRoute="true"
                                          SessionId="@WorkspaceSessionId"
                                          EnableGeneratedUi="true"
                                          Placeholder="Write me a haiku about nature."
                                          Theme="_dojoChatTheme"
                                          CssClass="dojo-embedded-chat dojo-embedded-chat--side" />
                    </MudPaper>
                </div>
            }
            else if (IsExample("shared-state"))
            {
                <div class="dojo-split-stage">
                    <MudPaper Elevation="1" Class="dojo-stage dojo-stage--artifact">
                        <AgentForm AgentId="dojo-recipe-form"
                                   Model="@Model"
                                   Submitted="OnRecipeSubmittedAsync">
                            <ChildContent Context="_">
                                <DataAnnotationsValidator />

                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="dojo-recipe__header">
                                    <MudText Typo="Typo.h4">@Model.Title</MudText>
                                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary">Live Recipe</MudChip>
                                </MudStack>

                                <MudGrid Spacing="2" Class="dojo-recipe__meta">
                                    <MudItem xs="12" md="6">
                                        <MudTextField T="string"
                                                      Label="Recipe Title"
                                                      Placeholder="Classic Omelette"
                                                      For="@(() => Model.Title)"
                                                      @bind-Value="Model.Title" />
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudNumericField T="int"
                                                         Label="Minutes"
                                                         For="@(() => Model.Minutes)"
                                                         @bind-Value="Model.Minutes" />
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudSelect T="string"
                                                   Label="Difficulty"
                                                   For="@(() => Model.Difficulty)"
                                                   @bind-Value="Model.Difficulty">
                                            <MudSelectItem T="string" Value="@("Beginner")">Beginner</MudSelectItem>
                                            <MudSelectItem T="string" Value="@("Intermediate")">Intermediate</MudSelectItem>
                                            <MudSelectItem T="string" Value="@("Advanced")">Advanced</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>

                                <section class="dojo-recipe__section">
                                    <MudText Typo="Typo.h6">Dietary Preferences</MudText>
                                    <div class="dojo-recipe__flags">
                                        <MudCheckBox T="bool" @bind-Value="Model.HighProtein" Label="High Protein" />
                                        <MudCheckBox T="bool" @bind-Value="Model.LowCarb" Label="Low Carb" />
                                        <MudCheckBox T="bool" @bind-Value="Model.Spicy" Label="Spicy" />
                                        <MudCheckBox T="bool" @bind-Value="Model.Vegetarian" Label="Vegetarian" />
                                    </div>
                                </section>

                                <section class="dojo-recipe__section">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                                        <MudText Typo="Typo.h6">Ingredients</MudText>
                                        <MudButton Variant="Variant.Outlined"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="OpenIngredientDialogAsync">
                                            + Add Ingredient
                                        </MudButton>
                                    </MudStack>

                                    <div class="dojo-recipe__grid">
                                        @foreach (var ingredient in _ingredients)
                                        {
                                            <MudPaper Elevation="0" Class="dojo-recipe__card">
                                                <MudText Typo="Typo.subtitle2">@ingredient.Name</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@ingredient.Amount</MudText>
                                                @if (!string.IsNullOrWhiteSpace(ingredient.Notes))
                                                {
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@ingredient.Notes</MudText>
                                                }
                                            </MudPaper>
                                        }
                                    </div>
                                </section>

                                <section class="dojo-recipe__section">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-2">
                                        <MudText Typo="Typo.h6">Instructions</MudText>
                                        <MudButton Variant="Variant.Outlined"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   OnClick="OpenStepDialogAsync">
                                            + Add Step
                                        </MudButton>
                                    </MudStack>

                                    <ol class="dojo-recipe__steps">
                                        @foreach (var step in _steps)
                                        {
                                            <li>
                                                <MudPaper Elevation="0" Class="dojo-recipe__step-card">
                                                    @step
                                                </MudPaper>
                                            </li>
                                        }
                                    </ol>
                                </section>

                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="dojo-recipe__actions">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Last save: @LastSavedLabel</MudText>
                                    <MudStack Row="true" Spacing="1">
                                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary">
                                            Save Draft
                                        </MudButton>
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ShowAssistantTip">
                                            Improve with AI
                                        </MudButton>
                                    </MudStack>
                                </MudStack>
                            </ChildContent>
                        </AgentForm>
                    </MudPaper>

                    <MudPaper Elevation="1" Class="dojo-stage dojo-stage--sidechat">
                        <div class="dojo-sidechat__head">
                            <p>AI Recipe Assistant</p>
                        </div>

                        <AgentChatSurface FormName="dojo-chat-shared-state"
                                          DefaultAgentName="Dojo Workspace Agent"
                                          ShowAgentSelector="false"
                                          LockAgentToCurrentRoute="true"
                                          SessionId="@WorkspaceSessionId"
                                          Placeholder="Add eggs, add onion, create Italian recipe, or make it healthier."
                                          Theme="_dojoChatTheme"
                                          CssClass="dojo-embedded-chat dojo-embedded-chat--side" />
                    </MudPaper>
                </div>
            }
            else if (IsExample("predictive-state"))
            {
                <div class="dojo-split-stage">
                    <MudPaper Elevation="1" Class="dojo-stage dojo-stage--artifact">
                        <div class="dojo-document">
                            <p class="dojo-document__label">Predictive State Updates Document Editor</p>
                            @foreach (var line in _predictiveDocumentLines)
                            {
                                <p class="dojo-document__line dojo-document__line--@line.Kind.ToString().ToLowerInvariant()">@line.Text</p>
                            }
                        </div>
                    </MudPaper>

                    <MudPaper Elevation="1" Class="dojo-stage dojo-stage--sidechat">
                        <div class="dojo-sidechat__head">
                            <p>AI Document Editor</p>
                        </div>

                        @if (_predictiveHasPendingChanges)
                        {
                            <MudPaper Elevation="0" Class="dojo-approval-card">
                                <MudText Typo="Typo.subtitle1">Confirm Changes</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@_predictiveApprovalPrompt</MudText>
                                <MudStack Row="true" Justify="Justify.FlexEnd" Spacing="1" Class="mt-2">
                                    <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="RejectPredictiveChanges">
                                        Reject
                                    </MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmPredictiveChangesFromUi">
                                        Confirm
                                    </MudButton>
                                </MudStack>
                            </MudPaper>
                        }

                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="dojo-sidechat__note">
                            @_predictiveAssistantMessage
                        </MudText>

                        <AgentChatSurface FormName="dojo-chat-predictive"
                                          DefaultAgentName="Dojo Workspace Agent"
                                          ShowAgentSelector="false"
                                          LockAgentToCurrentRoute="true"
                                          SessionId="@WorkspaceSessionId"
                                          EnableGeneratedUi="true"
                                          Placeholder="Make all bold, rewrite the story, or summarize the content."
                                          Theme="_dojoChatTheme"
                                          CssClass="dojo-embedded-chat dojo-embedded-chat--side" />
                    </MudPaper>
                </div>
            }

        }
        else if (_viewMode == DojoViewMode.Code)
        {
            <MudPaper Elevation="0" Class="dojo-workspace__mode-panel">
                <p class="dojo-workspace__mode-eyebrow">Code</p>
                <MudText Typo="Typo.h6" Class="mb-2">@CurrentExample.Title</MudText>
                <pre class="docs-code">@CurrentExample.Code</pre>
            </MudPaper>
        }
        else
        {
            <MudPaper Elevation="0" Class="dojo-workspace__mode-panel">
                <p class="dojo-workspace__mode-eyebrow">Docs</p>
                <MudText Typo="Typo.h6" Class="mb-2">@CurrentExample.Title</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@CurrentExample.Docs</MudText>
            </MudPaper>
        }
    </div>

    <AgentDialog @ref="_ingredientDialog"
                 AgentId="dojo-ingredient-dialog"
                 Visible="@_ingredientDialogVisible"
                 VisibleChanged="OnIngredientDialogVisibleChanged">
        <TitleContent>
            <MudText Typo="Typo.h6">Add Ingredient</MudText>
        </TitleContent>
        <DialogContent>
            <AgentForm AgentId="dojo-ingredient-form"
                       Model="@_ingredientDraft"
                       Submitted="OnIngredientSubmittedAsync">
                <ChildContent Context="_">
                    <DataAnnotationsValidator />
                    <MudTextField T="string"
                                  Label="Ingredient name"
                                  For="@(() => _ingredientDraft.Name)"
                                  @bind-Value="_ingredientDraft.Name" />
                    <MudTextField T="string"
                                  Label="Amount"
                                  For="@(() => _ingredientDraft.Amount)"
                                  @bind-Value="_ingredientDraft.Amount" />
                    <MudCheckBox T="bool"
                                 Label="Optional"
                                 @bind-Value="_ingredientDraft.Optional" />
                    <MudTextField T="string"
                                  Label="Notes"
                                  For="@(() => _ingredientDraft.Notes)"
                                  @bind-Value="_ingredientDraft.Notes" />
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary">
                            Save Ingredient
                        </MudButton>
                    </MudStack>
                </ChildContent>
            </AgentForm>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseIngredientDialogAsync">
                Close
            </MudButton>
        </DialogActions>
    </AgentDialog>

    <AgentDialog @ref="_stepDialog"
                 AgentId="dojo-step-dialog"
                 Visible="@_stepDialogVisible"
                 VisibleChanged="OnStepDialogVisibleChanged">
        <TitleContent>
            <MudText Typo="Typo.h6">Add Instruction Step</MudText>
        </TitleContent>
        <DialogContent>
            <AgentForm AgentId="dojo-step-form"
                       Model="@_stepDraft"
                       Submitted="OnStepSubmittedAsync">
                <ChildContent Context="_">
                    <DataAnnotationsValidator />
                    <MudTextField T="string"
                                  Label="Step text"
                                  Lines="3"
                                  For="@(() => _stepDraft.Text)"
                                  @bind-Value="_stepDraft.Text" />
                    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mt-2">
                        <MudButton ButtonType="ButtonType.Submit"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary">
                            Save Step
                        </MudButton>
                    </MudStack>
                </ChildContent>
            </AgentForm>
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseStepDialogAsync">
                Close
            </MudButton>
        </DialogActions>
    </AgentDialog>
</div>

@code {
    protected override string AgentIdValue => "dojo-recipe-workflow";
    protected override string FormDisplayName => "Recipe";

    private static readonly ChatTheme _dojoChatTheme = new()
    {
        Variant = ChatThemeVariant.Light,
        Style = ChatVisualStyle.Minimal,
        Spacing = ChatSpacing.Compact,
        BorderRadius = ChatBorderRadius.Large,
        EnableGlassEffect = false,
        AccentColor = "#ff8a57",
        FontFamily = "\"Public Sans\", \"Segoe UI\", sans-serif",
        FontSize = "0.93rem"
    };

    private List<DojoIngredientRow> _ingredients = [];
    private List<string> _steps = [];
    private List<DojoRunNote> _runNotes = [];

    private AgentDialog? _ingredientDialog;
    private bool _ingredientDialogVisible;
    private DojoIngredientDraft _ingredientDraft = new();
    private AgentDialog? _stepDialog;
    private bool _stepDialogVisible;
    private DojoStepDraft _stepDraft = new();
    private BackendToolFormModel _backendToolModel = new();
    private DateTime? _lastSavedUtc;

    private string _selectedIntegration = "Microsoft Agent Framework (.NET)";
    private DojoViewMode _viewMode = DojoViewMode.Preview;
    private string _selectedExampleKey = "shared-state";

    private string _backgroundStudioTheme = "neutral";
    private string _backgroundStudioUserPrompt = "\"Can you change the background color to something more vibrant?\"";
    private string _backgroundStudioHeadline = "How can I help you today?";
    private string _backgroundStudioBody = "Describe a UI change and the mounted Dojo component can respond instantly.";
    private readonly IReadOnlyList<string> _backgroundStudioSuggestions = ["Change background", "Generate sonnet"];

    private List<DojoChecklistStep> _humanLoopSteps = CreateHumanLoopSteps();
    private string _humanLoopStatus = "Ready";

    private List<DojoProgressStep> _taskProgressSteps = CreateTaskProgressSteps();

    private List<DojoDocumentLine> _predictiveDocumentLines = CreatePredictiveDocumentLines();
    private bool _predictiveHasPendingChanges = true;
    private string _predictiveApprovalPrompt = "Do you want to accept the changes?";
    private string _predictiveAssistantMessage =
        "I have updated the document to make all text bold. Let me know if you need any further adjustments.";

