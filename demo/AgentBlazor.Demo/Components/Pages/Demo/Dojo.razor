    private static string BuildReadableStateSnippet()
    {
        var readableProperties = typeof(Dojo)
            .GetProperties(BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic)
            .Where(property => property.GetCustomAttribute<AgentReadableAttribute>() is not null)
            .ToArray();

        var lines = new List<string>();
        foreach (var property in readableProperties)
        {
            var attribute = property.GetCustomAttribute<AgentReadableAttribute>()!;
            var attributeBits = new List<string>();
            if (!string.IsNullOrWhiteSpace(attribute.Description))
            {
                attributeBits.Add($"\"{attribute.Description}\"");
            }

            if (!string.IsNullOrWhiteSpace(attribute.StateKey))
            {
                attributeBits.Add($"StateKey = \"{attribute.StateKey}\"");
            }

            if (attribute.MaxItems != 5)
            {
                attributeBits.Add($"MaxItems = {attribute.MaxItems}");
            }

            lines.Add($"[AgentReadable({string.Join(", ", attributeBits)})]");
            lines.Add($"public {FormatTypeName(property.PropertyType)} {property.Name} => ...;");
            lines.Add(string.Empty);
        }

        return string.Join(Environment.NewLine, lines).TrimEnd();
    }

    private static string BuildModelSnippet()
    {
        var properties = typeof(DojoIncidentModel)
            .GetProperties(BindingFlags.Instance | BindingFlags.Public)
            .Where(static property => property.CanRead && property.CanWrite)
            .ToArray();

        var sb = new StringBuilder();
        sb.AppendLine("public sealed class DojoIncidentModel");
        sb.AppendLine("{");
        foreach (var property in properties)
        {
            sb.Append("    public ")
                .Append(FormatTypeName(property.PropertyType))
                .Append(' ')
                .Append(property.Name)
                .Append(" { get; set; }");

            if (property.GetValue(new DojoIncidentModel()) is { } initialValue)
            {
                sb.Append(" = ")
                    .Append(FormatDefaultLiteral(initialValue))
                    .Append(';');
            }

            sb.AppendLine();
        }

        sb.Append('}');
        return sb.ToString();
    }

    private static string BuildActionSnippet(params string[] methodNames)
    {
        var methods = methodNames
            .Select(name => typeof(Dojo).GetMethod(name, BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic))
            .Where(static method => method is not null)
            .Cast<MethodInfo>()
            .ToArray();

        var lines = new List<string>();
        foreach (var method in methods)
        {
            var attribute = method.GetCustomAttribute<AgentActionAttribute>();
            if (attribute is null)
            {
                continue;
            }

            var attributeArgs = new List<string>();
            if (!string.IsNullOrWhiteSpace(attribute.Description))
            {
                attributeArgs.Add($"\"{attribute.Description}\"");
            }

            if (!string.IsNullOrWhiteSpace(attribute.ActionId))
            {
                attributeArgs.Add($"ActionId = \"{attribute.ActionId}\"");
            }

            if (!string.IsNullOrWhiteSpace(attribute.AvailableWhen))
            {
                attributeArgs.Add($"AvailableWhen = nameof({attribute.AvailableWhen})");
            }

            if (!attribute.FollowUp)
            {
                attributeArgs.Add("FollowUp = false");
            }

            if (attribute.RequiresApproval)
            {
                attributeArgs.Add("RequiresApproval = true");
            }

            if (!string.IsNullOrWhiteSpace(attribute.Instructions))
            {
                attributeArgs.Add($"Instructions = \"{EscapeCodeString(attribute.Instructions)}\"");
            }

            lines.Add($"[AgentAction({string.Join(", ", attributeArgs)})]");
            lines.Add($"public {FormatTypeName(method.ReturnType)} {method.Name}({FormatParameters(method)})");
            lines.Add(string.Empty);
        }

        return string.Join(Environment.NewLine, lines).TrimEnd();
    }

    private static string FormatParameters(MethodInfo method)
    {
        return string.Join(", ",
            method.GetParameters().Select(parameter =>
            {
                var attribute = parameter.GetCustomAttribute<AgentParamAttribute>();
                var prefix = string.Empty;
                if (attribute is not null)
                {
                    var attributeArgs = new List<string>();
                    if (!string.IsNullOrWhiteSpace(attribute.Description))
                    {
                        attributeArgs.Add($"\"{EscapeCodeString(attribute.Description)}\"");
                    }

                    if (attribute.Required)
                    {
                        attributeArgs.Add("Required = true");
                    }

                    if (!string.IsNullOrWhiteSpace(attribute.AllowedValues))
                    {
                        attributeArgs.Add($"AllowedValues = \"{EscapeCodeString(attribute.AllowedValues)}\"");
                    }

                    prefix = $"[AgentParam({string.Join(", ", attributeArgs)})] ";
                }

                var defaultValue = parameter.HasDefaultValue
                    ? $" = {FormatParameterDefault(parameter.DefaultValue)}"
                    : string.Empty;
                return $"{prefix}{FormatTypeName(parameter.ParameterType)} {parameter.Name}{defaultValue}";
            }));
    }

    private static string FormatTypeName(Type type)
    {
        var nullableUnderlying = Nullable.GetUnderlyingType(type);
        if (nullableUnderlying is not null)
        {
            return $"{FormatTypeName(nullableUnderlying)}?";
        }

        if (type == typeof(string)) return "string";
        if (type == typeof(bool)) return "bool";
        if (type == typeof(int)) return "int";
        if (type == typeof(long)) return "long";
        if (type == typeof(double)) return "double";
        if (type == typeof(decimal)) return "decimal";
        if (type == typeof(void)) return "void";
        if (type == typeof(Task)) return "Task";

        if (type.IsGenericType && type.GetGenericTypeDefinition() == typeof(Task<>))
        {
            return $"Task<{FormatTypeName(type.GetGenericArguments()[0])}>";
        }

        return type.Name;
    }

    private static string FormatParameterDefault(object? value)
        => value is null ? "null" : FormatDefaultLiteral(value);

    private static string FormatDefaultLiteral(object value)
        => value switch
        {
            string text => $"\"{EscapeCodeString(text)}\"",
            bool boolValue => boolValue ? "true" : "false",
            _ => value.ToString() ?? "null"
        };

    private static string EscapeCodeString(string value)
        => value.Replace("\\", "\\\\", StringComparison.Ordinal)
            .Replace("\"", "\\\"", StringComparison.Ordinal);

