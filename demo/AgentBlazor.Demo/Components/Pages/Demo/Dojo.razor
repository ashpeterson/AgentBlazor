@page "/demo/dojo"
@layout DemoLayout
@using System.Reflection
@using System.Text
@using System.Text.Json
@using AgentBlazor
@using AgentBlazor.Attributes
@using AgentBlazor.Components
@using AgentBlazor.Components.Chat
@using AgentBlazor.Core.Components
@using AgentBlazor.Demo.Components.Pages.Demo
@using MudBlazor
@inherits AgentControllableComponentBase
@attribute [AgentComponent(AgentId = "dojo-workspace", ComponentType = "DojoIncident")]

<PageTitle>Dojo Workspace</PageTitle>

<div class="dojo-workspace">
    <aside class="dojo-workspace__rail">
        <div class="dojo-workspace__rail-header">
            <p class="dojo-workspace__eyebrow">AgentBlazor Dojo</p>
            <MudText Typo="Typo.h6">Three native Blazor agent UI patterns.</MudText>
        </div>

        <section class="dojo-workspace__rail-section">
            <p class="dojo-workspace__rail-label">View</p>
            <div class="dojo-workspace__view-toggle">
                <button type="button" class="dojo-workspace__view-button @(IsViewMode(DojoViewMode.Preview) ? "is-active" : null)" @onclick="() => SetViewMode(DojoViewMode.Preview)">Preview</button>
                <button type="button" class="dojo-workspace__view-button @(IsViewMode(DojoViewMode.Code) ? "is-active" : null)" @onclick="() => SetViewMode(DojoViewMode.Code)">Code</button>
                <button type="button" class="dojo-workspace__view-button @(IsViewMode(DojoViewMode.Docs) ? "is-active" : null)" @onclick="() => SetViewMode(DojoViewMode.Docs)">Docs</button>
            </div>
        </section>

        <section class="dojo-workspace__rail-section">
            <p class="dojo-workspace__rail-label">Try asking</p>
            <div class="dojo-workspace__prompt-chips">
                @foreach (var prompt in CurrentExample.Prompts)
                {
                    <button type="button" class="dojo-workspace__prompt-chip" @onclick="() => InjectPromptAsync(prompt)">@prompt</button>
                }
            </div>
        </section>

        <section class="dojo-workspace__rail-section dojo-workspace__rail-section--fill">
            <p class="dojo-workspace__rail-label">Pillars</p>
            <div class="dojo-workspace__demo-list">
                @foreach (var example in _examples)
                {
                    <button type="button"
                            class="dojo-workspace__demo-item @(IsSelectedExample(example.Key) ? "is-active" : null)"
                            @onclick="() => SelectExample(example.Key)">
                        <span class="dojo-workspace__demo-title">@example.Title</span>
                        <span class="dojo-workspace__demo-description">@example.ShortDescription</span>
                        <span class="dojo-workspace__demo-tags">
                            @foreach (var tag in example.Tags)
                            {
                                <span>@tag</span>
                            }
                        </span>
                    </button>
                }
            </div>
        </section>
    </aside>

    <main class="dojo-workspace__main">
        <header class="dojo-workspace__header">
            <p class="dojo-workspace__eyebrow">@CurrentExample.Title</p>
            <MudText Typo="Typo.h4">@CurrentExample.Headline</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@CurrentExample.Subtitle</MudText>
        </header>

        @if (_viewMode == DojoViewMode.Preview)
        {
            <div class="dojo-preview">
                <section class="dojo-stage dojo-stage--canvas">
                    @if (IsExample("controlled-generative-ui"))
                    {
                        <div class="dojo-controlled">
                            <article class="dojo-card dojo-controlled__card">
                                <div class="dojo-controlled__card-head">
                                    <div>
                                        <p class="dojo-controlled__label">Incident review draft</p>
                                        <MudText Typo="Typo.h5">@Model.Incident</MudText>
                                    </div>
                                    <span class="dojo-status-chip @(_controlledReviewQueued ? "is-success" : null)">@(_controlledReviewQueued ? "Review queued" : "Draft")</span>
                                </div>

                                <div class="dojo-controlled__grid">
                                    <div class="dojo-key-stat">
                                        <span>Severity</span>
                                        <strong>@Model.Severity</strong>
                                    </div>
                                    <div class="dojo-key-stat">
                                        <span>Owner</span>
                                        <strong>@Model.Owner</strong>
                                    </div>
                                    <div class="dojo-key-stat dojo-key-stat--wide">
                                        <span>Next step</span>
                                        <strong>@Model.NextStep</strong>
                                    </div>
                                </div>

                                <div class="dojo-controlled__actions">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="dojo-controlled__button" OnClick="QueueControlledReviewFromUiAsync">Queue Review</MudButton>
                                </div>
                            </article>

                            <article class="dojo-card dojo-controlled__feed">
                                <div class="dojo-card__head">
                                    <MudText Typo="Typo.h6">Lifecycle Feed</MudText>
                                    <span>Host-rendered updates</span>
                                </div>

                                <div class="dojo-feed">
                                    @if (_controlledLifecycle.Count == 0)
                                    {
                                        <div class="dojo-feed__empty">No actions yet.</div>
                                    }
                                    else
                                    {
                                        @foreach (var item in _controlledLifecycle)
                                        {
                                            <div class="dojo-feed__item">
                                                <strong>@item.Timestamp.ToLocalTime().ToString("HH:mm:ss")</strong>
                                                <span>@item.Message</span>
                                            </div>
                                        }
                                    }
                                </div>
                            </article>
                        </div>
                    }
                    else if (IsExample("declarative-generative-ui"))
                    {
                        <div class="dojo-declarative">
                            <div class="dojo-declarative__toolbar">
                                <div class="dojo-inline-toggle">
                                    <button type="button" class="dojo-inline-toggle__button @(IsDeclarativeProtocol(DojoDeclarativeProtocol.Native) ? "is-active" : null)" @onclick="() => SetDeclarativeProtocol(DojoDeclarativeProtocol.Native)">Native</button>
                                    <button type="button" class="dojo-inline-toggle__button @(IsDeclarativeProtocol(DojoDeclarativeProtocol.A2Ui) ? "is-active" : null)" @onclick="() => SetDeclarativeProtocol(DojoDeclarativeProtocol.A2Ui)">A2UI</button>
                                    <button type="button" class="dojo-inline-toggle__button @(IsDeclarativeProtocol(DojoDeclarativeProtocol.OpenJsonUi) ? "is-active" : null)" @onclick="() => SetDeclarativeProtocol(DojoDeclarativeProtocol.OpenJsonUi)">Open-JSON-UI</button>
                                </div>
                                <span class="dojo-status-chip">@DeclarativeProtocolLabel</span>
                            </div>

                            <article class="dojo-card dojo-declarative__surface">
                                <div class="dojo-card__head">
                                    <MudText Typo="Typo.h6">@DeclarativePreviewTitle</MudText>
                                    <span>@_declarativeSummary</span>
                                </div>

                                <AgentGenerativeSurface Document="@_declarativeDocument"
                                                        CssClass="dojo-generated-surface"
                                                        AgentName="Dojo Workspace Agent"
                                                        ForwardActionsToRuntime="true"
                                                        ShowRuntimeResponses="false" />
                            </article>
                        </div>
                    }
                    else
                    {
                        <div class="dojo-open-ended">
                            <article class="dojo-card dojo-open-ended__shell">
                                <div class="dojo-open-ended__toolbar">
                                    <span class="dojo-open-ended__traffic"><i></i><i></i><i></i></span>
                                    <span class="dojo-open-ended__url">@_openEndedOriginLabel</span>
                                    <span class="dojo-status-chip">Sandboxed iframe</span>
                                </div>

                                <iframe class="dojo-open-ended__frame" title="Hosted agent app" sandbox="allow-scripts" srcdoc="@_openEndedAppMarkup"></iframe>
                            </article>
                        </div>
                    }
                </section>

                <aside class="dojo-stage dojo-stage--chat-panel">
                    <AgentChatSurface @key="_selectedExampleKey"
                                      @ref="_chatSurface"
                                      FormName="dojo-chat"
                                      DefaultAgentName="Dojo Workspace Agent"
                                      ShowAgentSelector="false"
                                      LockAgentToCurrentRoute="true"
                                      Title="Dojo Workspace Agent"
                                      Placeholder="@CurrentExample.Placeholder"
                                      CssClass="dojo-embedded-chat" />
                </aside>
            </div>
        }
        else if (_viewMode == DojoViewMode.Code)
        {
                <section class="dojo-stage dojo-stage--document dojo-code">
                @foreach (var codeSection in CurrentCodeSections)
                {
                    <article class="dojo-card dojo-code__section">
                        <div class="dojo-card__head dojo-code__head">
                            <div>
                                <MudText Typo="Typo.h6">@codeSection.Title</MudText>
                                @if (!string.IsNullOrWhiteSpace(codeSection.Description))
                                {
                                    <p class="dojo-code__description">@codeSection.Description</p>
                                }
                            </div>
                            <span class="dojo-status-chip">@codeSection.Language</span>
                        </div>

                        <pre class="docs-code dojo-code__block"><code>@codeSection.Content</code></pre>
                    </article>
                }
            </section>
        }
        else
        {
            <section class="dojo-stage dojo-stage--document dojo-docs">
                <article class="dojo-card dojo-docs__intro">
                    <div class="dojo-card__head">
                        <MudText Typo="Typo.h6">Overview</MudText>
                        <span class="dojo-status-chip">@CurrentExample.Title</span>
                    </div>
                    <p>@CurrentExample.Docs</p>
                </article>

                @foreach (var docSection in CurrentDocSections)
                {
                    <article class="dojo-card dojo-docs__section">
                        <div class="dojo-card__head">
                            <MudText Typo="Typo.h6">@docSection.Title</MudText>
                        </div>
                        <p>@docSection.Body</p>
                        @if (docSection.Bullets.Count > 0)
                        {
                            <ul class="dojo-docs__list">
                                @foreach (var bullet in docSection.Bullets)
                                {
                                    <li>@bullet</li>
                                }
                            </ul>
                        }
                    </article>
                }
            </section>
        }
    </main>
</div>

@code {
    private AgentChatSurface? _chatSurface;
    private DojoIncidentModel Model { get; } = new();
    private DojoViewMode _viewMode = DojoViewMode.Preview;
    private string _selectedExampleKey = "controlled-generative-ui";
    private DojoDeclarativeProtocol _declarativeProtocol = DojoDeclarativeProtocol.Native;
    private OpenEndedPreset _openEndedPreset = OpenEndedPreset.Analytics;
    private readonly List<DojoTimelineItem> _controlledLifecycle = [];
    private AgentUiDocument _declarativeDocument = CreateNativeDeclarativeDocument();
    private string _declarativePayload = string.Empty;
    private string _declarativeSummary = "Native AgentUiDocument rendered with Blazor components.";
    private bool _controlledReviewQueued;
    private string _openEndedAppMarkup = CreateAnalyticsHostedAppMarkup();
    private string _openEndedOriginLabel = "about:srcdoc / analytics-cockpit";

    private DojoExampleDefinition CurrentExample => _examples.First(example => string.Equals(example.Key, _selectedExampleKey, StringComparison.Ordinal));
    private IReadOnlyList<DojoCodeSection> CurrentCodeSections => BuildCodeSections();
    private IReadOnlyList<DojoDocSection> CurrentDocSections => BuildDocSections();
    private string DeclarativeProtocolLabel => _declarativeProtocol switch
    {
        DojoDeclarativeProtocol.A2Ui => "Imported from A2UI",
        DojoDeclarativeProtocol.OpenJsonUi => "Imported from Open-JSON-UI",
        _ => "Native AgentUiDocument"
    };
    private string DeclarativePreviewTitle => _declarativeProtocol switch
    {
        DojoDeclarativeProtocol.A2Ui => "Imported from A2UI",
        DojoDeclarativeProtocol.OpenJsonUi => "Imported from Open-JSON-UI",
        _ => "Blazor-Rendered Generative UI"
    };
    private static readonly IReadOnlyList<DojoExampleDefinition> _examples =
    [
        new(
            "controlled-generative-ui",
            "Controlled Generative UI",
            "Prebuilt Blazor UI selected and driven by the agent.",
            "Prebuilt UI, agent-selected actions",
            "The host owns the layout and lifecycle. The agent can only update known fields and trigger known actions.",
            "Controlled generative UI is the highest-control pattern: the UI is authored in Blazor and MudBlazor, and the agent only chooses from exposed actions. This is the right fit for workflows like incident review, approvals, and operator handoff where layout, validation, and lifecycle must stay deterministic.",
            "Try: make this a P1 checkout incident",
            ["AG-UI", "Blazor", "High control"],
            ["make this a P1 checkout incident", "assign the draft to Ash", "queue review"]),
        new(
            "declarative-generative-ui",
            "Declarative Generative UI",
            "Import open declarative payloads and render them with native Blazor components.",
            "One renderer, multiple open specs",
            "AgentBlazor keeps a native Blazor renderer and imports A2UI or Open-JSON-UI payloads into one internal document model.",
            "Declarative generative UI lets the agent return a structured UI description instead of choosing a fully prebuilt screen. In AgentBlazor, open schemas like A2UI and Open-JSON-UI are adapter inputs, while the actual renderer stays Blazor-native so styling, theming, and action wiring remain consistent.",
            "Try: switch to a2ui import",
            ["Declarative UI", "A2UI", "Open-JSON-UI"],
            ["switch to a2ui import", "switch to open-json-ui import", "switch back to native"]),
        new(
            "open-ended-generative-ui",
            "Open-ended Generative UI",
            "Host a larger app-like surface inside the Blazor shell.",
            "Hosted app surface inside Blazor",
            "Use this when the agent needs to swap between broader app experiences instead of a constrained card or form.",
            "Open-ended generative UI treats the Blazor app as the host shell and lets the agent switch between broader app surfaces while maintaining sandboxing and framing. This is the lowest-control mode and should be used when a card or declarative surface is no longer enough.",
            "Try: switch to planner workspace",
            ["Hosted app", "Sandboxed", "Low control"],
            ["open the analytics cockpit", "switch to planner workspace", "switch to support workspace"])
    ];

    [AgentReadable("Currently selected dojo pillar.")]
    public string SelectedPillar => _selectedExampleKey;

    [AgentReadable("Current controlled incident title.")]
    public string Incident => Model.Incident;

    [AgentReadable("Current controlled incident severity.")]
    public string Severity => Model.Severity;

    [AgentReadable("Current controlled incident owner.")]
    public string Owner => Model.Owner;

    [AgentReadable("Current controlled incident next step.")]
    public string NextStep => Model.NextStep;

    [AgentReadable("Current review state.")]
    public string ReviewState => _controlledReviewQueued ? "review queued" : "draft";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshDeclarativeDemo();
        RefreshOpenEndedDemo();
    }




    private bool IsSelectedExample(string key) => string.Equals(_selectedExampleKey, key, StringComparison.Ordinal);
    private bool IsExample(string key) => IsSelectedExample(key);
    private bool IsViewMode(DojoViewMode mode) => _viewMode == mode;
    private bool IsDeclarativeProtocol(DojoDeclarativeProtocol protocol) => _declarativeProtocol == protocol;
    private bool CanUseControlledActions() => IsExample("controlled-generative-ui");
    private bool CanUseDeclarativeActions() => IsExample("declarative-generative-ui");
    private bool CanUseOpenEndedActions() => IsExample("open-ended-generative-ui");

    private void SelectExample(string key)
    {
        _selectedExampleKey = key;
    }

    private void SetViewMode(DojoViewMode mode)
    {
        _viewMode = mode;
    }

    private async Task InjectPromptAsync(string prompt)
    {
        if (_chatSurface is null)
        {
            return;
        }

        await _chatSurface.InjectAsync(prompt);
    }

    private async Task QueueControlledReviewFromUiAsync()
    {
        await QueueControlledIncidentReview();
    }

    [AgentAction("Select the dojo pillar to display.", ActionId = "select_dojo_pillar", FollowUp = false)]
    public Task SelectDojoPillar(
        [AgentParam("One of: controlled-generative-ui, declarative-generative-ui, open-ended-generative-ui")] string pillar)
    {
        var normalized = NormalizeToken(pillar);
        _selectedExampleKey = normalized switch
        {
            "controlled" or "controlledgenerativeui" => "controlled-generative-ui",
            "declarative" or "declarativegenerativeui" => "declarative-generative-ui",
            "openended" or "openendedgenerativeui" or "hostedapp" => "open-ended-generative-ui",
            _ => _selectedExampleKey
        };

        return RequestComponentRefreshAsync();
    }

    [AgentAction("Switch the dojo view between preview, code, and docs.", ActionId = "set_dojo_view", FollowUp = false)]
    public Task SetDojoView([AgentParam("preview, code, or docs")] string view)
    {
        _viewMode = NormalizeToken(view) switch
        {
            "code" => DojoViewMode.Code,
            "docs" => DojoViewMode.Docs,
            _ => DojoViewMode.Preview
        };

        return RequestComponentRefreshAsync();
    }

    [AgentAction(
        "Update the controlled incident draft.",
        ActionId = "update_controlled_incident_draft",
        AvailableWhen = nameof(CanUseControlledActions),
        Instructions = "ALWAYS use this action to change the controlled incident title, severity, owner, or next step. If the user names a new incident domain or summary like checkout, payments, latency, or support, update the incident title to match that new incident. NEVER invent another component id or field-specific action."
    )]
    public Task UpdateControlledIncidentDraft(
        [AgentParam("Incident title, for example 'Checkout latency spike'.")] string? incident = null,
        [AgentParam("Severity: P1, P2, or P3.")] string? severity = null,
        [AgentParam("Owner name.")] string? owner = null,
        [AgentParam("Next operational step.")] string? nextStep = null)
    {
        if (!string.IsNullOrWhiteSpace(incident))
        {
            Model.Incident = incident.Trim();
        }

        if (!string.IsNullOrWhiteSpace(severity))
        {
            Model.Severity = severity.Trim().ToUpperInvariant();
        }

        if (!string.IsNullOrWhiteSpace(owner))
        {
            Model.Owner = owner.Trim();
        }

        if (!string.IsNullOrWhiteSpace(nextStep))
        {
            Model.NextStep = nextStep.Trim();
        }

        _controlledReviewQueued = false;
        AppendControlledLifecycle("Draft updated.");
        return RequestComponentRefreshAsync();
    }

    [AgentAction(
        "Assign the controlled incident draft to an owner.",
        ActionId = "assign_draft",
        AvailableWhen = nameof(CanUseControlledActions),
        Instructions = "ALWAYS use this action when the user says assign the draft to someone."
    )]
    public Task AssignDraft([AgentParam("Owner name.")] string assignee)
        => UpdateControlledIncidentDraft(owner: assignee);

    [AgentAction(
        "Set the controlled incident owner.",
        ActionId = "fill_owner",
        AvailableWhen = nameof(CanUseControlledActions),
        Instructions = "ALWAYS use this action when the user says change owner to someone."
    )]
    public Task FillOwner([AgentParam("Owner name.")] string owner)
        => UpdateControlledIncidentDraft(owner: owner);

    [AgentAction(
        "Queue the current incident draft for review.",
        ActionId = "queue_controlled_incident_review",
        AvailableWhen = nameof(CanUseControlledActions),
        Instructions = "ALWAYS use this action when the user asks to submit, queue, or send the review."
    )]
    public Task QueueControlledIncidentReview()
    {
        _controlledReviewQueued = true;
        AppendControlledLifecycle($"Review queued for {Model.Owner}.");
        return RequestComponentRefreshAsync();
    }

    [AgentAction(
        "Switch the declarative demo protocol.",
        ActionId = "switch_declarative_protocol",
        AvailableWhen = nameof(CanUseDeclarativeActions),
        FollowUp = false,
        Instructions = "Use this action when the user asks for Native, A2UI, or Open-JSON-UI in the declarative demo."
    )]
    public Task SwitchDeclarativeProtocol([AgentParam("native, a2ui, or open-json-ui")] string protocol)
    {
        _declarativeProtocol = NormalizeToken(protocol) switch
        {
            "a2ui" => DojoDeclarativeProtocol.A2Ui,
            "openjsonui" => DojoDeclarativeProtocol.OpenJsonUi,
            _ => DojoDeclarativeProtocol.Native
        };

        RefreshDeclarativeDemo();
        return RequestComponentRefreshAsync();
    }

    [AgentAction(
        "Switch the hosted app surface for the open-ended demo.",
        ActionId = "switch_open_ended_surface",
        AvailableWhen = nameof(CanUseOpenEndedActions),
        FollowUp = false,
        Instructions = "Use this action when the user asks to open analytics, planner, or support in the hosted app demo."
    )]
    public Task SwitchOpenEndedSurface([AgentParam("analytics, planner, or support")] string preset)
    {
        _openEndedPreset = NormalizeToken(preset) switch
        {
            "planner" or "workspace" => OpenEndedPreset.Planner,
            "support" or "helpdesk" => OpenEndedPreset.Support,
            _ => OpenEndedPreset.Analytics
        };

        RefreshOpenEndedDemo();
        return RequestComponentRefreshAsync();
    }

    private void AppendControlledLifecycle(string message)
    {
        _controlledLifecycle.Insert(0, new DojoTimelineItem(DateTimeOffset.UtcNow, message));
        if (_controlledLifecycle.Count > 6)
        {
            _controlledLifecycle.RemoveAt(_controlledLifecycle.Count - 1);
        }
    }

    private void SetDeclarativeProtocol(DojoDeclarativeProtocol protocol)
    {
        _declarativeProtocol = protocol;
        RefreshDeclarativeDemo();
    }

    private void RefreshDeclarativeDemo()
    {
        switch (_declarativeProtocol)
        {
            case DojoDeclarativeProtocol.A2Ui:
                _declarativePayload = CreateA2UiDeclarativePayload();
                _declarativeDocument =
                    AgentUiInterchangeAdapters.FromA2UiJsonLines(_declarativePayload, out _)
                    ?? CreateFallbackDeclarativeDocument("A2UI import unavailable", "No declarative UI blocks were produced.");
                _declarativeSummary = "A2UI envelopes are imported into the native AgentUiDocument renderer.";
                break;
            case DojoDeclarativeProtocol.OpenJsonUi:
                _declarativePayload = CreateOpenJsonUiDeclarativePayload();
                _declarativeDocument =
                    AgentUiInterchangeAdapters.FromOpenJsonUi(_declarativePayload, out _)
                    ?? CreateFallbackDeclarativeDocument("Open-JSON-UI import unavailable", "No declarative UI blocks were produced.");
                _declarativeSummary = "Open-JSON-UI is treated as input while the renderer stays Blazor-native.";
                break;
            default:
                _declarativeDocument = CreateNativeDeclarativeDocument();
                _declarativePayload = JsonSerializer.Serialize(_declarativeDocument, AgentGenerativeUiSpec.JsonOptions);
                _declarativeSummary = "Native AgentUiDocument rendered with Blazor components.";
                break;
        }
    }

    private void RefreshOpenEndedDemo()
    {
        switch (_openEndedPreset)
        {
            case OpenEndedPreset.Planner:
                _openEndedOriginLabel = "about:srcdoc / planner-workspace";
                _openEndedAppMarkup = CreatePlannerHostedAppMarkup();
                break;
            case OpenEndedPreset.Support:
                _openEndedOriginLabel = "about:srcdoc / support-workspace";
                _openEndedAppMarkup = CreateSupportHostedAppMarkup();
                break;
            default:
                _openEndedOriginLabel = "about:srcdoc / analytics-cockpit";
                _openEndedAppMarkup = CreateAnalyticsHostedAppMarkup();
                break;
        }
    }

    private static AgentUiDocument CreateNativeDeclarativeDocument() => new()
    {
        Blocks =
        [
            new AgentUiBlock
            {
                Id = "release-summary",
                Kind = AgentUiBlockKind.Card,
                Title = "Release Summary",
                Description = "Sprint 24 is on track with one blocker flagged.",
                Actions =
                [
                    new AgentUiAction
                    {
                        Id = "review_blocker",
                        Label = "Review blocker",
                        Prompt = "review the blocker and propose next steps"
                    }
                ]
            },
            new AgentUiBlock
            {
                Id = "release-form",
                Kind = AgentUiBlockKind.Form,
                Title = "Launch Draft",
                Description = "Native AgentUiDocument input rendered in Blazor.",
                Fields =
                [
                    new AgentUiField { Name = "Channel", Label = "Channel", Type = "text", Value = "Web checkout" },
                    new AgentUiField { Name = "Owner", Label = "Owner", Type = "text", Value = "Ash" },
                    new AgentUiField { Name = "Status", Label = "Status", Type = "text", Value = "Ready for review" }
                ]
            }
        ]
    };

    private static AgentUiDocument CreateFallbackDeclarativeDocument(string title, string description) => new()
    {
        Blocks =
        [
            new AgentUiBlock
            {
                Id = "fallback-card",
                Kind = AgentUiBlockKind.Card,
                Title = title,
                Description = description
            }
        ]
    };

    private static string CreateA2UiDeclarativePayload() => """
{"surfaceUpdate":{"surfaceId":"inventory-surface","components":[{"id":"inventory-summary","type":"card","title":"Inventory Summary","description":"Warehouse inventory is stable and ready for review.","actions":[{"id":"sync_inventory","label":"Sync inventory","prompt":"sync inventory counts for the warehouse dashboard"}]},{"id":"inventory-form","type":"form","title":"Restock Draft","fields":[{"name":"Item","label":"Item","type":"text","required":true},{"name":"Quantity","label":"Quantity","type":"number","required":true},{"name":"Priority","label":"Priority","type":"text"}],"actions":[{"id":"queue_restock","label":"Queue restock","prompt":"queue a restock draft for the selected item"}]}]}}
{"dataModelUpdate":{"surfaceId":"inventory-surface","path":"/","contents":{"Item":"Espresso Beans","Quantity":24,"Priority":"High"}}}
{"beginRendering":{"surfaceId":"inventory-surface","root":"inventory-form","styles":{"gap":"16px"}}}
""";

    private static string CreateOpenJsonUiDeclarativePayload() => """
{
  "type": "open-json-ui",
  "spec": {
    "components": [
      {
        "id": "release-summary",
        "type": "card",
        "properties": {
          "title": "Release Summary",
          "description": "Sprint 24 is on track with one blocker flagged."
        }
      },
      {
        "id": "release-table",
        "type": "table",
        "properties": {
          "title": "Feature Readiness",
          "columns": [
            { "key": "feature", "header": "Feature" },
