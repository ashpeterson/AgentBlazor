    public async Task<ActionResult> PlanTravelWorkflow(
        [AgentParam("Destination name.")]
        string? destination = null)
    {
        var place = string.IsNullOrWhiteSpace(destination) ? "Japan" : destination.Trim();
        _taskProgressSteps = CreateTaskProgressSteps(place);
        await RequestComponentRefreshAsync();
        return ActionResult.Applied($"Prepared the task progress board for travel to {place}.");
    }

    [AgentAction("Mark a travel task complete by number.", AvailableWhen = nameof(CanUseTaskProgressActions))]
    public async Task<ActionResult> MarkTravelTaskComplete(
        [AgentParam("Task number.", Required = true)]
        int taskNumber,
        [AgentParam("Whether the task is complete.")]
        bool completed = true)
    {
        var step = _taskProgressSteps.FirstOrDefault(x => x.Number == taskNumber);
        if (step is null)
        {
            return ActionResult.NeedsClarification("Unknown task number.");
        }

        step.Completed = completed;
        await RequestComponentRefreshAsync();
        return ActionResult.Applied($"Marked travel task {taskNumber} as {(completed ? "complete" : "incomplete")}.");
    }

    [AgentAction("Complete the next unfinished travel task.", AvailableWhen = nameof(CanUseTaskProgressActions))]
    public async Task<ActionResult> CompleteNextTask()
    {
        var next = _taskProgressSteps.FirstOrDefault(x => !x.Completed);
        if (next is null)
        {
            return ActionResult.Applied("All travel tasks are already complete.");
        }

        next.Completed = true;
        await RequestComponentRefreshAsync();
        return ActionResult.Applied($"Completed task {next.Number}: {next.Text}");
    }

    [AgentAction("Apply an editorial instruction to the predictive document.", AvailableWhen = nameof(CanUsePredictiveDocumentActions))]
    public async Task<ActionResult> ApplyPredictiveDocumentInstruction(
        [AgentParam("Editing instruction.", Required = true)]
        string instruction)
    {
        if (string.IsNullOrWhiteSpace(instruction))
        {
            return ActionResult.NeedsClarification("Provide an editing instruction.");
        }

        var normalized = instruction.Trim();
        _predictiveHasPendingChanges = true;
        _predictiveApprovalPrompt = "Do you want to accept the changes?";
        _predictiveAssistantMessage = $"I have updated the document to '{normalized}'. Let me know if you need any further adjustments.";

        if (normalized.Contains("bold", StringComparison.OrdinalIgnoreCase))
        {
            foreach (var line in _predictiveDocumentLines)
            {
                if (line.Kind == DojoDocumentLineKind.Accepted)
                {
                    line.Text = $"**{line.Text.Trim('*')}**";
                }
            }
        }

        await RequestComponentRefreshAsync();
        return ActionResult.Applied($"Applied the predictive document instruction '{normalized}'.");
    }

