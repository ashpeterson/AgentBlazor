    [AgentAction("Select dojo example by key or title without route navigation.")]
    public async Task<ActionResult> SetDojoExample(
        [AgentParam("Example key/title.", Required = true)]
        string example)
    {
        var resolved = ResolveExampleKey(example);
        if (resolved is null)
        {
            return ActionResult.NeedsClarification(
                $"Unknown dojo example '{example}'. Use one of: {string.Join(", ", _examples.Select(x => x.Key))}.");
        }

        _selectedExampleKey = resolved;
        _viewMode = DojoViewMode.Preview;
        SyncDojoExperienceState();
        await RequestComponentRefreshAsync();
        return ActionResult.Applied($"Selected dojo example '{resolved}'.");
    }

    [AgentAction("Switch dojo view mode between preview, code, and docs.")]
    public async Task<ActionResult> SetDojoView(
        [AgentParam("View mode value.", Required = true, AllowedValues = "preview,code,docs")]
        string viewMode)
    {
        if (!TryParseViewMode(viewMode, out var resolvedMode))
        {
            return ActionResult.NeedsClarification("Unknown view mode. Use preview, code, or docs.");
        }

        _viewMode = resolvedMode;
        SyncDojoExperienceState();
        await RequestComponentRefreshAsync();
        return ActionResult.Applied($"Switched dojo view to {ToViewModeKey(resolvedMode)}.");
    }

