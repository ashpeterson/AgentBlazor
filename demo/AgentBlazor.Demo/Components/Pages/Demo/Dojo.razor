    protected override async Task OnInitializedAsync()
    {
        _selectedIntegration = DojoExperience.SelectedIntegration;
        _selectedExampleKey = ResolveExampleKey(DojoExperience.SelectedExampleKey) ?? "shared-state";
        _viewMode = ParseViewMode(DojoExperience.SelectedViewMode);
        SyncDojoExperienceState();
        await LoadSnapshotAsync();
