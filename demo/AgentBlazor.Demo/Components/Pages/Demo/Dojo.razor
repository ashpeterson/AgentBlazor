    {
        if (string.IsNullOrWhiteSpace(integration))
        {
            return ActionResult.NeedsClarification("Provide an integration name.");
        }

        _selectedIntegration = integration.Trim();
        SyncDojoExperienceState();
        await RequestComponentRefreshAsync();
        return ActionResult.Applied($"Integration set to {_selectedIntegration}.");
