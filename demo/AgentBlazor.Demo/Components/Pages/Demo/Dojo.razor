        {
            DojoDeclarativeProtocol.A2Ui => _declarativePayload,
            DojoDeclarativeProtocol.OpenJsonUi => _declarativePayload,
            _ => JsonSerializer.Serialize(_declarativeDocument, AgentGenerativeUiSpec.JsonOptions)
        };

        return
        [
            new(
                "Renderer Host",
                "razor",
                "The Dojo keeps one native Blazor renderer and swaps the input document or imported payload.",
                """
                <AgentGenerativeSurface Document="@_declarativeDocument"
                                        CssClass="dojo-generated-surface"
                                        AgentName="Dojo Workspace Agent"
                                        ForwardActionsToRuntime="true"
                                        ShowRuntimeResponses="false" />
                """),
            new(
                "Protocol Switch Action",
                "csharp",
                "The agent changes protocol through one deterministic action instead of mounting a different renderer.",
                BuildActionSnippet(nameof(SwitchDeclarativeProtocol))),
            new(
                "Adapter Entry Points",
                "csharp",
                "These are the native AgentBlazor adapter calls used by the declarative pillar.",
                """
                _declarativeDocument =
                    AgentUiInterchangeAdapters.FromA2UiJsonLines(_declarativePayload, out _)
                    ?? CreateFallbackDeclarativeDocument("A2UI import unavailable", "No declarative UI blocks were produced.");

                _declarativeDocument =
                    AgentUiInterchangeAdapters.FromOpenJsonUi(_declarativePayload, out _)
                    ?? CreateFallbackDeclarativeDocument("Open-JSON-UI import unavailable", "No declarative UI blocks were produced.");
                """),
