    private static string ToViewModeKey(DojoViewMode viewMode) => viewMode switch
    {
        DojoViewMode.Code => "code",
        DojoViewMode.Docs => "docs",
        _ => "preview"
    };

    private static DojoViewMode ParseViewMode(string? value)
    {
        return value?.Trim().ToLowerInvariant() switch
        {
            "code" => DojoViewMode.Code,
            "docs" => DojoViewMode.Docs,
            _ => DojoViewMode.Preview
        };
    }

    private static bool TryParseViewMode(string? value, out DojoViewMode mode)
    {
        if (string.Equals(value, "code", StringComparison.OrdinalIgnoreCase))
        {
            mode = DojoViewMode.Code;
            return true;
        }

        if (string.Equals(value, "docs", StringComparison.OrdinalIgnoreCase))
        {
            mode = DojoViewMode.Docs;
            return true;
        }

        if (string.Equals(value, "preview", StringComparison.OrdinalIgnoreCase))
        {
            mode = DojoViewMode.Preview;
            return true;
        }

        mode = DojoViewMode.Preview;
        return false;
    }

    private static string? ResolveExampleKey(string? hint)
    {
        if (string.IsNullOrWhiteSpace(hint))
        {
            return null;
        }

        var trimmed = hint.Trim();
        var direct = _examples.FirstOrDefault(x => string.Equals(x.Key, trimmed, StringComparison.OrdinalIgnoreCase));
        if (direct is not null)
        {
            return direct.Key;
        }

        var normalized = NormalizeToken(trimmed);
        if (normalized.Length == 0)
        {
            return null;
        }

        if (_exampleAliases.TryGetValue(normalized, out var aliasTarget))
        {
            return aliasTarget;
        }

        foreach (var example in _examples)
        {
            var keyToken = NormalizeToken(example.Key);
            var titleToken = NormalizeToken(example.Title);
            if (string.Equals(keyToken, normalized, StringComparison.Ordinal) ||
                string.Equals(titleToken, normalized, StringComparison.Ordinal) ||
                keyToken.Contains(normalized, StringComparison.Ordinal) ||
                titleToken.Contains(normalized, StringComparison.Ordinal))
            {
                return example.Key;
            }
        }

        return null;
    }

    private static string NormalizeToken(string value) =>
        new(value.ToLowerInvariant().Where(char.IsLetterOrDigit).ToArray());

