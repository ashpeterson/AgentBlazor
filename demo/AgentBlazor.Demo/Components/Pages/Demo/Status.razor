@page "/demo/status"
@layout DemoLayout
@using AgentBlazor.Agents
@using AgentBlazor.Options
@using Microsoft.Extensions.Options
@inject IAgentRegistry AgentRegistry
@inject IComponentCapabilityCatalog ComponentCatalog
@inject IOptions<AgentBlazorOptions> AgentOptions

<PageTitle>AgentBlazor Status</PageTitle>

<MudPaper Class="demo-surface demo-hero pa-5" Elevation="0">
    <MudText Typo="Typo.h4" GutterBottom="true">Runtime Status</MudText>
    <MudText Typo="Typo.body2" Class="demo-subtitle">
        Live snapshot of configured provider, registered agents, and exposed component capabilities.
    </MudText>

    <MudGrid Class="mt-4">
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle2">Provider Kind</MudText>
                <MudText Typo="Typo.h6">@AgentOptions.Value.Provider.Kind</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.subtitle2">Provider Model</MudText>
                <MudText Typo="Typo.h6">@(AgentOptions.Value.Provider.Model ?? "(none)")</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudGrid Class="mt-4">
    <MudItem xs="12" lg="6">
        <MudPaper Class="demo-surface pa-4" Elevation="0">
            <MudText Typo="Typo.h6">Agents</MudText>
            <MudList T="string" Dense="true" Class="mt-2">
                @foreach (var agent in AgentRegistry.GetAll().OrderBy(a => a.Name))
                {
                    <MudListItem T="string">
                        <MudText Typo="Typo.subtitle2">@agent.Name</MudText>
                        @if (!string.IsNullOrWhiteSpace(agent.Description))
                        {
                            <MudText Typo="Typo.body2" Class="demo-muted">@agent.Description</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="6">
        <MudPaper Class="demo-surface pa-4" Elevation="0">
            <MudText Typo="Typo.h6">Component Capability Catalog</MudText>
            <MudTable Items="@_catalogRows" Dense="true" Hover="true" Bordered="true" Class="mt-2">
                <HeaderContent>
                    <MudTh>Component</MudTh>
                    <MudTh>Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Component">@context.ComponentId</MudTd>
                    <MudTd DataLabel="Actions">@context.ActionCount</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private IReadOnlyList<ComponentRow> _catalogRows = [];

    protected override void OnInitialized()
    {
        _catalogRows = ComponentCatalog.GetComponents()
            .OrderBy(static c => c.ComponentId, StringComparer.OrdinalIgnoreCase)
            .Select(static c => new ComponentRow(c.ComponentId, c.Actions.Count))
            .ToArray();
    }

    private sealed record ComponentRow(string ComponentId, int ActionCount);
}
