@page "/demo/workflows/response-orchestration"
@layout DemoLayout
@using AgentBlazor.Components
@using AgentBlazor.Core.Runtime.Interfaces
@using AgentBlazor.Demo.Services
@implements IDisposable
@inject ResponseOrchestrationWorkflowService Workflow
@inject IAgentComponentRegistry ComponentRegistry

<PageTitle>Response Orchestration Workflow</PageTitle>

<div class="workflow-board">
    <MudPaper Elevation="0" Class="workflow-board__hero">
        <div class="workflow-board__hero-top">
            <div>
                <p class="workflow-board__eyebrow">Primary live flow</p>
                <MudText Typo="Typo.h4">Response orchestration</MudText>
            </div>

            <div class="workflow-board__stat-strip">
                <span><strong>@GetWorkflowPhase()</strong><small>phase</small></span>
                <span><strong>@Workflow.Snapshot.HighlightedSupplierCount</strong><small>suppliers</small></span>
                <span><strong>@Workflow.Snapshot.VerifiedFileCount</strong><small>files</small></span>
                <span><strong>1</strong><small>approval</small></span>
            </div>
        </div>

        <div class="workflow-board__prompt-row">
            <span>Assess readiness</span>
            <span>Run next step</span>
            <span>Prepare packet</span>
            <a href="/demo/workflows/release-dossier?reset=true">Release proof</a>
        </div>

        @if (!string.IsNullOrWhiteSpace(ReturnedFrom))
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mt-3 mb-0">
                @Workflow.GetGuidedJourneySummary(ReturnedFrom, ReturnState)
            </MudAlert>
        }

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunPrimaryActionAsync">
                @GetPrimaryActionLabel()
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Info" OnClick="ResetAsync">
                Reset
            </MudButton>
        </MudStack>

        <MudGrid Spacing="2" Class="mt-4">
            @foreach (var step in Workflow.GetJourneySteps(ReturnedFrom))
            {
                <MudItem xs="12" sm="6" lg="3">
                    <MudPaper Class="workflow-board__journey-card" Outlined="true">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.subtitle2">@step.Title</MudText>
                            <MudChip T="string" Color="@GetStepColor(step.Status)" Variant="@(step.Status == ResponseOrchestrationJourneyStepStatus.Complete ? Variant.Filled : Variant.Outlined)" Size="Size.Small">
                                @GetStepLabel(step.Status)
                            </MudChip>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                            @step.Phase
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-2">
                            @step.Summary
                        </MudText>
                        @if (!string.IsNullOrWhiteSpace(step.Route))
                        {
                            <MudButton Variant="Variant.Text" Color="@GetStepColor(step.Status)" Href="@step.Route" Class="mt-2 px-0">
                                Open
                            </MudButton>
                        }
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </MudPaper>

    <section class="demo-doc-page__section">
        <MudPaper Class="workflow-board__preview-card" Outlined="true">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h6">Packet preview</MudText>
                <MudChip T="string" Color="@GetOutcomeChipColor()" Variant="Variant.Outlined" Size="Size.Small">
                    @GetWorkflowPhase()
                </MudChip>
            </MudStack>

            @if (Workflow.CurrentPacket is { } packet)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-3">@packet.Title</MudText>
                <MudText Typo="Typo.caption" Class="d-block mb-2">
                    Incident: @packet.IncidentId • Suppliers: @string.Join(", ", packet.SupplierIds)
                </MudText>
                <MudList T="string" Dense="true">
                    @foreach (var packetSection in packet.Sections)
                    {
                        <MudListItem T="string">@packetSection</MudListItem>
                    }
                </MudList>
            }
            else if (Workflow.LatestBlockers.Count > 0)
            {
                <MudList T="string" Dense="true" Class="mt-3">
                    @foreach (var blocker in Workflow.LatestBlockers)
                    {
                        <MudListItem T="string">@blocker</MudListItem>
                    }
                </MudList>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mt-3">@GetNextStepSummary()</MudText>
            }
        </MudPaper>
    </section>

    <AgentDialog AgentId="response-orchestration-dialog"
                 Visible="@Workflow.IsPacketDialogOpen"
                 VisibleChanged="OnPacketVisibilityChanged">
        <TitleContent>
            <MudText Typo="Typo.h6">Cross-system response packet</MudText>
        </TitleContent>
        <DialogContent>
            @if (Workflow.CurrentPacket is { } packet)
            {
                <MudText Typo="Typo.body2" Class="mb-2">
                    This packet brings the supplier, evidence, and incident systems into one approval surface.
                </MudText>
                <MudList T="string" Dense="true" Class="mb-3">
                    @foreach (var packetSection in packet.Sections)
                    {
                        <MudListItem T="string">@packetSection</MudListItem>
                    }
                </MudList>
                <MudText Typo="Typo.subtitle2">Handoff checklist</MudText>
                <MudList T="string" Dense="true">
                    @foreach (var item in packet.HandoffChecklist)
                    {
                        <MudListItem T="string">@item</MudListItem>
                    }
                </MudList>
            }
            else
            {
                <MudText Typo="Typo.body2">No response packet is active.</MudText>
            }
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ClosePacketAsync">
                Close packet
            </MudButton>
        </DialogActions>
    </AgentDialog>
</div>

@code {
    [SupplyParameterFromQuery(Name = "returnedFrom")] public string? ReturnedFrom { get; set; }
    [SupplyParameterFromQuery(Name = "returnState")] public string? ReturnState { get; set; }
    [SupplyParameterFromQuery(Name = "reset")] public bool? ResetDemo { get; set; }

    private string? _lastProcessedReturnKey;
    private string? _lastResetKey;

    protected override async Task OnInitializedAsync()
    {
        Workflow.Changed += HandleWorkflowChanged;
        await Workflow.LoadAsync(ComponentRegistry.SessionId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ResetDemo is true)
        {
            var resetKey = $"response|{ComponentRegistry.SessionId}";
            if (!string.Equals(_lastResetKey, resetKey, StringComparison.Ordinal))
            {
                _lastResetKey = resetKey;
                Workflow.Reset();
                await Workflow.LoadAsync(ComponentRegistry.SessionId);
            }
        }
        else
        {
            _lastResetKey = null;
        }

        if (string.IsNullOrWhiteSpace(ReturnedFrom))
        {
            _lastProcessedReturnKey = null;
            return;
        }

        var returnKey = $"{ReturnedFrom}|{ReturnState}|{ComponentRegistry.SessionId}";
        if (string.Equals(_lastProcessedReturnKey, returnKey, StringComparison.Ordinal))
        {
            return;
        }

        _lastProcessedReturnKey = returnKey;
        await Workflow.ProcessGuidedReturnAsync(ComponentRegistry.SessionId, ReturnedFrom, ReturnState);
    }

    private Task AssessAsync()
        => Workflow.AssessResponseReadinessAsync(ComponentRegistry.SessionId);

    private Task RunPrimaryActionAsync()
    {
        if (Workflow.CurrentPacket is not null)
        {
            Workflow.SetPacketDialogVisible(true);
            return Task.CompletedTask;
        }

        if (Workflow.LatestBlockers.Count > 0)
        {
            return ApplyRecoveryAsync();
        }

        if (GetNextGuidedRoute() is not null)
        {
            return AdvanceNextStageAsync();
        }

        if (HasAssessmentState())
        {
            return PreparePacketAsync();
        }

        return AssessAsync();
    }

    private Task AdvanceNextStageAsync()
        => Workflow.AdvanceNextStageAsync(ComponentRegistry.SessionId);

    private Task PreparePacketAsync()
        => Workflow.PrepareResponsePacketAsync(ComponentRegistry.SessionId);

    private Task ApplyRecoveryAsync()
        => Workflow.ApplyRecoveryPlaybookAsync(ComponentRegistry.SessionId);

    private Task ResetAsync()
    {
        Workflow.Reset();
        return Task.CompletedTask;
    }

    private Task ClosePacketAsync()
    {
        Workflow.SetPacketDialogVisible(false);
        return Task.CompletedTask;
    }

    private Task OnPacketVisibilityChanged(bool visible)
    {
        Workflow.SetPacketDialogVisible(visible);
        return Task.CompletedTask;
    }

    private string GetPrimaryActionLabel()
    {
        if (Workflow.CurrentPacket is not null)
        {
            return "Open packet";
        }

        if (Workflow.LatestBlockers.Count > 0)
        {
            return "Run recovery";
        }

        if (GetNextGuidedRoute() is not null)
        {
            return "Run next step";
        }

        return HasAssessmentState() ? "Prepare packet" : "Assess";
    }

    private bool HasAssessmentState() =>
        !string.Equals(Workflow.Snapshot.SupplierPhase, "Idle", StringComparison.OrdinalIgnoreCase) ||
        !string.Equals(Workflow.Snapshot.FileBundlePhase, "Idle", StringComparison.OrdinalIgnoreCase) ||
        !string.Equals(Workflow.Snapshot.IncidentPhase, "Idle", StringComparison.OrdinalIgnoreCase) ||
        Workflow.Snapshot.HighlightedSupplierCount > 0 ||
        Workflow.Snapshot.VerifiedFileCount > 0;

    private string GetWorkflowPhase() =>
        Workflow.CurrentPacket is not null
            ? "Response packet ready"
            : Workflow.LatestBlockers.Count > 0
                ? "Recovery required"
                : Workflow.Snapshot.HighlightedSupplierCount > 0 || Workflow.Snapshot.FileSnapshot.Files.Count > 0
                    ? "Readiness assessed"
                    : "Awaiting orchestration";

    private string GetNextStepSummary()
    {
        if (Workflow.CurrentPacket is not null)
        {
            return Workflow.IsPacketDialogOpen
                ? "Review the cross-system packet in the dialog and decide whether to approve the operational handoff."
                : "Reopen the packet dialog or approve the downstream handoff.";
        }

        if (Workflow.LatestBlockers.Count > 0)
        {
            return "Apply the cross-system recovery playbook to align supplier, evidence, and incident state before preparing the packet again.";
        }

        return "Assess readiness first, then prepare the response packet once the subsystem phases are aligned.";
    }

    private string? GetNextGuidedRoute() => Workflow.GetNextGuidedWorkflowRoute(ReturnedFrom);

    private Color GetOutcomeChipColor()
    {
        if (Workflow.CurrentPacket is not null)
        {
            return Color.Success;
        }

        return Workflow.LatestBlockers.Count > 0 ? Color.Warning : Color.Primary;
    }

    private static string GetStepLabel(ResponseOrchestrationJourneyStepStatus status) => status switch
    {
        ResponseOrchestrationJourneyStepStatus.Complete => "Complete",
        ResponseOrchestrationJourneyStepStatus.Blocked => "Blocked",
        ResponseOrchestrationJourneyStepStatus.Current => "Current",
        _ => "Pending"
    };

    private static Color GetStepColor(ResponseOrchestrationJourneyStepStatus status) => status switch
    {
        ResponseOrchestrationJourneyStepStatus.Complete => Color.Success,
        ResponseOrchestrationJourneyStepStatus.Blocked => Color.Warning,
        ResponseOrchestrationJourneyStepStatus.Current => Color.Primary,
        _ => Color.Secondary
    };

    private void HandleWorkflowChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Workflow.Changed -= HandleWorkflowChanged;
    }
}
