@page "/demo"
@layout DemoLayout
@using AgentBlazor.Components
@using MudBlazor

<PageTitle>AgentBlazor Demo</PageTitle>

<div class="demo-home">
    <!-- Hero Section -->
    <section class="demo-home__hero">
        <div class="demo-home__hero-bg">
            <div class="demo-home__orb demo-home__orb--1"></div>
            <div class="demo-home__orb demo-home__orb--2"></div>
            <div class="demo-home__grid"></div>
        </div>

        <div class="demo-home__hero-content">
            <h1 class="demo-home__title">
                Talk to your <span class="demo-home__accent">Blazor App</span>
            </h1>
            <p class="demo-home__subtitle">
                Run a real end-to-end workflow: submit onboarding, review suppliers, and generate live charts from persisted app data.
            </p>

            <AgentChatBar Placeholder="Try: show overdue records"
                          Suggestions="_suggestions"
                          ShowTimeline="true"
                          ShowClearButton="true"
                          ClearButtonText="Clear conversation" />
        </div>
    </section>

    <!-- Quick Links -->
    <section class="demo-home__links">
        <a href="demo/workflow" class="demo-home__link-card">
            <MudIcon Icon="@Icons.Material.Filled.Hub" Size="Size.Large" />
            <span>Complex Workflow</span>
            <small>Queue + suppliers + generated UI</small>
        </a>
        <a href="demo/suppliers" class="demo-home__link-card">
            <MudIcon Icon="@Icons.Material.Filled.TableChart" Size="Size.Large" />
            <span>Data Grid</span>
            <small>Filter, sort, and focus rows</small>
        </a>
        <a href="demo/generative-ui" class="demo-home__link-card">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Size="Size.Large" />
            <span>Generative UI</span>
            <small>Prompt to generated blocks and actions</small>
        </a>
        <a href="demo/workspace" class="demo-home__link-card">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Large" />
            <span>Workspace</span>
            <small>Navigate tabs and pages</small>
        </a>
        <a href="demo/onboarding" class="demo-home__link-card">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" />
            <span>Form Workflow</span>
            <small>Forms and dialogs</small>
        </a>
        <a href="demo/status" class="demo-home__link-card">
            <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="Size.Large" />
            <span>Status</span>
            <small>Runtime telemetry</small>
        </a>
    </section>
</div>

@code {
    private static readonly IReadOnlyList<string> _suggestions =
    [
        "open onboarding and draft a new supplier request",
        "go to workflow and sort onboarding queue by priority",
        "go to suppliers and show high risk rows first",
        "switch to the Risk tab in workspace",
        "summarize this page as generated ui",
        "show supplier risk by region as a chart"
    ];
}
