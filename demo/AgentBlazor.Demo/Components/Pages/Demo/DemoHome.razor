@page "/demo"
@layout DemoLayout
@using MudBlazor
@inject NavigationManager NavigationManager

<PageTitle>Demo — AgentBlazor</PageTitle>

<div class="launchpad">
    <MudPaper Elevation="0" Class="launchpad__hero">
        <div class="launchpad__hero-copy">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">Opening demo</MudChip>
            <MudText Typo="Typo.h4" Class="mt-4 mb-2">Loading response orchestration…</MudText>
        </div>
        <div class="launchpad__hero-actions">
            <MudButton Variant="Variant.Text" Color="Color.Secondary" Href="/demo/workflows/response-orchestration?reset=true">
                Open now
            </MudButton>
        </div>
    </MudPaper>
</div>

@code {
    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        NavigationManager.NavigateTo("/demo/workflows/response-orchestration?reset=true", replace: true);
    }
}
