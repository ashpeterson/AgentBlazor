@page "/demo"
@layout DemoLayout
@using AgentBlazor.Components
@using MudBlazor

<PageTitle>AgentBlazor Demo</PageTitle>

<div class="demo-home">
    <!-- Hero Section -->
    <section class="demo-home__hero">
        <div class="demo-home__hero-bg">
            <div class="demo-home__orb demo-home__orb--1"></div>
            <div class="demo-home__orb demo-home__orb--2"></div>
            <div class="demo-home__grid"></div>
        </div>

        <div class="demo-home__hero-content">
            <h1 class="demo-home__title">
                Talk to your <span class="demo-home__accent">Supplier Platform</span>
            </h1>
            <p class="demo-home__subtitle">
                Use natural language to filter data, navigate pages, switch tabs, and control UI components.
            </p>

            <AgentChatBar Placeholder="Try: show me high risk suppliers"
                          Suggestions="_suggestions"
                          ShowTimeline="true"
                          ShowClearButton="true"
                          ClearButtonText="Clear conversation" />
        </div>
    </section>

    <!-- Quick Links -->
    <section class="demo-home__links">
        <a href="demo/suppliers" class="demo-home__link-card">
            <MudIcon Icon="@Icons.Material.Filled.TableChart" Size="Size.Large" />
            <span>Suppliers Grid</span>
            <small>Filter, sort, and focus rows</small>
        </a>
        <a href="demo/workspace" class="demo-home__link-card">
            <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Large" />
            <span>Workspace</span>
            <small>Navigate tabs and pages</small>
        </a>
        <a href="demo/onboarding" class="demo-home__link-card">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Large" />
            <span>Onboarding</span>
            <small>Forms and dialogs</small>
        </a>
        <a href="demo/status" class="demo-home__link-card">
            <MudIcon Icon="@Icons.Material.Filled.MonitorHeart" Size="Size.Large" />
            <span>Status</span>
            <small>Runtime telemetry</small>
        </a>
    </section>
</div>

@code {
    private static readonly IReadOnlyList<string> _suggestions =
    [
        "show me high risk suppliers",
        "go to workspace and switch to Risk tab",
        "navigate to onboarding",
        "sort suppliers by risk descending"
    ];
}
