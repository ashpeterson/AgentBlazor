@page "/demo"
@layout DemoLayout
@using MudBlazor

<PageTitle>Demo — AgentBlazor</PageTitle>

<div class="demo-overview">
    <MudPaper Elevation="1" Class="demo-overview__hero">
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">Focused Demo Surface</MudChip>
        <MudText Typo="Typo.h4" Class="mt-3 mb-1">AgentBlazor Dojo + Component Explorer</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            The demo is now intentionally reduced to a CopilotKit-style dojo workspace and a MudBlazor-style component explorer,
            with side-by-side compatibility proofs and a dedicated attribute-based parity example.
        </MudText>

        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/demo/dojo">
                Open Dojo
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/demo/components">
                Open Components
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Warning" Href="/demo/workflows/supplier-compliance">
                Workflow Showcase
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Info" Href="/demo/components/attribute-based">
                Attribute-Based Example
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Success" Href="/demo/components/parity/form">
                Compatibility Proofs
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudGrid Spacing="2" Class="mt-2">
        <MudItem xs="12" md="6">
            <MudPaper Class="demo-overview__card">
                <MudText Typo="Typo.subtitle1">Dojo</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Single-canvas workspace intended for assistant-led edits and approvals.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="demo-overview__card">
                <MudText Typo="Typo.subtitle1">Components</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Expandable component catalog covering all currently shipped wrappers.
                </MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Class="demo-overview__card">
                <MudText Typo="Typo.subtitle1">Workflow Showcase</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Production-style supplier compliance workflow driven by semantic capabilities, explanations, and approval-gated drafts.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</div>
