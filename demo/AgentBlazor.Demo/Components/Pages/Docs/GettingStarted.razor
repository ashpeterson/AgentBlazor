@page "/docs/getting-started"
@layout DocsLayout
@using MudBlazor

<PageTitle>Getting Started — AgentBlazor Docs</PageTitle>

<div class="guide-page">
    <section class="guide-page__hero">
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">Getting Started</MudChip>
        <MudText Typo="Typo.h3" Class="mt-4 mb-2">From empty app to first workflow.</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            One package. One workflow. One route. One chat surface.
        </MudText>
    </section>

    <section class="guide-page__section">
        <MudText Typo="Typo.h5">1. Install</MudText>
        <pre class="guide-page__code"><code>dotnet add package AgentBlazor</code></pre>
    </section>

    <section class="guide-page__section">
        <MudText Typo="Typo.h5">2. Register</MudText>
        <pre class="guide-page__code"><code>builder.Services.AddAgentBlazor(options =&gt;
{
    // Use OpenAI (or UseOllama for local)
    options.UseOpenAI(
        apiKey: builder.Configuration["OpenAI:ApiKey"]!,
        model: "gpt-4o-mini");

    // Optional: Enable Pro tier features
    // options.UseProLicense("AB-PRO-YOUR-KEY-HERE");

    options.ConfigureBuilder(agentBuilder =&gt;
    {
        // Register your workflow capability
        agentBuilder.AddWorkflow&lt;OperationsCapabilities&gt;(
            "Operations Agent",
            agent =&gt;
            {
                agent.WithDescription("Handles workflow assessment and remediation.");
                agent.WithRoutePrefixes("/ops");
            });
    });
});</code></pre>
    </section>

    <section class="guide-page__section">
        <MudText Typo="Typo.h5">3. Define Capabilities</MudText>
        <pre class="guide-page__code"><code>using AgentBlazor.App;
using AgentBlazor.Attributes;

[AgentCapability("operations",
    Name = "Operations Workflow",
    Description = "Assess workflow readiness and prepare remediation.",
    Category = "Workflow")]
public sealed class OperationsCapabilities(IOperationsService ops)
{
    [AgentAction("Assess current workflow readiness")]
    public Task&lt;CapabilityResult&gt; AssessReadinessAsync()
    {
        var summary = ops.GetReadinessSummary();
        return Task.FromResult(CapabilityResult.Success(summary) with
        {
            NextActions = ["Explain blockers", "Prepare remediation"]
        });
    }

    [AgentAction("Prepare remediation draft", RequiresApproval = true)]
    public Task&lt;CapabilityResult&gt; PrepareRemediationAsync(
        [AgentParam("Target area")] string area)
    {
        var draft = ops.PrepareRemediation(area);
        return Task.FromResult(CapabilityResult.Success(draft));
    }
}</code></pre>
    </section>

    <section class="guide-page__section">
        <MudText Typo="Typo.h5">4. Render</MudText>
        <pre class="guide-page__code"><code>&lt;AgentChatWidget
    Title="Operations"
    Placeholder="Ask the agent to assess, prepare, or advance the workflow..."
    Width="30rem"
    Height="68vh" /&gt;</code></pre>
    </section>

    <section class="guide-page__section">
        <MudText Typo="Typo.h5">5. Run</MudText>
        <div class="guide-page__chips">
            <span>Assess the workflow</span>
            <span>Explain blockers</span>
            <span>Prepare the draft</span>
        </div>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-3">
            See the <MudLink Href="/demo/components">component explorer</MudLink> for all 14 agentic components.
        </MudText>
    </section>

    <section class="guide-page__footer">
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/docs">
            Back
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/demo/workflows/response-orchestration?reset=true">
            Open live demo
        </MudButton>
    </section>
</div>
