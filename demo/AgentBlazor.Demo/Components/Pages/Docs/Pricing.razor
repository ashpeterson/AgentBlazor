@page "/docs/pricing"
@layout DocsLayout
@using MudBlazor

<PageTitle>Pricing & Tiers — AgentBlazor Docs</PageTitle>

<div class="docs-article">
    <section class="docs-hero">
        <p class="docs-hero__eyebrow">Pricing</p>
        <h1 class="docs-hero__title">Free ships the workflow. Pro adds durable intelligence.</h1>
        <p class="docs-hero__lede">
            Free proves the product in the app. Pro adds persistent history, analytics, audit, and smarter suggestions.
        </p>
    </section>

    <section class="docs-section">
        <div class="docs-section__header">
            <div>
                <h2>Current tiers</h2>
            </div>
        </div>

        <div class="docs-card-grid">
            <div class="docs-card"><strong>Free</strong><p>Runtime, workflows, components, and chat surfaces.</p></div>
            <div class="docs-card"><strong>Pro</strong><p>Persistent history, analytics, audit, and suggestions.</p></div>
            <div class="docs-card"><strong>Enterprise</strong><p>Governance, support, and larger org requirements.</p></div>
        </div>
    </section>

    <section class="docs-section">
        <div class="docs-section__header">
            <div>
                <h2>Enable Pro</h2>
            </div>
        </div>

        <pre class="docs-code"><code>builder.Services.AddAgentBlazor(options =&gt;
{
    options.UseOpenAI(apiKey, "gpt-5.4-mini");
    options.UseProLicense("AB-PRO-YOUR-LICENSE-KEY");
});</code></pre>
    </section>
</div>
