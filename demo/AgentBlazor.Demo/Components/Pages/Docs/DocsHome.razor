@page "/docs"
@layout DocsLayout
@using MudBlazor

<PageTitle>Docs — AgentBlazor</PageTitle>

<div class="docs-article">
    <section class="docs-hero">
        <p class="docs-hero__eyebrow">Documentation</p>
        <h1 class="docs-hero__title">Install it. Run one route. Prove it works.</h1>
        <p class="docs-hero__lede">
            Start with one Blazor route, one workflow, and one chat surface. The reference route is the support inbox demo.
        </p>

        <div class="docs-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/docs/getting-started">Start setup</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/demo">Open demo</MudButton>
        </div>

        <div class="docs-kpi-grid">
            <div class="docs-kpi">
                <strong>Default path</strong>
                <span><code>package</code> -> <code>Program.cs</code> -> <code>one workflow</code></span>
            </div>
            <div class="docs-kpi">
                <strong>Verification first</strong>
                <span>build, run, then test prompts on a real route</span>
            </div>
            <div class="docs-kpi">
                <strong>CLI is advanced</strong>
                <span>keep it out of the first install unless manual setup is too slow</span>
            </div>
        </div>
    </section>

    <section class="docs-section">
        <div class="docs-section__header">
            <div>
                <h2>Manual start order</h2>
            </div>
        </div>

        <pre class="docs-code"><code>dotnet add package AgentBlazor --version 0.1.0-preview.11
builder.Services.AddAgentBlazor(...)
app.MapAgentBlazorEndpoints()
Render one chat surface on one route
dotnet build
dotnet run</code></pre>
    </section>

    <section class="docs-section">
        <div class="docs-section__header">
            <div>
                <h2>Read these pages next</h2>
            </div>
        </div>

        <div class="docs-link-grid">
            <a href="/docs/getting-started" class="docs-link-card">
                <strong>Getting Started</strong>
                <p>Package source, install path, first workflow.</p>
            </a>
            <a href="/docs/cli" class="docs-link-card">
                <strong>Advanced CLI</strong>
                <p>Scaffold help for existing apps after the manual path works.</p>
            </a>
            <a href="/docs/verification" class="docs-link-card">
                <strong>Verification</strong>
                <p>How to prove the install works.</p>
            </a>
            <a href="/docs/hosting-models" class="docs-link-card">
                <strong>Hosting</strong>
                <p>Standard, hosted WASM, and review-first hosts.</p>
            </a>
            <a href="/docs/workflows" class="docs-link-card">
                <strong>Workflows</strong>
                <p>Capability class and route scoping.</p>
            </a>
            <a href="/docs/components" class="docs-link-card">
                <strong>Components</strong>
                <p>Chat surfaces and deterministic wrappers.</p>
            </a>
        </div>
    </section>
</div>
