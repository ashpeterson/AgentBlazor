@page "/docs/demo-tour"
@layout DocsLayout
@using MudBlazor

<PageTitle>Demo Tour — AgentBlazor Docs</PageTitle>

<div class="docs-article">
    <section class="docs-hero">
        <p class="docs-hero__eyebrow">Demo Tour</p>
        <h1 class="docs-hero__title">The demo is a small funnel.</h1>
        <p class="docs-hero__lede">
            Start with the support inbox route. Use preserved workflow routes and components as supporting reference.
        </p>
    </section>

    <section class="docs-section">
        <div class="docs-section__header">
            <div>
                <h2>Main routes</h2>
            </div>
        </div>

        <div class="docs-definition-grid">
            <div class="docs-definition"><strong><code>/</code></strong><p>Landing page.</p></div>
            <div class="docs-definition"><strong><code>/docs</code></strong><p>Developer docs.</p></div>
            <div class="docs-definition"><strong><code>/demo/workflows/support-inbox</code></strong><p>Main demo route.</p></div>
            <div class="docs-definition"><strong><code>/demo/workflows/response-orchestration?reset=true</code></strong><p>Preserved advanced workflow route.</p></div>
            <div class="docs-definition"><strong><code>/demo/components</code></strong><p>Component reference.</p></div>
        </div>
    </section>
</div>
