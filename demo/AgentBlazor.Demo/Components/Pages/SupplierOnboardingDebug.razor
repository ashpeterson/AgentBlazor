@page "/supplier-onboarding-debug"
@using System.ComponentModel.DataAnnotations
@using AgentBlazor.Components
@using MudBlazor

<PageTitle>Supplier Onboarding Debug</PageTitle>

<MudPaper Class="pa-4 agent-dialog-form-demo__panel" Elevation="1">
    <MudText Typo="Typo.h4">AgentDialog + AgentForm Debug</MudText>
    <MudText Typo="Typo.body2" Class="agent-dialog-form-demo__subtitle">
        This page uses only wrapper components. Ask the agent to open/close dialog, set fields, validate, and submit.
    </MudText>

    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenDialogAsync">
        Open Dialog
    </MudButton>
</MudPaper>

<AgentDialog @ref="_dialog"
             AgentId="supplier-onboarding-dialog-debug">
    <TitleContent>
        <MudText Typo="Typo.h6">Supplier Onboarding Dialog</MudText>
    </TitleContent>
    <DialogContent>
        <AgentForm AgentId="supplier-onboarding-form-debug"
                   Model="@_model"
                   Submitted="OnSubmitted">
            <ChildContent Context="formContext">
                <DataAnnotationsValidator />
                <MudTextField T="string"
                              Label="Supplier name"
                              For="@(() => _model.SupplierName)"
                              @bind-Value="_model.SupplierName" />
                <MudTextField T="string"
                              Label="Contact email"
                              For="@(() => _model.ContactEmail)"
                              @bind-Value="_model.ContactEmail" />
                <MudTextField T="string"
                              Label="Risk tier"
                              For="@(() => _model.RiskTier)"
                              @bind-Value="_model.RiskTier" />
                <MudNumericField T="decimal"
                                 Label="Requested budget"
                                 For="@(() => _model.RequestedBudget)"
                                 @bind-Value="_model.RequestedBudget"
                                 Adornment="Adornment.End"
                                 AdornmentText="USD" />
            </ChildContent>
        </AgentForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="CloseDialogAsync">
            Close
        </MudButton>
    </DialogActions>
</AgentDialog>

<MudPaper Class="pa-4 mt-4 agent-dialog-form-demo__panel" Elevation="1">
    <AgentChatWidget
        Title="Supplier Onboarding Agent Chat"
        Description="Try: open dialog, set SupplierName to Contoso, validate form, submit form." />
</MudPaper>

@code {
    private AgentDialog? _dialog;
    private readonly SupplierOnboardingModel _model = new();

    private Task OpenDialogAsync() => _dialog?.Open() ?? Task.CompletedTask;

    private Task CloseDialogAsync() => _dialog?.Close() ?? Task.CompletedTask;

    private Task OnSubmitted() => CloseDialogAsync();

    private sealed class SupplierOnboardingModel
    {
        [Required]
        public string SupplierName { get; set; } = string.Empty;

        [Required, EmailAddress]
        public string ContactEmail { get; set; } = string.Empty;

        [Required]
        public string RiskTier { get; set; } = string.Empty;

        [Range(typeof(decimal), "0.01", "1000000000")]
        public decimal RequestedBudget { get; set; }
    }
}
