@page "/counter"
@rendermode InteractiveServer

<PageTitle>Counter</PageTitle>

<MudPaper Class="demo-surface pa-5" Elevation="0">
    <MudText Typo="Typo.h4" GutterBottom="true">Counter</MudText>
    <MudText Typo="Typo.body2" Class="demo-subtitle">
        Minimal interactive page styled to match the demo shell.
    </MudText>

    <MudStack Spacing="2" Class="mt-4">
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
            Current count: @currentCount
        </MudChip>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="IncrementCount">
            Increment
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    private int currentCount;

    private void IncrementCount()
    {
        currentCount++;
    }
}
