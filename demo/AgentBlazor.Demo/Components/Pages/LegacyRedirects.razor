@page "/debug"
@page "/agent-routing-demo"
@page "/agent-grid-demo"
@page "/suppliers-debug"
@page "/supplier-onboarding-debug"
@page "/workspace-debug"
@page "/demo/workspace"
@page "/agentblazor-status"
@page "/suppliers"
@page "/supplier-onboarding"
@page "/workspace"
@page "/demo/suppliers"
@page "/demo/onboarding"
@page "/demo/workflow"
@page "/demo/generative-ui"
@page "/demo/status"
@page "/demo/docs"
@page "/demo/examples/supplier-dashboard"
@page "/demo/dashboard"
@page "/demo/compare/wrappers"
@page "/demo/compare/attributes"
@inject NavigationManager Navigation

<PageTitle>Redirecting...</PageTitle>

<MudText Typo="Typo.body2">Redirecting to the updated demo flow...</MudText>

@code {
    protected override void OnInitialized()
    {
        var route = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].ToLowerInvariant();

        var target = route switch
        {
            "agent-grid-demo" => "/demo/components/datagrid",
            "suppliers-debug" => "/demo/components/datagrid",
            "suppliers" => "/demo/components/datagrid",
            "supplier-onboarding-debug" => "/demo/components/form",
            "supplier-onboarding" => "/demo/components/form",
            "workspace-debug" => "/demo/dojo",
            "workspace" => "/demo/dojo",
            "demo/workspace" => "/demo/dojo",
            "agentblazor-status" => "/demo/components",
            "agent-routing-demo" => "/demo",
            "demo/suppliers" => "/demo/components/datagrid",
            "demo/onboarding" => "/demo/components/form",
            "demo/workflow" => "/demo/dojo",
            "demo/generative-ui" => "/demo/components",
            "demo/status" => "/demo/components",
            "demo/docs" => "/demo/components",
            "demo/examples/supplier-dashboard" => "/demo/dojo",
            "demo/dashboard" => "/demo/dojo",
            "demo/compare/wrappers" => "/demo/components",
            "demo/compare/attributes" => "/demo/components/attribute-based",
            "debug" => "/demo",
            _ => "/demo"
        };

        Navigation.NavigateTo(target, replace: true);
    }
}
