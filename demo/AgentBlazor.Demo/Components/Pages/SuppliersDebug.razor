@page "/suppliers-debug"
@using AgentBlazor.Components
@using AgentBlazor.Demo.Models
@using AgentBlazor.Demo.Services
@using MudBlazor
@inject SupplierWorkflowService WorkflowService

<PageTitle>Suppliers Debug</PageTitle>

<MudPaper Class="pa-4 agent-grid-demo__panel" Elevation="1">
    <MudText Typo="Typo.h4">AgentDataGrid Debug</MudText>
    <MudText Typo="Typo.body2" Class="agent-grid-demo__subtitle">
        This page uses only the AgentDataGrid wrapper. Ask for filter/sort/page/focus actions and inspect live wrapper state.
    </MudText>

    <MudStack Row="true" Spacing="1" Class="my-3">
        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">
            Ask the agent to filter, sort, page, or focus rows
        </MudChip>
    </MudStack>

    <AgentDataGrid TItem="SupplierRow"
                   AgentId="supplier-grid-debug"
                   Items="@_suppliers"
                   Dense="true"
                   Hover="true"
                   Bordered="true"
                   Striped="true"
                   RowKeyProperty="SupplierId">
        <Columns>
            <PropertyColumn T="SupplierRow" TProperty="string" Property="x => x.SupplierId" Title="Supplier ID" />
            <PropertyColumn T="SupplierRow" TProperty="string" Property="x => x.SupplierName" Title="Supplier" />
            <PropertyColumn T="SupplierRow" TProperty="string" Property="x => x.Region" Title="Region" />
            <PropertyColumn T="SupplierRow" TProperty="int" Property="x => x.RiskScore" Title="Risk Score" />
            <PropertyColumn T="SupplierRow" TProperty="DateTime" Property="x => x.LastAuditDate" Title="Last Audit" Format="yyyy-MM-dd" />
        </Columns>
    </AgentDataGrid>
</MudPaper>

<MudPaper Class="pa-4 mt-4 agent-grid-demo__panel" Elevation="1">
    <AgentChatWidget
        Title="Agent Chat"
        Description="Try prompts like: sort suppliers ascending, filter risk score <= 50, focus supplier SUP-010." />
</MudPaper>

@code {
    private List<SupplierRow> _suppliers = [];

    protected override async Task OnInitializedAsync()
    {
        _suppliers = (await WorkflowService.ListSuppliersAsync(CancellationToken.None)).ToList();
    }
}
