@using MudBlazor

<section class="landing-reviews" id="reviews">
    <div class="landing-reviews__container">
        <div class="landing-reviews__header">
            <h2 class="landing-reviews__title">What Our Customers Say</h2>
            <p class="landing-reviews__subtitle">
                Teams are building smarter applications with AgentBlazor.
            </p>
        </div>

        <div class="landing-reviews__grid">
            <article class="landing-review">
                <div class="landing-review__stars">
                    @for (int i = 0; i < 5; i++)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" />
                    }
                </div>
                <blockquote class="landing-review__quote">
                    "AgentBlazor transformed how our users interact with complex data grids.
                    Natural language filtering reduced our support tickets by 40%."
                </blockquote>
                <div class="landing-review__author">
                    <div class="landing-review__avatar">SM</div>
                    <div class="landing-review__info">
                        <div class="landing-review__name">Sarah Mitchell</div>
                        <div class="landing-review__role">CTO, DataFlow Inc.</div>
                    </div>
                </div>
            </article>

            <article class="landing-review">
                <div class="landing-review__stars">
                    @for (int i = 0; i < 5; i++)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" />
                    }
                </div>
                <blockquote class="landing-review__quote">
                    "The approval workflow feature gives us confidence to deploy AI-powered
                    interfaces in regulated industries. Exactly what we needed."
                </blockquote>
                <div class="landing-review__author">
                    <div class="landing-review__avatar">JC</div>
                    <div class="landing-review__info">
                        <div class="landing-review__name">James Chen</div>
                        <div class="landing-review__role">Lead Developer, FinTech Solutions</div>
                    </div>
                </div>
            </article>

            <article class="landing-review">
                <div class="landing-review__stars">
                    @for (int i = 0; i < 5; i++)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" />
                    }
                </div>
                <blockquote class="landing-review__quote">
                    "Integration was seamless. We wrapped our existing MudBlazor components
                    and had AI control working within a day. Impressive documentation too."
                </blockquote>
                <div class="landing-review__author">
                    <div class="landing-review__avatar">AR</div>
                    <div class="landing-review__info">
                        <div class="landing-review__name">Alex Rodriguez</div>
                        <div class="landing-review__role">Software Architect, CloudOps</div>
                    </div>
                </div>
            </article>
        </div>
    </div>
</section>
