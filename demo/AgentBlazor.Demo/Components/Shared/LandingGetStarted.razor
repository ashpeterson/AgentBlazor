@using MudBlazor

<section class="landing-getstarted" id="explore">
    <div class="landing-getstarted__container">
        <div class="landing-getstarted__header">
            <h2 class="landing-getstarted__title">Explore AgentBlazor in 3 Stops</h2>
            <p class="landing-getstarted__subtitle">
                The landing page gives the product overview, the Dojo explains the patterns,
                and Agentic Components shows the reusable building blocks you can drop into a Blazor app.
            </p>
        </div>

        <div class="landing-getstarted__steps">
            <article class="landing-step">
                <div class="landing-step__number">1</div>
                <div class="landing-step__content">
                    <h3 class="landing-step__title">Start on Home</h3>
                    <p class="landing-step__desc">
                        Use this page to understand the product shape: native Blazor agentic UI, AG-UI transport,
                        runtime visibility, and the split between patterns and reusable components.
                    </p>
                    <div class="landing-step__pill-row">
                        <span>Product overview</span>
                        <span>Blazor-first positioning</span>
                        <span>User journey hub</span>
                    </div>
                </div>
            </article>

            <article class="landing-step">
                <div class="landing-step__number">2</div>
                <div class="landing-step__content">
                    <h3 class="landing-step__title">Open the Capability Dojo</h3>
                    <p class="landing-step__desc">
                        Walk through controlled, declarative, and open-ended agentic UI in one focused workspace.
                        This is where you validate how the runtime, prompts, inspector, and host-owned UI fit together.
                    </p>
                    <div class="landing-step__code">
                        <div class="landing-step__code-header">
                            <span>What you’ll see</span>
                        </div>
                        <pre><code>Controlled: prebuilt Blazor UI + deterministic actions
Declarative: AgentUiDocument + A2UI/Open-JSON-UI imports
Open-ended: sandboxed hosted app surfaces inside Blazor</code></pre>
                    </div>
                    <MudButton Href="/demo/dojo"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Open Capability Dojo
                    </MudButton>
                </div>
            </article>

            <article class="landing-step">
                <div class="landing-step__number">3</div>
                <div class="landing-step__content">
                    <h3 class="landing-step__title">Browse Agentic Components</h3>
                    <p class="landing-step__desc">
                        Open the component catalog to inspect the drop-in primitives: data grids, forms, dialogs,
                        navigation, dates, commands, uploads, and the attribute-based extension path.
                    </p>
                    <div class="landing-step__code">
                        <div class="landing-step__code-header">
                            <span>Drop-in shape</span>
                        </div>
                        <pre><code>&lt;AgentDataGrid AgentId="records-grid" Items="@@records" /&gt;
&lt;AgentForm AgentId="review-form" Model="@@model" /&gt;
&lt;AgentChatSurface Title="Assistant" /&gt;</code></pre>
                    </div>
                    <MudButton Href="/demo/components"
                               Variant="Variant.Outlined"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Browse Agentic Components
                    </MudButton>
                </div>
            </article>
        </div>

        <div class="landing-getstarted__cta">
            <MudButton Href="/demo/dojo"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       EndIcon="@Icons.Material.Filled.PlayArrow">
                Start with the Dojo
            </MudButton>
            <MudButton Href="/demo/components"
                       Variant="Variant.Outlined"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Widgets">
                Open Agentic Components
            </MudButton>
        </div>
    </div>
</section>
