@using MudBlazor

<section class="landing-getstarted" id="get-started">
    <div class="landing-getstarted__container">
        <div class="landing-getstarted__header">
            <h2 class="landing-getstarted__title">Get Started in 4 Steps</h2>
            <p class="landing-getstarted__subtitle">
                Add AI-powered control to your existing Blazor app in minutes.
            </p>
        </div>

        <div class="landing-getstarted__steps">
            @* Step 1: Install *@
            <article class="landing-step">
                <div class="landing-step__number">1</div>
                <div class="landing-step__content">
                    <h3 class="landing-step__title">Install the NuGet packages</h3>
                    <p class="landing-step__desc">Add AgentBlazor to your project via NuGet.</p>
                    <div class="landing-step__code">
                        <div class="landing-step__code-header">
                            <span>Package Manager</span>
                            <button class="landing-step__copy" title="Copy to clipboard">
                                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" />
                            </button>
                        </div>
                        <pre><code>dotnet add package AgentBlazor.Components
dotnet add package AgentBlazor.Hosting</code></pre>
                    </div>
                </div>
            </article>

            @* Step 2: Register Services *@
            <article class="landing-step">
                <div class="landing-step__number">2</div>
                <div class="landing-step__content">
                    <h3 class="landing-step__title">Register AgentBlazor services</h3>
                    <p class="landing-step__desc">Configure AgentBlazor with your preferred LLM provider in Program.cs.</p>
                    <div class="landing-step__code">
                        <div class="landing-step__code-header">
                            <span>Program.cs</span>
                        </div>
                        <pre><code><span class="code-keyword">using</span> AgentBlazor;

builder.Services.AddSingleton&lt;MyChartDataSources&gt;();

builder.Services.AddAgentBlazor(options =>
{
    options.UseOpenAI(apiKey: <span class="code-string">"your-api-key"</span>);
    options.UseChartDataResolver(sp => 
        sp.GetRequiredService&lt;MyChartDataSources&gt;().ResolveAsync);
    <span class="code-comment">// Or use Ollama, Azure OpenAI, etc.</span>
});

<span class="code-comment">// Don't forget to map the endpoints</span>
app.MapAgentBlazorEndpoints();</code></pre>
                    </div>
                </div>
            </article>

            @* Step 3: Update Components *@
            <article class="landing-step">
                <div class="landing-step__number">3</div>
                <div class="landing-step__content">
                    <h3 class="landing-step__title">Swap in agent-aware components</h3>
                    <p class="landing-step__desc">Replace MudBlazor components with their AgentBlazor equivalents.</p>
                    <div class="landing-step__code">
                        <div class="landing-step__code-header">
                            <span>YourPage.razor</span>
                        </div>
                        <pre><code><span class="code-comment">// Before: Standard MudBlazor</span>
<span class="code-deleted">&lt;MudDataGrid Items="@@records"&gt;</span>

<span class="code-comment">// After: Agent-controllable</span>
<span class="code-added">&lt;AgentDataGrid AgentId="records-grid"</span>
<span class="code-added">               Items="@@records"&gt;</span>

<span class="code-comment">// Same for forms, dialogs, tabs, nav menus...</span>
<span class="code-added">&lt;AgentForm AgentId="my-form" ...&gt;</span>
<span class="code-added">&lt;AgentDialog AgentId="my-dialog" ...&gt;</span>
<span class="code-added">&lt;AgentTabs AgentId="my-tabs" ...&gt;</span></code></pre>
                    </div>
                </div>
            </article>

            @* Step 4: Add Chat *@
            <article class="landing-step">
                <div class="landing-step__number">4</div>
                <div class="landing-step__content">
                    <h3 class="landing-step__title">Add the chat interface</h3>
                    <p class="landing-step__desc">Drop in a chat widget — users can now control your UI with natural language.</p>
                    <div class="landing-step__code">
                        <div class="landing-step__code-header">
                            <span>YourPage.razor</span>
                        </div>
                        <pre><code><span class="code-comment">// Floating chat bubble (recommended)</span>
<span class="code-added">&lt;AgentChatWidget Title="Assistant"</span>
<span class="code-added">                 Description="Ask me to filter, sort, or navigate." /&gt;</span>

<span class="code-comment">// Or embed chat directly in your layout</span>
<span class="code-added">&lt;AgentChatSurface Title="Agent Chat" /&gt;</span></code></pre>
                    </div>
                    <div class="landing-step__result">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" />
                        <span>That's it! Users can now say <em>"show overdue records"</em> and watch the magic happen.</span>
                    </div>
                </div>
            </article>
        </div>

        <div class="landing-getstarted__cta">
            <MudButton Href="demo"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       EndIcon="@Icons.Material.Filled.PlayArrow">
                See It In Action
            </MudButton>
            <MudButton Href="https://github.com/agentblazor"
                       Target="_blank"
                       Variant="Variant.Outlined"
                       Size="Size.Large"
                       StartIcon="@Icons.Custom.Brands.GitHub">
                View on GitHub
            </MudButton>
        </div>
    </div>
</section>
