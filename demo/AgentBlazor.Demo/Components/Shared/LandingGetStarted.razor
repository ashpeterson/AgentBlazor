@using MudBlazor

<section class="landing-getstarted" id="explore">
    <div class="landing-getstarted__container">
        <div class="landing-getstarted__header">
            <h2 class="landing-getstarted__title">Explore AgentBlazor in 3 Stops</h2>
            <p class="landing-getstarted__subtitle">
                The landing page gives the product overview, the workflow hub proves the product story,
                and the dojo/components surfaces act as supporting references for patterns and reusable building blocks.
            </p>
        </div>

        <div class="landing-getstarted__steps">
            <article class="landing-step">
                <div class="landing-step__number">1</div>
                <div class="landing-step__content">
                    <h3 class="landing-step__title">Start on Home</h3>
                    <p class="landing-step__desc">
                        Use this page to understand the product shape: native Blazor agentic UI, AG-UI transport,
                        runtime visibility, and the split between patterns and reusable components.
                    </p>
                    <div class="landing-step__pill-row">
                        <span>Product overview</span>
                        <span>Blazor-first positioning</span>
                        <span>User journey hub</span>
                    </div>
                </div>
            </article>

            <article class="landing-step">
                <div class="landing-step__number">2</div>
                <div class="landing-step__content">
                    <h3 class="landing-step__title">Open the Workflow Hub</h3>
                    <p class="landing-step__desc">
                        Lead with the product proof: semantic workflows that combine explanation, approvals,
                        deterministic UI execution, and blocked/failure handling in one place.
                    </p>
                    <div class="landing-step__code">
                        <div class="landing-step__code-header">
                            <span>What you’ll see</span>
                        </div>
                        <pre><code>Supplier compliance: analysis, explanation, remediation draft
File audit bundle: remote handoff, verification, blocked branch
Recipe release: readiness, blockers, approval-gated publish draft</code></pre>
                    </div>
                    <MudButton Href="/demo"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Open Workflow Hub
                    </MudButton>
                </div>
            </article>

            <article class="landing-step">
                <div class="landing-step__number">3</div>
                <div class="landing-step__content">
                    <h3 class="landing-step__title">Use the Dojo and Components as References</h3>
                    <p class="landing-step__desc">
                        Once the workflow story is clear, use the dojo to inspect control patterns and the component
                        catalog to inspect the drop-in primitives you can ship in your own Blazor app.
                    </p>
                    <div class="landing-step__code">
                        <div class="landing-step__code-header">
                            <span>Reference surfaces</span>
                        </div>
                        <pre><code>Dojo: controlled, declarative, and open-ended patterns
Components: grids, forms, dialogs, navigation, uploads
Parity: MudBlazor baselines beside Agent wrappers</code></pre>
                    </div>
                    <MudButton Href="/demo/dojo"
                               Variant="Variant.Outlined"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Open Capability Dojo
                    </MudButton>
                    <MudButton Href="/demo/components"
                               Variant="Variant.Text"
                               EndIcon="@Icons.Material.Filled.ArrowForward">
                        Browse Agentic Components
                    </MudButton>
                </div>
            </article>
        </div>

        <div class="landing-getstarted__cta">
            <MudButton Href="/demo"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       EndIcon="@Icons.Material.Filled.PlayArrow">
                Start with the Workflow Hub
            </MudButton>
            <MudButton Href="/demo/dojo"
                       Variant="Variant.Outlined"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.AutoFixHigh">
                Open Capability Dojo
            </MudButton>
            <MudButton Href="/demo/components"
                       Variant="Variant.Text"
                       Size="Size.Large"
                       StartIcon="@Icons.Material.Filled.Widgets">
                Open Agentic Components
            </MudButton>
        </div>
    </div>
</section>
