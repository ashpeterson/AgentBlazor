<MudPaper Class="pa-4" Outlined="true">
    <MudText Typo="Typo.h6">@Title</MudText>

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">
            @Description
        </MudText>
    }

    @if (!string.IsNullOrWhiteSpace(PhaseLabel) || !string.IsNullOrWhiteSpace(ApprovalBoundarySummary))
    {
        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3">
            @if (!string.IsNullOrWhiteSpace(PhaseLabel))
            {
                <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled">
                    Phase: @PhaseLabel
                </MudChip>
            }

            @if (!string.IsNullOrWhiteSpace(ApprovalBoundarySummary))
            {
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined">
                    Approval boundary: @ApprovalBoundarySummary
                </MudChip>
            }
        </MudStack>
    }

    @if (SummaryContent is not null)
    {
        <div class="mb-3">
            @SummaryContent
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(NextStepSummary))
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            Next step: @NextStepSummary
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(OutcomeSummary))
    {
        <MudText Typo="Typo.subtitle2" Class="mb-1">@OutcomeTitle</MudText>
        <MudAlert Severity="@OutcomeSeverity" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            @OutcomeSummary
        </MudAlert>
    }

    @if (Blockers.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            @BlockerSummary
        </MudAlert>
        <MudList T="string" Dense="true" Class="mb-3">
            @foreach (var blocker in Blockers)
            {
                <MudListItem T="string">@blocker</MudListItem>
            }
        </MudList>
    }

    @if (Warnings.Count > 0)
    {
        <MudText Typo="Typo.subtitle2" Class="mb-1">Warnings</MudText>
        <MudList T="string" Dense="true" Class="mb-3">
            @foreach (var warning in Warnings)
            {
                <MudListItem T="string">@warning</MudListItem>
            }
        </MudList>
    }

    <MudText Typo="Typo.subtitle2" Class="mb-1">Recommended next actions</MudText>
    <MudList T="string" Dense="true">
        @foreach (var action in NextActions)
        {
            <MudListItem T="string">@action</MudListItem>
        }
    </MudList>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "Decision support";

    [Parameter] public string? Description { get; set; }

    [Parameter] public string? PhaseLabel { get; set; }

    [Parameter] public string? ApprovalBoundarySummary { get; set; }

    [Parameter] public string? NextStepSummary { get; set; }

    [Parameter] public string OutcomeTitle { get; set; } = "Current outcome";

    [Parameter] public string? OutcomeSummary { get; set; }

    [Parameter] public Severity OutcomeSeverity { get; set; } = Severity.Info;

    [Parameter] public string BlockerSummary { get; set; } = "Resolve these blockers before continuing.";

    [Parameter] public IReadOnlyList<string> Blockers { get; set; } = [];

    [Parameter] public IReadOnlyList<string> Warnings { get; set; } = [];

    [Parameter] public IReadOnlyList<string> NextActions { get; set; } = [];

    [Parameter] public RenderFragment? SummaryContent { get; set; }
}
