@using MudBlazor

<section class="landing-features" id="features">
    <div class="landing-features__container">
        <div class="landing-features__header">
            <h2 class="landing-features__title">What You Explore Here</h2>
            <p class="landing-features__subtitle">
                AgentBlazor gives Blazor teams a native path from reusable agentic components
                to full end-to-end agentic UI patterns.
            </p>
        </div>

        <div class="landing-features__grid">
            <article class="landing-feature">
                <div class="landing-feature__icon">
                    <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Size="Size.Large" />
                </div>
                <h3 class="landing-feature__title">Capability Dojo</h3>
                <p class="landing-feature__desc">
                    See controlled, declarative, and open-ended agentic UI patterns working end to end
                    with live prompts, runtime inspection, and host-rendered Blazor UI.
                </p>
            </article>

            <article class="landing-feature">
                <div class="landing-feature__icon">
                    <MudIcon Icon="@Icons.Material.Filled.Widgets" Size="Size.Large" />
                </div>
                <h3 class="landing-feature__title">Agentic Components</h3>
                <p class="landing-feature__desc">
                    Drop in native Blazor components for forms, grids, dialogs, navigation, steps,
                    commands, dates, uploads, and more without leaving the MudBlazor ecosystem.
                </p>
            </article>

            <article class="landing-feature">
                <div class="landing-feature__icon">
                    <MudIcon Icon="@Icons.Material.Filled.DeveloperBoard" Size="Size.Large" />
                </div>
                <h3 class="landing-feature__title">Blazor-First Authoring</h3>
                <p class="landing-feature__desc">
                    Build your own agentic components with <code>AgentControllableComponentBase</code>,
                    readable state, and typed actions instead of adopting a separate frontend stack.
                </p>
            </article>

            <article class="landing-feature">
                <div class="landing-feature__icon">
                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Large" />
                </div>
                <h3 class="landing-feature__title">Runtime Visibility</h3>
                <p class="landing-feature__desc">
                    Inspect plans, validation, execution, and AG-UI activity directly in the product
                    so debugging agent behavior stays practical during development.
                </p>
            </article>
        </div>
    </div>
</section>
