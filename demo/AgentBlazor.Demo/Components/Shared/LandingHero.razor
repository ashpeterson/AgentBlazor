@using MudBlazor

<section class="landing-hero" id="hero">
    <div class="landing-hero__bg">
        <div class="landing-hero__orb landing-hero__orb--1"></div>
        <div class="landing-hero__orb landing-hero__orb--2"></div>
        <div class="landing-hero__orb landing-hero__orb--3"></div>
        <div class="landing-hero__grid"></div>
    </div>

    <div class="landing-hero__content">
        <p class="landing-hero__eyebrow">Blazor-native agent workflows</p>
        <h1 class="landing-hero__title">
            Talk to the app.<br />
            <span class="landing-hero__accent">Watch real workflows move.</span>
        </h1>
        <p class="landing-hero__subtitle">
            Start the live orchestration demo, ask for the next stage, and let the agent coordinate supplier,
            evidence, incident, and release work inside the app.
        </p>
        <div class="landing-hero__cta">
            <MudButton Href="/demo/workflows/response-orchestration?reset=true"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       EndIcon="@Icons.Material.Filled.PlayArrow">
                Start Live Demo
            </MudButton>
            <MudButton Href="/demo"
                       Variant="Variant.Outlined"
                       Size="Size.Large"
                       EndIcon="@Icons.Material.Filled.ArrowForward">
                Open Workflow Hub
            </MudButton>
        </div>
        <div class="landing-hero__prompt-strip" aria-label="Suggested prompts">
            <span>“Assess cross-system response readiness”</span>
            <span>“Advance the next guided subsystem stage”</span>
            <span>“Prepare the response packet”</span>
        </div>
        <div class="landing-hero__quickstart" aria-label="Free quickstart">
            <div class="landing-hero__quickstart-copy">
                <p>Ship free first</p>
                <strong>Add the runtime. Register one agent. Drop in the chat surface.</strong>
            </div>
            <div class="landing-hero__quickstart-steps">
                <span><code>AddAgentBlazor(...)</code></span>
                <span><code>AddAgent("ops")</code></span>
                <span><code>&lt;AgentChatWidget /&gt;</code></span>
            </div>
        </div>

        <div class="landing-hero__plans" aria-label="Plan summary">
            <article class="landing-hero__plan-card landing-hero__plan-card--free">
                <p>Free</p>
                <strong>Ship the workflow layer</strong>
                <span>Runtime, workflow chat, deterministic execution.</span>
            </article>
            <article class="landing-hero__plan-card landing-hero__plan-card--paid">
                <p>Pro</p>
                <strong>Make the product smarter</strong>
                <span>History, adaptive suggestions, and better next steps.</span>
            </article>
            <article class="landing-hero__plan-card landing-hero__plan-card--premium">
                <p>Premium</p>
                <strong>Scale with control</strong>
                <span>Governance, analytics, and audit visibility.</span>
            </article>
        </div>
    </div>
</section>
