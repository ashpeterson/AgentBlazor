@using MudBlazor

<div class="landing-hero" id="hero">
    <p class="landing-hero__eyebrow">Agent workflows for Blazor</p>
    <h1 class="landing-hero__title">Install it. Mount one workflow. Watch the UI move.</h1>
    <p class="landing-hero__subtitle">
        One reel. CLI install, minimal code, then a real prompt changing an official Microsoft Blazor app.
    </p>

    <div class="landing-hero__cta">
        <MudButton Href="/demo"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   EndIcon="@Icons.Material.Filled.PlayArrow">
            Watch reel
        </MudButton>
        <MudButton Href="/docs"
                   Variant="Variant.Outlined"
                   Size="Size.Large"
                   EndIcon="@Icons.Material.Filled.MenuBook">
            Open docs
        </MudButton>
        <MudButton Href="/demo/workflows/response-orchestration?reset=true"
                   Variant="Variant.Text"
                   Size="Size.Large">
            Live workflow
        </MudButton>
    </div>
</div>
