@using MudBlazor

<div class="landing-hero" id="hero">
    <p class="landing-hero__eyebrow">Agent workflows for Blazor</p>
    <h1 class="landing-hero__title">One prompt moves the app.</h1>
    <p class="landing-hero__subtitle">
        Fresh app. Small code shape. Real workflow state changing in the UI.
    </p>

    <div class="landing-hero__cta">
        <MudButton Href="/docs"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   EndIcon="@Icons.Material.Filled.MenuBook">
            Open docs
        </MudButton>
        <MudButton Href="/demo/workflows/response-orchestration?reset=true"
                   Variant="Variant.Outlined"
                   Size="Size.Large">
            Live workflow
        </MudButton>
    </div>
</div>
