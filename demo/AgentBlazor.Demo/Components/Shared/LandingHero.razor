@using MudBlazor

<section class="landing-hero" id="hero">
    <div class="landing-hero__bg">
        <div class="landing-hero__orb landing-hero__orb--1"></div>
        <div class="landing-hero__orb landing-hero__orb--2"></div>
        <div class="landing-hero__orb landing-hero__orb--3"></div>
        <div class="landing-hero__grid"></div>
    </div>

    <div class="landing-hero__content">
        <p class="landing-hero__eyebrow">Blazor-native agentic UI</p>
        <h1 class="landing-hero__title">
            Explore AgentBlazor<br />
            <span class="landing-hero__accent">From capabilities to components</span>
        </h1>
        <p class="landing-hero__subtitle">
            Start on the home page, step into the Dojo to understand the patterns, then open Agentic Components
            to see the drop-in Blazor building blocks you can ship in your own app.
        </p>
        <div class="landing-hero__cta">
            <MudButton Href="/demo/dojo"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       EndIcon="@Icons.Material.Filled.ArrowForward">
                Open Capability Dojo
            </MudButton>
            <MudButton Href="/demo/components"
                       Variant="Variant.Outlined"
                       Size="Size.Large">
                Browse Agentic Components
            </MudButton>
            <MudButton Href="#explore"
                       Variant="Variant.Text"
                       Size="Size.Large">
                Follow the Product Tour
            </MudButton>
        </div>
        <div class="landing-hero__meta">
            <span>Controlled, declarative, and open-ended agentic UI</span>
            <span>Drop-in components for Blazor and MudBlazor apps</span>
            <span>AG-UI runtime and inspector built in</span>
        </div>
    </div>
</section>
