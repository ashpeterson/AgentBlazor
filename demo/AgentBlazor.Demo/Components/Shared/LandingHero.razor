@using MudBlazor

<div class="landing-hero" id="hero">
    <p class="landing-hero__eyebrow">Agent workflows for Blazor</p>
    <h1 class="landing-hero__title">From CLI to working UI.</h1>
    <p class="landing-hero__subtitle">
        Install it, inspect the generated shape, and watch the app respond.
    </p>

    <div class="landing-hero__cta">
        <MudButton Href="/docs"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   EndIcon="@Icons.Material.Filled.MenuBook">
            Docs
        </MudButton>
        <MudButton Href="/demo/workflows/response-orchestration?reset=true"
                   Variant="Variant.Outlined"
                   Size="Size.Large">
            Live demo
        </MudButton>
    </div>
</div>
