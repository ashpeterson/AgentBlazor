@using MudBlazor

<section class="landing-hero" id="hero">
    <div class="landing-hero__glow landing-hero__glow--orange"></div>
    <div class="landing-hero__glow landing-hero__glow--blue"></div>

    <div class="landing-hero__content">
        <div class="landing-hero__intro">
            <p class="landing-hero__eyebrow">Blazor-native agent workflows</p>
            <h1 class="landing-hero__title">One prompt moves the app.</h1>
            <p class="landing-hero__subtitle">
                Ask the agent to assess, advance, and prepare the handoff. Watch real workflow state move inside the app.
            </p>
        </div>

        <div class="landing-hero__cta">
            <MudButton Href="/demo/workflows/response-orchestration?reset=true"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Large"
                       EndIcon="@Icons.Material.Filled.PlayArrow">
                Try live workflow
            </MudButton>
            <MudButton Href="/docs"
                       Variant="Variant.Outlined"
                       Size="Size.Large"
                       EndIcon="@Icons.Material.Filled.MenuBook">
                Docs site
            </MudButton>
        </div>

        <div class="landing-hero__prompts" aria-label="Suggested prompts">
            <span>Assess readiness</span>
            <span>Advance next stage</span>
            <span>Prepare handoff</span>
        </div>

        <div class="landing-hero__proof">
            <article class="landing-hero__proof-card landing-hero__proof-card--primary">
                <p>Live response workflow</p>
                <strong>Supplier + evidence + incident</strong>
                <span>One guided flow. One approval.</span>
            </article>
            <article class="landing-hero__proof-card">
                <p>Free path</p>
                <strong>Ship one workflow first</strong>
                <span>Add the runtime, one workflow, one chat surface.</span>
            </article>
            <article class="landing-hero__proof-card">
                <p>Docs + install</p>
                <strong>Preview, apply, validate</strong>
                <span>Use the docs site and CLI flow before touching a real host.</span>
            </article>
        </div>

        <div class="landing-hero__plan-strip" aria-label="Plans">
            <span><strong>Free</strong> full runtime + 14 components</span>
            <span><strong>Pro $29/seat</strong> analytics + audit + smart suggestions</span>
            <span><strong>Enterprise</strong> SSO + SLA + dedicated support</span>
        </div>
    </div>
</section>
