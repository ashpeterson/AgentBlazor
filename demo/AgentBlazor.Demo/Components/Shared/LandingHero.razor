@using MudBlazor

<div class="landing-hero" id="hero">
    <p class="landing-hero__eyebrow">Agent help for real Blazor screens</p>
    <h1 class="landing-hero__title">Install it. Open a support queue. Draft the next safe reply.</h1>
    <p class="landing-hero__subtitle">
        The launch path is one route, one chat surface, and one normal ticket workflow with a visible approval boundary.
    </p>

    <div class="landing-hero__cta">
        <MudButton Href="/docs"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   EndIcon="@Icons.Material.Filled.MenuBook">
            Docs
        </MudButton>
        <MudButton Href="/demo/workflows/support-inbox"
                   Variant="Variant.Outlined"
                   Size="Size.Large">
            Live demo
        </MudButton>
    </div>
</div>
