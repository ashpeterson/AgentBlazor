{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "AgentBlazor.Core.Runtime.Agents.AgentRuntime": "Information",
      "AgentBlazor.Core.Runtime.Interfaces.InMemoryAgentNavigationIntentService": "Information",
      "AgentBlazor": "Information"
    }
  },
  "ConnectionStrings": {
    "DemoWorkflow": "Data Source=agentblazor-demo.db"
  },
  "DemoSecurity": {
    "RequireProviderInProduction": true,
    "AllowOllamaInProduction": false,
    "TrustForwardedHeaders": false,
    "RateLimiting": {
      "Enabled": true,
      "PermitLimit": 20,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "DemoLogging": {
    "Enabled": true,
    "DirectoryPath": "",
    "FileName": "chat-requests.jsonl",
    "AccessToken": "",
    "IncludePromptPreview": false,
    "PromptPreviewMaxLength": 160,
    "MaxTailLines": 500
  },
  "DemoRemoteStorage": {
    "Adapter": "InMemory",
    "HttpBaseUrl": "",
    "HttpApiKey": "",
    "HttpBearerToken": "",
    "HttpHandoffPath": "handoff",
    "HttpValidatePath": "validate",
    "MaxAttempts": 3,
    "RetryDelayMilliseconds": 150
  },
  "AllowedHosts": "*"
}
