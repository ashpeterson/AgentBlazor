{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Demo (Blazor)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "buildDemo",
      "program": "${workspaceFolder}/demo/AgentBlazor.Demo/bin/Debug/net10.0/AgentBlazor.Demo.dll",
      "args": [],
      "cwd": "${workspaceFolder}/demo/AgentBlazor.Demo",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5249"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
