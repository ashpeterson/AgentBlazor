<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AgentBlazor.Cli</RootNamespace>
    <AssemblyName>agentblazor</AssemblyName>

    <!-- Package as dotnet tool -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>agentblazor</ToolCommandName>
    <PackageId>AgentBlazor.Cli</PackageId>
    <Description>CLI tool for generating AGENT.md from Blazor applications</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentBlazor.Cli.Analysis\AgentBlazor.Cli.Analysis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <!-- Include MSBuild targets for build-time integration -->
  <ItemGroup>
    <None Include="build\**" Pack="true" PackagePath="build\" />
  </ItemGroup>

</Project>
