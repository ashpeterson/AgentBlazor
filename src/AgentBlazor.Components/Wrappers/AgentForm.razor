@namespace AgentBlazor.Components
@using AgentBlazor.Attributes
@using AgentBlazor.Core.Runtime.Components
@using AgentBlazor.Runtime
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.ComponentModel
@using System.Reflection
@inherits AgentControllableComponentBase

<EditForm EditContext="_editContext"
          FormName="@EffectiveFormName"
          OnValidSubmit="HandleValidSubmitAsync"
          id="@AgentId"
          data-ab-type="form"
          data-ab-agentid="@AgentId"
          @attributes="AdditionalAttributes">
    @if (ChildContent is not null)
    {
        @ChildContent(_editContext!)
    }
</EditForm>

@code {
    private EditContext? _editContext;
    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private Dictionary<string, object?> _initialValues = new(StringComparer.OrdinalIgnoreCase);

    [Parameter, EditorRequired]
    public object Model { get; set; } = default!;

    [Parameter]
    public RenderFragment<EditContext>? ChildContent { get; set; }

    [Parameter]
    public EventCallback<bool> ValidationChanged { get; set; }

    [Parameter]
    public EventCallback Submitted { get; set; }

    [Parameter]
    public string? FormName { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    public override string ComponentType => "Form";

    private string EffectiveFormName =>
        string.IsNullOrWhiteSpace(FormName)
            ? $"agent-form-{_instanceId}"
            : FormName;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        EnsureEditContext();
    }

    // NOTE: The SetField action has been removed because it's unreliable for forms inside dialogs.
    // Forms inside closed dialogs are not rendered/mounted, so the agent cannot target them.
    //
    // RECOMMENDED PATTERN (CopilotKit-style):
    // Create a dedicated workflow agent component that exposes a compound action with explicit
    // parameters for each field. The action handler opens the dialog AND fills all fields
    // atomically. See SupplierOnboardingAgent.razor for an example.
    //
    // Example:
    //   [AgentAction("Fill out the order form")]
    //   public async Task<ActionResult> FillOrderForm(
    //       [AgentParam("Customer name")] string customer,
    //       [AgentParam("Product ID")] string productId,
    //       [AgentParam("Quantity")] int quantity)
    //   {
    //       await _dialog.Open();
    //       _model.Customer = customer;
    //       _model.ProductId = productId;
    //       _model.Quantity = quantity;
    //       return ActionResult.Applied("Filled order form.");
    //   }

    [AgentAction("Validate the form")]
    public async Task<ActionResult> Validate()
    {
        EnsureEditContext();
        var valid = _editContext!.Validate();
        await ValidationChanged.InvokeAsync(valid);
        await RequestComponentRefreshAsync();
        return valid
            ? ActionResult.Applied("Form validation passed.")
            : ActionResult.Failure("Form validation failed.");
    }

    [AgentAction("Reset the form to its initial values")]
    public async Task<ActionResult> Reset()
    {
        EnsureEditContext();
        RestoreValues(_initialValues);
        _editContext = new EditContext(Model);
        await ValidationChanged.InvokeAsync(false);
        await RequestComponentRefreshAsync();
        return ActionResult.Applied("Reset form to initial values.");
    }

    [AgentAction("Submit the form", RequiresApproval = true)]
    public async Task<ActionResult> Submit()
    {
        EnsureEditContext();
        var valid = _editContext!.Validate();
        await ValidationChanged.InvokeAsync(valid);
        if (!valid)
            return ActionResult.Failure("Submit blocked because validation failed.");

        await Submitted.InvokeAsync();
        await RequestComponentRefreshAsync();
        return ActionResult.Applied("Submitted form.");
    }

    public override ComponentState GetCurrentState()
    {
        EnsureEditContext();
        var values = CaptureValues();
        var metadata = GetFieldMetadata();

        // Note: We avoid calling _editContext.Validate() here because it triggers
        // StateHasChanged via MudBlazor's validation handlers, which fails when
        // GetCurrentState is called from background threads (planner/executor).
        // Instead, we check if there are any existing validation messages.
        var hasValidationMessages = _editContext!.GetValidationMessages().Any();

        return new ComponentState
        {
            ["fieldCount"] = values.Count,
            ["hasValidationErrors"] = hasValidationMessages,
            ["fields"] = values.Keys.ToArray(),
            ["fieldValues"] = values,
            ["fieldMetadata"] = metadata
        };
    }

    private async Task HandleValidSubmitAsync()
    {
        await Submitted.InvokeAsync();
    }

    private void EnsureEditContext()
    {
        if (Model is null)
            throw new InvalidOperationException($"{nameof(AgentForm)} requires a non-null {nameof(Model)}.");

        if (_editContext is null || !ReferenceEquals(_editContext.Model, Model))
        {
            _editContext = new EditContext(Model);
            _initialValues = CaptureValues();
        }
    }

    // Simple case-insensitive property resolution — the planner sends exact field names
    private PropertyInfo? ResolveProperty(string fieldHint)
    {
        return Model.GetType()
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .FirstOrDefault(p =>
                p.CanWrite &&
                p.GetIndexParameters().Length == 0 &&
                string.Equals(p.Name, fieldHint, StringComparison.OrdinalIgnoreCase));
    }

    private string[] GetSettableFieldNames() =>
        Model.GetType()
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(static p => p.CanWrite && p.GetIndexParameters().Length == 0)
            .Select(static p => p.Name)
            .OrderBy(static n => n, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private Dictionary<string, object?> CaptureValues()
    {
        var values = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        foreach (var p in Model.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            if (!p.CanRead || !p.CanWrite || p.GetIndexParameters().Length > 0)
                continue;
            values[p.Name] = p.GetValue(Model);
        }
        return values;
    }

    private void RestoreValues(IReadOnlyDictionary<string, object?> values)
    {
        foreach (var p in Model.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            if (!p.CanWrite || p.GetIndexParameters().Length > 0)
                continue;
            if (!values.TryGetValue(p.Name, out var initial))
                continue;
            if (initial is null)
            {
                p.SetValue(Model, null);
                continue;
            }
            if (TryConvert(initial, p.PropertyType, out var converted))
                p.SetValue(Model, converted);
        }
    }

    private bool TrySetValue(PropertyInfo property, object? raw, out string message)
    {
        if (raw is null)
        {
            property.SetValue(Model, null);
            message = $"Set field '{property.Name}' to null.";
            return true;
        }

        if (!TryConvert(raw, property.PropertyType, out var converted))
        {
            message = $"Unable to convert '{raw}' to {property.PropertyType.Name} for field '{property.Name}'.";
            return false;
        }

        property.SetValue(Model, converted);
        message = $"Set field '{property.Name}' to '{converted}'.";
        return true;
    }

    private Dictionary<string, FieldMetadata> GetFieldMetadata()
    {
        var result = new Dictionary<string, FieldMetadata>(StringComparer.OrdinalIgnoreCase);
        foreach (var p in Model.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            if (!p.CanRead || !p.CanWrite || p.GetIndexParameters().Length > 0)
                continue;

            var propType = p.PropertyType;
            var underlying = Nullable.GetUnderlyingType(propType);
            var effective = underlying ?? propType;

            string[]? allowed = effective.IsEnum ? Enum.GetNames(effective) : null;
            var req = p.GetCustomAttribute<RequiredAttribute>();
            var maxLen = p.GetCustomAttribute<MaxLengthAttribute>();
            var minLen = p.GetCustomAttribute<MinLengthAttribute>();
            var strLen = p.GetCustomAttribute<StringLengthAttribute>();
            var range = p.GetCustomAttribute<RangeAttribute>();
            var regex = p.GetCustomAttribute<RegularExpressionAttribute>();
            var display = p.GetCustomAttribute<DisplayAttribute>();
            var displayName = p.GetCustomAttribute<DisplayNameAttribute>();

            result[p.Name] = new FieldMetadata
            {
                Type = GetFriendlyTypeName(effective),
                IsRequired = req is not null,
                IsNullable = underlying is not null || !propType.IsValueType,
                MaxLength = maxLen?.Length ?? strLen?.MaximumLength,
                MinLength = minLen?.Length ?? strLen?.MinimumLength,
                Pattern = regex?.Pattern,
                MinValue = range?.Minimum,
                MaxValue = range?.Maximum,
                AllowedValues = allowed,
                DisplayName = display?.Name ?? displayName?.DisplayName,
                Description = display?.Description ?? display?.Prompt
            };
        }
        return result;
    }

    private static string GetFriendlyTypeName(Type type)
    {
        if (type == typeof(string)) return "string";
        if (type == typeof(int) || type == typeof(long) || type == typeof(short) || type == typeof(byte)) return "integer";
        if (type == typeof(decimal) || type == typeof(double) || type == typeof(float)) return "number";
        if (type == typeof(bool)) return "boolean";
        if (type == typeof(DateTime) || type == typeof(DateTimeOffset)) return "datetime";
        if (type == typeof(DateOnly)) return "date";
        if (type == typeof(TimeOnly) || type == typeof(TimeSpan)) return "time";
        if (type == typeof(Guid)) return "guid";
        if (type.IsEnum) return "enum";
        return "object";
    }

    private static object? NormalizeValue(object? value)
    {
        if (value is System.Text.Json.JsonElement json)
        {
            return json.ValueKind switch
            {
                System.Text.Json.JsonValueKind.String => json.GetString(),
                System.Text.Json.JsonValueKind.Number when json.TryGetInt64(out var i64) => i64,
                System.Text.Json.JsonValueKind.Number when json.TryGetDouble(out var d) => d,
                System.Text.Json.JsonValueKind.True => true,
                System.Text.Json.JsonValueKind.False => false,
                System.Text.Json.JsonValueKind.Null => null,
                _ => json.ToString()
            };
        }
        return value;
    }

    private static bool TryConvert(object raw, Type destinationType, out object? converted)
    {
        var target = Nullable.GetUnderlyingType(destinationType) ?? destinationType;
        try
        {
            if (target.IsEnum)
            {
                converted = raw is string s
                    ? Enum.Parse(target, s, ignoreCase: true)
                    : Enum.ToObject(target, raw);
                return true;
            }
            if (target == typeof(Guid))
            {
                converted = raw is Guid g ? g : Guid.Parse(raw.ToString() ?? string.Empty);
                return true;
            }
            converted = Convert.ChangeType(raw, target, System.Globalization.CultureInfo.InvariantCulture);
            return true;
        }
        catch
        {
            converted = null;
            return false;
        }
    }
}
