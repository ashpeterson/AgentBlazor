@namespace AgentBlazor.Components
@using AgentBlazor.Components
@using AgentBlazor.Core.Runtime.Components
@using AgentBlazor.Runtime
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@using System.ComponentModel
@using System.Reflection
@inherits AgentControllableComponentBase

<EditForm EditContext="_editContext"
          FormName="@EffectiveFormName"
          OnValidSubmit="HandleValidSubmitAsync"
          id="@AgentId"
          data-ab-type="form"
          data-ab-agentid="@AgentId"
          @attributes="AdditionalAttributes">
    @if (ChildContent is not null)
    {
        @ChildContent(_editContext!)
    }
</EditForm>

@code {
    private EditContext? _editContext;
    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private Dictionary<string, object?> _initialValues = new(StringComparer.OrdinalIgnoreCase);

    [Parameter, EditorRequired]
    public object Model { get; set; } = default!;

    [Parameter]
    public RenderFragment<EditContext>? ChildContent { get; set; }

    [Parameter]
    public EventCallback<bool> ValidationChanged { get; set; }

    [Parameter]
    public EventCallback Submitted { get; set; }

    [Parameter]
    public string? FormName { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    public override string ComponentType => "Form";

    protected override string ComponentIdForRoute => AgentComponentCapabilityProfile.AgentFormComponentId;

    private string EffectiveFormName =>
        string.IsNullOrWhiteSpace(FormName)
            ? $"agent-form-{_instanceId}"
            : FormName;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        EnsureEditContext();
    }

    public override ComponentCapability GetCapability()
    {
        var capability = new ComponentCapability(AgentId, "Agent-aware form wrapper.");
        capability.UpsertAction(new ComponentActionCapability(
            AgentComponentCapabilityProfile.FormSetFieldActionId,
            "Set a form field value."));
        capability.UpsertAction(new ComponentActionCapability(
            AgentComponentCapabilityProfile.FormValidateActionId,
            "Validate the form."));
        capability.UpsertAction(new ComponentActionCapability(
            AgentComponentCapabilityProfile.FormSubmitActionId,
            "Submit the form.",
            RequiresApproval: true));
        capability.UpsertAction(new ComponentActionCapability(
            AgentComponentCapabilityProfile.FormResetActionId,
            "Reset form fields to initial values."));
        return capability;
    }

    public override ComponentState GetCurrentState()
    {
        EnsureEditContext();
        var values = CaptureValues(Model);
        var metadata = GetFieldMetadata(Model);

        return new ComponentState
        {
            ["fieldCount"] = values.Count,
            ["isValid"] = _editContext!.Validate(),
            // NEW: Expose field names for the agent
            ["fields"] = values.Keys.ToArray(),
            // NEW: Expose current field values
            ["fieldValues"] = values,
            // NEW: Expose field metadata (types, validation rules)
            ["fieldMetadata"] = metadata
        };
    }

    /// <summary>
    /// Extracts metadata from form model properties using reflection and data annotations.
    /// </summary>
    private static Dictionary<string, FieldMetadata> GetFieldMetadata(object model)
    {
        var result = new Dictionary<string, FieldMetadata>(StringComparer.OrdinalIgnoreCase);

        foreach (var prop in model.GetType().GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            if (!prop.CanRead || !prop.CanWrite || prop.GetIndexParameters().Length > 0)
            {
                continue;
            }

            var propType = prop.PropertyType;
            var underlyingType = Nullable.GetUnderlyingType(propType);
            var isNullable = underlyingType is not null || !propType.IsValueType;
            var effectiveType = underlyingType ?? propType;

            // Extract validation attributes
            var requiredAttr = prop.GetCustomAttribute<RequiredAttribute>();
            var maxLengthAttr = prop.GetCustomAttribute<MaxLengthAttribute>();
            var minLengthAttr = prop.GetCustomAttribute<MinLengthAttribute>();
            var stringLengthAttr = prop.GetCustomAttribute<StringLengthAttribute>();
            var rangeAttr = prop.GetCustomAttribute<RangeAttribute>();
            var regexAttr = prop.GetCustomAttribute<RegularExpressionAttribute>();
            var displayAttr = prop.GetCustomAttribute<DisplayAttribute>();
            var displayNameAttr = prop.GetCustomAttribute<DisplayNameAttribute>();

            // Get enum values if applicable
            string[]? allowedValues = null;
            if (effectiveType.IsEnum)
            {
                allowedValues = Enum.GetNames(effectiveType);
            }

            result[prop.Name] = new FieldMetadata
            {
                Type = GetFriendlyTypeName(effectiveType),
                IsRequired = requiredAttr is not null,
                IsNullable = isNullable,
                MaxLength = maxLengthAttr?.Length ?? stringLengthAttr?.MaximumLength,
                MinLength = minLengthAttr?.Length ?? stringLengthAttr?.MinimumLength,
                Pattern = regexAttr?.Pattern,
                MinValue = rangeAttr?.Minimum,
                MaxValue = rangeAttr?.Maximum,
                AllowedValues = allowedValues,
                DisplayName = displayAttr?.Name ?? displayNameAttr?.DisplayName,
                Description = displayAttr?.Description ?? displayAttr?.Prompt
            };
        }

        return result;
    }

    /// <summary>
    /// Converts a CLR type to a friendly type name for the LLM.
    /// </summary>
    private static string GetFriendlyTypeName(Type type)
    {
        if (type == typeof(string)) return "string";
        if (type == typeof(int) || type == typeof(long) || type == typeof(short) || type == typeof(byte)) return "integer";
        if (type == typeof(decimal) || type == typeof(double) || type == typeof(float)) return "number";
        if (type == typeof(bool)) return "boolean";
        if (type == typeof(DateTime) || type == typeof(DateTimeOffset)) return "datetime";
        if (type == typeof(DateOnly)) return "date";
        if (type == typeof(TimeOnly) || type == typeof(TimeSpan)) return "time";
        if (type == typeof(Guid)) return "guid";
        if (type.IsEnum) return "enum";
        return "object";
    }

    public override async Task<ActionResult> ExecuteActionAsync(
        AgentAction action,
        CancellationToken cancellationToken = default)
    {
        _ = cancellationToken;
        action = NormalizeAction(AgentComponentCapabilityProfile.AgentFormComponentId, action);
        EnsureEditContext();
        if (string.Equals(action.Name, AgentComponentCapabilityProfile.FormSetFieldActionId, StringComparison.OrdinalIgnoreCase))
        {
            if (!action.TryGetParameter<string>("field", out var field) || string.IsNullOrWhiteSpace(field))
            {
                return ActionResult.Failure("Action 'set_field' requires 'field' parameter.");
            }

            var resolvedField = ResolveFieldName(Model.GetType(), field);
            if (resolvedField is null)
            {
                var available = string.Join(", ", GetSettableFieldNames(Model.GetType()));
                return ActionResult.Failure(
                    $"Field '{field}' was not found or is ambiguous on form model '{Model.GetType().Name}'. Available fields: {available}.");
            }

            if (!action.Parameters.TryGetValue("value", out var raw))
            {
                action.Parameters.TryGetValue("fieldValue", out raw);
            }
            if (!TrySetFieldValue(Model, resolvedField, Normalize(raw), out var message))
            {
                return ActionResult.Failure(message);
            }

            _editContext!.NotifyFieldChanged(new FieldIdentifier(Model, resolvedField));
            await RequestComponentRefreshAsync();
            return ActionResult.Success(message);
        }

        if (string.Equals(action.Name, AgentComponentCapabilityProfile.FormValidateActionId, StringComparison.OrdinalIgnoreCase))
        {
            var valid = _editContext!.Validate();
            await ValidationChanged.InvokeAsync(valid);
            await RequestComponentRefreshAsync();
            return valid
                ? ActionResult.Success("Form validation passed.")
                : ActionResult.Failure("Form validation failed.");
        }

        if (string.Equals(action.Name, AgentComponentCapabilityProfile.FormSubmitActionId, StringComparison.OrdinalIgnoreCase))
        {
            var valid = _editContext!.Validate();
            await ValidationChanged.InvokeAsync(valid);
            if (!valid)
            {
                return ActionResult.Failure("Submit blocked because validation failed.");
            }

            await Submitted.InvokeAsync();
            await RequestComponentRefreshAsync();
            return ActionResult.Success("Submitted form.");
        }

        if (string.Equals(action.Name, AgentComponentCapabilityProfile.FormResetActionId, StringComparison.OrdinalIgnoreCase))
        {
            RestoreValues(Model, _initialValues);
            _editContext = new EditContext(Model);
            await ValidationChanged.InvokeAsync(false);
            await RequestComponentRefreshAsync();
            return ActionResult.Success("Reset form to initial values.");
        }

        return ActionResult.Unknown(action.Name);
    }

    private async Task HandleValidSubmitAsync()
    {
        await Submitted.InvokeAsync();
    }

    private void EnsureEditContext()
    {
        if (Model is null)
        {
            throw new InvalidOperationException($"{nameof(AgentForm)} requires a non-null {nameof(Model)}.");
        }

        if (_editContext is null || !ReferenceEquals(_editContext.Model, Model))
        {
            _editContext = new EditContext(Model);
            _initialValues = CaptureValues(Model);
        }
    }

    private static Dictionary<string, object?> CaptureValues(object model)
    {
        var values = new Dictionary<string, object?>(StringComparer.OrdinalIgnoreCase);
        foreach (var property in model.GetType().GetProperties(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance))
        {
            if (!property.CanRead || !property.CanWrite || property.GetIndexParameters().Length > 0)
            {
                continue;
            }

            values[property.Name] = property.GetValue(model);
        }

        return values;
    }

    private static void RestoreValues(object model, IReadOnlyDictionary<string, object?> values)
    {
        foreach (var property in model.GetType().GetProperties(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance))
        {
            if (!property.CanWrite || property.GetIndexParameters().Length > 0)
            {
                continue;
            }

            if (!values.TryGetValue(property.Name, out var initial))
            {
                continue;
            }

            if (initial is null)
            {
                property.SetValue(model, null);
                continue;
            }

            if (TryConvert(initial, property.PropertyType, out var converted))
            {
                property.SetValue(model, converted);
            }
        }
    }

    private static bool TrySetFieldValue(object model, string field, object? raw, out string message)
    {
        var property = model.GetType().GetProperties(System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance)
            .FirstOrDefault(p => p.CanWrite && string.Equals(p.Name, field, StringComparison.OrdinalIgnoreCase));
        if (property is null)
        {
            message = $"Field '{field}' was not found on form model '{model.GetType().Name}'.";
            return false;
        }

        if (raw is null)
        {
            property.SetValue(model, null);
            message = $"Set field '{property.Name}' to null.";
            return true;
        }

        if (!TryConvert(raw, property.PropertyType, out var converted))
        {
            message = $"Unable to convert field '{property.Name}' value '{raw}' to {property.PropertyType.Name}.";
            return false;
        }

        property.SetValue(model, converted);
        message = $"Set field '{property.Name}' to '{converted}'.";
        return true;
    }

    private static string[] GetSettableFieldNames(Type modelType) =>
        modelType.GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(static property => property.CanWrite && property.GetIndexParameters().Length == 0)
            .Select(static property => property.Name)
            .OrderBy(static name => name, StringComparer.OrdinalIgnoreCase)
            .ToArray();

    private static string? ResolveFieldName(Type modelType, string fieldHint)
    {
        var properties = modelType.GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Where(static property => property.CanWrite && property.GetIndexParameters().Length == 0)
            .ToArray();
        if (properties.Length == 0)
        {
            return null;
        }

        var direct = properties.FirstOrDefault(property =>
            string.Equals(property.Name, fieldHint, StringComparison.OrdinalIgnoreCase));
        if (direct is not null)
        {
            return direct.Name;
        }

        var normalizedHint = NormalizeIdentifier(fieldHint);
        if (normalizedHint.Length == 0)
        {
            return null;
        }

        var normalizedMatches = properties
            .Where(property => string.Equals(
                NormalizeIdentifier(property.Name),
                normalizedHint,
                StringComparison.OrdinalIgnoreCase))
            .ToArray();
        if (normalizedMatches.Length == 1)
        {
            return normalizedMatches[0].Name;
        }

        var hintTokens = SplitIdentifierTokens(fieldHint);
        if (hintTokens.Count == 0)
        {
            return null;
        }

        var scored = properties
            .Select(property =>
            {
                var propertyTokens = SplitIdentifierTokens(property.Name);
                var score = propertyTokens.Count(token =>
                    hintTokens.Contains(token, StringComparer.OrdinalIgnoreCase));
                var normalizedProperty = NormalizeIdentifier(property.Name);
                if (normalizedProperty.Contains(normalizedHint, StringComparison.OrdinalIgnoreCase) ||
                    normalizedHint.Contains(normalizedProperty, StringComparison.OrdinalIgnoreCase))
                {
                    score += 1;
                }

                return (property.Name, score);
            })
            .Where(static candidate => candidate.score > 0)
            .OrderByDescending(static candidate => candidate.score)
            .ThenBy(static candidate => candidate.Name, StringComparer.OrdinalIgnoreCase)
            .ToArray();

        if (scored.Length == 0)
        {
            return null;
        }

        if (scored.Length > 1 && scored[0].score == scored[1].score)
        {
            return null;
        }

        return scored[0].Name;
    }

    private static string NormalizeIdentifier(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        return new string(value.Where(char.IsLetterOrDigit).ToArray()).ToLowerInvariant();
    }

    private static List<string> SplitIdentifierTokens(string value)
    {
        var tokens = new List<string>();
        if (string.IsNullOrWhiteSpace(value))
        {
            return tokens;
        }

        var builder = new System.Text.StringBuilder();
        char? previous = null;
        foreach (var ch in value)
        {
            if (!char.IsLetterOrDigit(ch))
            {
                Flush();
                previous = null;
                continue;
            }

            if (previous is not null &&
                char.IsLower(previous.Value) &&
                char.IsUpper(ch))
            {
                Flush();
            }

            builder.Append(char.ToLowerInvariant(ch));
            previous = ch;
        }

        Flush();
        return tokens;

        void Flush()
        {
            if (builder.Length == 0)
            {
                return;
            }

            tokens.Add(builder.ToString());
            builder.Clear();
        }
    }

    private static object? Normalize(object? value)
    {
        if (value is System.Text.Json.JsonElement json)
        {
            return json.ValueKind switch
            {
                System.Text.Json.JsonValueKind.String => json.GetString(),
                System.Text.Json.JsonValueKind.Number when json.TryGetInt64(out var i64) => i64,
                System.Text.Json.JsonValueKind.Number when json.TryGetDouble(out var d) => d,
                System.Text.Json.JsonValueKind.True => true,
                System.Text.Json.JsonValueKind.False => false,
                System.Text.Json.JsonValueKind.Null => null,
                _ => json.ToString()
            };
        }

        return value;
    }

    private static bool TryConvert(object raw, Type destinationType, out object? converted)
    {
        var targetType = Nullable.GetUnderlyingType(destinationType) ?? destinationType;
        try
        {
            if (targetType.IsEnum)
            {
                converted = raw is string s
                    ? Enum.Parse(targetType, s, ignoreCase: true)
                    : Enum.ToObject(targetType, raw);
                return true;
            }

            if (targetType == typeof(Guid))
            {
                converted = raw is Guid g ? g : Guid.Parse(raw.ToString() ?? string.Empty);
                return true;
            }

            converted = Convert.ChangeType(raw, targetType, System.Globalization.CultureInfo.InvariantCulture);
            return true;
        }
        catch
        {
            converted = null;
            return false;
        }
    }
}
