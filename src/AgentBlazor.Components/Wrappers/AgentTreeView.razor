@namespace AgentBlazor.Components
@using AgentBlazor.Attributes
@using AgentBlazor.Runtime
@inherits AgentControllableComponentBase

<ul id="@AgentId"
    class="agent-tree-view"
    data-ab-type="tree-view"
    data-ab-agentid="@AgentId"
    @attributes="AdditionalAttributes">
    @foreach (var nodeId in GetNodes())
    {
        var isExpanded = IsExpanded(nodeId);
        var isSelected = string.Equals(SelectedNodeId, nodeId, StringComparison.OrdinalIgnoreCase);
        <li>
            <button type="button"
                    disabled="@(Disabled || ReadOnly)"
                    class="agent-tree-node @(isSelected ? "selected" : null)"
                    @onclick="() => OnNodeClickedAsync(nodeId)">
                @(isExpanded ? "▾" : "▸") @nodeId
            </button>
        </li>
    }
</ul>

@code {
    [Parameter]
    public IEnumerable<string>? NodeIds { get; set; }

    [Parameter]
    public string? SelectedNodeId { get; set; }

    [Parameter]
    public EventCallback<string?> SelectedNodeIdChanged { get; set; }

    [Parameter]
    public IEnumerable<string>? ExpandedNodeIds { get; set; }

    [Parameter]
    public EventCallback<IReadOnlyList<string>> ExpandedNodeIdsChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool ReadOnly { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private bool _expandedInitialized;

    public override string ComponentType => "TreeView";

    [AgentReadable("Currently selected node id")]
    public string? CurrentSelectedNodeId => SelectedNodeId;

    [AgentReadable("Currently expanded node ids")]
    public string[] CurrentExpandedNodeIds => GetExpandedNodes().ToArray();

    [AgentReadable("Available node ids")]
    public string[] AvailableNodeIds => GetNodes().ToArray();

    [AgentAction("Expand one tree node", ActionId = "expand")]
    public async Task<ActionResult> Expand(
        [AgentParam("Node id to expand", Required = true)] string nodeId)
    {
        if (Disabled || ReadOnly)
        {
            return ActionResult.Failure("Cannot expand nodes while tree view is disabled or read-only.");
        }

        if (!ContainsNode(nodeId))
        {
            return ActionResult.NeedsClarification($"Node '{nodeId}' is not available.");
        }

        EnsureExpandedInitialized();
        _expanded.Add(nodeId);
        await ExpandedNodeIdsChanged.InvokeAsync(GetExpandedNodes());
        await RequestComponentRefreshAsync();
        return ActionResult.Applied($"Expanded node '{nodeId}'.");
    }

    [AgentAction("Collapse one tree node", ActionId = "collapse")]
    public async Task<ActionResult> Collapse(
        [AgentParam("Node id to collapse", Required = true)] string nodeId)
    {
        if (Disabled || ReadOnly)
        {
            return ActionResult.Failure("Cannot collapse nodes while tree view is disabled or read-only.");
        }

        if (!ContainsNode(nodeId))
        {
            return ActionResult.NeedsClarification($"Node '{nodeId}' is not available.");
        }

        EnsureExpandedInitialized();
        _expanded.Remove(nodeId);
        await ExpandedNodeIdsChanged.InvokeAsync(GetExpandedNodes());
        await RequestComponentRefreshAsync();
        return ActionResult.Applied($"Collapsed node '{nodeId}'.");
    }

    [AgentAction("Select one tree node", ActionId = "select_node")]
    public async Task<ActionResult> SelectNode(
        [AgentParam("Node id to select", Required = true)] string nodeId)
    {
        if (Disabled || ReadOnly)
        {
            return ActionResult.Failure("Cannot select nodes while tree view is disabled or read-only.");
        }

        if (!ContainsNode(nodeId))
        {
            return ActionResult.NeedsClarification($"Node '{nodeId}' is not available.");
        }

        SelectedNodeId = nodeId;
        await SelectedNodeIdChanged.InvokeAsync(SelectedNodeId);
        await RequestComponentRefreshAsync();
        return ActionResult.Applied($"Selected node '{nodeId}'.");
    }

    public override ComponentState GetCurrentState() => new()
    {
        ["selectedNodeId"] = SelectedNodeId,
        ["expandedNodeIds"] = GetExpandedNodes().ToArray(),
        ["nodeIds"] = GetNodes().ToArray(),
        ["disabled"] = Disabled,
        ["readOnly"] = ReadOnly
    };

    private async Task OnNodeClickedAsync(string nodeId)
    {
        _ = await SelectNode(nodeId);
    }

    private IReadOnlyList<string> GetNodes() =>
        NodeIds?
            .Where(static n => !string.IsNullOrWhiteSpace(n))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray()
        ?? [];

    private bool ContainsNode(string nodeId)
    {
        var nodes = GetNodes();
        return nodes.Count == 0 || nodes.Contains(nodeId, StringComparer.OrdinalIgnoreCase);
    }

    private bool IsExpanded(string nodeId)
    {
        EnsureExpandedInitialized();
        return _expanded.Contains(nodeId);
    }

    private IReadOnlyList<string> GetExpandedNodes()
    {
        EnsureExpandedInitialized();
        return [.. _expanded.OrderBy(static n => n, StringComparer.OrdinalIgnoreCase)];
    }

    private void EnsureExpandedInitialized()
    {
        if (_expandedInitialized)
        {
            return;
        }

        _expandedInitialized = true;
        if (ExpandedNodeIds is null)
        {
            return;
        }

        foreach (var nodeId in ExpandedNodeIds)
        {
            if (!string.IsNullOrWhiteSpace(nodeId))
            {
                _expanded.Add(nodeId);
            }
        }
    }
}
