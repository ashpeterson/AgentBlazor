@namespace AgentBlazor.Components
@using AgentBlazor.Attributes
@using AgentBlazor.Runtime
@using MudBlazor
@inherits AgentControllableComponentBase

<MudTabs ActivePanelIndex="ActivePanelIndex"
         ActivePanelIndexChanged="OnActivePanelIndexChanged"
         id="@AgentId"
         data-ab-type="tabs"
         data-ab-agentid="@AgentId"
         @attributes="AdditionalAttributes">
    @ChildContent
</MudTabs>

@code {
    [Parameter]
    public int ActivePanelIndex { get; set; }

    [Parameter]
    public EventCallback<int> ActivePanelIndexChanged { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    public override string ComponentType => "Tabs";

    [AgentReadable("Currently active tab index (0-based)")]
    public int CurrentTabIndex => ActivePanelIndex;

    [AgentAction("Switch to a specific tab by index (0-based)")]
    public async Task SwitchTab(
        [AgentParam("Tab index, starting from 0", Required = true)] int index)
    {
        ActivePanelIndex = index;
        await ActivePanelIndexChanged.InvokeAsync(index);
        await RequestComponentRefreshAsync();
    }

    public override ComponentState GetCurrentState() => new()
    {
        ["activePanelIndex"] = ActivePanelIndex
    };

    private async Task OnActivePanelIndexChanged(int index)
    {
        ActivePanelIndex = index;
        await ActivePanelIndexChanged.InvokeAsync(index);
    }
}
