@namespace AgentBlazor.Components
@using AgentBlazor.Attributes
@using AgentBlazor.Runtime
@using MudBlazor
@inherits AgentControllableComponentBase

<MudDialog Visible="Visible"
           VisibleChanged="OnVisibleChanged"
           id="@AgentId"
           data-ab-type="dialog"
           data-ab-agentid="@AgentId"
           @attributes="AdditionalAttributes">
    <TitleContent>
        @TitleContent
    </TitleContent>
    <DialogContent>
        @DialogContent
    </DialogContent>
    <DialogActions>
        @DialogActions
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public RenderFragment? TitleContent { get; set; }

    [Parameter]
    public RenderFragment? DialogContent { get; set; }

    [Parameter]
    public RenderFragment? DialogActions { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Callback invoked when the agent calls the Confirm action.
    /// Wire this up to handle confirmation logic (e.g., form submission, delete confirmation).
    /// Return ActionResult.Applied("Success message") or ActionResult.Failure("Error message").
    /// </summary>
    [Parameter]
    public Func<Task<ActionResult>>? OnConfirm { get; set; }

    public override string ComponentType => "Dialog";

    [AgentReadable("Whether the dialog is currently visible")]
    public bool IsVisible => Visible;

    [AgentAction("Open this dialog. Call this BEFORE setting any form fields inside if the dialog is closed.")]
    public async Task Open()
    {
        await InvokeAsync(async () =>
        {
            Visible = true;
            await VisibleChanged.InvokeAsync(true);
            StateHasChanged();
        });
    }

    [AgentAction("Close this dialog")]
    public async Task Close()
    {
        await InvokeAsync(async () =>
        {
            Visible = false;
            await VisibleChanged.InvokeAsync(false);
            StateHasChanged();
        });
    }

    [AgentAction("Confirm the dialog action", RequiresApproval = true)]
    public async Task<ActionResult> Confirm()
    {
        if (OnConfirm is null)
        {
            return ActionResult.NeedsClarification("No confirm handler configured for this dialog. Set the OnConfirm parameter.");
        }

        ActionResult? result = null;
        await InvokeAsync(async () => result = await OnConfirm());
        return result ?? ActionResult.Failure("Confirm handler did not return a result.");
    }

    public override ComponentState GetCurrentState() => new()
    {
        ["visible"] = Visible
    };

    private Task OnVisibleChanged(bool visible)
    {
        return InvokeAsync(async () =>
        {
            Visible = visible;
            await VisibleChanged.InvokeAsync(visible);
            StateHasChanged();
        });
    }
}
