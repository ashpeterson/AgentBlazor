@namespace AgentBlazor.Components
@using AgentBlazor.Components
@using AgentBlazor.Runtime
@using MudBlazor
@inherits AgentControllableComponentBase

<MudDialog Visible="Visible"
           VisibleChanged="OnVisibleChanged"
           id="@AgentId"
           data-ab-type="dialog"
           data-ab-agentid="@AgentId"
           @attributes="AdditionalAttributes">
    <TitleContent>
        @TitleContent
    </TitleContent>
    <DialogContent>
        @DialogContent
    </DialogContent>
    <DialogActions>
        @DialogActions
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter]
    public RenderFragment? TitleContent { get; set; }

    [Parameter]
    public RenderFragment? DialogContent { get; set; }

    [Parameter]
    public RenderFragment? DialogActions { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    public override string ComponentType => "Dialog";

    protected override string ComponentIdForRoute => AgentComponentCapabilityProfile.AgentDialogComponentId;

    public override ComponentCapability GetCapability()
    {
        var capability = new ComponentCapability(AgentId, "Agent-aware dialog wrapper.");
        capability.UpsertAction(new ComponentActionCapability(
            AgentComponentCapabilityProfile.DialogOpenActionId,
            "Open dialog."));
        capability.UpsertAction(new ComponentActionCapability(
            AgentComponentCapabilityProfile.DialogCloseActionId,
            "Close dialog."));
        capability.UpsertAction(new ComponentActionCapability(
            AgentComponentCapabilityProfile.DialogConfirmActionId,
            "Confirm dialog action.",
            RequiresApproval: true));
        return capability;
    }

    public override ComponentState GetCurrentState() => new()
    {
        ["visible"] = Visible
    };

    public override async Task<ActionResult> ExecuteActionAsync(
        AgentAction action,
        CancellationToken cancellationToken = default)
    {
        _ = cancellationToken;
        action = NormalizeAction(AgentComponentCapabilityProfile.AgentDialogComponentId, action);
        if (string.Equals(action.Name, AgentComponentCapabilityProfile.DialogOpenActionId, StringComparison.OrdinalIgnoreCase))
        {
            await InvokeAsync(async () =>
            {
                Visible = true;
                await VisibleChanged.InvokeAsync(true);
                StateHasChanged();
            });
            return ActionResult.Success("Dialog opened.");
        }

        if (string.Equals(action.Name, AgentComponentCapabilityProfile.DialogCloseActionId, StringComparison.OrdinalIgnoreCase))
        {
            await InvokeAsync(async () =>
            {
                Visible = false;
                await VisibleChanged.InvokeAsync(false);
                StateHasChanged();
            });
            return ActionResult.Success("Dialog closed.");
        }

        if (string.Equals(action.Name, AgentComponentCapabilityProfile.DialogConfirmActionId, StringComparison.OrdinalIgnoreCase))
        {
            return ActionResult.Failure("Confirm workflow registration is present, but execution wiring is not implemented yet.");
        }

        return ActionResult.Unknown(action.Name);
    }

    public Task<ActionResult> OpenAsync(CancellationToken cancellationToken = default)
        => ExecuteActionAsync(
            AgentAction.Create(AgentComponentCapabilityProfile.DialogOpenActionId),
            cancellationToken);

    public Task<ActionResult> CloseAsync(CancellationToken cancellationToken = default)
        => ExecuteActionAsync(
            AgentAction.Create(AgentComponentCapabilityProfile.DialogCloseActionId),
            cancellationToken);

    private Task OnVisibleChanged(bool visible)
    {
        return InvokeAsync(async () =>
        {
            Visible = visible;
            await VisibleChanged.InvokeAsync(visible);
            StateHasChanged();
        });
    }
}
