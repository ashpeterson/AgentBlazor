@namespace AgentBlazor.Components
@using AgentBlazor.Components.Chat
@using AgentBlazor.Core.Runtime.Agents
@using AgentBlazor.Runtime
@using Microsoft.AspNetCore.Components.Web
@implements IDisposable
@inject IAgentChatWidgetState WidgetState

<section class="ab-chat-widget @(WidgetState.IsOpen ? "ab-chat-widget--open" : null) @(Theme?.CssClass) @(Theme?.GetFeatureClasses())"
         data-theme="@(Theme?.DataTheme)"
         data-style="@(Theme?.DataStyle)"
         data-radius="@(Theme?.DataRadius)"
         style="@HostStyle"
         aria-label="Chat widget">
    <div class="ab-chat-widget__window"
         role="dialog"
         aria-modal="true"
         aria-hidden="@(!WidgetState.IsOpen)"
         aria-label="@(Title ?? "Agent chat")"
         tabindex="@(WidgetState.IsOpen ? 0 : -1)"
         data-testid="agent-chat-widget-window"
         @onkeydown="HandleWindowKeyDown">
        <header class="ab-chat-widget__window-header">
            <span id="@HeaderLabelId">@(Title ?? "Agent Assistant")</span>
            <button type="button"
                    class="ab-chat-widget__icon-btn"
                    @onclick="Close"
                    tabindex="@(WidgetState.IsOpen ? 0 : -1)"
                    title="Minimize chat widget"
                    data-testid="agent-chat-widget-minimize"
                    aria-label="Minimize chat widget">
                <span class="ab-chat-widget__icon-btn-label">Minimize</span>
                <span aria-hidden="true">&minus;</span>
            </button>
        </header>

        <div class="ab-chat-widget__window-body">
            <AgentChatSurface Title="@Title"
                             Description="@EffectiveDescription"
                             FormName="@FormName"
                             DefaultAgentName="@DefaultAgentName"
                             ShowAgentSelector="@ShowAgentSelector"
                             LockedAgentName="@LockedAgentName"
                             LockAgentToCurrentRoute="@LockAgentToCurrentRoute"
                             EnableAgentHandoff="@EnableAgentHandoff"
                             AutoNavigateOnRouteLockedHandoff="@AutoNavigateOnRouteLockedHandoff"
                             RequireHandoffApproval="@RequireHandoffApproval"
                             HandoffApprovalPolicy="@HandoffApprovalPolicy"
                             HandoffPolicy="@HandoffPolicy"
                             MaxHandoffsPerSession="@MaxHandoffsPerSession"
                             MaxHandoffsPerPair="@MaxHandoffsPerPair"
                             MaxHandoffsPerWindow="@MaxHandoffsPerWindow"
                             HandoffWindowMinutes="@HandoffWindowMinutes"
                             MaxPairHandoffsPerWindow="@MaxPairHandoffsPerWindow"
                             BlockImmediateReturnHandoff="@BlockImmediateReturnHandoff"
                             SessionId="@SessionId"
                             Placeholder="@Placeholder"
                             EnableGeneratedUi="@EnableGeneratedUi"
                             ShowExecutionDetails="@ShowExecutionDetails"
                             ShowDevTools="@ShowDevTools"
                             AutoShowDevTools="@AutoShowDevTools"
                             Theme="@Theme"
                             CssClass="@CssClass" />
        </div>
    </div>

    <button type="button"
            class="ab-chat-widget__bubble"
            @onclick="Open"
            aria-hidden="@WidgetState.IsOpen"
            aria-expanded="@WidgetState.IsOpen"
            tabindex="@(WidgetState.IsOpen ? -1 : 0)"
            data-testid="agent-chat-widget-open"
            aria-label="@(BubbleAriaLabel ?? "Open agent chat")">
        <span class="ab-chat-widget__bubble-label" aria-hidden="true">@BubbleLabel</span>
    </button>
</section>

@code {
    [Parameter]
    public string? Title { get; set; } = "AgentBlazor Chat Widget";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string BubbleLabel { get; set; } = "Ask Agent";

    [Parameter]
    public string? BubbleAriaLabel { get; set; }

    [Parameter]
    public string Width { get; set; } = "360px";

    [Parameter]
    public string Height { get; set; } = "560px";

    [Parameter]
    public string Right { get; set; } = "1.25rem";

    [Parameter]
    public string Bottom { get; set; } = "1.25rem";

    [Parameter]
    public string Placeholder { get; set; } = "Type a message… (Enter to send, Shift+Enter for new line)";

    [Parameter]
    public ChatTheme? Theme { get; set; }

    [Parameter]
    public string? FormName { get; set; }

    [Parameter]
    public string? DefaultAgentName { get; set; }

    [Parameter]
    public bool ShowAgentSelector { get; set; } = true;

    [Parameter]
    public string? LockedAgentName { get; set; }

    [Parameter]
    public bool LockAgentToCurrentRoute { get; set; }

    [Parameter]
    public bool EnableAgentHandoff { get; set; } = true;

    [Parameter]
    public bool AutoNavigateOnRouteLockedHandoff { get; set; } = true;

    [Parameter]
    public bool RequireHandoffApproval { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, IReadOnlyList<string>>? HandoffApprovalPolicy { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, IReadOnlyList<string>>? HandoffPolicy { get; set; }

    [Parameter]
    public int? MaxHandoffsPerSession { get; set; }

    [Parameter]
    public int? MaxHandoffsPerPair { get; set; }

    [Parameter]
    public int? MaxHandoffsPerWindow { get; set; }

    [Parameter]
    public int? HandoffWindowMinutes { get; set; }

    [Parameter]
    public int? MaxPairHandoffsPerWindow { get; set; }

    [Parameter]
    public bool BlockImmediateReturnHandoff { get; set; } = true;

    [Parameter]
    public string? SessionId { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public bool EnableGeneratedUi { get; set; }

    [Parameter]
    public bool ShowExecutionDetails { get; set; }

    [Parameter]
    public bool? ShowDevTools { get; set; }

    [Parameter]
    public bool? AutoShowDevTools { get; set; }

    private string HeaderLabelId => $"ab-chat-widget-header-{_instanceId}";

    private readonly string _instanceId = Guid.NewGuid().ToString("N");

    private string EffectiveDescription =>
        !string.IsNullOrWhiteSpace(Description)
            ? Description
            : "Register an agent with ConfigureBuilder(builder => builder.AddWorkflow<T>(\"agent-name\")) before expecting the widget to respond.";

    private string HostStyle
    {
        get
        {
            var vars = $"--ab-chat-widget-width:{Width};--ab-chat-widget-height:{Height};--ab-chat-widget-right:{Right};--ab-chat-widget-bottom:{Bottom};";
            var themeStyle = Theme?.GetStyleString();
            return string.IsNullOrEmpty(themeStyle) ? vars : vars + " " + themeStyle;
        }
    }

    protected override void OnInitialized()
    {
        WidgetState.Changed += OnWidgetStateChanged;
        WidgetState.Close();
    }

    public void Dispose()
    {
        WidgetState.Changed -= OnWidgetStateChanged;
    }

    private void Open() => WidgetState.Open();

    private void Close() => WidgetState.Close();

    private void HandleWindowKeyDown(KeyboardEventArgs args)
    {
        if (string.Equals(args.Key, "Escape", StringComparison.OrdinalIgnoreCase))
        {
            WidgetState.Close();
        }
    }

    private void OnWidgetStateChanged() => _ = InvokeAsync(StateHasChanged);
}
