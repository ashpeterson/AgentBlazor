@namespace AgentBlazor.Components
@using AgentBlazor.Components.Chat
@using AgentBlazor.Core.Runtime.Agents
@using AgentBlazor.Runtime
@implements IDisposable
@inject IAgentChatWidgetState WidgetState

<section class="ab-chat-widget @(Theme?.CssClass)" data-theme="@(Theme?.DataTheme)" style="@HostStyle" aria-label="Chat widget">
    @if (WidgetState.IsOpen)
    {
        <div class="ab-chat-widget__window" role="dialog" aria-modal="true" aria-label="@(Title ?? "Agent chat")">
            <header class="ab-chat-widget__window-header">
                <span id="@HeaderLabelId">@(Title ?? "Agent Assistant")</span>
                <button type="button"
                        class="ab-chat-widget__icon-btn"
                        @onclick="Close"
                        aria-label="Minimize chat widget">
                    <span aria-hidden="true">&minus;</span>
                </button>
            </header>

            <div class="ab-chat-widget__window-body">
                <AgentChatSurface Title="@Title"
                                 Description="@Description"
                                 FormName="@FormName"
                                 DefaultAgentName="@DefaultAgentName"
                                 Placeholder="@Placeholder"
                                 Theme="@Theme"
                                 CssClass="@CssClass" />
            </div>
        </div>
    }
    else
    {
        <button type="button"
                class="ab-chat-widget__bubble"
                @onclick="Open"
                aria-label="@(BubbleAriaLabel ?? "Open agent chat")">
            <span class="ab-chat-widget__bubble-label" aria-hidden="true">@BubbleLabel</span>
        </button>
    }
</section>

@code {
    [Parameter]
    public string? Title { get; set; } = "AgentBlazor Chat Widget";

    [Parameter]
    public string? Description { get; set; } =
        "Built-in component-aware agent is active by default. You can also select custom registered agents.";

    [Parameter]
    public string BubbleLabel { get; set; } = "Ask Agent";

    [Parameter]
    public string? BubbleAriaLabel { get; set; }

    [Parameter]
    public string Width { get; set; } = "360px";

    [Parameter]
    public string Height { get; set; } = "560px";

    [Parameter]
    public string Right { get; set; } = "1.25rem";

    [Parameter]
    public string Bottom { get; set; } = "1.25rem";

    [Parameter]
    public string Placeholder { get; set; } = "Type a message… (Enter to send, Shift+Enter for new line)";

    [Parameter]
    public ChatTheme? Theme { get; set; }

    [Parameter]
    public string? FormName { get; set; }

    [Parameter]
    public string? DefaultAgentName { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    private string HeaderLabelId => $"ab-chat-widget-header-{_instanceId}";

    private readonly string _instanceId = Guid.NewGuid().ToString("N");

    private string HostStyle
    {
        get
        {
            var vars = $"--ab-chat-widget-width:{Width};--ab-chat-widget-height:{Height};--ab-chat-widget-right:{Right};--ab-chat-widget-bottom:{Bottom};";
            var themeStyle = Theme?.GetStyleString();
            return string.IsNullOrEmpty(themeStyle) ? vars : vars + " " + themeStyle;
        }
    }

    protected override void OnInitialized()
    {
        WidgetState.Changed += OnWidgetStateChanged;
    }

    public void Dispose()
    {
        WidgetState.Changed -= OnWidgetStateChanged;
    }

    private void Open() => WidgetState.Open();

    private void Close() => WidgetState.Close();

    private void OnWidgetStateChanged() => _ = InvokeAsync(StateHasChanged);
}
