@namespace AgentBlazor.Components
@using AgentBlazor.Components.Chat
@using AgentBlazor.Core.Runtime.Agents
@using AgentBlazor.Core.Runtime.Components
@using AgentBlazor.Core.Runtime.Interfaces
@using MudBlazor
@inject IAgentRuntime AgentRuntime

<div class="ab-chat-bar @(Theme?.CssClass) @CssClass" data-theme="@(Theme?.DataTheme)" style="@_themeStyle">
    <div class="ab-chat-bar__input-wrap">
        @if (ShowIcon)
        {
            <MudIcon Icon="@Icon" Class="ab-chat-bar__icon" />
        }
        <input type="text"
               class="ab-chat-bar__input"
               placeholder="@Placeholder"
               @bind="_prompt"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown"
               disabled="@_isBusy" />
        <button class="ab-chat-bar__send"
                @onclick="SendAsync"
                disabled="@(_isBusy || string.IsNullOrWhiteSpace(_prompt))">
            @if (_isBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Send" />
            }
        </button>
    </div>

    @if (Suggestions?.Count > 0)
    {
        <div class="ab-chat-bar__suggestions">
            @foreach (var suggestion in Suggestions)
            {
                <button class="ab-chat-bar__chip"
                        @onclick="@(() => SendPromptAsync(suggestion))"
                        disabled="@_isBusy">
                    @suggestion
                </button>
            }
        </div>
    }

    @if (ShowTimeline && _timeline.Count > 0)
    {
        <div class="ab-chat-bar__timeline">
            @foreach (var item in _timeline)
            {
                <article class="ab-chat-bar__message ab-chat-bar__message--@item.Role">
                    <div class="ab-chat-bar__message-role">@(item.Role == "user" ? "You" : "Agent")</div>
                    <div class="ab-chat-bar__message-text">@item.Text</div>
                    @if (item.PlannedActions.Count > 0)
                    {
                        <div class="ab-chat-bar__message-actions">
                            @foreach (var action in item.PlannedActions)
                            {
                                <span class="ab-chat-bar__action-chip">
                                    @action.ComponentId.@action.ActionId
                                </span>
                            }
                        </div>
                    }
                </article>
            }

            @if (ShowClearButton)
            {
                <button class="ab-chat-bar__clear" @onclick="ClearTimeline">
                    <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                    @ClearButtonText
                </button>
            }
        </div>
    }
</div>

@code {
    private string _prompt = string.Empty;
    private bool _isBusy;
    private readonly string _sessionId = Guid.NewGuid().ToString("N");
    private readonly List<ChatBarTimelineItem> _timeline = [];

    /// <summary>
    /// Placeholder text for the input field.
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; } = "Ask the agent...";

    /// <summary>
    /// List of suggestion chips to display below the input.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string>? Suggestions { get; set; }

    /// <summary>
    /// Whether to show the conversation timeline below the input.
    /// </summary>
    [Parameter]
    public bool ShowTimeline { get; set; } = true;

    /// <summary>
    /// Whether to show the icon in the input bar.
    /// </summary>
    [Parameter]
    public bool ShowIcon { get; set; } = true;

    /// <summary>
    /// Icon to display in the input bar.
    /// </summary>
    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.AutoAwesome;

    /// <summary>
    /// Whether to show the clear conversation button.
    /// </summary>
    [Parameter]
    public bool ShowClearButton { get; set; } = true;

    /// <summary>
    /// Text for the clear button.
    /// </summary>
    [Parameter]
    public string ClearButtonText { get; set; } = "Clear conversation";

    /// <summary>
    /// Name of the agent to use. If null, uses the default agent.
    /// </summary>
    [Parameter]
    public string? AgentName { get; set; }

    /// <summary>
    /// Theme configuration for the component.
    /// </summary>
    [Parameter]
    public ChatTheme? Theme { get; set; }

    /// <summary>
    /// Additional CSS class to apply to the root element.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Callback invoked when a message is sent.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnMessageSent { get; set; }

    /// <summary>
    /// Callback invoked when a response is received.
    /// </summary>
    [Parameter]
    public EventCallback<AgentTurnResponse> OnResponseReceived { get; set; }

    /// <summary>
    /// Callback invoked when an error occurs.
    /// </summary>
    [Parameter]
    public EventCallback<Exception> OnError { get; set; }

    private string? _themeStyle => Theme?.GetStyleString();

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_prompt) && !_isBusy)
        {
            await SendAsync();
        }
    }

    private async Task SendPromptAsync(string prompt)
    {
        _prompt = prompt;
        await SendAsync();
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt) || _isBusy)
            return;

        var message = _prompt.Trim();
        _prompt = string.Empty;
        _isBusy = true;
        StateHasChanged();

        // Add user message to timeline
        _timeline.Add(new ChatBarTimelineItem("user", message, []));

        await OnMessageSent.InvokeAsync(message);

        try
        {
            var response = await AgentRuntime.RunTurnAsync(new AgentTurnRequest(
                message,
                AgentName,
                SessionId: _sessionId));

            // Add agent response to timeline
            _timeline.Add(new ChatBarTimelineItem(
                "assistant",
                response.ResponseText,
                response.PlannedActions));

            await OnResponseReceived.InvokeAsync(response);
        }
        catch (Exception ex)
        {
            _timeline.Add(new ChatBarTimelineItem("assistant", $"Error: {ex.Message}", []));
            await OnError.InvokeAsync(ex);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ClearTimeline()
    {
        _timeline.Clear();
    }

    /// <summary>
    /// Programmatically send a message.
    /// </summary>
    public async Task SendMessageAsync(string message)
    {
        _prompt = message;
        await SendAsync();
    }

    /// <summary>
    /// Clear the conversation timeline.
    /// </summary>
    public void Clear() => ClearTimeline();

    private sealed record ChatBarTimelineItem(
        string Role,
        string Text,
        IReadOnlyList<PlannedComponentAction> PlannedActions);
}
