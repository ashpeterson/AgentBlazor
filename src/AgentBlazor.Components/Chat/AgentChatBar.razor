@namespace AgentBlazor.Components
@using AgentBlazor.Components.Chat
@using AgentBlazor.Components.Render
@using AgentBlazor.Core.Components
@using AgentBlazor.Core.Models
@using AgentBlazor.Core.Runtime.Agents
@using AgentBlazor.Core.Runtime.Components
@using AgentBlazor.Core.Runtime.Conversation
@using AgentBlazor.Core.Runtime.Interfaces
@using AgentBlazor.Execution
@using AgentBlazor.Options
@using Microsoft.Extensions.Options
@implements IDisposable
@using MudBlazor
@inject IAgentRuntimeAdapter RuntimeAdapter
@inject IAgentDeferredActionEvents DeferredActionEvents
@inject IConversationStore ConversationStore
@inject IAgentChatSessionState ChatSessionState
@inject IAgentChatSessionEvents SessionEvents
@inject IAgentActionRenderRegistry ActionRenderRegistry
@inject NavigationManager NavigationManager
@inject IOptions<AgentBlazorOptions> AgentBlazorOptionsAccessor
@inject IServiceProvider ServiceProvider
@inject IAgentExecutionScopeAccessor ExecutionScopeAccessor

<div class="ab-chat-bar @(HasConversation ? "ab-chat-bar--has-conversation" : "ab-chat-bar--idle") @(Theme?.CssClass) @(Theme?.GetFeatureClasses()) @CssClass"
     data-theme="@(Theme?.DataTheme)"
     data-style="@(Theme?.DataStyle)"
     data-radius="@(Theme?.DataRadius)"
     data-spacing="@(Theme?.DataSpacing)"
     data-testid="agent-chat-bar"
     style="@_themeStyle">
    <div class="ab-chat-bar__input-wrap">
        @if (ShowIcon)
        {
            <MudIcon Icon="@Icon" Class="ab-chat-bar__icon" />
        }
        <input type="text"
               class="ab-chat-bar__input"
               placeholder="@Placeholder"
               aria-label="Message input"
               data-testid="agent-chat-bar-input"
               @bind="_prompt"
               @bind:event="oninput"
               @onkeydown="HandleKeyDown"
               disabled="@_isBusy" />
        <button class="ab-chat-bar__send"
                type="button"
                aria-label="Send message"
                data-testid="agent-chat-bar-send"
                @onclick="SendAsync"
                disabled="@(_isBusy || string.IsNullOrWhiteSpace(_prompt))">
            @if (_isBusy)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Inherit" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Send" />
            }
        </button>
    </div>

    @if (Suggestions?.Count > 0)
    {
        <div class="ab-chat-bar__suggestions">
            @foreach (var suggestion in Suggestions)
            {
                <button class="ab-chat-bar__chip"
                        type="button"
                        data-testid="agent-chat-bar-suggestion"
                        @onclick="@(() => SendPromptAsync(suggestion))"
                        disabled="@_isBusy">
                    @suggestion
                </button>
            }
        </div>
    }

    @if (ShowTimeline && _timeline.Count > 0)
    {
        <div class="ab-chat-bar__timeline">
            @foreach (var item in _timeline)
            {
                <article class="ab-chat-bar__message ab-chat-bar__message--@item.Role">
                    <div class="ab-chat-bar__message-role">@GetRoleLabel(item.Role)</div>
                    <div class="ab-chat-bar__message-text">@item.Text</div>
                    @if (ShowExecutionDetails && TryGetPlanSummary(item, out var planSummary))
                    {
                        <div class="ab-chat-bar__message-text">@planSummary</div>
                    }
                    @if (ShowExecutionDetails && GetDisplayStepChips(item).Count > 0)
                    {
                        <div class="ab-chat-bar__message-actions">
                            @foreach (var action in GetDisplayStepChips(item))
                            {
                                <span class="ab-chat-bar__action-chip">
                                    @action
                                </span>
                            }
                        </div>
                    }
                    @if (ShowExecutionDetails && item.ActivityMessages.Count > 0)
                    {
                        <ul class="ab-chat-bar__activity-list">
                            @foreach (var activity in item.ActivityMessages)
                            {
                                if (TryBuildRenderedActivity(activity, out var renderedActivity))
                                {
                                    <li>@renderedActivity</li>
                                }
                                else
                                {
                                    <li>@activity.Text</li>
                                }
                            }
                        </ul>
                    }
                    @if (ShowExecutionDetails && GetDisplayResultTexts(item).Count > 0)
                    {
                        <ul class="ab-chat-bar__activity-list">
                            @foreach (var resultText in GetDisplayResultTexts(item))
                            {
                                <li>@resultText</li>
                            }
                        </ul>
                    }
                </article>
            }

            @if (!string.IsNullOrWhiteSpace(_streamingResponseText))
            {
                <article class="ab-chat-bar__message ab-chat-bar__message--assistant">
                    <div class="ab-chat-bar__message-role">@(_streamingAgentName ?? "Agent")</div>
                    <div class="ab-chat-bar__message-text">@_streamingResponseText</div>
                    @if (ShowExecutionDetails && _streamingActivityMessages.Count > 0)
                    {
                        <ul class="ab-chat-bar__activity-list">
                            @foreach (var activity in _streamingActivityMessages)
                            {
                                if (TryBuildRenderedActivity(activity, out var renderedActivity))
                                {
                                    <li>@renderedActivity</li>
                                }
                                else
                                {
                                    <li>@activity.Text</li>
                                }
                            }
                        </ul>
                    }
                </article>
            }

            @if (ShowClearButton)
            {
                <button class="ab-chat-bar__clear"
                        type="button"
                        data-testid="agent-chat-bar-clear"
                        @onclick="ClearTimelineAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                    @ClearButtonText
                </button>
            }
        </div>
    }
</div>

@code {
    private static readonly IReadOnlyDictionary<string, object?> EmptyActionArgs =
        new Dictionary<string, object?>();

    private string _prompt = string.Empty;
    private bool _isBusy;
    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private readonly List<ChatBarTimelineItem> _timeline = [];
    private string _streamingResponseText = string.Empty;
    private string? _streamingAgentName;
    private string? _activeRunId;
    private readonly List<ActivityMessage> _streamingActivityMessages = [];
    private readonly Dictionary<string, int> _assistantTimelineIndexByRunId =
        new(StringComparer.OrdinalIgnoreCase);
    private string? _historyHydratedForSession;
    private bool? _lastConversationState;

    /// <summary>
    /// Placeholder text for the input field.
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; } = "Ask the agent...";

    /// <summary>
    /// List of suggestion chips to display below the input.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string>? Suggestions { get; set; }

    /// <summary>
    /// Whether to show the conversation timeline below the input.
    /// </summary>
    [Parameter]
    public bool ShowTimeline { get; set; } = true;

    /// <summary>
    /// Whether to show the icon in the input bar.
    /// </summary>
    [Parameter]
    public bool ShowIcon { get; set; } = true;

    /// <summary>
    /// Icon to display in the input bar.
    /// </summary>
    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.AutoAwesome;

    /// <summary>
    /// Whether to show the clear conversation button.
    /// </summary>
    [Parameter]
    public bool ShowClearButton { get; set; } = true;

    /// <summary>
    /// Text for the clear button.
    /// </summary>
    [Parameter]
    public string ClearButtonText { get; set; } = "Clear conversation";

    /// <summary>
    /// Name of the agent to use. If null, uses the default agent.
    /// </summary>
    [Parameter]
    public string? AgentName { get; set; }

    /// <summary>
    /// Optional session identifier. If not provided, the scoped chat session id is used.
    /// </summary>
    [Parameter]
    public string? SessionId { get; set; }

    /// <summary>
    /// Enables generated UI planning context for each turn.
    /// </summary>
    [Parameter]
    public bool EnableGeneratedUi { get; set; }

    [Parameter]
    public bool ShowExecutionDetails { get; set; }

    /// <summary>
    /// Theme configuration for the component.
    /// </summary>
    [Parameter]
    public ChatTheme? Theme { get; set; }

    /// <summary>
    /// Additional CSS class to apply to the root element.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    /// <summary>
    /// Callback invoked when a message is sent.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnMessageSent { get; set; }

    /// <summary>
    /// Callback invoked when a response is received.
    /// </summary>
    [Parameter]
    public EventCallback<AgentTurnResponse> OnResponseReceived { get; set; }

    /// <summary>
    /// Callback invoked when an error occurs.
    /// </summary>
    [Parameter]
    public EventCallback<Exception> OnError { get; set; }

    /// <summary>
    /// Callback invoked when the bar transitions between idle and conversation-active states.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnConversationStateChanged { get; set; }

    private bool HasConversation =>
        _timeline.Count > 0 ||
        !string.IsNullOrWhiteSpace(_streamingResponseText) ||
        _isBusy;

    private string EffectiveSessionId =>
        string.IsNullOrWhiteSpace(SessionId)
            ? ChatSessionState.SessionId
            : SessionId.Trim();

    private string EffectiveConversationSessionId =>
        AgentConversationScope.BuildSessionKey(
            EffectiveSessionId,
            AgentName,
            AgentBlazorOptionsAccessor.Value.IsolateConversationsByAgent &&
            !string.IsNullOrWhiteSpace(AgentName));

    private string? _themeStyle => Theme?.GetStyleString();

    protected override void OnInitialized()
    {
        DeferredActionEvents.DeferredActionCompleted += HandleDeferredActionCompleted;
        SessionEvents.SessionUpdated += HandleSessionUpdated;
    }

    public void Dispose()
    {
        DeferredActionEvents.DeferredActionCompleted -= HandleDeferredActionCompleted;
        SessionEvents.SessionUpdated -= HandleSessionUpdated;
    }

    protected override async Task OnParametersSetAsync()
    {
        await HydrateTimelineFromHistoryAsync();
        await NotifyConversationStateChangedIfNeededAsync();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_prompt) && !_isBusy)
        {
            await SendAsync();
        }
    }

    private async Task SendPromptAsync(string prompt)
    {
        _prompt = prompt;
        await SendAsync();
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_prompt) || _isBusy)
            return;

        var message = _prompt.Trim();
        _prompt = string.Empty;
        _isBusy = true;
        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _activeRunId = null;
        _streamingActivityMessages.Clear();
        StateHasChanged();
        await NotifyConversationStateChangedIfNeededAsync();

        // Add user message to timeline
        _timeline.Add(new ChatBarTimelineItem("user", message, [], null, [], null));

        await OnMessageSent.InvokeAsync(message);

        try
        {
            var response = await RunTurnWithOptionalStreamingAsync(new AgentTurnRequest(
                message,
                AgentName,
                SessionId: EffectiveSessionId,
                Context: CreateRequestContext()));

            var activityMessages = _streamingActivityMessages.Count > 0
                ? _streamingActivityMessages.ToArray()
                : BuildActivityMessages(response);

            // Add agent response to timeline
            var runId = string.IsNullOrWhiteSpace(_activeRunId) ? null : _activeRunId;
            _timeline.Add(new ChatBarTimelineItem(
                "assistant",
                response.ResponseText,
                response.LegacyPlannedActions,
                response.ExecutionPlan,
                activityMessages,
                runId));
            if (!string.IsNullOrWhiteSpace(runId))
            {
                _assistantTimelineIndexByRunId[runId] = _timeline.Count - 1;
            }
            _streamingActivityMessages.Clear();

            await OnResponseReceived.InvokeAsync(response);
            SessionEvents.NotifySessionUpdated(EffectiveConversationSessionId, _instanceId);
        }
        catch (Exception ex)
        {
            _streamingResponseText = string.Empty;
            _streamingAgentName = null;
            _streamingActivityMessages.Clear();
            _timeline.Add(new ChatBarTimelineItem("assistant", $"Error: {ex.Message}", [], null, [], null));
            await OnError.InvokeAsync(ex);
        }
        finally
        {
            _isBusy = false;
            await NotifyConversationStateChangedIfNeededAsync();
        }
    }

    private async Task ClearTimelineAsync()
    {
        _timeline.Clear();
        _assistantTimelineIndexByRunId.Clear();
        _streamingActivityMessages.Clear();
        _activeRunId = null;
        await ConversationStore.ClearSessionAsync(EffectiveConversationSessionId);
        SessionEvents.NotifySessionUpdated(EffectiveConversationSessionId, _instanceId);
        await NotifyConversationStateChangedIfNeededAsync();
    }

    /// <summary>
    /// Programmatically send a message.
    /// </summary>
    public async Task SendMessageAsync(string message)
    {
        _prompt = message;
        await SendAsync();
    }

    /// <summary>
    /// Pre-fills the prompt input with the given text.
    /// </summary>
    public Task InjectAsync(string prompt)
    {
        _prompt = prompt;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Clear the conversation timeline.
    /// </summary>
    public void Clear()
    {
        _timeline.Clear();
        _assistantTimelineIndexByRunId.Clear();
        _streamingActivityMessages.Clear();
        _activeRunId = null;
        _ = ConversationStore.ClearSessionAsync(EffectiveConversationSessionId);
        SessionEvents.NotifySessionUpdated(EffectiveConversationSessionId, _instanceId);
        _ = NotifyConversationStateChangedIfNeededAsync();
    }

    private async Task<AgentTurnResponse> RunTurnWithOptionalStreamingAsync(AgentTurnRequest request)
    {
        using var executionScope = ExecutionScopeAccessor.Push(ServiceProvider);

        if (!RuntimeAdapter.SupportsStreaming)
        {
            return await RuntimeAdapter.RunTurnAsync(request);
        }

        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _activeRunId = null;
        _streamingActivityMessages.Clear();

        AgentTurnResponse? finalResponse = null;
        await foreach (var streamEvent in RuntimeAdapter.RunTurnStreamingAsync(request))
        {
            if (string.IsNullOrWhiteSpace(_activeRunId) &&
                !string.IsNullOrWhiteSpace(streamEvent.RunId))
            {
                _activeRunId = streamEvent.RunId;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.ToolCallStart &&
                streamEvent.PlannedAction is not null)
            {
                var plannedAction = streamEvent.PlannedAction;
                AddStreamingActivityMessage(
                    new ActivityMessage(
                        BuildActivityKey(plannedAction.ComponentId, plannedAction.ActionId),
                        FormatToolCallStartMessage(plannedAction),
                        Succeeded: true,
                        ComponentId: plannedAction.ComponentId,
                        ActionId: plannedAction.ActionId,
                        Status: ActionStatus.InProgress,
                        Args: plannedAction.Arguments,
                        Result: null));
                await InvokeAsync(StateHasChanged);
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.ToolCallArgs &&
                streamEvent.PlannedAction is not null)
            {
                var plannedAction = streamEvent.PlannedAction;
                var args = streamEvent.ToolArguments ?? plannedAction.Arguments;
                AddStreamingActivityMessage(
                    new ActivityMessage(
                        BuildActivityKey(plannedAction.ComponentId, plannedAction.ActionId),
                        FormatToolCallStartMessage(plannedAction),
                        Succeeded: true,
                        ComponentId: plannedAction.ComponentId,
                        ActionId: plannedAction.ActionId,
                        Status: ActionStatus.InProgress,
                        Args: args,
                        Result: null));
                await InvokeAsync(StateHasChanged);
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.ToolCallEnd &&
                streamEvent.PlannedAction is not null)
            {
                var plannedAction = streamEvent.PlannedAction;
                var key = BuildActivityKey(plannedAction.ComponentId, plannedAction.ActionId);
                AddStreamingActivityMessage(
                    new ActivityMessage(
                        key,
                        FormatToolCallStartMessage(plannedAction),
                        Succeeded: true,
                        ComponentId: plannedAction.ComponentId,
                        ActionId: plannedAction.ActionId,
                        Status: ActionStatus.Executing,
                        Args: streamEvent.ToolArguments ?? plannedAction.Arguments ?? GetActivityArgsByKey(key),
                        Result: null));
                await InvokeAsync(StateHasChanged);
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.ToolCallResult &&
                streamEvent.ExecutionResult is not null)
            {
                var result = streamEvent.ExecutionResult;
                var key = BuildActivityKey(result.ComponentId, result.ActionId);
                var status = MapExecutionResultStatus(result);
                AddStreamingActivityMessage(
                    new ActivityMessage(
                        key,
                        FormatToolCallResultMessage(result),
                        result.Outcome is ActionOutcome.Applied,
                        result.ComponentId,
                        result.ActionId,
                        status,
                        GetActivityArgsByKey(key),
                        result.Message));
                await InvokeAsync(StateHasChanged);
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.TextMessageContent &&
                !string.IsNullOrEmpty(streamEvent.TextDelta))
            {
                _streamingAgentName ??= streamEvent.AgentName;
                _streamingResponseText += streamEvent.TextDelta;
                await InvokeAsync(StateHasChanged);
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.RunFinished &&
                streamEvent.Response is not null)
            {
                finalResponse = streamEvent.Response;
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.RunError)
            {
                throw new InvalidOperationException(streamEvent.ErrorMessage ?? "Streaming run failed.");
            }
        }

        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        await NotifyConversationStateChangedIfNeededAsync();

        return finalResponse
            ?? throw new InvalidOperationException("Streaming completed without a final response.");
    }

    private void HandleDeferredActionCompleted(DeferredComponentActionEvent actionEvent)
    {
        if (!IsDeferredEventForCurrentChat(actionEvent))
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            var message = FormatDeferredActionMessage(actionEvent);
            var key = BuildActivityKey(actionEvent.ComponentType, actionEvent.ActionId);
            var status = actionEvent.Succeeded ? ActionStatus.Complete : ActionStatus.Failed;
            var activity = new ActivityMessage(
                key,
                message,
                actionEvent.Succeeded,
                actionEvent.ComponentType,
                actionEvent.ActionId,
                status,
                Args: null,
                Result: actionEvent.Message);
            if (!TryAttachActivityToAssociatedTurn(activity, actionEvent.RunId))
            {
                _timeline.Add(new ChatBarTimelineItem("activity", message, [], null, [], actionEvent.RunId));
            }

            StateHasChanged();
        });
    }

    private void HandleSessionUpdated(AgentChatSessionUpdate update)
    {
        if (_isBusy ||
            !string.Equals(update.SessionId, EffectiveConversationSessionId, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(update.SourceId, _instanceId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await HydrateTimelineFromHistoryAsync(force: true);
            StateHasChanged();
        });
    }

    private bool IsDeferredEventForCurrentChat(DeferredComponentActionEvent actionEvent)
    {
        if (!string.IsNullOrWhiteSpace(actionEvent.SessionId))
        {
            return string.Equals(actionEvent.SessionId, EffectiveSessionId, StringComparison.OrdinalIgnoreCase);
        }

        if (!string.IsNullOrWhiteSpace(actionEvent.RunId) &&
            !string.IsNullOrWhiteSpace(_activeRunId))
        {
            return string.Equals(actionEvent.RunId, _activeRunId, StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }

    private void AddStreamingActivityMessage(ActivityMessage activity)
    {
        if (string.IsNullOrWhiteSpace(activity.Key) || string.IsNullOrWhiteSpace(activity.Text))
        {
            return;
        }

        UpsertActivityMessage(_streamingActivityMessages, activity);
    }

    private bool TryAttachActivityToAssociatedTurn(ActivityMessage activity, string? runId)
    {
        if (string.IsNullOrWhiteSpace(activity.Key) || string.IsNullOrWhiteSpace(activity.Text))
        {
            return true;
        }

        if (!string.IsNullOrWhiteSpace(runId))
        {
            if (_isBusy &&
                !string.IsNullOrWhiteSpace(_activeRunId) &&
                string.Equals(runId, _activeRunId, StringComparison.OrdinalIgnoreCase))
            {
                AddStreamingActivityMessage(activity);
                return true;
            }

            if (_assistantTimelineIndexByRunId.TryGetValue(runId, out var assistantIndex))
            {
                return TryAppendActivityToAssistantItem(assistantIndex, activity);
            }
        }

        if (_isBusy)
        {
            AddStreamingActivityMessage(activity);
            return true;
        }

        for (var index = _timeline.Count - 1; index >= 0; index--)
        {
            if (_timeline[index].Role != "assistant")
            {
                continue;
            }

            return TryAppendActivityToAssistantItem(index, activity);
        }

        return false;
    }

    private bool TryAppendActivityToAssistantItem(int index, ActivityMessage activity)
    {
        if (index < 0 || index >= _timeline.Count)
        {
            return false;
        }

        var item = _timeline[index];
        if (!string.Equals(item.Role, "assistant", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var updatedActivities = UpsertActivityMessage(item.ActivityMessages, activity);
        _timeline[index] = item with { ActivityMessages = updatedActivities };
        return true;
    }

    private static string BuildActivityKey(string componentId, string actionId)
    {
        var normalizedComponent = (componentId ?? string.Empty).Trim();
        var normalizedAction = (actionId ?? string.Empty).Trim();
        return $"{normalizedComponent}.{normalizedAction}".ToLowerInvariant();
    }

    private static void UpsertActivityMessage(List<ActivityMessage> target, ActivityMessage activity)
    {
        var index = target.FindIndex(existing =>
            string.Equals(existing.Key, activity.Key, StringComparison.OrdinalIgnoreCase));
        if (index >= 0)
        {
            target[index] = activity;
            return;
        }

        target.Add(activity);
    }

    private static IReadOnlyList<ActivityMessage> UpsertActivityMessage(
        IReadOnlyList<ActivityMessage> source,
        ActivityMessage activity)
    {
        var copy = source.ToList();
        UpsertActivityMessage(copy, activity);
        return copy;
    }

    private bool TryBuildRenderedActivity(ActivityMessage activity, out RenderFragment? rendered)
    {
        rendered = null;
        if (string.IsNullOrWhiteSpace(activity.ComponentId) || string.IsNullOrWhiteSpace(activity.ActionId))
        {
            return false;
        }

        var fragments = ActionRenderRegistry.TryGet(activity.ComponentId, activity.ActionId);
        var fragment = fragments?.Resolve(activity.Status);
        if (fragment is null)
        {
            return false;
        }

        var context = new ActionRenderContext(
            activity.ComponentId,
            activity.ActionId,
            activity.Status,
            activity.Args ?? EmptyActionArgs,
            activity.Result ?? activity.Text);
        rendered = fragment(context);
        return true;
    }

    private IReadOnlyDictionary<string, object?>? GetActivityArgsByKey(string key)
    {
        for (var i = _streamingActivityMessages.Count - 1; i >= 0; i--)
        {
            var activity = _streamingActivityMessages[i];
            if (!string.Equals(activity.Key, key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return activity.Args;
        }

        return null;
    }

    private static IReadOnlyDictionary<string, object?> FindActionArguments(
        IReadOnlyList<PlannedComponentAction> plannedActions,
        string componentId,
        string actionId)
    {
        for (var i = plannedActions.Count - 1; i >= 0; i--)
        {
            var action = plannedActions[i];
            if (!string.Equals(action.ComponentId, componentId, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(action.ActionId, actionId, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return action.Arguments ?? EmptyActionArgs;
        }

        return EmptyActionArgs;
    }

    private static string FormatDeferredActionMessage(DeferredComponentActionEvent actionEvent)
    {
        var componentId = actionEvent.ComponentType.StartsWith("Agent", StringComparison.OrdinalIgnoreCase)
            ? actionEvent.ComponentType
            : $"Agent{actionEvent.ComponentType}";
        var status = actionEvent.Succeeded ? "applied" : "failed";
        return $"Deferred action {status}: {componentId}.{actionEvent.ActionId}. {actionEvent.Message}";
    }

    private static string FormatToolCallStartMessage(PlannedComponentAction plannedAction)
    {
        return $"Executing {plannedAction.ComponentId}.{plannedAction.ActionId}...";
    }

    private static string FormatToolCallResultMessage(ComponentActionExecutionResult executionResult)
    {
        if (!string.IsNullOrWhiteSpace(executionResult.Message))
        {
            return executionResult.Message;
        }

        return executionResult.Outcome switch
        {
            ActionOutcome.Applied => $"Completed {executionResult.ComponentId}.{executionResult.ActionId}.",
            ActionOutcome.Queued => $"Queued {executionResult.ComponentId}.{executionResult.ActionId}.",
            _ => $"Failed {executionResult.ComponentId}.{executionResult.ActionId}."
        };
    }

    private static ActionStatus MapExecutionResultStatus(ComponentActionExecutionResult executionResult)
        => executionResult.Outcome switch
        {
            ActionOutcome.Applied => ActionStatus.Complete,
            ActionOutcome.Queued => ActionStatus.InProgress,
            _ => ActionStatus.Failed
        };

    private IDictionary<string, string>? CreateRequestContext()
    {
        var context = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        if (EnableGeneratedUi)
        {
            context[AgentGenerativeUiSpec.GenerateUiContextKey] = bool.TrueString;
        }

        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var routePart = relativePath;
        var queryOrFragmentIndex = routePart.IndexOfAny(['?', '#']);
        if (queryOrFragmentIndex >= 0)
        {
            routePart = routePart[..queryOrFragmentIndex];
        }

        var currentRoute = string.IsNullOrWhiteSpace(routePart) ? "/" : "/" + routePart;
        context[AgentRuntimeContextKeys.CurrentRoute] = currentRoute;

        if (!string.IsNullOrWhiteSpace(AgentName))
        {
            context[AgentRuntimeContextKeys.AgentName] = AgentName;
            context[AgentRuntimeContextKeys.AgentLock] = bool.TrueString;
        }

        return context.Count > 0 ? context : null;
    }

    private async Task HydrateTimelineFromHistoryAsync(bool force = false)
    {
        var sessionId = EffectiveConversationSessionId;
        if (!force &&
            string.Equals(_historyHydratedForSession, sessionId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _historyHydratedForSession = sessionId;
        var history = await ConversationStore.GetHistoryAsync(sessionId);
        _timeline.Clear();
        _assistantTimelineIndexByRunId.Clear();
        _streamingActivityMessages.Clear();
        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _activeRunId = null;

        if (history is null || history.Turns.Count == 0)
        {
            return;
        }

        foreach (var turn in history.Turns.OrderBy(static turn => turn.Timestamp))
        {
            if (!string.IsNullOrWhiteSpace(turn.UserMessage))
            {
                _timeline.Add(new ChatBarTimelineItem("user", turn.UserMessage, [], null, [], null));
            }

            if (!string.IsNullOrWhiteSpace(turn.AgentResponse))
            {
                _timeline.Add(new ChatBarTimelineItem(
                    "assistant",
                    turn.AgentResponse,
                    turn.LegacyPlannedActions,
                    turn.ExecutionPlan,
                    BuildActivityMessages(turn),
                    null));
            }
        }

        await NotifyConversationStateChangedIfNeededAsync();
    }

    private async Task NotifyConversationStateChangedIfNeededAsync()
    {
        var hasConversation = HasConversation;
        if (_lastConversationState == hasConversation)
        {
            return;
        }

        _lastConversationState = hasConversation;
        if (OnConversationStateChanged.HasDelegate)
        {
            await OnConversationStateChanged.InvokeAsync(hasConversation);
        }
    }

    private static IReadOnlyList<ActivityMessage> BuildActivityMessages(
        ConversationTurn turn)
    {
        if (turn.ExecutionPlan?.Steps.Count > 0)
        {
            return turn.ExecutionPlan.Steps
                .Select(step => new ActivityMessage(
                    BuildActivityKey(step.TargetId, step.ActionId),
                    string.IsNullOrWhiteSpace(step.Message)
                        ? FormatExecutionStepActivity(step)
                        : $"{FormatExecutionStepActivity(step)}: {step.Message}",
                    step.Status is not AgentExecutionStepStatus.Failed and not AgentExecutionStepStatus.Blocked,
                    step.TargetId,
                    step.ActionId,
                    MapStepStatus(step.Status),
                    step.Arguments,
                    step.PolicyDecision))
                .ToArray();
        }

        return BuildActivityMessages(turn.LegacyExecutionResults, turn.LegacyPlannedActions);
    }

    private static IReadOnlyList<ActivityMessage> BuildActivityMessages(
        AgentTurnResponse response)
    {
        if (response.ExecutionPlan?.Steps.Count > 0)
        {
            return response.ExecutionPlan.Steps
                .Select(step => new ActivityMessage(
                    BuildActivityKey(step.TargetId, step.ActionId),
                    string.IsNullOrWhiteSpace(step.Message)
                        ? FormatExecutionStepActivity(step)
                        : $"{FormatExecutionStepActivity(step)}: {step.Message}",
                    step.Status is not AgentExecutionStepStatus.Failed and not AgentExecutionStepStatus.Blocked,
                    step.TargetId,
                    step.ActionId,
                    MapStepStatus(step.Status),
                    step.Arguments,
                    step.PolicyDecision))
                .ToArray();
        }

        return BuildActivityMessages(response.LegacyExecutionResults, response.LegacyPlannedActions);
    }

    private static string FormatExecutionStepActivity(AgentExecutionStep step)
    {
        var label = step.RequiresApproval
            ? "Approval"
            : step.Kind switch
            {
                AgentExecutionStepKind.SemanticCapability => "Capability",
                AgentExecutionStepKind.ServiceTool => "Tool",
                AgentExecutionStepKind.GeneratedUiTool => "UI Block",
                _ => "UI"
            };

        return $"{label} {step.TargetId}.{step.ActionId}";
    }

    private static IReadOnlyList<ActivityMessage> BuildActivityMessages(
        IReadOnlyList<ComponentActionExecutionResult> executionResults,
        IReadOnlyList<PlannedComponentAction> plannedActions)
    {
        if (executionResults.Count == 0)
        {
            return [];
        }

        var messages = new List<ActivityMessage>(executionResults.Count);
        foreach (var result in executionResults)
        {
            var key = BuildActivityKey(result.ComponentId, result.ActionId);
            var text = FormatToolCallResultMessage(result);
            var status = MapExecutionResultStatus(result);
            messages.Add(new ActivityMessage(
                key,
                text,
                result.Outcome is ActionOutcome.Applied,
                result.ComponentId,
                result.ActionId,
                status,
                FindActionArguments(plannedActions, result.ComponentId, result.ActionId),
                result.Message));
        }

        return messages;
    }

    private static ActionStatus MapStepStatus(AgentExecutionStepStatus status) =>
        status switch
        {
            AgentExecutionStepStatus.Pending => ActionStatus.InProgress,
            AgentExecutionStepStatus.Queued => ActionStatus.InProgress,
            AgentExecutionStepStatus.ApprovalRequired => ActionStatus.Executing,
            AgentExecutionStepStatus.NeedsClarification => ActionStatus.Failed,
            AgentExecutionStepStatus.Blocked => ActionStatus.Failed,
            AgentExecutionStepStatus.Failed => ActionStatus.Failed,
            _ => ActionStatus.Complete
        };

    private static IReadOnlyList<string> GetDisplayStepChips(ChatBarTimelineItem item)
        => ExecutionPlanNarrativeFormatter.BuildStepLabels(item.ExecutionPlan, item.LegacyPlannedActions);

    private static bool TryGetPlanSummary(ChatBarTimelineItem item, out string summary)
        => ExecutionPlanNarrativeFormatter.TryBuildPlanSummary(item.ExecutionPlan, item.LegacyPlannedActions, out summary);

    private static string GetRoleLabel(string role) =>
        role switch
        {
            "user" => "You",
            "activity" => "Activity",
            _ => "Agent"
        };

    private static IReadOnlyList<string> GetDisplayResultTexts(ChatBarTimelineItem item)
    {
        if (item.ExecutionPlan?.Steps.Count > 0)
        {
            return item.ExecutionPlan.Steps
                .SelectMany(ExecutionStepNarrativeFormatter.BuildResultTexts)
                .ToArray();
        }

        return [];
    }

    private sealed record ChatBarTimelineItem(
        string Role,
        string Text,
        IReadOnlyList<PlannedComponentAction> LegacyPlannedActions,
        AgentExecutionPlan? ExecutionPlan,
        IReadOnlyList<ActivityMessage> ActivityMessages,
        string? RunId);

    private sealed record ActivityMessage(
        string Key,
        string Text,
        bool Succeeded = true,
        string? ComponentId = null,
        string? ActionId = null,
        ActionStatus Status = ActionStatus.Complete,
        IReadOnlyDictionary<string, object?>? Args = null,
        object? Result = null);
}
