    private async Task RequestStopAsync()
    {
        if (!CanRequestStop || _stopRequested || string.IsNullOrWhiteSpace(_activeRunId))
        {
            return;
        }

        _stopRequested = true;
        await InvokeAsync(StateHasChanged);

        var stopped = await RuntimeAdapter.StopRunAsync(_activeRunId);
        if (!stopped)
        {
            _stopRequested = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<StreamTurnOutcome> RunTurnWithOptionalStreamingAsync(AgentTurnRequest request)
    {
        using var executionScope = ExecutionScopeAccessor.Push(ServiceProvider);

        if (!RuntimeAdapter.SupportsStreaming)
        {
            var immediateResponse = await RuntimeAdapter.RunTurnAsync(request);
            return new StreamTurnOutcome(
                immediateResponse,
                ClarificationQuestion: immediateResponse.RequiresClarification
                    ? immediateResponse.ClarificationQuestion
                    : null,
                PendingApprovals: immediateResponse.RequiresApproval
                    ? immediateResponse.PendingApprovals
                    : [],
                RunId: null);
        }

        return await ConsumeStreamingRunAsync(
            RuntimeAdapter.RunTurnStreamingAsync(request),
            request,
            fallbackAgentName: _selectedAgent ?? request.AgentName,
            conversationSessionId: EffectiveConversationSessionId,
            initialUserMessage: request.UserMessage,
            trackActiveRun: true);
    }

    private async Task<StreamTurnOutcome> ConsumeStreamingRunAsync(
        IAsyncEnumerable<AgentTurnStreamEvent> stream,
        AgentTurnRequest? request,
        string? fallbackAgentName,
        string conversationSessionId,
        string? initialUserMessage,
        bool trackActiveRun)
    {
        _streamingResponseText = string.Empty;
        _streamingReasoningText = string.Empty;
        _reasoningComplete = false;
        _streamingAgentName = null;
        _streamingActivityMessages.Clear();
        _completedActivityKeys.Clear();

        AgentTurnResponse? finalResponse = null;
        string? clarificationQuestion = null;
        var pendingApprovals = new List<PendingApproval>();
        try
        {
            await foreach (var streamEvent in stream)
            {
                if (string.IsNullOrWhiteSpace(_activeRunId) &&
                    !string.IsNullOrWhiteSpace(streamEvent.RunId))
                {
                    _activeRunId = streamEvent.RunId;
                    if (trackActiveRun)
                    {
                        ActiveRunStore.Track(new AgentChatActiveRun(
                            conversationSessionId,
                            streamEvent.RunId,
                            fallbackAgentName,
                            initialUserMessage,
                            DateTimeOffset.UtcNow));
                        SessionEvents.NotifySessionUpdated(EffectiveConversationSessionId, _instanceId);
                    }
                }

                if (streamEvent.Kind == AgentTurnStreamEventKind.ToolCallStart &&
                    streamEvent.PlannedAction is not null)
                {
                    var plannedAction = streamEvent.PlannedAction;
                    AddStreamingActivityMessage(
                        new ActivityMessage(
                            BuildActivityKey(plannedAction.ComponentId, plannedAction.ActionId),
                            FormatToolCallStartMessage(plannedAction),
                            Succeeded: true,
                            ComponentId: plannedAction.ComponentId,
                            ActionId: plannedAction.ActionId,
                            Status: ActionStatus.InProgress,
                            Args: plannedAction.Arguments,
                            Result: null));
                    _scrollRequested = true;
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                if (streamEvent.Kind == AgentTurnStreamEventKind.ToolCallArgs &&
                    streamEvent.PlannedAction is not null)
                {
                    var plannedAction = streamEvent.PlannedAction;
                    var args = streamEvent.ToolArguments ?? plannedAction.Arguments;
                    AddStreamingActivityMessage(
                        new ActivityMessage(
                            BuildActivityKey(plannedAction.ComponentId, plannedAction.ActionId),
                            FormatToolCallStartMessage(plannedAction),
                            Succeeded: true,
                            ComponentId: plannedAction.ComponentId,
                            ActionId: plannedAction.ActionId,
                            Status: ActionStatus.InProgress,
                            Args: args,
                            Result: null));
                    _scrollRequested = true;
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                if (streamEvent.Kind == AgentTurnStreamEventKind.ToolCallEnd &&
                    streamEvent.PlannedAction is not null)
                {
                    var plannedAction = streamEvent.PlannedAction;
                    var key = BuildActivityKey(plannedAction.ComponentId, plannedAction.ActionId);
                    AddStreamingActivityMessage(
                        new ActivityMessage(
                            key,
                            FormatToolCallStartMessage(plannedAction),
                            Succeeded: true,
                            ComponentId: plannedAction.ComponentId,
                            ActionId: plannedAction.ActionId,
                            Status: ActionStatus.Executing,
                            Args: streamEvent.ToolArguments ?? plannedAction.Arguments ?? GetActivityArgsByKey(key),
                            Result: null));
                    _scrollRequested = true;
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                if (streamEvent.Kind == AgentTurnStreamEventKind.ToolCallResult &&
                    streamEvent.ExecutionResult is not null)
                {
                    var resultKey = BuildActivityKey(streamEvent.ExecutionResult.ComponentId, streamEvent.ExecutionResult.ActionId);
                    var resultStatus = streamEvent.ExecutionResult.Succeeded ? ActionStatus.Complete : ActionStatus.Failed;
                    AddStreamingActivityMessage(
                        new ActivityMessage(
                            resultKey,
                            FormatToolCallResultMessage(streamEvent.ExecutionResult),
                            streamEvent.ExecutionResult.Succeeded,
                            streamEvent.ExecutionResult.ComponentId,
                            streamEvent.ExecutionResult.ActionId,
                            resultStatus,
                            GetActivityArgsByKey(resultKey),
                            streamEvent.ExecutionResult.Message));
                    _completedActivityKeys.Add(resultKey);
                    _scrollRequested = true;
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                if (streamEvent.Kind == AgentTurnStreamEventKind.ReasoningContent &&
                    !string.IsNullOrEmpty(streamEvent.ReasoningDelta))
                {
                    _streamingReasoningText += streamEvent.ReasoningDelta;
                    _reasoningComplete = false;
                    _scrollRequested = true;
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                if (streamEvent.Kind == AgentTurnStreamEventKind.ReasoningEnd)
                {
                    _reasoningComplete = true;
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                if (streamEvent.Kind == AgentTurnStreamEventKind.TextMessageContent &&
                    !string.IsNullOrEmpty(streamEvent.TextDelta))
                {
                    _streamingAgentName ??= streamEvent.AgentName;
                    _streamingResponseText += streamEvent.TextDelta;
                    _scrollRequested = true;
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                if (streamEvent.Kind == AgentTurnStreamEventKind.ClarificationRequired &&
                    !string.IsNullOrWhiteSpace(streamEvent.ClarificationQuestion))
                {
                    clarificationQuestion = streamEvent.ClarificationQuestion;
                    pendingApprovals.Clear();
                    continue;
                }

                if (streamEvent.Kind == AgentTurnStreamEventKind.ApprovalRequired &&
                    streamEvent.PendingApprovals is { Count: > 0 })
                {
                    clarificationQuestion = null;
                    pendingApprovals.Clear();
                    pendingApprovals.AddRange(streamEvent.PendingApprovals);
                    continue;
                }

                if (streamEvent.Kind == AgentTurnStreamEventKind.RunFinished &&
                    streamEvent.Response is not null)
                {
                    finalResponse = streamEvent.Response;
                    continue;
                }

                if (streamEvent.Kind == AgentTurnStreamEventKind.RunError)
                {
                    throw new InvalidOperationException(streamEvent.ErrorMessage ?? "Streaming run failed.");
                }
            }
        }
        catch (OperationCanceledException) when (_stopRequested)
        {
            if (!string.IsNullOrWhiteSpace(_activeRunId))
            {
                ActiveRunStore.Clear(conversationSessionId, _activeRunId);
            }

            return BuildCanceledTurnOutcome(request, fallbackAgentName);
        }
        finally
        {
            _stopRequested = false;
        }

        _streamingResponseText = string.Empty;
        _streamingReasoningText = string.Empty;
        _streamingAgentName = null;

        if (finalResponse is null)
        {
            if (!trackActiveRun &&
                !string.IsNullOrWhiteSpace(_activeRunId))
            {
                ActiveRunStore.Clear(conversationSessionId, _activeRunId);
            }

            return BuildReconnectUnavailableOutcome(fallbackAgentName);
        }

        if (!string.IsNullOrWhiteSpace(_activeRunId))
        {
            ActiveRunStore.Clear(conversationSessionId, _activeRunId);
        }

        var response = finalResponse;
        return new StreamTurnOutcome(
            response,
            clarificationQuestion ?? (response.RequiresClarification ? response.ClarificationQuestion : null),
            pendingApprovals.Count > 0
                ? pendingApprovals
                : (response.RequiresApproval ? response.PendingApprovals : []),
            _activeRunId);
    }

    private StreamTurnOutcome BuildCanceledTurnOutcome(AgentTurnRequest? request, string? fallbackAgentName)
    {
        var agentName = _streamingAgentName
            ?? fallbackAgentName
            ?? _selectedAgent
            ?? request?.AgentName
            ?? "Assistant";
        _streamingResponseText = string.Empty;
        _streamingReasoningText = string.Empty;
        _streamingAgentName = null;
        var response = new AgentTurnResponse(
            agentName,
            "Run canceled.",
            [],
            []);
        return new StreamTurnOutcome(response, null, [], _activeRunId);
    }

    private StreamTurnOutcome BuildReconnectUnavailableOutcome(string? fallbackAgentName)
    {
        _streamingResponseText = string.Empty;
        _streamingReasoningText = string.Empty;
        _streamingAgentName = null;
        var response = new AgentTurnResponse(
            fallbackAgentName ?? _selectedAgent ?? DefaultAgentName ?? "Assistant",
            "The active run could not be resumed.",
            [],
            []);
        return new StreamTurnOutcome(response, null, [], _activeRunId);
    }

    private static StreamTurnOutcome EnrichApprovalOutcome(StreamTurnOutcome turnOutcome)
    {
        if (!string.Equals(turnOutcome.Response.ResponseText, "Approved.", StringComparison.Ordinal))
        {
            return turnOutcome;
        }

        var enrichedMessage = turnOutcome.Response.ExecutionPlan?.Steps
            .Where(static step => step.Status is AgentExecutionStepStatus.Completed)
            .Select(static step => step.Message)
            .FirstOrDefault(static message => !string.IsNullOrWhiteSpace(message))
            ?? turnOutcome.Response.LegacyExecutionResults
                .Where(static result => result.Succeeded)
                .Select(static result => result.Message)
                .FirstOrDefault(static message => !string.IsNullOrWhiteSpace(message));

        if (string.IsNullOrWhiteSpace(enrichedMessage))
        {
            return turnOutcome;
        }

        return turnOutcome with
        {
            Response = turnOutcome.Response with
            {
                ResponseText = enrichedMessage
            }
        };
    }

    private async Task ApplyTurnOutcomeAsync(
        string sourceMessage,
        StreamTurnOutcome turnOutcome,
        int conversationTurnCountBefore)
    {
        var response = turnOutcome.Response;
        var runId = string.IsNullOrWhiteSpace(turnOutcome.RunId) ? null : turnOutcome.RunId;
        var activityMessages = _streamingActivityMessages.ToArray();
        _streamingActivityMessages.Clear();

        _timeline.Add(ChatTimelineItem.Agent(response, runId, activityMessages));
        if (!string.IsNullOrWhiteSpace(runId))
        {
            _assistantTimelineIndexByRunId[runId] = _timeline.Count - 1;
        }
        await PersistDisplayedTurnAsync(sourceMessage, response, conversationTurnCountBefore);
        SessionEvents.NotifySessionUpdated(EffectiveConversationSessionId, _instanceId);
        ApplyInteractionState(
            sourceMessage,
            turnOutcome.ClarificationQuestion,
            turnOutcome.PendingApprovals,
            turnOutcome.Response.ExecutionPlan);
    }

    private async Task<int> GetConversationTurnCountAsync()
    {
        var history = await ConversationStore.GetHistoryAsync(EffectiveConversationSessionId);
        return history?.Turns.Count ?? 0;
    }

    private async Task PersistDisplayedTurnAsync(
        string sourceMessage,
        AgentTurnResponse response,
        int conversationTurnCountBefore)
    {
        if (string.IsNullOrWhiteSpace(sourceMessage))
        {
            return;
        }

        var sessionId = EffectiveConversationSessionId;
        var persistedTurn = CreateConversationTurn(sourceMessage, response);
        var history = await ConversationStore.GetHistoryAsync(sessionId);
        if (history is null || history.Turns.Count == 0)
        {
            await ConversationStore.AppendTurnAsync(sessionId, persistedTurn);
            return;
        }

        var lastTurn = history.Turns[^1];
        var runtimePersistedCurrentTurn =
            history.Turns.Count > conversationTurnCountBefore &&
            string.Equals(lastTurn.UserMessage, sourceMessage, StringComparison.Ordinal);

        if (runtimePersistedCurrentTurn)
        {
            if (AreEquivalentTurns(lastTurn, persistedTurn))
            {
                return;
            }

            await RewriteConversationHistoryAsync(
                sessionId,
                history,
                [.. history.Turns.Take(history.Turns.Count - 1), persistedTurn]);
            return;
        }

        await ConversationStore.AppendTurnAsync(sessionId, persistedTurn);
    }

    private async Task RewriteConversationHistoryAsync(
        string sessionId,
        ConversationHistory history,
        IReadOnlyList<ConversationTurn> turns)
    {
        await ConversationStore.ClearSessionAsync(sessionId);
        foreach (var turn in turns)
        {
            await ConversationStore.AppendTurnAsync(sessionId, turn);
        }

        if (!string.IsNullOrWhiteSpace(history.UserId))
        {
            await ConversationStore.SetUserIdAsync(sessionId, history.UserId);
        }
    }

    private static ConversationTurn CreateConversationTurn(string sourceMessage, AgentTurnResponse response)
        => new()
        {
            Timestamp = DateTime.UtcNow,
            UserMessage = sourceMessage,
            AgentResponse = response.ResponseText,
            PlannedActions = response.LegacyPlannedActions,
            ExecutionResults = response.LegacyExecutionResults,
            ExecutionPlan = response.ExecutionPlan,
            GeneratedUi = response.GeneratedUi
        };

    private static bool AreEquivalentTurns(ConversationTurn left, ConversationTurn right)
    {
        return string.Equals(left.UserMessage, right.UserMessage, StringComparison.Ordinal) &&
               string.Equals(left.AgentResponse, right.AgentResponse, StringComparison.Ordinal) &&
               left.HasNormalizedExecutionPlan == right.HasNormalizedExecutionPlan &&
               left.LegacyPlannedActions.Count == right.LegacyPlannedActions.Count &&
               left.LegacyExecutionResults.Count == right.LegacyExecutionResults.Count &&
               GetExecutionPlanSignature(left.ExecutionPlan) == GetExecutionPlanSignature(right.ExecutionPlan);
    }

    private static string GetExecutionPlanSignature(AgentExecutionPlan? executionPlan)
    {
        if (executionPlan?.Steps.Count is not > 0)
        {
            return string.Empty;
        }

        return string.Join(
            "|",
            executionPlan.Steps.Select(static step =>
                $"{step.TargetId}:{step.ActionId}:{step.Status}:{step.Message}"));
    }

    private void SetPendingApprovals(
        IReadOnlyList<PendingApproval> approvals,
        AgentExecutionPlan? executionPlan = null)
    {
        _pendingApprovals.Clear();
        _pendingApprovals.AddRange(approvals.Select(approval =>
        {
            var step = ExecutionPlanNarrativeFormatter.FindStep(
                executionPlan,
                approval.ComponentId,
                approval.ActionId);

            return new PendingApprovalInfo(
                approval.ComponentId,
                approval.ActionId,
                approval.Description,
                approval.Parameters,
                approval.PolicyDecision,
                approval.PolicyDecision is null
                    ? null
                    : BuildApprovalPolicySummary(approval.PolicyDecision),
                ExecutionPlanNarrativeFormatter.TryGetApprovalStepLabel(
                    executionPlan,
                    approval.ComponentId,
                    approval.ActionId,
                    out var stepLabel)
                    ? stepLabel
                    : null,
                step is null
                    ? []
                    : ExecutionStepNarrativeFormatter.BuildResultTexts(step));
        }));
    }

    private void ApplyInteractionState(
        string sourceMessage,
        string? clarificationQuestion,
        IReadOnlyList<PendingApproval> approvals,
        AgentExecutionPlan? executionPlan = null)
    {
        if (!string.IsNullOrWhiteSpace(clarificationQuestion))
        {
            _pendingApprovals.Clear();
            _pendingClarification = new PendingClarificationInfo(clarificationQuestion, sourceMessage);
            _agentState = AgentState.WaitingForClarification;
            return;
        }

        if (approvals.Count > 0)
        {
            _pendingClarification = null;
            SetPendingApprovals(approvals, executionPlan);
            _agentState = AgentState.WaitingForApproval;
            return;
        }

        _pendingClarification = null;
        _pendingApprovals.Clear();
        _agentState = AgentState.Idle;
    }

    private void HandleDeferredActionCompleted(DeferredComponentActionEvent actionEvent)
    {
        if (!IsDeferredEventForCurrentChat(actionEvent))
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            var message = FormatDeferredActionMessage(actionEvent);
            var componentId = actionEvent.ComponentType;
            var key = BuildActivityKey(componentId, actionEvent.ActionId);
            var status = actionEvent.Succeeded ? ActionStatus.Complete : ActionStatus.Failed;
            var activity = new ActivityMessage(
                key,
                message,
                actionEvent.Succeeded,
                componentId,
                actionEvent.ActionId,
                status,
                Args: null,
                Result: actionEvent.Message);
            if (!TryAttachActivityToAssociatedTurn(activity, actionEvent.RunId))
            {
                _timeline.Add(ChatTimelineItem.Activity(message, actionEvent.RunId));
            }

            _scrollRequested = true;
            StateHasChanged();
        });
    }

    private bool IsDeferredEventForCurrentChat(DeferredComponentActionEvent actionEvent)
    {
        if (!string.IsNullOrWhiteSpace(actionEvent.SessionId))
        {
            return string.Equals(actionEvent.SessionId, EffectiveSessionId, StringComparison.OrdinalIgnoreCase);
        }

        if (!string.IsNullOrWhiteSpace(actionEvent.RunId) &&
            !string.IsNullOrWhiteSpace(_activeRunId))
        {
            return string.Equals(actionEvent.RunId, _activeRunId, StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }

    private void AddStreamingActivityMessage(ActivityMessage activity)
    {
        if (string.IsNullOrWhiteSpace(activity.Key) || string.IsNullOrWhiteSpace(activity.Text))
        {
            return;
        }

        UpsertActivityMessage(_streamingActivityMessages, activity);
    }

    private bool TryAttachActivityToAssociatedTurn(ActivityMessage activity, string? runId)
    {
        if (string.IsNullOrWhiteSpace(activity.Key) || string.IsNullOrWhiteSpace(activity.Text))
        {
            return true;
        }

        if (!string.IsNullOrWhiteSpace(runId))
        {
            if (_isBusy &&
                !string.IsNullOrWhiteSpace(_activeRunId) &&
                string.Equals(runId, _activeRunId, StringComparison.OrdinalIgnoreCase))
            {
                AddStreamingActivityMessage(activity);
                return true;
            }

            if (_assistantTimelineIndexByRunId.TryGetValue(runId, out var assistantIndex))
            {
                return TryAppendActivityToAssistantItem(assistantIndex, activity);
            }
        }

        if (_isBusy)
        {
            AddStreamingActivityMessage(activity);
            return true;
        }

        for (var index = _timeline.Count - 1; index >= 0; index--)
        {
            if (_timeline[index].Role != "assistant")
            {
                continue;
            }

            return TryAppendActivityToAssistantItem(index, activity);
        }

        return false;
    }

    private bool TryAppendActivityToAssistantItem(int index, ActivityMessage activity)
    {
        if (index < 0 || index >= _timeline.Count)
        {
            return false;
        }

        var item = _timeline[index];
        if (!string.Equals(item.Role, "assistant", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var updatedActivities = UpsertActivityMessage(item.ActivityMessages, activity);
        _timeline[index] = item with { ActivityMessages = updatedActivities };
        return true;
    }

    private static string BuildActivityKey(string componentId, string actionId)
    {
        var normalizedComponent = (componentId ?? string.Empty).Trim();
        var normalizedAction = (actionId ?? string.Empty).Trim();
        return $"{normalizedComponent}.{normalizedAction}".ToLowerInvariant();
    }

    private static void UpsertActivityMessage(List<ActivityMessage> target, ActivityMessage activity)
    {
        var index = target.FindIndex(existing =>
            string.Equals(existing.Key, activity.Key, StringComparison.OrdinalIgnoreCase));
        if (index >= 0)
        {
            target[index] = activity;
            return;
        }

        target.Add(activity);
    }

    private static IReadOnlyList<ActivityMessage> UpsertActivityMessage(
        IReadOnlyList<ActivityMessage> source,
        ActivityMessage activity)
    {
        var copy = source.ToList();
        UpsertActivityMessage(copy, activity);
        return copy;
    }

    private bool TryBuildRenderedActivity(ActivityMessage activity, out RenderFragment? rendered)
    {
        rendered = null;
        if (string.IsNullOrWhiteSpace(activity.ComponentId) || string.IsNullOrWhiteSpace(activity.ActionId))
        {
            return false;
        }

        var fragments = ActionRenderRegistry.TryGet(activity.ComponentId, activity.ActionId);
        var fragment = fragments?.Resolve(activity.Status);
        if (fragment is null)
        {
            return false;
        }

        var context = new ActionRenderContext(
            activity.ComponentId,
            activity.ActionId,
            activity.Status,
            activity.Args ?? EmptyActionArgs,
            activity.Result ?? activity.Text);
        rendered = fragment(context);
        return true;
    }

    private ActionRenderContext BuildResultRenderContext(
        ChatTimelineItem item,
        ComponentActionExecutionResult result)
    {
        var status = result.Succeeded ? ActionStatus.Complete : ActionStatus.Failed;
        var args = FindActionArguments(item.LegacyPlannedActions, result.ComponentId, result.ActionId);
        return new ActionRenderContext(
            result.ComponentId,
            result.ActionId,
            status,
            args,
            result.Message);
    }

    private IReadOnlyDictionary<string, object?>? GetActivityArgsByKey(string key)
    {
        for (var i = _streamingActivityMessages.Count - 1; i >= 0; i--)
        {
            var activity = _streamingActivityMessages[i];
            if (!string.Equals(activity.Key, key, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return activity.Args;
        }

        return null;
    }

    private static IReadOnlyDictionary<string, object?> FindActionArguments(
        IReadOnlyList<PlannedComponentAction> plannedActions,
        string componentId,
        string actionId)
    {
        for (var i = plannedActions.Count - 1; i >= 0; i--)
        {
            var action = plannedActions[i];
            if (!string.Equals(action.ComponentId, componentId, StringComparison.OrdinalIgnoreCase) ||
                !string.Equals(action.ActionId, actionId, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            return action.Arguments ?? EmptyActionArgs;
        }

        return EmptyActionArgs;
    }

    private static string FormatDeferredActionMessage(DeferredComponentActionEvent actionEvent)
    {
        var componentId = actionEvent.ComponentType.StartsWith("Agent", StringComparison.OrdinalIgnoreCase)
            ? actionEvent.ComponentType
            : $"Agent{actionEvent.ComponentType}";
        var status = actionEvent.Succeeded ? "applied" : "failed";
        return $"Deferred action {status}: {componentId}.{actionEvent.ActionId}. {actionEvent.Message}";
    }

    private static string FormatToolCallStartMessage(PlannedComponentAction plannedAction)
    {
        return $"Executing {plannedAction.ComponentId}.{plannedAction.ActionId}...";
    }

    private static string FormatToolCallResultMessage(ComponentActionExecutionResult executionResult)
    {
        if (!string.IsNullOrWhiteSpace(executionResult.Message))
        {
            return executionResult.Message;
        }

        return executionResult.Succeeded
            ? $"Completed {executionResult.ComponentId}.{executionResult.ActionId}."
            : $"Failed {executionResult.ComponentId}.{executionResult.ActionId}.";
    }

    private static string FormatExecutionStepActivity(AgentExecutionStep step)
    {
        var label = step.RequiresApproval
            ? "Approval"
            : step.Kind switch
            {
                AgentExecutionStepKind.SemanticCapability => "Capability",
                AgentExecutionStepKind.ServiceTool => "Tool",
                AgentExecutionStepKind.GeneratedUiTool => "UI Block",
                _ => "UI"
            };

        return $"{label} {step.TargetId}.{step.ActionId}";
    }

    private static ActionStatus MapStepStatus(AgentExecutionStepStatus status) =>
        status switch
        {
            AgentExecutionStepStatus.Completed => ActionStatus.Complete,
            AgentExecutionStepStatus.Failed => ActionStatus.Failed,
            AgentExecutionStepStatus.Blocked => ActionStatus.Failed,
            AgentExecutionStepStatus.NeedsClarification => ActionStatus.Failed,
            AgentExecutionStepStatus.ApprovalRequired => ActionStatus.InProgress,
            _ => ActionStatus.InProgress
        };

    private IDictionary<string, string>? CreateRequestContext(IReadOnlyDictionary<string, string>? additional = null)
    {
        Dictionary<string, string>? context = new(StringComparer.OrdinalIgnoreCase);

        if (EnableGeneratedUi)
        {
            context[AgentGenerativeUiSpec.GenerateUiContextKey] = bool.TrueString;
        }

        var currentRoute = GetCurrentRoute();
        if (!string.IsNullOrWhiteSpace(currentRoute))
        {
            context[AgentRuntimeContextKeys.CurrentRoute] = currentRoute;
        }

        if (IsAgentSelectionLocked && !string.IsNullOrWhiteSpace(_selectedAgent))
        {
            context[AgentRuntimeContextKeys.AgentName] = _selectedAgent;
            context[AgentRuntimeContextKeys.AgentLock] = bool.TrueString;
        }

        if (!string.IsNullOrWhiteSpace(_pendingHandoffFromAgent) &&
            !string.IsNullOrWhiteSpace(_pendingHandoffToAgent))
        {
            context[AgentRuntimeContextKeys.AgentHandoffFrom] = _pendingHandoffFromAgent;
            context[AgentRuntimeContextKeys.AgentHandoffTo] = _pendingHandoffToAgent;
            if (_pendingHandoffAtUtc.HasValue)
            {
                context[AgentRuntimeContextKeys.AgentHandoffAt] = _pendingHandoffAtUtc.Value.ToString("O");
            }
        }

        if (additional is not null)
        {
            foreach (var pair in additional)
            {
                context[pair.Key] = pair.Value;
            }
        }

        return context.Count > 0 ? context : null;
    }

    private void ApplyAgentSelectionPolicy()
    {
        if (_agentNames.Count == 0)
        {
            _selectedAgent = null;
            return;
        }

        if (!string.IsNullOrWhiteSpace(LockedAgentName))
        {
            _selectedAgent = _agentNames.FirstOrDefault(name =>
                string.Equals(name, LockedAgentName, StringComparison.OrdinalIgnoreCase))
                ?? _agentNames.FirstOrDefault();
            return;
        }

        if (LockAgentToCurrentRoute)
        {
            var resolved = ResolveRouteLockedAgentName();
            if (!string.IsNullOrWhiteSpace(resolved))
            {
                _selectedAgent = resolved;
                return;
            }
        }

        if (string.IsNullOrWhiteSpace(_selectedAgent) &&
            !string.IsNullOrWhiteSpace(DefaultAgentName))
        {
            _selectedAgent = _agentNames.FirstOrDefault(name =>
                string.Equals(name, DefaultAgentName, StringComparison.OrdinalIgnoreCase));
        }

        if (string.IsNullOrWhiteSpace(_selectedAgent) ||
            !_agentNames.Contains(_selectedAgent, StringComparer.OrdinalIgnoreCase))
        {
            _selectedAgent = _agentNames.FirstOrDefault();
        }
    }

    private string? ResolveRouteLockedAgentName()
    {
        var currentRoute = GetCurrentRoute();
        if (string.IsNullOrWhiteSpace(currentRoute))
        {
            return null;
        }

        AgentRegistration? bestMatch = null;
        var bestScore = -1;

        foreach (var registration in AgentRegistry.GetAll())
        {
            foreach (var routePattern in EnumerateRoutePatterns(registration))
            {
                var normalizedPattern = NormalizeRoute(routePattern);
                if (string.IsNullOrWhiteSpace(normalizedPattern))
                {
                    continue;
                }

                if (!currentRoute.StartsWith(normalizedPattern, StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                var score = normalizedPattern.Length;
                if (score <= bestScore)
                {
                    continue;
                }

                bestScore = score;
                bestMatch = registration;
            }
        }

        return bestMatch?.Name;
    }

    private string? GetCurrentRoute()
    {
        var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var routePart = uri;
        var queryOrFragmentIndex = routePart.IndexOfAny(['?', '#']);
        if (queryOrFragmentIndex >= 0)
        {
            routePart = routePart[..queryOrFragmentIndex];
        }

        var route = string.IsNullOrWhiteSpace(routePart) ? "/" : "/" + routePart;
        return NormalizeRoute(route);
    }

    private static string? NormalizeRoute(string? route)
    {
        if (string.IsNullOrWhiteSpace(route))
        {
            return null;
        }

        var normalized = route.Trim();
        if (Uri.TryCreate(normalized, UriKind.Absolute, out var absolute))
        {
            normalized = absolute.AbsolutePath;
        }

        if (!normalized.StartsWith('/'))
        {
            normalized = "/" + normalized;
        }

        normalized = normalized.TrimEnd('/');
        return normalized.Length == 0
            ? "/"
            : normalized.ToLowerInvariant();
    }

    private static IEnumerable<string> EnumerateRoutePatterns(AgentRegistration registration)
    {
        foreach (var key in AgentRouteMetadataKeys)
        {
            if (!registration.Metadata.TryGetValue(key, out var rawValue) ||
                string.IsNullOrWhiteSpace(rawValue))
            {
                continue;
            }

            foreach (var token in rawValue.Split([',', ';', '|'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
            {
                if (!string.IsNullOrWhiteSpace(token))
                {
                    yield return token;
                }
            }
        }
    }

    private Task HandleGeneratedActionInvokedAsync(AgentUiActionInvocation invocation)
    {
        _timeline.Add(ChatTimelineItem.Activity(
            $"Generated UI action invoked: {invocation.BlockId}.{invocation.Action.Id}."));
        _scrollRequested = true;
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleGeneratedRuntimeResponseAsync(AgentTurnResponse response)
    {
        _timeline.Add(ChatTimelineItem.Agent(response));
        SessionEvents.NotifySessionUpdated(EffectiveConversationSessionId, _instanceId);
        ApplyInteractionState(
            response.ResponseText,
            response.RequiresClarification ? response.ClarificationQuestion : null,
            response.RequiresApproval ? response.PendingApprovals : []);

        _scrollRequested = true;
        return InvokeAsync(StateHasChanged);
    }

    private void HandleSessionUpdated(AgentChatSessionUpdate update)
    {
        if (_isBusy ||
            !string.Equals(update.SessionId, EffectiveConversationSessionId, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(update.SourceId, _instanceId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await HydrateTimelineFromHistoryAsync(force: true);
            await TryResumeActiveRunAsync();
            StateHasChanged();
        });
    }

    private Task HandleGeneratedUiErrorAsync(Exception exception)
    {
        _timeline.Add(ChatTimelineItem.Activity($"Generated UI action failed: {exception.Message}"));
        _scrollRequested = true;
        return InvokeAsync(StateHasChanged);
    }

    private async Task HydrateTimelineFromHistoryAsync(bool force = false)
    {
        var sessionId = EffectiveConversationSessionId;
        if (!force &&
            string.Equals(_historyHydratedForSession, sessionId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _historyHydratedForSession = sessionId;
        var history = await ConversationStore.GetHistoryAsync(sessionId);

        _timeline.Clear();
        _assistantTimelineIndexByRunId.Clear();
        _streamingActivityMessages.Clear();
        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _activeRunId = null;
        _pendingClarification = null;
        _pendingApprovals.Clear();
        _pendingHandoffRequest = null;
        _clarificationResponse = string.Empty;
        _agentState = AgentState.Idle;
        _lastReconnectAttemptRunId = null;

        if (history is null || history.Turns.Count == 0)
        {
            return;
        }

        var roleLabel = _selectedAgent ?? DefaultAgentName ?? "Agent";
        foreach (var turn in history.Turns.OrderBy(static turn => turn.Timestamp))
        {
            if (!string.IsNullOrWhiteSpace(turn.UserMessage))
            {
                _timeline.Add(ChatTimelineItem.User(turn.UserMessage));
            }

            if (!string.IsNullOrWhiteSpace(turn.AgentResponse))
            {
                _timeline.Add(new ChatTimelineItem(
                    "assistant",
                    roleLabel,
                    turn.AgentResponse,
                    BuildActivityMessages(turn),
                    turn.LegacyPlannedActions,
                    turn.LegacyExecutionResults,
                    turn.ExecutionPlan,
                    GeneratedUi: turn.GeneratedUi,
                    RunId: null));
            }
        }
    }

    private async Task TryResumeActiveRunAsync()
    {
        if (_isBusy || !RuntimeAdapter.SupportsReconnect)
        {
            return;
        }

        if (!ActiveRunStore.TryGet(EffectiveConversationSessionId, out var activeRun))
        {
            return;
        }

        if (string.Equals(_lastReconnectAttemptRunId, activeRun.RunId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _lastReconnectAttemptRunId = activeRun.RunId;

        if (!string.IsNullOrWhiteSpace(activeRun.UserMessage) &&
            (_timeline.Count == 0 ||
             !string.Equals(_timeline.Last().Role, "user", StringComparison.OrdinalIgnoreCase) ||
             !string.Equals(_timeline.Last().Text, activeRun.UserMessage, StringComparison.Ordinal)))
        {
            _timeline.Add(ChatTimelineItem.User(activeRun.UserMessage));
        }

        _streamingResponseText = string.Empty;
        _streamingReasoningText = string.Empty;
        _reasoningComplete = false;
        _streamingAgentName = activeRun.AgentName ?? _selectedAgent ?? DefaultAgentName;
        _activeRunId = activeRun.RunId;
        _stopRequested = false;
        _streamingActivityMessages.Clear();
        _completedActivityKeys.Clear();
        _pendingClarification = null;
        _pendingApprovals.Clear();
        _clarificationResponse = string.Empty;
        _isBusy = true;
        _agentState = AgentState.Thinking;
        _scrollRequested = true;
        StartTimeoutTimer();
        StateHasChanged();

        try
        {
            var conversationTurnCountBefore = await GetConversationTurnCountAsync();
            var turnOutcome = await ConsumeStreamingRunAsync(
                RuntimeAdapter.ConnectRunStreamAsync(activeRun.RunId),
                request: null,
                fallbackAgentName: activeRun.AgentName ?? _selectedAgent ?? DefaultAgentName,
                conversationSessionId: EffectiveConversationSessionId,
                initialUserMessage: activeRun.UserMessage,
                trackActiveRun: false);
            await ApplyTurnOutcomeAsync(activeRun.UserMessage ?? "Resumed run.", turnOutcome, conversationTurnCountBefore);
            _scrollRequested = true;
        }
        finally
        {
            StopTimeoutTimer();
            _isBusy = false;
            if (_agentState == AgentState.Thinking)
            {
                _agentState = AgentState.Idle;
            }
        }
    }

    private static IReadOnlyList<ActivityMessage> BuildActivityMessages(
        ConversationTurn turn)
    {
        if (turn.ExecutionPlan?.Steps.Count > 0)
        {
            return turn.ExecutionPlan.Steps
                .Select(step => new ActivityMessage(
                    BuildActivityKey(step.TargetId, step.ActionId),
                    string.IsNullOrWhiteSpace(step.Message)
                        ? FormatExecutionStepActivity(step)
                        : $"{FormatExecutionStepActivity(step)}: {step.Message}",
                    step.Status is not AgentExecutionStepStatus.Failed and not AgentExecutionStepStatus.Blocked,
                    step.TargetId,
                    step.ActionId,
                    MapStepStatus(step.Status),
                    step.Arguments,
                    Result: step.Message))
                .ToArray();
        }

        return BuildActivityMessages(turn.LegacyExecutionResults);
    }

    private static IReadOnlyList<ActivityMessage> BuildActivityMessages(
        IReadOnlyList<ComponentActionExecutionResult> executionResults)
    {
        if (executionResults.Count == 0)
        {
            return [];
        }

        var messages = new List<ActivityMessage>(executionResults.Count);
        foreach (var result in executionResults)
        {
            var key = BuildActivityKey(result.ComponentId, result.ActionId);
            var text = FormatToolCallResultMessage(result);
            var status = result.Succeeded ? ActionStatus.Complete : ActionStatus.Failed;
            messages.Add(new ActivityMessage(
                key,
                text,
                result.Succeeded,
                result.ComponentId,
                result.ActionId,
                status,
                Args: null,
                Result: result.Message));
        }

        return messages;
    }

