@namespace AgentBlazor.Components
@using AgentBlazor.Agents
@using AgentBlazor.Components.Chat
@implements IDisposable
@using AgentBlazor.Core.Runtime.Agents
@using AgentBlazor.Core.Runtime.Components
@using AgentBlazor.Core.Runtime.Interfaces
@using AgentBlazor.Runtime
@using Microsoft.JSInterop
@inject IAgentRegistry AgentRegistry
@inject IAgentRuntime AgentRuntime
@inject IAgentDeferredActionEvents DeferredActionEvents
@inject IJSRuntime JSRuntime

<section class="ab-chat-surface @(Theme?.CssClass) @(Theme?.GetFeatureClasses()) @CssClass"
         data-theme="@(Theme?.DataTheme)"
         data-style="@(Theme?.DataStyle)"
         data-radius="@(Theme?.DataRadius)"
         data-spacing="@(Theme?.DataSpacing)"
         style="@_themeStyle"
         aria-label="@(Title ?? "Chat")">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <header class="ab-chat-surface__header" id="@HeaderId">@Title</header>
    }

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="ab-chat-surface__body" id="@DescriptionId">@Description</p>
    }

    @if (_agentState != AgentState.Idle)
    {
        <div class="ab-chat-surface__state ab-chat-surface__state--@_agentState.ToString().ToLower()">
            @if (_agentState == AgentState.Thinking)
            {
                <span class="ab-chat-surface__state-dot"></span>
                <span>Thinking...</span>
            }
            else if (_agentState == AgentState.WaitingForApproval)
            {
                <span class="ab-chat-surface__state-icon">&#9888;</span>
                <span>Waiting for approval</span>
            }
            else if (_agentState == AgentState.WaitingForClarification)
            {
                <span class="ab-chat-surface__state-icon">&#10067;</span>
                <span>Clarification needed</span>
            }
        </div>
    }

    @if (_timeline.Count > 0 || !string.IsNullOrWhiteSpace(_streamingResponseText))
    {
        <div id="@TimelineId"
             class="ab-chat-surface__timeline"
             role="log"
             aria-live="polite"
             aria-label="Conversation">
            @foreach (var item in _timeline)
            {
                <article class="ab-chat-surface__item ab-chat-surface__item--@item.Role"
                         aria-label="@item.RoleLabel">
                    <div class="ab-chat-surface__item-role">@item.RoleLabel</div>
                    <div class="ab-chat-surface__item-text">@item.Text</div>

                    @if (item.ActivityMessages.Count > 0)
                    {
                        <ul class="ab-chat-surface__results" aria-label="Activity">
                            @foreach (var activity in item.ActivityMessages)
                            {
                                <li>@activity.Text</li>
                            }
                        </ul>
                    }

                    @if (item.PlannedActions.Count > 0)
                    {
                        <ul class="ab-chat-surface__actions" aria-label="Planned actions">
                            @foreach (var action in item.PlannedActions)
                            {
                                <li>@action.ComponentId.@action.ActionId</li>
                            }
                        </ul>
                    }

                    @if (item.ExecutionResults.Count > 0)
                    {
                        <ul class="ab-chat-surface__results" aria-label="Results">
                            @foreach (var result in item.ExecutionResults)
                            {
                                <li>@result.Message</li>
                            }
                        </ul>
                    }

                    @if (item.GeneratedUi is not null)
                    {
                        <div class="ab-chat-surface__generated-ui">
                            <AgentGenerativeSurface Document="@item.GeneratedUi"
                                                    AgentName="@item.RoleLabel"
                                                    SessionId="@_instanceId"
                                                    ForwardActionsToRuntime="true"
                                                    ShowRuntimeResponses="false"
                                                    OnActionInvoked="HandleGeneratedActionInvokedAsync"
                                                    OnRuntimeResponseReceived="HandleGeneratedRuntimeResponseAsync"
                                                    OnError="HandleGeneratedUiErrorAsync" />
                        </div>
                    }
                </article>
            }

            @if (!string.IsNullOrWhiteSpace(_streamingResponseText))
            {
                <article class="ab-chat-surface__item ab-chat-surface__item--assistant"
                         aria-label="Assistant">
                    <div class="ab-chat-surface__item-role">@(_streamingAgentName ?? "Assistant")</div>
                    <div class="ab-chat-surface__item-text">@_streamingResponseText</div>
                    @if (_streamingActivityMessages.Count > 0)
                    {
                        <ul class="ab-chat-surface__results" aria-label="Activity">
                            @foreach (var activity in _streamingActivityMessages)
                            {
                                <li>@activity.Text</li>
                            }
                        </ul>
                    }
                </article>
            }
        </div>
    }

    @if (_pendingClarification is { } clar)
    {
        <article class="ab-chat-surface__item ab-chat-surface__item--clarification" aria-label="Clarification needed">
            <div class="ab-chat-surface__item-role">Clarification Needed</div>
            <div class="ab-chat-surface__item-text">@clar.Question</div>
            <div class="ab-chat-surface__clarification-input">
                <label class="ab-chat-surface__label" for="@ClarificationInputId">Your answer:</label>
                <input id="@ClarificationInputId"
                       type="text"
                       class="ab-chat-surface__input"
                       @bind="_clarificationResponse"
                       @bind:event="oninput"
                       placeholder="Type your answer..."
                       disabled="@_isBusy"
                       @onkeydown="HandleClarificationKeyDown" />
                <button type="button"
                        id="@ClarificationSubmitButtonId"
                        class="ab-chat-surface__submit"
                        disabled="@(_isBusy || string.IsNullOrWhiteSpace(_clarificationResponse))"
                        @onclick="SubmitClarificationAsync">
                    @(_isBusy ? "Sending…" : "Submit")
                </button>
            </div>
        </article>
    }

    @if (_pendingApprovals.Count > 0)
    {
        <article class="ab-chat-surface__item ab-chat-surface__item--approval" aria-label="Approval required">
            <div class="ab-chat-surface__item-role">Approval Required</div>
            <div class="ab-chat-surface__item-text">The following actions require your approval:</div>
            <ul class="ab-chat-surface__approval-list">
                @foreach (var approval in _pendingApprovals)
                {
                    <li>
                        <strong>@approval.ComponentId.@approval.ActionId</strong>
                        @if (approval.Parameters.Count > 0)
                        {
                            <span class="ab-chat-surface__approval-params">
                                (@string.Join(", ", approval.Parameters.Select(p => $"{p.Key}={p.Value}")))
                            </span>
                        }
                    </li>
                }
            </ul>
            <div class="ab-chat-surface__approval-buttons">
                <button type="button"
                        class="ab-chat-surface__submit ab-chat-surface__submit--approve"
                        disabled="@_isBusy"
                        @onclick="ApproveActionsAsync">
                    @(_isBusy ? "Approving…" : "Approve")
                </button>
                <button type="button"
                        class="ab-chat-surface__submit ab-chat-surface__submit--deny"
                        disabled="@_isBusy"
                        @onclick="DenyActionsAsync">
                    @(_isBusy ? "Denying…" : "Deny")
                </button>
            </div>
        </article>
    }

    <EditForm class="ab-chat-surface__controls" Model="@this" FormName="@EffectiveFormName" OnValidSubmit="SendAsync">
        <label class="ab-chat-surface__label" for="@AgentSelectId">Agent</label>
        <select id="@AgentSelectId"
                class="ab-chat-surface__select"
                @bind="_selectedAgent"
                aria-describedby="@DescriptionId"
                disabled="@_isBusy">
            @if (_agentNames.Count == 0)
            {
                <option value="">No agents registered</option>
            }
            @foreach (var agent in _agentNames)
            {
                <option value="@agent">@agent</option>
            }
        </select>

        <label class="ab-chat-surface__label" for="@PromptId">Message</label>
        <textarea id="@PromptId"
                  class="ab-chat-surface__input"
                  rows="3"
                  @bind="_prompt"
                  @bind:event="oninput"
                  placeholder="@Placeholder"
                  aria-describedby="@DescriptionId"
                  aria-label="Message input"
                  disabled="@_isBusy"></textarea>

        <button type="submit"
                id="@SubmitButtonId"
                class="ab-chat-surface__submit"
                disabled="@(_isBusy || !_canSubmit)"
                aria-busy="@_isBusy"
                aria-label="@(_isBusy ? "Sending..." : "Send message")">
            @(_isBusy ? "Sending…" : "Send")
        </button>
    </EditForm>
</section>

@code {
    private readonly List<string> _agentNames = [];
    private readonly List<ChatTimelineItem> _timeline = [];
    private string _prompt = string.Empty;
    private string? _selectedAgent;
    private bool _isBusy;
    private bool _scrollRequested;
    private bool _clarificationShortcutAttached;
    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private string _streamingResponseText = string.Empty;
    private string? _streamingAgentName;
    private string? _activeRunId;
    private readonly List<ActivityMessage> _streamingActivityMessages = [];
    private readonly Dictionary<string, int> _assistantTimelineIndexByRunId =
        new(StringComparer.OrdinalIgnoreCase);

    private PendingClarificationInfo? _pendingClarification;
    private string _clarificationResponse = string.Empty;
    private readonly List<PendingApprovalInfo> _pendingApprovals = [];
    private AgentState _agentState = AgentState.Idle;

    private enum AgentState { Idle, Thinking, WaitingForApproval, WaitingForClarification }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? FormName { get; set; }

    [Parameter]
    public string? DefaultAgentName { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Type a message… (Enter to send, Shift+Enter for new line)";

    [Parameter]
    public ChatTheme? Theme { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public bool EnableGeneratedUi { get; set; }

    private string EffectiveFormName =>
        string.IsNullOrWhiteSpace(FormName)
            ? $"agent-chat-surface-{_instanceId}"
            : FormName;

    private string AgentSelectId => $"ab-agent-select-{_instanceId}";
    private string PromptId => $"ab-agent-prompt-{_instanceId}";
    private string SubmitButtonId => $"ab-agent-submit-{_instanceId}";
    private string TimelineId => $"ab-chat-timeline-{_instanceId}";
    private string HeaderId => $"ab-chat-header-{_instanceId}";
    private string DescriptionId => $"ab-chat-description-{_instanceId}";
    private string ClarificationInputId => $"ab-clarification-input-{_instanceId}";
    private string ClarificationSubmitButtonId => $"ab-clarification-submit-{_instanceId}";

    private bool _canSubmit => !string.IsNullOrWhiteSpace(_prompt.Trim()) && _pendingClarification is null;

    private string? _themeStyle => Theme?.GetStyleString();

    protected override void OnInitialized()
    {
        DeferredActionEvents.DeferredActionCompleted += HandleDeferredActionCompleted;

        _agentNames.AddRange(
            AgentRegistry.GetAll()
                .Select(static agent => agent.Name)
                .OrderBy(static name => name, StringComparer.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(DefaultAgentName))
        {
            _selectedAgent = _agentNames.FirstOrDefault(name =>
                string.Equals(name, DefaultAgentName, StringComparison.OrdinalIgnoreCase));
        }

        _selectedAgent ??= _agentNames.FirstOrDefault();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("AgentBlazor.chat.attachEnterSubmit", PromptId, SubmitButtonId);
            }
            catch
            {
                // JS may be unavailable (e.g. prerender); ignore
            }
        }

        if (_scrollRequested)
        {
            _scrollRequested = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("AgentBlazor.chat.scrollToBottom", TimelineId);
            }
            catch
            {
                // JS may be unavailable (e.g. prerender); ignore
            }
        }

        if (_pendingClarification is not null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("AgentBlazor.chat.attachEnterSubmit", ClarificationInputId, ClarificationSubmitButtonId);
                _clarificationShortcutAttached = true;
            }
            catch { }
        }
        else if (_clarificationShortcutAttached)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("AgentBlazor.chat.detachEnterSubmit", ClarificationInputId);
            }
            catch
            {
                // Ignore when JS or component already torn down
            }

            _clarificationShortcutAttached = false;
        }
    }

    public void Dispose()
    {
        DeferredActionEvents.DeferredActionCompleted -= HandleDeferredActionCompleted;

        try
        {
            _ = JSRuntime.InvokeVoidAsync("AgentBlazor.chat.detachEnterSubmit", PromptId);
            _ = JSRuntime.InvokeVoidAsync("AgentBlazor.chat.detachEnterSubmit", ClarificationInputId);
        }
        catch
        {
            // Ignore when JS or component already torn down
        }
    }

    private async Task SendAsync()
    {
        if (_isBusy)
            return;

        var message = _prompt.Trim();
        if (message.Length == 0)
            return;

        if (_agentNames.Count == 0)
            return;

        _timeline.Add(ChatTimelineItem.User(message));
        _prompt = string.Empty;
        _pendingClarification = null;
        _pendingApprovals.Clear();
        _clarificationResponse = string.Empty;
        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _activeRunId = null;
        _streamingActivityMessages.Clear();
        _isBusy = true;
        _agentState = AgentState.Thinking;
        _scrollRequested = true;
        StateHasChanged();

        try
        {
            var turnOutcome = await RunTurnWithOptionalStreamingAsync(new AgentTurnRequest(
                message,
                _selectedAgent,
                SessionId: _instanceId,
                Context: CreateRequestContext()));
            ApplyTurnOutcome(message, turnOutcome);
            _scrollRequested = true;
        }
        finally
        {
            _isBusy = false;
            if (_agentState == AgentState.Thinking)
                _agentState = AgentState.Idle;
        }
    }

    private async Task SubmitClarificationAsync()
    {
        if (_isBusy || _pendingClarification is null || string.IsNullOrWhiteSpace(_clarificationResponse))
            return;

        var fullMessage = $"{_pendingClarification.OriginalMessage} {_clarificationResponse}".Trim();
        
        _timeline.Add(ChatTimelineItem.User(_clarificationResponse));
        _clarificationResponse = string.Empty;
        _pendingClarification = null;
        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _activeRunId = null;
        _streamingActivityMessages.Clear();
        _isBusy = true;
        _scrollRequested = true;
        StateHasChanged();

        try
        {
            var turnOutcome = await RunTurnWithOptionalStreamingAsync(new AgentTurnRequest(
                fullMessage,
                _selectedAgent,
                SessionId: _instanceId,
                Context: CreateRequestContext()));
            ApplyTurnOutcome(fullMessage, turnOutcome);
            _scrollRequested = true;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleClarificationKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_clarificationResponse))
        {
            await SubmitClarificationAsync();
        }
    }

    private async Task ApproveActionsAsync()
    {
        if (_isBusy || _pendingApprovals.Count == 0)
            return;

        var approvalKeys = _pendingApprovals
            .Select(static approval => $"{approval.ComponentId}.{approval.ActionId}")
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        var approvalContext = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["agentblazor.approvals"] = string.Join(",", approvalKeys)
        };
        
        _timeline.Add(ChatTimelineItem.User("Approved"));
        _pendingApprovals.Clear();
        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _activeRunId = null;
        _streamingActivityMessages.Clear();
        _isBusy = true;
        _agentState = AgentState.Thinking;
        _scrollRequested = true;
        StateHasChanged();

        try
        {
            var approvalMessage = "Approve the pending actions.";
            var turnOutcome = await RunTurnWithOptionalStreamingAsync(new AgentTurnRequest(
                approvalMessage,
                _selectedAgent,
                SessionId: _instanceId,
                Context: CreateRequestContext(approvalContext)));
            ApplyTurnOutcome(approvalMessage, turnOutcome);
            _scrollRequested = true;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DenyActionsAsync()
    {
        if (_isBusy || _pendingApprovals.Count == 0)
            return;

        _timeline.Add(ChatTimelineItem.User("Denied"));
        _pendingApprovals.Clear();
        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _activeRunId = null;
        _streamingActivityMessages.Clear();
        _agentState = AgentState.Idle;
        _scrollRequested = true;
        StateHasChanged();
    }

    private async Task<StreamTurnOutcome> RunTurnWithOptionalStreamingAsync(AgentTurnRequest request)
    {
        if (AgentRuntime is not IAgentRuntimeStreaming streamingRuntime)
        {
            var immediateResponse = await AgentRuntime.RunTurnAsync(request);
            return new StreamTurnOutcome(immediateResponse, ClarificationQuestion: null, PendingApprovals: [], RunId: null);
        }

        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _streamingActivityMessages.Clear();

        AgentTurnResponse? finalResponse = null;
        string? clarificationQuestion = null;
        var pendingApprovals = new List<PendingApproval>();
        await foreach (var streamEvent in streamingRuntime.RunTurnStreamingAsync(request))
        {
            if (string.IsNullOrWhiteSpace(_activeRunId) &&
                !string.IsNullOrWhiteSpace(streamEvent.RunId))
            {
                _activeRunId = streamEvent.RunId;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.ToolCallStart &&
                streamEvent.PlannedAction is not null)
            {
                AddStreamingActivityMessage(
                    BuildActivityKey(streamEvent.PlannedAction.ComponentId, streamEvent.PlannedAction.ActionId),
                    FormatToolCallStartMessage(streamEvent.PlannedAction));
                _scrollRequested = true;
                await InvokeAsync(StateHasChanged);
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.ToolCallResult &&
                streamEvent.ExecutionResult is not null)
            {
                AddStreamingActivityMessage(
                    BuildActivityKey(streamEvent.ExecutionResult.ComponentId, streamEvent.ExecutionResult.ActionId),
                    FormatToolCallResultMessage(streamEvent.ExecutionResult));
                _scrollRequested = true;
                await InvokeAsync(StateHasChanged);
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.TextMessageContent &&
                !string.IsNullOrEmpty(streamEvent.TextDelta))
            {
                _streamingAgentName ??= streamEvent.AgentName;
                _streamingResponseText += streamEvent.TextDelta;
                _scrollRequested = true;
                await InvokeAsync(StateHasChanged);
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.ClarificationRequired &&
                !string.IsNullOrWhiteSpace(streamEvent.ClarificationQuestion))
            {
                clarificationQuestion = streamEvent.ClarificationQuestion;
                pendingApprovals.Clear();
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.ApprovalRequired &&
                streamEvent.PendingApprovals is { Count: > 0 })
            {
                clarificationQuestion = null;
                pendingApprovals.Clear();
                pendingApprovals.AddRange(streamEvent.PendingApprovals);
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.RunFinished &&
                streamEvent.Response is not null)
            {
                finalResponse = streamEvent.Response;
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.RunError)
            {
                throw new InvalidOperationException(streamEvent.ErrorMessage ?? "Streaming run failed.");
            }
        }

        _streamingResponseText = string.Empty;
        _streamingAgentName = null;

        var response = finalResponse
            ?? throw new InvalidOperationException("Streaming completed without a final response.");
        return new StreamTurnOutcome(
            response,
            clarificationQuestion,
            pendingApprovals,
            _activeRunId);
    }

    private void ApplyTurnOutcome(string sourceMessage, StreamTurnOutcome turnOutcome)
    {
        var response = turnOutcome.Response;
        var runId = string.IsNullOrWhiteSpace(turnOutcome.RunId) ? null : turnOutcome.RunId;
        var activityMessages = _streamingActivityMessages.ToArray();
        _streamingActivityMessages.Clear();

        _timeline.Add(ChatTimelineItem.Agent(response, runId, activityMessages));
        if (!string.IsNullOrWhiteSpace(runId))
        {
            _assistantTimelineIndexByRunId[runId] = _timeline.Count - 1;
        }

        if (!string.IsNullOrWhiteSpace(turnOutcome.ClarificationQuestion))
        {
            _pendingApprovals.Clear();
            _pendingClarification = new PendingClarificationInfo(turnOutcome.ClarificationQuestion, sourceMessage);
            _agentState = AgentState.WaitingForClarification;
            return;
        }

        if (turnOutcome.PendingApprovals.Count > 0)
        {
            _pendingClarification = null;
            SetPendingApprovals(turnOutcome.PendingApprovals);
            _agentState = AgentState.WaitingForApproval;
            return;
        }

        if (response.RequiresClarification && !string.IsNullOrWhiteSpace(response.ClarificationQuestion))
        {
            _pendingApprovals.Clear();
            _pendingClarification = new PendingClarificationInfo(
                response.ClarificationQuestion,
                sourceMessage);
            _agentState = AgentState.WaitingForClarification;
            return;
        }

        if (response.RequiresApproval && response.PendingApprovals.Count > 0)
        {
            _pendingClarification = null;
            SetPendingApprovals(response.PendingApprovals);
            _agentState = AgentState.WaitingForApproval;
            return;
        }

        _pendingClarification = null;
        _pendingApprovals.Clear();
        _agentState = AgentState.Idle;
    }

    private void SetPendingApprovals(IReadOnlyList<PendingApproval> approvals)
    {
        _pendingApprovals.Clear();
        _pendingApprovals.AddRange(approvals.Select(static approval =>
            new PendingApprovalInfo(
                approval.ComponentId,
                approval.ActionId,
                approval.Description,
                approval.Parameters)));
    }

    private void HandleDeferredActionCompleted(DeferredComponentActionEvent actionEvent)
    {
        if (!IsDeferredEventForCurrentChat(actionEvent))
        {
            return;
        }

        _ = InvokeAsync(() =>
        {
            var message = FormatDeferredActionMessage(actionEvent);
            var key = BuildActivityKey(actionEvent.ComponentType, actionEvent.ActionId);
            if (!TryAttachActivityToAssociatedTurn(key, message, actionEvent.RunId))
            {
                _timeline.Add(ChatTimelineItem.Activity(message, actionEvent.RunId));
            }

            _scrollRequested = true;
            StateHasChanged();
        });
    }

    private bool IsDeferredEventForCurrentChat(DeferredComponentActionEvent actionEvent)
    {
        if (!string.IsNullOrWhiteSpace(actionEvent.SessionId))
        {
            return string.Equals(actionEvent.SessionId, _instanceId, StringComparison.OrdinalIgnoreCase);
        }

        if (!string.IsNullOrWhiteSpace(actionEvent.RunId) &&
            !string.IsNullOrWhiteSpace(_activeRunId))
        {
            return string.Equals(actionEvent.RunId, _activeRunId, StringComparison.OrdinalIgnoreCase);
        }

        return false;
    }

    private void AddStreamingActivityMessage(string key, string message)
    {
        if (string.IsNullOrWhiteSpace(key) || string.IsNullOrWhiteSpace(message))
        {
            return;
        }

        UpsertActivityMessage(_streamingActivityMessages, key, message);
    }

    private bool TryAttachActivityToAssociatedTurn(string key, string message, string? runId)
    {
        if (string.IsNullOrWhiteSpace(key) || string.IsNullOrWhiteSpace(message))
        {
            return true;
        }

        if (!string.IsNullOrWhiteSpace(runId))
        {
            if (_isBusy &&
                !string.IsNullOrWhiteSpace(_activeRunId) &&
                string.Equals(runId, _activeRunId, StringComparison.OrdinalIgnoreCase))
            {
                AddStreamingActivityMessage(key, message);
                return true;
            }

            if (_assistantTimelineIndexByRunId.TryGetValue(runId, out var assistantIndex))
            {
                return TryAppendActivityToAssistantItem(assistantIndex, key, message);
            }
        }

        if (_isBusy)
        {
            AddStreamingActivityMessage(key, message);
            return true;
        }

        for (var index = _timeline.Count - 1; index >= 0; index--)
        {
            if (_timeline[index].Role != "assistant")
            {
                continue;
            }

            return TryAppendActivityToAssistantItem(index, key, message);
        }

        return false;
    }

    private bool TryAppendActivityToAssistantItem(int index, string key, string message)
    {
        if (index < 0 || index >= _timeline.Count)
        {
            return false;
        }

        var item = _timeline[index];
        if (!string.Equals(item.Role, "assistant", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        var updatedActivities = UpsertActivityMessage(item.ActivityMessages, key, message);
        _timeline[index] = item with { ActivityMessages = updatedActivities };
        return true;
    }

    private static string BuildActivityKey(string componentId, string actionId)
    {
        var normalizedComponent = (componentId ?? string.Empty).Trim();
        var normalizedAction = (actionId ?? string.Empty).Trim();
        return $"{normalizedComponent}.{normalizedAction}".ToLowerInvariant();
    }

    private static void UpsertActivityMessage(List<ActivityMessage> target, string key, string message)
    {
        var index = target.FindIndex(activity =>
            string.Equals(activity.Key, key, StringComparison.OrdinalIgnoreCase));
        var entry = new ActivityMessage(key, message);
        if (index >= 0)
        {
            target[index] = entry;
            return;
        }

        target.Add(entry);
    }

    private static IReadOnlyList<ActivityMessage> UpsertActivityMessage(
        IReadOnlyList<ActivityMessage> source,
        string key,
        string message)
    {
        var copy = source.ToList();
        UpsertActivityMessage(copy, key, message);
        return copy;
    }

    private static string FormatDeferredActionMessage(DeferredComponentActionEvent actionEvent)
    {
        var componentId = actionEvent.ComponentType.StartsWith("Agent", StringComparison.OrdinalIgnoreCase)
            ? actionEvent.ComponentType
            : $"Agent{actionEvent.ComponentType}";
        var status = actionEvent.Succeeded ? "applied" : "failed";
        return $"Deferred action {status}: {componentId}.{actionEvent.ActionId}. {actionEvent.Message}";
    }

    private static string FormatToolCallStartMessage(PlannedComponentAction plannedAction)
    {
        return $"Executing {plannedAction.ComponentId}.{plannedAction.ActionId}...";
    }

    private static string FormatToolCallResultMessage(ComponentActionExecutionResult executionResult)
    {
        if (!string.IsNullOrWhiteSpace(executionResult.Message))
        {
            return executionResult.Message;
        }

        return executionResult.Succeeded
            ? $"Completed {executionResult.ComponentId}.{executionResult.ActionId}."
            : $"Failed {executionResult.ComponentId}.{executionResult.ActionId}.";
    }

    private IDictionary<string, string>? CreateRequestContext(IReadOnlyDictionary<string, string>? additional = null)
    {
        Dictionary<string, string>? context = null;

        if (EnableGeneratedUi)
        {
            context = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
                [AgentGenerativeUiSpec.GenerateUiContextKey] = bool.TrueString
            };
        }

        if (additional is not null)
        {
            context ??= new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
            foreach (var pair in additional)
            {
                context[pair.Key] = pair.Value;
            }
        }

        return context;
    }

    private Task HandleGeneratedActionInvokedAsync(AgentUiActionInvocation invocation)
    {
        _timeline.Add(ChatTimelineItem.Activity(
            $"Generated UI action invoked: {invocation.BlockId}.{invocation.Action.Id}."));
        _scrollRequested = true;
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleGeneratedRuntimeResponseAsync(AgentTurnResponse response)
    {
        _timeline.Add(ChatTimelineItem.Agent(response));
        _scrollRequested = true;
        return InvokeAsync(StateHasChanged);
    }

    private Task HandleGeneratedUiErrorAsync(Exception exception)
    {
        _timeline.Add(ChatTimelineItem.Activity($"Generated UI action failed: {exception.Message}"));
        _scrollRequested = true;
        return InvokeAsync(StateHasChanged);
    }

    private sealed record ChatTimelineItem(
        string Role,
        string RoleLabel,
        string Text,
        IReadOnlyList<ActivityMessage> ActivityMessages,
        IReadOnlyList<PlannedComponentAction> PlannedActions,
        IReadOnlyList<ComponentActionExecutionResult> ExecutionResults,
        AgentUiDocument? GeneratedUi,
        string? RunId)
    {
        public static ChatTimelineItem User(string text) =>
            new("user", "User", text, [], [], [], null, null);

        public static ChatTimelineItem Agent(
            AgentTurnResponse response,
            string? runId = null,
            IReadOnlyList<ActivityMessage>? activityMessages = null) =>
            new(
                "assistant",
                response.AgentName,
                response.ResponseText,
                activityMessages ?? [],
                response.PlannedActions,
                response.ExecutionResults,
                response.GeneratedUi,
                runId);

        public static ChatTimelineItem Activity(string text, string? runId = null) =>
            new("activity", "Activity", text, [], [], [], null, runId);
    }

    private sealed record ActivityMessage(string Key, string Text);

    private sealed record StreamTurnOutcome(
        AgentTurnResponse Response,
        string? ClarificationQuestion,
        IReadOnlyList<PendingApproval> PendingApprovals,
        string? RunId);

    private sealed record PendingClarificationInfo(string Question, string OriginalMessage);
    private sealed record PendingApprovalInfo(string ComponentId, string ActionId, string Description, IReadOnlyDictionary<string, object?> Parameters);
}
