@namespace AgentBlazor.Components
@using AgentBlazor.Agents
@using AgentBlazor.Components.Chat
@using AgentBlazor.Components.Render
@using AgentBlazor.Core.Models
@using AgentBlazor.Core.Paid
@using AgentBlazor.Options
@using Markdig
@implements IDisposable
@using AgentBlazor.Core.Runtime.Agents
@using AgentBlazor.Core.Runtime.Components
@using AgentBlazor.Core.Runtime.Conversation
@using AgentBlazor.Core.Runtime.Discovery
@using AgentBlazor.Core.Runtime.Interfaces
@using AgentBlazor.Execution
@using AgentBlazor.Runtime
@using Microsoft.Extensions.Options
@using Microsoft.JSInterop
@inject IAgentRegistry AgentRegistry
@inject IAgentRuntimeAdapter RuntimeAdapter
@inject IAgentDeferredActionEvents DeferredActionEvents
@inject IConversationStore ConversationStore
@inject IAgentComponentRegistry ComponentRegistry
@inject IAgentChatSessionEvents SessionEvents
@inject IAgentChatActiveRunStore ActiveRunStore
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject IAgentActionRenderRegistry ActionRenderRegistry
@inject IAdaptiveSuggestionService SuggestionService
@inject IProactiveInsightService ProactiveInsightService
@inject IOptions<AgentBlazorOptions> AgentBlazorOptionsAccessor
@inject IServiceProvider ServiceProvider
@inject IAgentExecutionScopeAccessor ExecutionScopeAccessor

<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        <div class="ab-chat-surface-shell @(ResolvedShowDevTools ? "ab-chat-surface-shell--with-devtools" : null)">
        <section class="ab-chat-surface @(Theme?.CssClass) @(Theme?.GetFeatureClasses()) @CssClass"
                 data-theme="@(Theme?.DataTheme)"
                 data-style="@(Theme?.DataStyle)"
                 data-radius="@(Theme?.DataRadius)"
                 data-spacing="@(Theme?.DataSpacing)"
                 data-testid="agent-chat-surface"
                 style="@_themeStyle"
                 aria-label="@(Title ?? "Chat")">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <header class="ab-chat-surface__header" id="@HeaderId">@Title</header>
            }

            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="ab-chat-surface__body" id="@DescriptionId">@Description</p>
            }

            @if (_agentState != AgentState.Idle)
    {
        <div class="ab-chat-surface__state ab-chat-surface__state--@_agentState.ToString().ToLower() @(_showTimeoutWarning ? "ab-chat-surface__state--timeout" : "")">
            @if (_agentState == AgentState.Thinking)
            {
                <span class="ab-chat-surface__state-dot"></span>
                @if (_showTimeoutWarning)
                {
                    <span>Taking longer than expected...</span>
                }
                else
                {
                    <span>Thinking...</span>
                }
            }
            else if (_agentState == AgentState.WaitingForApproval)
            {
                <span class="ab-chat-surface__state-icon">&#9888;</span>
                <span>Waiting for approval</span>
            }
            else if (_agentState == AgentState.WaitingForClarification)
            {
                <span class="ab-chat-surface__state-icon">&#10067;</span>
                <span>Clarification needed</span>
            }
        </div>
    }

    @if (_timeline.Count > 0 ||
         !string.IsNullOrWhiteSpace(_streamingResponseText) ||
         _pendingClarification is not null ||
         _pendingApprovals.Count > 0)
    {
        <div id="@TimelineId"
             class="ab-chat-surface__timeline"
             role="log"
             aria-live="polite"
             aria-label="Conversation">
            @foreach (var item in _timeline)
            {
                <article class="ab-chat-surface__item ab-chat-surface__item--@item.Role @(item.GeneratedUi is null ? null : "ab-chat-surface__item--generated") @(item.IsProactive ? "ab-chat-surface__item--proactive" : null)"
                         aria-label="@item.RoleLabel">
                    <div class="ab-chat-surface__item-role">
                        @if (item.IsProactive)
                        {
                            <span class="ab-chat-surface__proactive-badge">Agent noticed:</span>
                        }
                        else
                        {
                            @item.RoleLabel
                        }
                    </div>
                    @if (item.Role == "assistant" || item.IsProactive)
                    {
                        <div class="ab-chat-surface__item-text ab-chat-surface__item-text--markdown">@RenderMarkdown(item.Text)</div>
                    }
                    else
                    {
                        <div class="ab-chat-surface__item-text">@item.Text</div>
                    }

                    @if (TryGetPlanSummary(item, out var planSummary))
                    {
                        <div class="ab-chat-surface__plan-summary">@planSummary</div>
                    }

                    @if (item.ActivityMessages.Count > 0)
                    {
                        <ul class="ab-chat-surface__activity-list" aria-label="Activity">
                            @foreach (var activity in item.ActivityMessages)
                            {
                                if (TryBuildRenderedActivity(activity, out var renderedActivity))
                                {
                                    <li class="ab-chat-surface__activity-item ab-chat-surface__activity-item--custom">
                                        @renderedActivity
                                    </li>
                                }
                                else
                                {
                                    <li class="ab-chat-surface__activity-item @(activity.Succeeded ? "ab-chat-surface__activity-item--done" : "ab-chat-surface__activity-item--failed")">
                                        <span class="ab-chat-surface__activity-icon @(activity.Succeeded ? "" : "ab-chat-surface__activity-icon--failed")">@(activity.Succeeded ? "✓" : "✗")</span>
                                        <span class="ab-chat-surface__activity-text">@activity.Text</span>
                                    </li>
                                }
                            }
                        </ul>
                    }

                    @if (GetDisplayStepLabels(item).Count > 0)
                    {
                        <ul class="ab-chat-surface__actions" aria-label="Planned actions">
                            @foreach (var step in GetDisplayStepLabels(item))
                            {
                                <li>@step</li>
                            }
                        </ul>
                    }

                    @if (GetDisplayResultTexts(item).Count > 0)
                    {
                        <ul class="ab-chat-surface__results" aria-label="Results">
                            @foreach (var resultText in GetDisplayResultTexts(item))
                            {
                                <li>@resultText</li>
                            }
                        </ul>
                    }

                    @if (item.GeneratedUi is not null)
                    {
                        <div class="ab-chat-surface__generated-ui">
                            <AgentGenerativeSurface Document="@item.GeneratedUi"
                                                    AgentName="@item.RoleLabel"
                                                    SessionId="@EffectiveSessionId"
                                                    ForwardActionsToRuntime="true"
                                                    ShowRuntimeResponses="false"
                                                    OnActionInvoked="HandleGeneratedActionInvokedAsync"
                                                    OnRuntimeResponseReceived="HandleGeneratedRuntimeResponseAsync"
                                                    OnError="HandleGeneratedUiErrorAsync" />
                        </div>
                    }
                </article>
            }

            @if (_streamingActivityMessages.Count > 0 || !string.IsNullOrWhiteSpace(_streamingResponseText))
            {
                <article class="ab-chat-surface__item ab-chat-surface__item--assistant"
                         aria-label="Assistant">
                    <div class="ab-chat-surface__item-role">@(_streamingAgentName ?? "Assistant")</div>
                    @if (_streamingActivityMessages.Count > 0)
                    {
                        <ul class="ab-chat-surface__activity-list" aria-label="Activity">
                            @foreach (var activity in _streamingActivityMessages)
                            {
                                if (TryBuildRenderedActivity(activity, out var renderedActivity))
                                {
                                    <li class="ab-chat-surface__activity-item ab-chat-surface__activity-item--custom">
                                        @renderedActivity
                                    </li>
                                }
                                else
                                {
                                    var isDone = _completedActivityKeys.Contains(activity.Key);
                                    var statusClass = isDone
                                        ? (activity.Succeeded ? "ab-chat-surface__activity-item--done" : "ab-chat-surface__activity-item--failed")
                                        : string.Empty;
                                    <li class="ab-chat-surface__activity-item @statusClass">
                                        @if (isDone)
                                        {
                                            <span class="ab-chat-surface__activity-icon @(activity.Succeeded ? "" : "ab-chat-surface__activity-icon--failed")">@(activity.Succeeded ? "✓" : "✗")</span>
                                        }
                                        else
                                        {
                                            <span class="ab-chat-surface__activity-spinner" aria-hidden="true"></span>
                                        }
                                        <span class="ab-chat-surface__activity-text">@activity.Text</span>
                                    </li>
                                }
                            }
                        </ul>
                    }
                    @if (!string.IsNullOrWhiteSpace(_streamingReasoningText))
                    {
                        <details class="ab-chat-surface__reasoning" open="@(_reasoningComplete ? null : string.Empty)">
                            <summary class="ab-chat-surface__reasoning-summary">Thinking…</summary>
                            <div class="ab-chat-surface__reasoning-body">@_streamingReasoningText</div>
                        </details>
                    }
                    @if (!string.IsNullOrWhiteSpace(_streamingResponseText))
                    {
                        <div class="ab-chat-surface__item-text ab-chat-surface__item-text--markdown">@RenderMarkdown(_streamingResponseText)</div>
                    }
                </article>
            }

            @if (_pendingClarification is { } clar)
            {
                <article class="ab-chat-surface__item ab-chat-surface__item--clarification" aria-label="Clarification needed">
                    <div class="ab-chat-surface__item-role">Clarification Needed</div>
                    <div class="ab-chat-surface__item-text">@clar.Question</div>
                    <div class="ab-chat-surface__clarification-input">
                        <label class="ab-chat-surface__label" for="@ClarificationInputId">Your answer:</label>
                        <input id="@ClarificationInputId"
                               type="text"
                               class="ab-chat-surface__input"
                               @bind="_clarificationResponse"
                               @bind:event="oninput"
                               placeholder="Type your answer..."
                               disabled="@_isBusy"
                               @onkeydown="HandleClarificationKeyDown" />
                        <button type="button"
                                id="@ClarificationSubmitButtonId"
                                class="ab-chat-surface__submit"
                                disabled="@(_isBusy || string.IsNullOrWhiteSpace(_clarificationResponse))"
                                @onclick="SubmitClarificationAsync">
                            @(_isBusy ? "Sending…" : "Submit")
                        </button>
                    </div>
                </article>
            }

            @if (_pendingApprovals.Count > 0)
            {
                <article class="ab-chat-surface__item ab-chat-surface__item--approval" aria-label="Approval required">
                    <div class="ab-chat-surface__item-role">Approval Required</div>
                    <div class="ab-chat-surface__item-text">The following actions require your approval:</div>
                    <div class="ab-chat-surface__plan-summary">@BuildApprovalSummary(_pendingApprovals)</div>
                    <ul class="ab-chat-surface__approval-list">
                        @foreach (var approval in _pendingApprovals)
                        {
                            <li>
                                <strong>@GetApprovalDisplayTitle(approval)</strong>
                                @if (!string.IsNullOrWhiteSpace(approval.StepLabel))
                                {
                                    <div class="ab-chat-surface__approval-params">@approval.StepLabel</div>
                                }
                                else
                                {
                                    <div class="ab-chat-surface__approval-params">@approval.ComponentId.@approval.ActionId</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(approval.PolicySummary))
                                {
                                    <div class="ab-chat-surface__approval-params">@approval.PolicySummary</div>
                                }
                                @if (approval.Parameters.Count > 0)
                                {
                                    <div class="ab-chat-surface__approval-params">
                                        (@string.Join(", ", approval.Parameters.Select(p => $"{p.Key}={p.Value}")))
                                    </div>
                                }
                                @if (approval.NarrativeLines.Count > 0)
                                {
                                    <ul class="ab-chat-surface__results" aria-label="Approval details">
                                        @foreach (var narrativeLine in approval.NarrativeLines)
                                        {
                                            <li>@narrativeLine</li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ul>
                    <div class="ab-chat-surface__approval-buttons">
                        <button type="button"
                                class="ab-chat-surface__submit ab-chat-surface__submit--approve"
                                disabled="@_isBusy"
                                @onclick="ApproveActionsAsync">
                            @(_isBusy ? "Approving…" : "Approve")
                        </button>
                        <button type="button"
                                class="ab-chat-surface__submit ab-chat-surface__submit--deny"
                                disabled="@_isBusy"
                                @onclick="DenyActionsAsync">
                            @(_isBusy ? "Denying…" : "Deny")
                        </button>
                    </div>
                </article>
            }

            @if (_pendingHandoffRequest is { } pendingHandoff)
            {
                <article class="ab-chat-surface__item ab-chat-surface__item--approval" aria-label="Handoff approval required">
                    <div class="ab-chat-surface__item-role">Handoff Pending</div>
                    <div class="ab-chat-surface__item-text">
                        Transfer control from <strong>@pendingHandoff.FromAgent</strong> to <strong>@pendingHandoff.ToAgent</strong>?
                        @if (!string.IsNullOrWhiteSpace(pendingHandoff.TargetRoute))
                        {
                            <span> Route: <code>@pendingHandoff.TargetRoute</code>.</span>
                        }
                    </div>
                    <div class="ab-chat-surface__approval-buttons">
                        <button type="button"
                                class="ab-chat-surface__submit ab-chat-surface__submit--approve"
                                disabled="@_isBusy"
                                @onclick="ApprovePendingHandoffAsync">
                            @(_isBusy ? "Approving…" : "Approve Handoff")
                        </button>
                        <button type="button"
                                class="ab-chat-surface__submit ab-chat-surface__submit--deny"
                                disabled="@_isBusy"
                                @onclick="CancelPendingHandoffAsync">
                            @(_isBusy ? "Cancelling…" : "Cancel")
                        </button>
                    </div>
                </article>
            }
        </div>
    }

    @if (_suggestions.Count > 0 && !_isBusy)
    {
        <div class="ab-chat-surface__suggestions" role="list" aria-label="Suggestions">
            @foreach (var suggestion in _suggestions)
            {
                <button type="button"
                        class="ab-chat-surface__suggestion-chip"
                        role="listitem"
                        @onclick="() => AcceptSuggestion(suggestion.Text)">
                    @suggestion.Text
                </button>
            }
        </div>
    }

    <EditForm class="ab-chat-surface__controls" Model="@this" FormName="@EffectiveFormName" OnValidSubmit="SendAsync">
        @if (ShowAgentSelector && !IsAgentSelectionLocked)
        {
            <label class="ab-chat-surface__label" for="@AgentSelectId">Agent</label>
            <select id="@AgentSelectId"
                    class="ab-chat-surface__select"
                    @bind="_selectedAgent"
                    aria-describedby="@DescriptionId"
                    disabled="@_isBusy">
                @if (_agentNames.Count == 0)
                {
                    <option value="">No agents registered</option>
                }
                @foreach (var agent in _agentNames)
                {
                    <option value="@agent">@agent</option>
                }
            </select>
        }
        else if (IsAgentSelectionLocked && !string.IsNullOrWhiteSpace(_selectedAgent))
        {
            <label class="ab-chat-surface__label">Agent</label>
            <div class="ab-chat-surface__select">@_selectedAgent</div>
        }

        <label class="ab-chat-surface__label" for="@PromptId">Message</label>
        <div class="ab-chat-surface__input-wrapper">
            @if (_showSlashMenu && _slashItems.Count > 0)
            {
                <div class="ab-chat-surface__slash-menu" role="listbox" aria-label="Available commands">
                    @foreach (var group in _slashItems.GroupBy(s => s.ComponentId))
                    {
                        <div class="ab-chat-surface__slash-group">
                            <div class="ab-chat-surface__slash-group-label">@group.Key</div>
                            @foreach (var item in group)
                            {
                                <button type="button"
                                        class="ab-chat-surface__slash-item"
                                        role="option"
                                        @onclick="() => AcceptSlashItem(item)">
                                    <span class="ab-chat-surface__slash-action">/@item.ActionId</span>
                                    <span class="ab-chat-surface__slash-desc">@item.Label</span>
                                </button>
                            }
                        </div>
                    }
                </div>
            }
            <textarea id="@PromptId"
                      class="ab-chat-surface__input"
                      rows="3"
                      value="@_prompt"
                      @oninput="HandlePromptInput"
                      @onkeydown="HandlePromptKeyDown"
                      placeholder="@Placeholder"
                      aria-describedby="@DescriptionId"
                      aria-label="Message input"
                      disabled="@_isBusy"></textarea>
        </div>

            <button type="submit"
                    id="@SubmitButtonId"
                    class="ab-chat-surface__submit"
                    disabled="@(_isBusy || !_canSubmit)"
                    aria-busy="@_isBusy"
                    aria-label="@(_isBusy ? "Sending..." : "Send message")">
                @(_isBusy ? "Sending…" : "Send")
            </button>
            @if (CanRequestStop)
            {
                <button type="button"
                        class="ab-chat-surface__submit"
                        disabled="@_stopRequested"
                        aria-label="@(_stopRequested ? "Stopping active run" : "Stop active run")"
                        @onclick="RequestStopAsync">
                    @(_stopRequested ? "Stopping…" : "Stop")
                </button>
            }
        </EditForm>
    </section>
    @if (ResolvedShowDevTools)
    {
        <aside class="ab-chat-surface__devtools" aria-label="Agent inspector">
            <AgentInspectorPanel SessionId="@EffectiveSessionId"
                                 Inline="true"
                                 AutoShowOnDebug="@ResolvedAutoShowDevTools" />
        </aside>
    }
    </div>
    </ChildContent>
    <ErrorContent Context="exception">
        <section class="ab-chat-surface ab-chat-surface--error @(Theme?.CssClass) @CssClass"
                 data-theme="@(Theme?.DataTheme)"
                 style="@_themeStyle"
                 aria-label="Error">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <header class="ab-chat-surface__header" id="@HeaderId">@Title</header>
            }
            <div class="ab-chat-surface__error-content">
                <div class="ab-chat-surface__error-icon">⚠️</div>
                <div class="ab-chat-surface__error-title">Something went wrong</div>
                <div class="ab-chat-surface__error-message">@exception.Message</div>
                <button type="button"
                        class="ab-chat-surface__submit"
                        @onclick="RecoverFromError">
                    Try Again
                </button>
            </div>
        </section>
    </ErrorContent>
</ErrorBoundary>

@code {
    private static readonly MarkdownPipeline _mdPipeline =
        new MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
    private static readonly IReadOnlyDictionary<string, object?> EmptyActionArgs =
        new Dictionary<string, object?>();
    private static readonly string[] AgentRouteMetadataKeys = ["route", "routes", "route_prefix", "route_prefixes"];

    private static MarkupString RenderMarkdown(string? text) =>
        new(string.IsNullOrWhiteSpace(text) ? string.Empty :
            Markdown.ToHtml(text ?? string.Empty, _mdPipeline));

    private ErrorBoundary? _errorBoundary;

    private readonly List<string> _agentNames = [];
    private readonly List<ChatTimelineItem> _timeline = [];
    private string _prompt = string.Empty;
    private string? _selectedAgent;
    private bool _isBusy;
    private bool _scrollRequested;
    private bool _clarificationShortcutAttached;
    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private string _streamingResponseText = string.Empty;
    private string _streamingReasoningText = string.Empty;
    private bool _reasoningComplete;
    private string? _streamingAgentName;
    private string? _activeRunId;
    private bool _stopRequested;
    private string? _lastReconnectAttemptRunId;
    private readonly List<ActivityMessage> _streamingActivityMessages = [];
    private readonly HashSet<string> _completedActivityKeys = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, int> _assistantTimelineIndexByRunId =
        new(StringComparer.OrdinalIgnoreCase);
    private string? _historyHydratedForSession;
    private IReadOnlyList<AgentSuggestion> _suggestions = [];

    // Slash command discovery
    private bool _showSlashMenu;
    private List<SlashItem> _slashItems = [];
    private List<SlashItem>? _allSlashItems; // cached full list
    private string? _pendingHandoffFromAgent;
    private string? _pendingHandoffToAgent;
    private DateTimeOffset? _pendingHandoffAtUtc;
    private PendingHandoffRequest? _pendingHandoffRequest;
    private readonly List<HandoffTransition> _handoffHistory = [];

    // Timeout warning
    private bool _showTimeoutWarning;
    private System.Timers.Timer? _timeoutTimer;
    private const int TimeoutWarningMs = 10000; // Show warning after 10 seconds

    // Session ID is taken from the scoped circuit registry so the runtime
    // can look up this circuit's components via AgentComponentRegistryHub.
    private string CircuitSessionId => ComponentRegistry.SessionId;

    private PendingClarificationInfo? _pendingClarification;
    private string _clarificationResponse = string.Empty;
    private readonly List<PendingApprovalInfo> _pendingApprovals = [];
    private AgentState _agentState = AgentState.Idle;

    private enum AgentState { Idle, Thinking, WaitingForApproval, WaitingForClarification }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? FormName { get; set; }

    [Parameter]
    public string? DefaultAgentName { get; set; }

    [Parameter]
    public bool ShowAgentSelector { get; set; } = true;

    [Parameter]
    public string? LockedAgentName { get; set; }

    [Parameter]
    public bool LockAgentToCurrentRoute { get; set; }

    [Parameter]
    public bool EnableAgentHandoff { get; set; } = true;

    [Parameter]
    public bool AutoNavigateOnRouteLockedHandoff { get; set; } = true;

    [Parameter]
    public bool RequireHandoffApproval { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, IReadOnlyList<string>>? HandoffApprovalPolicy { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, IReadOnlyList<string>>? HandoffPolicy { get; set; }

    [Parameter]
    public int? MaxHandoffsPerSession { get; set; }

    [Parameter]
    public int? MaxHandoffsPerPair { get; set; }

    [Parameter]
    public int? MaxHandoffsPerWindow { get; set; }

    [Parameter]
    public int? HandoffWindowMinutes { get; set; }

    [Parameter]
    public int? MaxPairHandoffsPerWindow { get; set; }

    [Parameter]
    public bool BlockImmediateReturnHandoff { get; set; } = true;

    [Parameter]
    public string Placeholder { get; set; } = "Type a message… (Enter to send, Shift+Enter for new line)";

    [Parameter]
    public ChatTheme? Theme { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public string? SessionId { get; set; }

    [Parameter]
    public bool EnableGeneratedUi { get; set; }

    [Parameter]
    public bool? ShowDevTools { get; set; }

    [Parameter]
    public bool? AutoShowDevTools { get; set; }

    private string EffectiveSessionId =>
        string.IsNullOrWhiteSpace(SessionId)
            ? CircuitSessionId
            : SessionId.Trim();

    private string EffectiveConversationSessionId =>
        AgentConversationScope.BuildSessionKey(
            EffectiveSessionId,
            _selectedAgent,
            ShouldIsolateConversationSession);

    private bool ResolvedShowDevTools =>
        ShowDevTools ?? AgentBlazorOptionsAccessor.Value.EnableDevTools;

    private bool ResolvedAutoShowDevTools =>
        AutoShowDevTools ?? AgentBlazorOptionsAccessor.Value.AutoShowDevTools;

    private string EffectiveFormName =>
        string.IsNullOrWhiteSpace(FormName)
            ? $"agent-chat-surface-{_instanceId}"
            : FormName;

    private string AgentSelectId => $"ab-agent-select-{_instanceId}";
    private string PromptId => $"ab-agent-prompt-{_instanceId}";
    private string SubmitButtonId => $"ab-agent-submit-{_instanceId}";
    private string TimelineId => $"ab-chat-timeline-{_instanceId}";
    private string HeaderId => $"ab-chat-header-{_instanceId}";
    private string DescriptionId => $"ab-chat-description-{_instanceId}";
    private string ClarificationInputId => $"ab-clarification-input-{_instanceId}";
    private string ClarificationSubmitButtonId => $"ab-clarification-submit-{_instanceId}";

    private bool IsAgentSelectionLocked =>
        !string.IsNullOrWhiteSpace(LockedAgentName) || LockAgentToCurrentRoute;

    private bool ShouldIsolateConversationSession =>
        AgentBlazorOptionsAccessor.Value.IsolateConversationsByAgent && _agentNames.Count > 1;

    private bool _canSubmit => !string.IsNullOrWhiteSpace(_prompt.Trim()) && _pendingClarification is null;

    private bool CanRequestStop =>
        _isBusy &&
        RuntimeAdapter.SupportsCancellation &&
        !string.IsNullOrWhiteSpace(_activeRunId);

    private string? _themeStyle => Theme?.GetStyleString();

    protected override void OnInitialized()
    {
        DeferredActionEvents.DeferredActionCompleted += HandleDeferredActionCompleted;
        if (SessionEvents is not null)
            SessionEvents.SessionUpdated += HandleSessionUpdated;

        _agentNames.AddRange(
            AgentRegistry.GetAll()
                .Select(static agent => agent.Name)
                .OrderBy(static name => name, StringComparer.OrdinalIgnoreCase));
        ApplyAgentSelectionPolicy();
    }

    protected override async Task OnParametersSetAsync()
    {
        ApplyAgentSelectionPolicy();
        await HydrateTimelineFromHistoryAsync();
        await TryResumeActiveRunAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("AgentBlazor.chat.attachEnterSubmit", PromptId, SubmitButtonId);
            }
            catch
            {
                // JS may be unavailable (e.g. prerender); ignore
            }
        }

        if (_scrollRequested)
        {
            _scrollRequested = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("AgentBlazor.chat.scrollToBottom", TimelineId);
            }
            catch
            {
                // JS may be unavailable (e.g. prerender); ignore
            }
        }

        if (_pendingClarification is not null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("AgentBlazor.chat.attachEnterSubmit", ClarificationInputId, ClarificationSubmitButtonId);
                _clarificationShortcutAttached = true;
            }
            catch { }
        }
        else if (_clarificationShortcutAttached)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("AgentBlazor.chat.detachEnterSubmit", ClarificationInputId);
            }
            catch
            {
                // Ignore when JS or component already torn down
            }

            _clarificationShortcutAttached = false;
        }
    }

    public void Dispose()
    {
        DeferredActionEvents.DeferredActionCompleted -= HandleDeferredActionCompleted;
        if (SessionEvents is not null)
            SessionEvents.SessionUpdated -= HandleSessionUpdated;

        StopTimeoutTimer();
        _timeoutTimer?.Dispose();

        try
        {
            _ = JSRuntime.InvokeVoidAsync("AgentBlazor.chat.detachEnterSubmit", PromptId);
            _ = JSRuntime.InvokeVoidAsync("AgentBlazor.chat.detachEnterSubmit", ClarificationInputId);
        }
        catch
        {
            // Ignore when JS or component already torn down
        }
    }

    private void StartTimeoutTimer()
    {
        _showTimeoutWarning = false;
        _timeoutTimer ??= new System.Timers.Timer(TimeoutWarningMs);
        _timeoutTimer.Elapsed -= OnTimeoutElapsed;
        _timeoutTimer.Elapsed += OnTimeoutElapsed;
        _timeoutTimer.AutoReset = false;
        _timeoutTimer.Start();
    }

    private void StopTimeoutTimer()
    {
        _timeoutTimer?.Stop();
        _showTimeoutWarning = false;
    }

    private void OnTimeoutElapsed(object? sender, System.Timers.ElapsedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (_isBusy && _agentState == AgentState.Thinking)
            {
                _showTimeoutWarning = true;
                StateHasChanged();
            }
        });
    }

    private void RecoverFromError()
    {
        _errorBoundary?.Recover();
        _isBusy = false;
        _agentState = AgentState.Idle;
        _streamingResponseText = string.Empty;
        _streamingReasoningText = string.Empty;
        _streamingAgentName = null;
        _streamingActivityMessages.Clear();
        _completedActivityKeys.Clear();
        _pendingHandoffRequest = null;
        StateHasChanged();
    }

    private async Task SendAsync()
    {
        if (_isBusy)
            return;

        var message = _prompt.Trim();
        if (message.Length == 0)
            return;

        if (_agentNames.Count == 0)
        {
            _timeline.Add(ChatTimelineItem.Activity(
                "No agents are registered. Add a workflow with ConfigureBuilder(builder => builder.AddWorkflow<T>(\"agent-name\")) in your AddAgentBlazor setup."));
            _scrollRequested = true;
            StateHasChanged();
            return;
        }

        if (TryHandleAgentListCommand(message))
        {
            _prompt = string.Empty;
            _showSlashMenu = false;
            _suggestions = [];
            _scrollRequested = true;
            StateHasChanged();
            return;
        }

        if (TryHandleHandoffHistoryCommand(message))
        {
            _prompt = string.Empty;
            _showSlashMenu = false;
            _suggestions = [];
            _scrollRequested = true;
            StateHasChanged();
            return;
        }

        if (TryHandleHandoffPolicyCommand(message))
        {
            _prompt = string.Empty;
            _showSlashMenu = false;
            _suggestions = [];
            _scrollRequested = true;
            StateHasChanged();
            return;
        }

        if (await TryHandleHandoffDecisionCommandAsync(message))
        {
            _prompt = string.Empty;
            _showSlashMenu = false;
            _suggestions = [];
            _scrollRequested = true;
            StateHasChanged();
            return;
        }

        if (await TryHandleAgentHandoffCommandAsync(message))
        {
            _prompt = string.Empty;
            _showSlashMenu = false;
            _suggestions = [];
            _scrollRequested = true;
            StateHasChanged();
            return;
        }

        _timeline.Add(ChatTimelineItem.User(message));
        _suggestions = [];
        _prompt = string.Empty;
        _showSlashMenu = false;
        _pendingClarification = null;
        _pendingApprovals.Clear();
        _clarificationResponse = string.Empty;
        _streamingResponseText = string.Empty;
        _streamingReasoningText = string.Empty;
        _reasoningComplete = false;
        _streamingAgentName = null;
        _activeRunId = null;
        _stopRequested = false;
        _streamingActivityMessages.Clear();
        _completedActivityKeys.Clear();
        _isBusy = true;
        _agentState = AgentState.Thinking;
        _scrollRequested = true;
        StartTimeoutTimer();
        StateHasChanged();

        try
        {
            var conversationTurnCountBefore = await GetConversationTurnCountAsync();
            var turnOutcome = await RunTurnWithOptionalStreamingAsync(new AgentTurnRequest(
                message,
                _selectedAgent,
                SessionId: EffectiveSessionId,
                Context: CreateRequestContext()));
            await ApplyTurnOutcomeAsync(message, turnOutcome, conversationTurnCountBefore);
            ClearPendingHandoffMetadata();
            _ = FireProactiveInsightAsync(message, turnOutcome);
            _scrollRequested = true;
        }
        finally
        {
            StopTimeoutTimer();
            _isBusy = false;
            if (_agentState == AgentState.Thinking)
                _agentState = AgentState.Idle;
        }

        await RefreshSuggestionsAsync();
    }

