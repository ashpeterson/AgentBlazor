@namespace AgentBlazor.Components
@using AgentBlazor.Agents
@using AgentBlazor.Components.Chat
@implements IDisposable
@using AgentBlazor.Core.Runtime.Agents
@using AgentBlazor.Core.Runtime.Components
@using AgentBlazor.Core.Runtime.Interfaces
@using AgentBlazor.Runtime
@using Microsoft.JSInterop
@inject IAgentRegistry AgentRegistry
@inject IAgentRuntime AgentRuntime
@inject IAgentDeferredActionEvents DeferredActionEvents
@inject IJSRuntime JSRuntime

<section class="ab-chat-surface @(Theme?.CssClass) @CssClass" data-theme="@(Theme?.DataTheme)" style="@_themeStyle" aria-label="@(Title ?? "Chat")">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <header class="ab-chat-surface__header" id="@HeaderId">@Title</header>
    }

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="ab-chat-surface__body" id="@DescriptionId">@Description</p>
    }

    @if (_agentState != AgentState.Idle)
    {
        <div class="ab-chat-surface__state ab-chat-surface__state--@_agentState.ToString().ToLower()">
            @if (_agentState == AgentState.Thinking)
            {
                <span class="ab-chat-surface__state-dot"></span>
                <span>Thinking...</span>
            }
            else if (_agentState == AgentState.WaitingForApproval)
            {
                <span class="ab-chat-surface__state-icon">&#9888;</span>
                <span>Waiting for approval</span>
            }
            else if (_agentState == AgentState.WaitingForClarification)
            {
                <span class="ab-chat-surface__state-icon">&#10067;</span>
                <span>Clarification needed</span>
            }
        </div>
    }

    @if (_timeline.Count > 0 || !string.IsNullOrWhiteSpace(_streamingResponseText))
    {
        <div id="@TimelineId"
             class="ab-chat-surface__timeline"
             role="log"
             aria-live="polite"
             aria-label="Conversation">
            @foreach (var item in _timeline)
            {
                <article class="ab-chat-surface__item ab-chat-surface__item--@item.Role"
                         aria-label="@item.RoleLabel">
                    <div class="ab-chat-surface__item-role">@item.RoleLabel</div>
                    <div class="ab-chat-surface__item-text">@item.Text</div>

                    @if (item.PlannedActions.Count > 0)
                    {
                        <ul class="ab-chat-surface__actions" aria-label="Planned actions">
                            @foreach (var action in item.PlannedActions)
                            {
                                <li>@action.ComponentId.@action.ActionId</li>
                            }
                        </ul>
                    }

                    @if (item.ExecutionResults.Count > 0)
                    {
                        <ul class="ab-chat-surface__results" aria-label="Results">
                            @foreach (var result in item.ExecutionResults)
                            {
                                <li>@result.Message</li>
                            }
                        </ul>
                    }
                </article>
            }

            @if (!string.IsNullOrWhiteSpace(_streamingResponseText))
            {
                <article class="ab-chat-surface__item ab-chat-surface__item--assistant"
                         aria-label="Assistant">
                    <div class="ab-chat-surface__item-role">@(_streamingAgentName ?? "Assistant")</div>
                    <div class="ab-chat-surface__item-text">@_streamingResponseText</div>
                </article>
            }
        </div>
    }

    @if (_pendingClarification is { } clar)
    {
        <article class="ab-chat-surface__item ab-chat-surface__item--clarification" aria-label="Clarification needed">
            <div class="ab-chat-surface__item-role">Clarification Needed</div>
            <div class="ab-chat-surface__item-text">@clar.Question</div>
            <div class="ab-chat-surface__clarification-input">
                <label class="ab-chat-surface__label" for="@ClarificationInputId">Your answer:</label>
                <input id="@ClarificationInputId"
                       type="text"
                       class="ab-chat-surface__input"
                       @bind="_clarificationResponse"
                       @bind:event="oninput"
                       placeholder="Type your answer..."
                       disabled="@_isBusy"
                       @onkeydown="HandleClarificationKeyDown" />
                <button type="button"
                        class="ab-chat-surface__submit"
                        disabled="@(_isBusy || string.IsNullOrWhiteSpace(_clarificationResponse))"
                        @onclick="SubmitClarificationAsync">
                    @(_isBusy ? "Sending…" : "Submit")
                </button>
            </div>
        </article>
    }

    @if (_pendingApprovals.Count > 0)
    {
        <article class="ab-chat-surface__item ab-chat-surface__item--approval" aria-label="Approval required">
            <div class="ab-chat-surface__item-role">Approval Required</div>
            <div class="ab-chat-surface__item-text">The following actions require your approval:</div>
            <ul class="ab-chat-surface__approval-list">
                @foreach (var approval in _pendingApprovals)
                {
                    <li>
                        <strong>@approval.ComponentId.@approval.ActionId</strong>
                        @if (approval.Parameters.Count > 0)
                        {
                            <span class="ab-chat-surface__approval-params">
                                (@string.Join(", ", approval.Parameters.Select(p => $"{p.Key}={p.Value}")))
                            </span>
                        }
                    </li>
                }
            </ul>
            <div class="ab-chat-surface__approval-buttons">
                <button type="button"
                        class="ab-chat-surface__submit ab-chat-surface__submit--approve"
                        disabled="@_isBusy"
                        @onclick="ApproveActionsAsync">
                    @(_isBusy ? "Approving…" : "Approve")
                </button>
                <button type="button"
                        class="ab-chat-surface__submit ab-chat-surface__submit--deny"
                        disabled="@_isBusy"
                        @onclick="DenyActionsAsync">
                    @(_isBusy ? "Denying…" : "Deny")
                </button>
            </div>
        </article>
    }

    <EditForm class="ab-chat-surface__controls" Model="@this" FormName="@EffectiveFormName" OnValidSubmit="SendAsync">
        <label class="ab-chat-surface__label" for="@AgentSelectId">Agent</label>
        <select id="@AgentSelectId"
                class="ab-chat-surface__select"
                @bind="_selectedAgent"
                aria-describedby="@DescriptionId"
                disabled="@_isBusy">
            @if (_agentNames.Count == 0)
            {
                <option value="">No agents registered</option>
            }
            @foreach (var agent in _agentNames)
            {
                <option value="@agent">@agent</option>
            }
        </select>

        <label class="ab-chat-surface__label" for="@PromptId">Message</label>
        <textarea id="@PromptId"
                  @ref="_promptRef"
                  class="ab-chat-surface__input"
                  rows="3"
                  @bind="_prompt"
                  @bind:event="oninput"
                  placeholder="@Placeholder"
                  aria-describedby="@DescriptionId"
                  aria-label="Message input"
                  disabled="@_isBusy"></textarea>

        <button type="submit"
                id="@SubmitButtonId"
                class="ab-chat-surface__submit"
                disabled="@(_isBusy || !_canSubmit)"
                aria-busy="@_isBusy"
                aria-label="@(_isBusy ? "Sending..." : "Send message")">
            @(_isBusy ? "Sending…" : "Send")
        </button>
    </EditForm>
</section>

@code {
    private readonly List<string> _agentNames = [];
    private readonly List<ChatTimelineItem> _timeline = [];
    private string _prompt = string.Empty;
    private string? _selectedAgent;
    private bool _isBusy;
    private bool _scrollRequested;
    private ElementReference _promptRef;
    private readonly string _instanceId = Guid.NewGuid().ToString("N");
    private string _streamingResponseText = string.Empty;
    private string? _streamingAgentName;

    private PendingClarificationInfo? _pendingClarification;
    private string _clarificationResponse = string.Empty;
    private string? _lastUserMessage;
    private readonly List<PendingApprovalInfo> _pendingApprovals = [];
    private AgentState _agentState = AgentState.Idle;

    private enum AgentState { Idle, Thinking, WaitingForApproval, WaitingForClarification }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? FormName { get; set; }

    [Parameter]
    public string? DefaultAgentName { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Type a message… (Enter to send, Shift+Enter for new line)";

    [Parameter]
    public ChatTheme? Theme { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    private string EffectiveFormName =>
        string.IsNullOrWhiteSpace(FormName)
            ? $"agent-chat-surface-{_instanceId}"
            : FormName;

    private string AgentSelectId => $"ab-agent-select-{_instanceId}";
    private string PromptId => $"ab-agent-prompt-{_instanceId}";
    private string SubmitButtonId => $"ab-agent-submit-{_instanceId}";
    private string TimelineId => $"ab-chat-timeline-{_instanceId}";
    private string HeaderId => $"ab-chat-header-{_instanceId}";
    private string DescriptionId => $"ab-chat-description-{_instanceId}";
    private string ClarificationInputId => $"ab-clarification-input-{_instanceId}";

    private bool _canSubmit => !string.IsNullOrWhiteSpace(_prompt.Trim()) && _pendingClarification is null;

    private string? _themeStyle => Theme?.GetStyleString();

    protected override void OnInitialized()
    {
        DeferredActionEvents.DeferredActionCompleted += HandleDeferredActionCompleted;

        _agentNames.AddRange(
            AgentRegistry.GetAll()
                .Select(static agent => agent.Name)
                .OrderBy(static name => name, StringComparer.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(DefaultAgentName))
        {
            _selectedAgent = _agentNames.FirstOrDefault(name =>
                string.Equals(name, DefaultAgentName, StringComparison.OrdinalIgnoreCase));
        }

        _selectedAgent ??= _agentNames.FirstOrDefault();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("AgentBlazor.chat.attachEnterSubmit", PromptId, SubmitButtonId);
            }
            catch
            {
                // JS may be unavailable (e.g. prerender); ignore
            }
        }

        if (_scrollRequested)
        {
            _scrollRequested = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("AgentBlazor.chat.scrollToBottom", TimelineId);
            }
            catch
            {
                // JS may be unavailable (e.g. prerender); ignore
            }
        }

        if (_pendingClarification is not null)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("AgentBlazor.chat.attachEnterSubmit", ClarificationInputId, $"ab-clarification-submit-{_instanceId}");
            }
            catch { }
        }
    }

    public void Dispose()
    {
        DeferredActionEvents.DeferredActionCompleted -= HandleDeferredActionCompleted;

        try
        {
            _ = JSRuntime.InvokeVoidAsync("AgentBlazor.chat.detachEnterSubmit", PromptId);
        }
        catch
        {
            // Ignore when JS or component already torn down
        }
    }

    private async Task SendAsync()
    {
        if (_isBusy)
            return;

        var message = _prompt.Trim();
        if (message.Length == 0)
            return;

        if (_agentNames.Count == 0)
            return;

        _timeline.Add(ChatTimelineItem.User(message));
        _lastUserMessage = message;
        _prompt = string.Empty;
        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _isBusy = true;
        _agentState = AgentState.Thinking;
        _scrollRequested = true;
        StateHasChanged();

        try
        {
            var response = await RunTurnWithOptionalStreamingAsync(new AgentTurnRequest(
                message,
                _selectedAgent,
                SessionId: _instanceId));

            if (response.RequiresClarification && !string.IsNullOrWhiteSpace(response.ClarificationQuestion))
            {
                _pendingClarification = new PendingClarificationInfo(
                    response.ClarificationQuestion,
                    message);
                _timeline.Add(ChatTimelineItem.Agent(response));
                _agentState = AgentState.WaitingForClarification;
            }
            else if (response.RequiresApproval && response.PendingApprovals.Count > 0)
            {
                _pendingApprovals.Clear();
                _pendingApprovals.AddRange(response.PendingApprovals.Select(p => 
                    new PendingApprovalInfo(p.ComponentId, p.ActionId, p.Description, p.Parameters)));
                _timeline.Add(ChatTimelineItem.Agent(response));
                _agentState = AgentState.WaitingForApproval;
            }
            else
            {
                _timeline.Add(ChatTimelineItem.Agent(response));
                _agentState = AgentState.Idle;
            }
            _scrollRequested = true;
        }
        finally
        {
            _isBusy = false;
            if (_agentState == AgentState.Thinking)
                _agentState = AgentState.Idle;
        }

        try
        {
            await _promptRef.FocusAsync();
        }
        catch
        {
            // Focus may fail in some hosts
        }
    }

    private async Task SubmitClarificationAsync()
    {
        if (_isBusy || _pendingClarification is null || string.IsNullOrWhiteSpace(_clarificationResponse))
            return;

        var fullMessage = $"{_pendingClarification.OriginalMessage} {_clarificationResponse}".Trim();
        
        _timeline.Add(ChatTimelineItem.User(_clarificationResponse));
        var responseText = _clarificationResponse;
        _clarificationResponse = string.Empty;
        _pendingClarification = null;
        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _isBusy = true;
        _scrollRequested = true;
        StateHasChanged();

        try
        {
            var response = await RunTurnWithOptionalStreamingAsync(new AgentTurnRequest(
                fullMessage,
                _selectedAgent,
                SessionId: _instanceId));

            _timeline.Add(ChatTimelineItem.Agent(response));
            _agentState = AgentState.Idle;
            _scrollRequested = true;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleClarificationKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !string.IsNullOrWhiteSpace(_clarificationResponse))
        {
            await SubmitClarificationAsync();
        }
    }

    private async Task ApproveActionsAsync()
    {
        if (_isBusy || _pendingApprovals.Count == 0)
            return;

        var approvalKeys = _pendingApprovals
            .Select(static approval => $"{approval.ComponentId}.{approval.ActionId}")
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
        var context = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
        {
            ["agentblazor.approvals"] = string.Join(",", approvalKeys)
        };
        
        _timeline.Add(ChatTimelineItem.User("Approved"));
        _pendingApprovals.Clear();
        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _isBusy = true;
        _agentState = AgentState.Thinking;
        _scrollRequested = true;
        StateHasChanged();

        try
        {
            var response = await RunTurnWithOptionalStreamingAsync(new AgentTurnRequest(
                "Approve the pending actions.",
                _selectedAgent,
                SessionId: _instanceId,
                Context: context));

            _timeline.Add(ChatTimelineItem.Agent(response));
            _agentState = AgentState.Idle;
            _scrollRequested = true;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DenyActionsAsync()
    {
        if (_isBusy || _pendingApprovals.Count == 0)
            return;

        _timeline.Add(ChatTimelineItem.User("Denied"));
        _pendingApprovals.Clear();
        _streamingResponseText = string.Empty;
        _streamingAgentName = null;
        _agentState = AgentState.Idle;
        _scrollRequested = true;
        StateHasChanged();
    }

    private async Task<AgentTurnResponse> RunTurnWithOptionalStreamingAsync(AgentTurnRequest request)
    {
        if (AgentRuntime is not IAgentRuntimeStreaming streamingRuntime)
        {
            return await AgentRuntime.RunTurnAsync(request);
        }

        _streamingResponseText = string.Empty;
        _streamingAgentName = null;

        AgentTurnResponse? finalResponse = null;
        await foreach (var streamEvent in streamingRuntime.RunTurnStreamingAsync(request))
        {
            if (streamEvent.Kind == AgentTurnStreamEventKind.TextDelta &&
                !string.IsNullOrEmpty(streamEvent.TextDelta))
            {
                _streamingAgentName ??= streamEvent.AgentName;
                _streamingResponseText += streamEvent.TextDelta;
                _scrollRequested = true;
                await InvokeAsync(StateHasChanged);
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.RunFinished &&
                streamEvent.Response is not null)
            {
                finalResponse = streamEvent.Response;
                continue;
            }

            if (streamEvent.Kind == AgentTurnStreamEventKind.RunError)
            {
                throw new InvalidOperationException(streamEvent.ErrorMessage ?? "Streaming run failed.");
            }
        }

        _streamingResponseText = string.Empty;
        _streamingAgentName = null;

        return finalResponse
            ?? throw new InvalidOperationException("Streaming completed without a final response.");
    }

    private void HandleDeferredActionCompleted(DeferredComponentActionEvent actionEvent)
    {
        _ = InvokeAsync(() =>
        {
            _timeline.Add(ChatTimelineItem.Activity(FormatDeferredActionMessage(actionEvent)));
            _scrollRequested = true;
            StateHasChanged();
        });
    }

    private static string FormatDeferredActionMessage(DeferredComponentActionEvent actionEvent)
    {
        var componentId = actionEvent.ComponentType.StartsWith("Agent", StringComparison.OrdinalIgnoreCase)
            ? actionEvent.ComponentType
            : $"Agent{actionEvent.ComponentType}";
        var status = actionEvent.Succeeded ? "applied" : "failed";
        return $"Deferred action {status}: {componentId}.{actionEvent.ActionId}. {actionEvent.Message}";
    }

    private sealed record ChatTimelineItem(
        string Role,
        string RoleLabel,
        string Text,
        IReadOnlyList<PlannedComponentAction> PlannedActions,
        IReadOnlyList<ComponentActionExecutionResult> ExecutionResults)
    {
        public static ChatTimelineItem User(string text) =>
            new("user", "User", text, [], []);

        public static ChatTimelineItem Agent(AgentTurnResponse response) =>
            new("assistant", response.AgentName, response.ResponseText, response.PlannedActions, response.ExecutionResults);

        public static ChatTimelineItem Activity(string text) =>
            new("activity", "Activity", text, [], []);
    }

    private sealed record PendingClarificationInfo(string Question, string OriginalMessage);
    private sealed record PendingApprovalInfo(string ComponentId, string ActionId, string Description, IReadOnlyDictionary<string, object?> Parameters);
}
