        => ExecutionPlanNarrativeFormatter.BuildApprovalSummary(
            approvals.Select(static approval => approval.PolicyDecision));

    private static string GetApprovalDisplayTitle(PendingApprovalInfo approval) =>
        ExecutionPlanNarrativeFormatter.BuildApprovalDisplayTitle(
            approval.ComponentId,
            approval.ActionId,
            approval.Description);

    private static string BuildApprovalPolicySummary(AgentPolicyDecision policyDecision) =>
        ExecutionPlanNarrativeFormatter.BuildApprovalPolicySummary(policyDecision);

    private static IReadOnlyList<string> GetDisplayResultTexts(ChatTimelineItem item)
    {
        if (item.ExecutionPlan?.Steps.Count > 0)
        {
            return item.ExecutionPlan.Steps
                .SelectMany(ExecutionStepNarrativeFormatter.BuildResultTexts)
                .ToArray();
        }

        if (item.LegacyExecutionResults.Count == 0)
        {
            return [];
        }

        return item.LegacyExecutionResults
            .Where(static result => !string.IsNullOrWhiteSpace(result.Message))
            .Select(static result => result.Message)
            .ToArray();
    }

    // ── Slash Command Discovery ─────────────────────────────────────────────

    private void HandlePromptInput(ChangeEventArgs args)
    {
        var value = args.Value?.ToString() ?? string.Empty;
        _prompt = value;

        if (value.StartsWith('/'))
        {
            var filter = value.Length > 1 ? value[1..].ToLowerInvariant() : string.Empty;
            _allSlashItems ??= BuildAllSlashItems();
            _slashItems = string.IsNullOrEmpty(filter)
                ? _allSlashItems
                : _allSlashItems
                    .Where(i => i.ActionId.Contains(filter, StringComparison.OrdinalIgnoreCase)
                             || i.Label.Contains(filter, StringComparison.OrdinalIgnoreCase))
                    .ToList();
            _showSlashMenu = _slashItems.Count > 0;
        }
        else
        {
            _showSlashMenu = false;
        }
    }

    private void HandlePromptKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            _showSlashMenu = false;
        }
    }

    private void AcceptSlashItem(SlashItem item)
    {
        _prompt = item.InsertText;
        _showSlashMenu = false;
        StateHasChanged();
    }

    private List<SlashItem> BuildAllSlashItems()
    {
        var items = new List<SlashItem>();
        if (EnableAgentHandoff && _agentNames.Count > 0)
        {
            items.Add(new SlashItem(
                "AgentRuntime",
                "agents",
                "List available agents",
                "/agents"));
            items.Add(new SlashItem(
                "AgentRuntime",
                "handoff-history",
                "Show recent handoff transitions",
                "/handoff-history"));
            items.Add(new SlashItem(
                "AgentRuntime",
                "handoff-policy",
                "Show active handoff policy and limits",
                "/handoff-policy"));
            foreach (var agentName in _agentNames)
            {
                items.Add(new SlashItem(
                    "AgentRuntime",
                    "handoff",
                    $"Switch control to {agentName}",
                    $"/agent {agentName}"));
            }

            if (RequireHandoffApproval)
            {
                items.Add(new SlashItem(
                    "AgentRuntime",
                    "approve-handoff",
                    "Approve pending handoff request",
                    "/approve-handoff"));
                items.Add(new SlashItem(
                    "AgentRuntime",
                    "cancel-handoff",
                    "Cancel pending handoff request",
                    "/cancel-handoff"));
            }
        }

        foreach (var component in ComponentRegistry.GetAll())
        {
            if (!AgentActionDiscovery.IsAttributeDriven(component))
                continue;

            var capability = AgentActionDiscovery.BuildCapability(component);
            foreach (var action in capability.Actions)
            {
                items.Add(new SlashItem(
                    component.ComponentType,
                    action.ActionId,
                    action.Description,
                    action.Description));
            }
        }

        return items;
    }

    private async Task<bool> TryHandleAgentHandoffCommandAsync(string message)
    {
        if (!EnableAgentHandoff || !TryExtractHandoffTarget(message, out var targetHint))
        {
            return false;
        }

        if (_agentNames.Count == 0)
        {
            _timeline.Add(ChatTimelineItem.Activity("No agents are registered to hand off to."));
            return true;
        }

        if (!TryResolveAgentByHint(targetHint, out var targetAgent))
        {
            _timeline.Add(ChatTimelineItem.Activity(
                $"Unknown agent '{targetHint}'. Available: {string.Join(", ", _agentNames)}."));
            return true;
        }

        var previousAgent = _selectedAgent ?? _agentNames.FirstOrDefault() ?? "Agent";
        if (string.Equals(previousAgent, targetAgent, StringComparison.OrdinalIgnoreCase))
        {
            _timeline.Add(ChatTimelineItem.Activity($"Already assigned to {targetAgent}."));
            return true;
        }

        if (!IsHandoffAllowed(previousAgent, targetAgent, out var policyViolation))
        {
            _timeline.Add(ChatTimelineItem.Activity(policyViolation ?? $"Handoff from {previousAgent} to {targetAgent} is blocked by policy."));
            return true;
        }

        if (!string.IsNullOrWhiteSpace(LockedAgentName))
        {
            _timeline.Add(ChatTimelineItem.Activity(
                $"Agent is locked to '{LockedAgentName}'. Handoff command was ignored."));
            return true;
        }

        string? targetRoute = null;
        if (LockAgentToCurrentRoute)
        {
            if (!AutoNavigateOnRouteLockedHandoff)
            {
                _timeline.Add(ChatTimelineItem.Activity(
                    $"Agent is route-locked on '{GetCurrentRoute()}'. Navigate to the target route to complete handoff."));
                return true;
            }

            targetRoute = ResolvePrimaryRouteForAgent(targetAgent);
            if (string.IsNullOrWhiteSpace(targetRoute))
            {
                _timeline.Add(ChatTimelineItem.Activity(
                    $"Could not resolve a route prefix for '{targetAgent}'."));
                return true;
            }
        }

        if (ShouldRequireHandoffApproval(previousAgent, targetAgent))
        {
            _pendingHandoffRequest = new PendingHandoffRequest(previousAgent, targetAgent, targetRoute);
            var routeInfo = string.IsNullOrWhiteSpace(targetRoute)
                ? string.Empty
                : $" Route: {targetRoute}.";
            _timeline.Add(ChatTimelineItem.Activity(
                $"Handoff requested: {previousAgent} -> {targetAgent}.{routeInfo} Type /approve-handoff or /cancel-handoff."));
            return true;
        }

        await CompleteHandoffAsync(previousAgent, targetAgent, targetRoute);
        return true;
    }

    private async Task ApprovePendingHandoffAsync()
    {
        if (_isBusy || _pendingHandoffRequest is null)
        {
            return;
        }

        var request = _pendingHandoffRequest;
        if (!IsHandoffAllowed(request.FromAgent, request.ToAgent, out var policyViolation))
        {
            _timeline.Add(ChatTimelineItem.Activity(policyViolation ?? $"Handoff from {request.FromAgent} to {request.ToAgent} is blocked by policy."));
            _pendingHandoffRequest = null;
            _scrollRequested = true;
            StateHasChanged();
            return;
        }

        _pendingHandoffRequest = null;
        await CompleteHandoffAsync(request.FromAgent, request.ToAgent, request.TargetRoute);
        _scrollRequested = true;
        StateHasChanged();
    }

    private Task CancelPendingHandoffAsync()
    {
        if (_isBusy || _pendingHandoffRequest is null)
        {
            return Task.CompletedTask;
        }

        _timeline.Add(ChatTimelineItem.Activity(
            $"Canceled handoff: {_pendingHandoffRequest.FromAgent} -> {_pendingHandoffRequest.ToAgent}."));
        _pendingHandoffRequest = null;
        _scrollRequested = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private bool TryHandleAgentListCommand(string message)
    {
        if (!EnableAgentHandoff || !IsAgentListCommand(message))
        {
            return false;
        }

        if (_agentNames.Count == 0)
        {
            _timeline.Add(ChatTimelineItem.Activity("No agents are currently registered."));
            return true;
        }

        _timeline.Add(ChatTimelineItem.Activity($"Available agents: {string.Join(", ", _agentNames)}."));
        return true;
    }

    private bool TryHandleHandoffHistoryCommand(string message)
    {
        if (!EnableAgentHandoff || !HandoffHistoryFormatter.TryParseHistoryCommand(message, out var limit))
        {
            return false;
        }

        var summary = HandoffHistoryFormatter.BuildSummary(_handoffHistory, limit);
        _timeline.Add(ChatTimelineItem.Activity(summary));
        return true;
    }

    private bool TryHandleHandoffPolicyCommand(string message)
    {
        if (!EnableAgentHandoff || !HandoffPolicyFormatter.TryParsePolicyCommand(message))
        {
            return false;
        }

        var summary = HandoffPolicyFormatter.BuildSummary(
            HandoffPolicy,
            HandoffApprovalPolicy,
            RequireHandoffApproval,
            _handoffHistory,
            MaxHandoffsPerSession,
            MaxHandoffsPerPair,
            BlockImmediateReturnHandoff,
            MaxHandoffsPerWindow,
            HandoffWindowMinutes,
            MaxPairHandoffsPerWindow);
        _timeline.Add(ChatTimelineItem.Activity(summary));
        return true;
    }

    private async Task<bool> TryHandleHandoffDecisionCommandAsync(string message)
    {
        if (!EnableAgentHandoff || !TryExtractHandoffDecision(message, out var approve))
        {
            return false;
        }

        if (_pendingHandoffRequest is null)
        {
            _timeline.Add(ChatTimelineItem.Activity("No pending handoff request."));
            return true;
        }

        if (!approve)
        {
            await CancelPendingHandoffAsync();
            return true;
        }

        await ApprovePendingHandoffAsync();
        return true;
    }

    private async Task CompleteHandoffAsync(string fromAgent, string toAgent, string? targetRoute)
    {
        _selectedAgent = toAgent;
        SetPendingHandoffMetadata(fromAgent, toAgent);
        RecordHandoffTransition(fromAgent, toAgent);

        if (LockAgentToCurrentRoute)
        {
            if (!string.IsNullOrWhiteSpace(targetRoute))
            {
                _timeline.Add(ChatTimelineItem.Activity(
                    $"Handed off from {fromAgent} to {toAgent}. Navigating to {targetRoute}."));
                NavigationManager.NavigateTo(targetRoute);
                return;
            }

            _timeline.Add(ChatTimelineItem.Activity(
                $"Handed off from {fromAgent} to {toAgent}."));
            return;
        }

        await HydrateTimelineFromHistoryAsync(force: true);
        _timeline.Add(ChatTimelineItem.Activity($"Handed off from {fromAgent} to {toAgent}."));
    }

    private string? ResolvePrimaryRouteForAgent(string agentName)
    {
        var registration = AgentRegistry.GetAll().FirstOrDefault(a =>
            string.Equals(a.Name, agentName, StringComparison.OrdinalIgnoreCase));
        if (registration is null)
        {
            return null;
        }

        foreach (var routePattern in EnumerateRoutePatterns(registration))
        {
            var normalized = NormalizeRoute(routePattern);
            if (!string.IsNullOrWhiteSpace(normalized))
            {
                return normalized;
            }
        }

        return null;
    }

    private bool TryResolveAgentByHint(string hint, out string resolvedAgent)
    {
        resolvedAgent = string.Empty;
        var normalizedHint = NormalizeAgentHint(hint);
        if (string.IsNullOrWhiteSpace(normalizedHint))
        {
            return false;
        }

        var exact = _agentNames.FirstOrDefault(name =>
            string.Equals(NormalizeAgentHint(name), normalizedHint, StringComparison.Ordinal));
        if (!string.IsNullOrWhiteSpace(exact))
        {
            resolvedAgent = exact;
            return true;
        }

        var containsMatches = _agentNames
            .Where(name =>
            {
                var normalizedName = NormalizeAgentHint(name);
                return normalizedName.Contains(normalizedHint, StringComparison.Ordinal) ||
                       normalizedHint.Contains(normalizedName, StringComparison.Ordinal);
            })
            .ToArray();

        if (containsMatches.Length == 1)
        {
            resolvedAgent = containsMatches[0];
            return true;
        }

        return false;
    }

    private static bool TryExtractHandoffTarget(string message, out string targetHint)
    {
        targetHint = string.Empty;
        if (string.IsNullOrWhiteSpace(message))
        {
            return false;
        }

        var trimmed = message.Trim();
        var prefixes = new[]
        {
            "/agent ",
            "/handoff ",
            "handoff to ",
            "switch agent to ",
            "transfer agent to "
        };

        foreach (var prefix in prefixes)
        {
            if (!trimmed.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            targetHint = trimmed[prefix.Length..].Trim();
            return !string.IsNullOrWhiteSpace(targetHint);
        }

        return false;
    }

    private static bool IsAgentListCommand(string message)
    {
        if (string.IsNullOrWhiteSpace(message))
        {
            return false;
        }

        var trimmed = message.Trim();
        return string.Equals(trimmed, "/agents", StringComparison.OrdinalIgnoreCase) ||
               string.Equals(trimmed, "list agents", StringComparison.OrdinalIgnoreCase);
    }

    private static bool TryExtractHandoffDecision(string message, out bool approve)
    {
        approve = false;
        if (string.IsNullOrWhiteSpace(message))
        {
            return false;
        }

        var trimmed = message.Trim();
        if (string.Equals(trimmed, "/approve-handoff", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(trimmed, "approve handoff", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(trimmed, "approve transfer", StringComparison.OrdinalIgnoreCase))
        {
            approve = true;
            return true;
        }

        if (string.Equals(trimmed, "/cancel-handoff", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(trimmed, "cancel handoff", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(trimmed, "deny handoff", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return false;
    }

    private static string NormalizeAgentHint(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var trimmed = value.Trim();
        if (trimmed.EndsWith(" agent", StringComparison.OrdinalIgnoreCase))
        {
            trimmed = trimmed[..^6];
        }

        return new string(trimmed
            .Where(char.IsLetterOrDigit)
            .Select(char.ToLowerInvariant)
            .ToArray());
    }

    private bool ShouldRequireHandoffApproval(string fromAgent, string toAgent)
        => HandoffApprovalPolicyEvaluator.ShouldRequireApproval(
            RequireHandoffApproval,
            fromAgent,
            toAgent,
            HandoffApprovalPolicy);

    private bool IsHandoffAllowed(string fromAgent, string toAgent, out string? violationMessage)
    {
        var decision = HandoffPolicyEvaluator.Evaluate(
            fromAgent,
            toAgent,
            HandoffPolicy,
            _handoffHistory,
            MaxHandoffsPerSession,
            MaxHandoffsPerPair,
            BlockImmediateReturnHandoff,
            MaxHandoffsPerWindow,
            HandoffWindowMinutes,
            MaxPairHandoffsPerWindow);
        violationMessage = decision.ViolationMessage;
        return decision.Allowed;
    }

    private void RecordHandoffTransition(string fromAgent, string toAgent)
    {
        _handoffHistory.Add(new HandoffTransition(fromAgent, toAgent, DateTimeOffset.UtcNow));
        if (_handoffHistory.Count > 100)
        {
            _handoffHistory.RemoveAt(0);
        }
    }

    private void SetPendingHandoffMetadata(string fromAgent, string toAgent)
    {
        _pendingHandoffFromAgent = fromAgent;
        _pendingHandoffToAgent = toAgent;
        _pendingHandoffAtUtc = DateTimeOffset.UtcNow;
    }

    private void ClearPendingHandoffMetadata()
    {
        _pendingHandoffFromAgent = null;
        _pendingHandoffToAgent = null;
        _pendingHandoffAtUtc = null;
    }

    // ── Proactive Insights ──────────────────────────────────────────────────

    private async Task FireProactiveInsightAsync(string userMessage, StreamTurnOutcome turnOutcome)
    {
        try
        {
            var activitySummaries = turnOutcome.Response.ExecutionPlan?.Steps.Count > 0
                ? turnOutcome.Response.ExecutionPlan.Steps
                    .Select(static step => $"{step.TargetId}.{step.ActionId}")
                    .ToList()
                : turnOutcome.Response.LegacyExecutionResults
                    .Select(r => $"{r.ComponentId}.{r.ActionId}")
                    .ToList();

            if (activitySummaries.Count == 0)
                return;

            var agentName = turnOutcome.Response.AgentName;
            var insight = await ProactiveInsightService.GetInsightAsync(
                EffectiveSessionId,
                userMessage,
                activitySummaries,
                componentContext: null);

            if (string.IsNullOrWhiteSpace(insight))
                return;

            await InvokeAsync(() =>
            {
                _timeline.Add(ChatTimelineItem.Proactive(agentName, insight));
                _scrollRequested = true;
                StateHasChanged();
            });
        }
        catch
        {
            // Never let insight errors affect the chat
        }
    }

    private sealed record SlashItem(string ComponentId, string ActionId, string Label, string InsertText);

    private sealed record ChatTimelineItem(
        string Role,
        string RoleLabel,
        string Text,
        IReadOnlyList<ActivityMessage> ActivityMessages,
        IReadOnlyList<PlannedComponentAction> LegacyPlannedActions,
        IReadOnlyList<ComponentActionExecutionResult> LegacyExecutionResults,
        AgentExecutionPlan? ExecutionPlan,
        AgentUiDocument? GeneratedUi,
        string? RunId,
        bool IsProactive = false)
    {
        public static ChatTimelineItem User(string text) =>
            new("user", "User", text, [], [], [], null, null, null);

        public static ChatTimelineItem Agent(
            AgentTurnResponse response,
            string? runId = null,
            IReadOnlyList<ActivityMessage>? activityMessages = null) =>
            new(
                "assistant",
                response.AgentName,
                response.ResponseText,
                activityMessages ?? [],
                response.LegacyPlannedActions,
                response.LegacyExecutionResults,
                response.ExecutionPlan,
                response.GeneratedUi,
                runId);

        public static ChatTimelineItem Proactive(string agentName, string insight) =>
            new("assistant", agentName, insight, [], [], [], null, null, null, IsProactive: true);

        public static ChatTimelineItem Activity(string text, string? runId = null) =>
            new("activity", "Activity", text, [], [], [], null, null, runId);
    }

