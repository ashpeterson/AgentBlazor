@namespace AgentBlazor.Components
@using AgentBlazor.Components.Chat

<aside class="ab-chat-panel @(Theme?.CssClass) @(Theme?.GetFeatureClasses())"
       data-theme="@(Theme?.DataTheme)"
       data-style="@(Theme?.DataStyle)"
       data-testid="agent-chat-panel"
       style="@_panelStyle"
       role="complementary"
       aria-label="@(Title ?? "Agent chat panel")">
    <AgentChatSurface Title="@Title"
                      Description="@EffectiveDescription"
                      FormName="@FormName"
                      DefaultAgentName="@DefaultAgentName"
                      ShowAgentSelector="@ShowAgentSelector"
                      LockedAgentName="@LockedAgentName"
                      LockAgentToCurrentRoute="@LockAgentToCurrentRoute"
                      EnableAgentHandoff="@EnableAgentHandoff"
                      AutoNavigateOnRouteLockedHandoff="@AutoNavigateOnRouteLockedHandoff"
                      RequireHandoffApproval="@RequireHandoffApproval"
                      HandoffApprovalPolicy="@HandoffApprovalPolicy"
                      HandoffPolicy="@HandoffPolicy"
                      MaxHandoffsPerSession="@MaxHandoffsPerSession"
                      MaxHandoffsPerPair="@MaxHandoffsPerPair"
                      MaxHandoffsPerWindow="@MaxHandoffsPerWindow"
                      HandoffWindowMinutes="@HandoffWindowMinutes"
                      MaxPairHandoffsPerWindow="@MaxPairHandoffsPerWindow"
                      BlockImmediateReturnHandoff="@BlockImmediateReturnHandoff"
                      SessionId="@SessionId"
                      Placeholder="@Placeholder"
                      EnableGeneratedUi="@EnableGeneratedUi"
                      ShowExecutionDetails="@ShowExecutionDetails"
                      Theme="@Theme"
                      CssClass="@CssClass" />
</aside>

@code {
    [Parameter]
    public string Width { get; set; } = "350px";

    [Parameter]
    public string Height { get; set; } = "100%";

    [Parameter]
    public string? Title { get; set; } = "Agent Assistant";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Type a message… (Enter to send, Shift+Enter for new line)";

    [Parameter]
    public ChatTheme? Theme { get; set; }

    [Parameter]
    public string? FormName { get; set; }

    [Parameter]
    public string? DefaultAgentName { get; set; }

    [Parameter]
    public bool ShowAgentSelector { get; set; } = true;

    [Parameter]
    public string? LockedAgentName { get; set; }

    [Parameter]
    public bool LockAgentToCurrentRoute { get; set; }

    [Parameter]
    public bool EnableAgentHandoff { get; set; } = true;

    [Parameter]
    public bool AutoNavigateOnRouteLockedHandoff { get; set; } = true;

    [Parameter]
    public bool RequireHandoffApproval { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, IReadOnlyList<string>>? HandoffApprovalPolicy { get; set; }

    [Parameter]
    public IReadOnlyDictionary<string, IReadOnlyList<string>>? HandoffPolicy { get; set; }

    [Parameter]
    public int? MaxHandoffsPerSession { get; set; }

    [Parameter]
    public int? MaxHandoffsPerPair { get; set; }

    [Parameter]
    public int? MaxHandoffsPerWindow { get; set; }

    [Parameter]
    public int? HandoffWindowMinutes { get; set; }

    [Parameter]
    public int? MaxPairHandoffsPerWindow { get; set; }

    [Parameter]
    public bool BlockImmediateReturnHandoff { get; set; } = true;

    [Parameter]
    public string? SessionId { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public bool EnableGeneratedUi { get; set; }

    [Parameter]
    public bool ShowExecutionDetails { get; set; }

    private string EffectiveDescription =>
        !string.IsNullOrWhiteSpace(Description)
            ? Description
            : "Ask an agent to work with this Blazor app.";

    private string _panelStyle
    {
        get
        {
            var vars = $"--ab-chat-panel-width:{Width};--ab-chat-panel-height:{Height};";
            var themeStyle = Theme?.GetStyleString();
            return string.IsNullOrEmpty(themeStyle) ? vars : vars + " " + themeStyle;
        }
    }
}
