@namespace AgentBlazor.Components
@using AgentBlazor.Components.Chat

<aside class="ab-chat-panel @(Theme?.CssClass)" data-theme="@(Theme?.DataTheme)" style="@_panelStyle" role="complementary" aria-label="@(Title ?? "Agent chat panel")">
    <AgentChatSurface Title="@Title"
                      Description="@Description"
                      FormName="@FormName"
                      DefaultAgentName="@DefaultAgentName"
                      Placeholder="@Placeholder"
                      Theme="@Theme"
                      CssClass="@CssClass" />
</aside>

@code {
    [Parameter]
    public string Width { get; set; } = "350px";

    [Parameter]
    public string Height { get; set; } = "100%";

    [Parameter]
    public string? Title { get; set; } = "Agent Assistant";

    [Parameter]
    public string? Description { get; set; } =
        "Built-in component-aware agent is active by default. You can also select custom registered agents.";

    [Parameter]
    public string Placeholder { get; set; } = "Type a message… (Enter to send, Shift+Enter for new line)";

    [Parameter]
    public ChatTheme? Theme { get; set; }

    [Parameter]
    public string? FormName { get; set; }

    [Parameter]
    public string? DefaultAgentName { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    private string _panelStyle
    {
        get
        {
            var vars = $"--ab-chat-panel-width:{Width};--ab-chat-panel-height:{Height};";
            var themeStyle = Theme?.GetStyleString();
            return string.IsNullOrEmpty(themeStyle) ? vars : vars + " " + themeStyle;
        }
    }
}
