<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Azure.*" />
      <package pattern="AngleSharp*" />
      <package pattern="bunit.*" />
      <package pattern="coverlet.*" />
      <package pattern="Google.*" />
      <package pattern="Humanizer.*" />
      <package pattern="Markdig" />
      <package pattern="Microsoft.*" />
      <package pattern="MudBlazor" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="OpenAI" />
      <package pattern="OpenTelemetry.*" />
      <package pattern="Spectre.*" />
      <package pattern="SQLitePCLRaw.*" />
      <package pattern="System.*" />
      <package pattern="Validation*" />
      <package pattern="xunit" />
      <package pattern="xunit.*" />
      <package pattern="Xunit.*" />
    </packageSource>
    <packageSource key="github-agentblazor">
      <package pattern="AgentBlazor*" />
    </packageSource>
    <packageSource key="agentblazor-local">
      <package pattern="AgentBlazor*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
